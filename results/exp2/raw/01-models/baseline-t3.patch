+    public let status: String
+
+    public init(
+        id: Int, title: String, overview: String = "", posterPath: String? = nil,
+        backdropPath: String? = nil, releaseDate: Date? = nil, voteAverage: Double = 0,
+        voteCount: Int = 0, runtime: Int? = nil, tagline: String? = nil,
