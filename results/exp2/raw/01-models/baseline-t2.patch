index 0000000..a8010d9
--- /dev/null
+++ b/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift
@@ -0,0 +1,41 @@
+import Foundation
+
+extension JSONDecoder {
+    /// Decoder for every TMDB response (snake_case keys). A new instance is returned on each access.
+    static var tmdb: JSONDecoder {
+        let decoder = JSONDecoder()
+        decoder.keyDecodingStrategy = .convertFromSnakeCase
+        return decoder
+    }
+}
+
+enum TMDBDate {
+    private static var calendar: Calendar {
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = TimeZone(identifier: "UTC")!
+        return calendar
+    }
+
+    /// Parses "yyyy-MM-dd"; returns nil for empty or malformed input.
+    static func parse(_ string: String) -> Date? {
+        let parts = string.split(separator: "-", omittingEmptySubsequences: false)
+        guard parts.count == 3,
+              let y = Int(parts[0]), let m = Int(parts[1]), let d = Int(parts[2]) else { return nil }
+        let components = DateComponents(year: y, month: m, day: d)
+        guard let date = calendar.date(from: components),
+              calendar.dateComponents([.year, .month, .day], from: date) == components else { return nil }
+        return date
+    }
+
+    static func year(of date: Date?) -> String? {
+        date.map { String(calendar.component(.year, from: $0)) }
+    }
+}
+
+extension KeyedDecodingContainer {
+    /// Decodes an optional "yyyy-MM-dd" date; missing, null, empty, or malformed values yield nil.
+    func decodeTMDBDate(forKey key: Key) throws -> Date? {
+        guard let string = try decodeIfPresent(String.self, forKey: key) else { return nil }
+        return TMDBDate.parse(string)
+    }
+}
