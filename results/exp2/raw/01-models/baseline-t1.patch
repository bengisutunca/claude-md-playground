@@ -0,0 +1,66 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("Models")
+struct ModelTests {
+    private func decode<T: Decodable>(_ type: T.Type, _ fixture: String) throws -> T {
+        try JSONDecoder.tmdb.decode(type, from: Fixture.data(fixture))
+    }
+
+    @Test func popularPage1() throws {
+        let page = try decode(PagedResponse<Movie>.self, "popular_page1")
+        #expect(page.page == 1)
+        #expect(page.results.count == 5)
+        #expect(page.totalPages >= 2)
+        #expect(page.totalResults >= page.results.count)
+        let inception = try #require(page.results.first)
+        #expect(inception.id == 27205)
+        #expect(inception.title == "Inception")
+        #expect(inception.genreIDs == [28, 878, 12])
+        #expect(inception.year == "2010")
+        #expect(inception.ratingText == "8.4")
+        #expect(inception.voteCount == 37000)
+    }
+
+    @Test func nullImagePaths() throws {
+        let movies = try decode(PagedResponse<Movie>.self, "popular_page1").results
+        #expect(movies.contains { $0.backdropPath == nil && $0.posterPath != nil })
+        #expect(movies.contains { $0.posterPath == nil && $0.backdropPath != nil })
+    }
+
+    @Test func popularPage2AndEmptyReleaseDate() throws {
+        let page = try decode(PagedResponse<Movie>.self, "popular_page2")
+        #expect(page.page == 2)
+        let parasite = try #require(page.results.first { $0.title == "Parasite" })
+        #expect(parasite.releaseDate == nil)
+        #expect(parasite.year == nil)
+        #expect(page.results.contains { $0.releaseDate != nil })
+    }
+
+    @Test func movieDetail() throws {
+        let d = try decode(MovieDetail.self, "movie_detail_27205")
+        #expect(d.id == 27205)
+        #expect(d.runtime == 148)
+        #expect(d.tagline == "Your mind is the scene of the crime.")
+        #expect(d.status == "Released")
+        #expect(d.genres.map(\.name) == ["Action", "Science Fiction", "Adventure"])
+        #expect(d.year == "2010")
+    }
+
+    @Test func credits() throws {
+        let c = try decode(Credits.self, "movie_credits_27205")
+        #expect(c.id == 27205)
+        #expect(c.cast.first?.name == "Leonardo DiCaprio")
+        #expect(c.cast.first?.character == "Cobb")
+        #expect(c.cast.first?.order == 0)
+        #expect(c.cast.contains { $0.profilePath == nil })
+        #expect(c.crew.first?.job == "Director")
+        #expect(c.crew.first?.department == "Directing")
+    }
+
+    @Test func ratingTextFormatting() {
+        #expect(Movie(id: 1, title: "x", voteAverage: 7).ratingText == "7.0")
+        #expect(Movie(id: 1, title: "x", voteAverage: 8.449).ratingText == "8.4")
+    }
+}
