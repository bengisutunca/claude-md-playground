@@ -0,0 +1,76 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("Model decoding")
+struct ModelDecodingTests {
+    private func page(_ name: String) throws -> PagedResponse<Movie> {
+        try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data(name))
+    }
+
+    @Test func popularPage1() throws {
+        let page = try page("popular_page1")
+        #expect(page.page == 1)
+        #expect(page.totalPages >= 1)
+        #expect(page.totalResults >= page.results.count)
+        let inception = try #require(page.results.first { $0.id == 27205 })
+        #expect(inception.title == "Inception")
+        #expect(inception.genreIDs == [28, 878, 12])
+        #expect(inception.posterPath == "/inception.jpg")
+        #expect(inception.backdropPath == "/inception_bg.jpg")
+        #expect(inception.voteCount == 37000)
+        #expect(inception.ratingText == "8.4")
+        #expect(inception.year == "2010")
+        #expect(inception.releaseDate != nil)
+    }
+
+    @Test func nullImagePathsDecodeAsNil() throws {
+        let movies = try page("popular_page1").results
+        #expect(movies.contains { $0.posterPath == nil })
+        #expect(movies.contains { $0.backdropPath == nil })
+    }
+
+    @Test func emptyReleaseDateDecodesAsNil() throws {
+        let movies = try page("popular_page2").results
+        #expect(movies.contains { $0.releaseDate == nil && $0.year == nil })
+        #expect(movies.contains { $0.releaseDate != nil })
+    }
+
+    @Test func popularPage2() throws {
+        let p2 = try page("popular_page2")
+        #expect(p2.page == 2)
+        let ids1 = Set(try page("popular_page1").results.map(\.id))
+        #expect(ids1.isDisjoint(with: p2.results.map(\.id)))
+    }
+
+    @Test func movieDetail() throws {
+        let detail = try JSONDecoder.tmdb.decode(MovieDetail.self, from: Fixture.data("movie_detail_27205"))
+        #expect(detail.id == 27205)
+        #expect(detail.runtime == 148)
+        #expect(detail.tagline == "Your mind is the scene of the crime.")
+        #expect(detail.status == "Released")
+        #expect(detail.genres.map(\.name) == ["Action", "Science Fiction", "Adventure"])
+        #expect(detail.year == "2010")
+    }
+
+    @Test func credits() throws {
+        let credits = try JSONDecoder.tmdb.decode(Credits.self, from: Fixture.data("movie_credits_27205"))
+        #expect(credits.id == 27205)
+        #expect(credits.cast.count == 4)
+        #expect(credits.cast[0].name == "Leonardo DiCaprio")
+        #expect(credits.cast[0].character == "Cobb")
+        #expect(credits.cast[2].profilePath == nil)
+        #expect(credits.crew.first?.job == "Director")
+        #expect(credits.crew.first?.department == "Directing")
+    }
+
+    @Test func ratingTextUsesOneDecimal() {
+        #expect(Movie(id: 1, title: "A", voteAverage: 7).ratingText == "7.0")
+        #expect(Movie(id: 1, title: "A", voteAverage: 8.449).ratingText == "8.4")
+    }
+
+    @Test func malformedDateThrows() {
+        let json = Data(#"{"id":1,"title":"x","release_date":"nope"}"#.utf8)
+        #expect(throws: DecodingError.self) { try JSONDecoder.tmdb.decode(Movie.self, from: json) }
+    }
+}
