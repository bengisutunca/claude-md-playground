+import Foundation
+import Testing
+@testable import TMDBApp
+
+/// `HTTPClient` that decodes a canned fixture (or throws) and records endpoints. No network.
+private final class MockHTTPClient: HTTPClient, @unchecked Sendable {
+    private let lock = NSLock()
+    private var _endpoints: [Endpoint] = []
+    var data: Data
+    var error: Error?
+
+    init(data: Data = Data(), error: Error? = nil) {
+        self.data = data
+        self.error = error
+    }
+
+    var endpoints: [Endpoint] { lock.withLock { _endpoints } }
+
+    func send<T: Decodable>(_ endpoint: Endpoint, as type: T.Type) async throws -> T {
+        lock.withLock { _endpoints.append(endpoint) }
+        if let error { throw error }
+        return try JSONDecoder.tmdb.decode(T.self, from: data)
+    }
+}
+
+@Suite("TMDBMovieService")
+struct MovieServiceTests {
+    @Test func popularUsesEndpointAndDecodes() async throws {
+        let client = MockHTTPClient(data: try Fixture.data("popular_page1"))
+        let page = try await TMDBMovieService(client: client).popular(page: 1)
+        #expect(client.endpoints == [.popular(page: 1)])
+        #expect(page.results.count == 5)
+        #expect(page.results.first?.id == 27205)
+    }
+
+    @Test func popularPage2() async throws {
+        let client = MockHTTPClient(data: try Fixture.data("popular_page2"))
+        let page = try await TMDBMovieService(client: client).popular(page: 2)
+        #expect(client.endpoints == [.popular(page: 2)])
+        #expect(page.page == 2)
+    }
+
+    @Test func searchPassesQueryAndPage() async throws {
+        let client = MockHTTPClient(data: try Fixture.data("search_inception"))
+        let page = try await TMDBMovieService(client: client).search(query: "inception", page: 1)
+        #expect(client.endpoints == [.search(query: "inception", page: 1)])
+        #expect(!page.results.isEmpty)
+    }
+
+    @Test func searchEmptyResults() async throws {
+        let client = MockHTTPClient(data: try Fixture.data("search_empty"))
+        let page = try await TMDBMovieService(client: client).search(query: "zzzz", page: 1)
+        #expect(page.results.isEmpty)
+    }
+
+    @Test func detailDecodes() async throws {
+        let client = MockHTTPClient(data: try Fixture.data("movie_detail_27205"))
+        let detail = try await TMDBMovieService(client: client).detail(id: 27205)
+        #expect(client.endpoints == [.movieDetail(id: 27205)])
+        #expect(detail.id == 27205)
+        #expect(detail.runtime == 148)
+    }
+
+    @Test func creditsDecodes() async throws {
+        let client = MockHTTPClient(data: try Fixture.data("movie_credits_27205"))
+        _ = try await TMDBMovieService(client: client).credits(id: 27205)
+        #expect(client.endpoints == [.credits(movieID: 27205)])
+    }
+
+    @Test func clientErrorsPropagate() async throws {
+        let client = MockHTTPClient(error: APIError.httpStatus(code: 401, message: "nope"))
+        let service = TMDBMovieService(client: client)
+        do {
+            _ = try await service.popular(page: 1)
+            Issue.record("expected error")
+        } catch APIError.httpStatus(let code, let message) {
+            #expect(code == 401)
+            #expect(message == "nope")
+        }
+    }
+
+    @Test func mockServiceRecordsCallsAndThrows() async throws {
+        let mock = MockMovieService()
+        _ = try await mock.popular(page: 1)
+        _ = try await mock.detail(id: 27205)
+        #expect(mock.calls == [.popular(page: 1), .detail(id: 27205)])
+        mock.error = APIError.invalidResponse
+        await #expect(throws: APIError.self) { try await mock.credits(id: 1) }
+        #expect(mock.calls.last == .credits(id: 1))
+    }
+}
