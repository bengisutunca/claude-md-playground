+import Foundation
+@testable import TMDBApp
+
+/// Reusable `MovieService` double: returns fixture data (or a configured error) and records calls.
+final class MockMovieService: MovieService, @unchecked Sendable {
+    enum Call: Equatable {
+        case popular(page: Int)
+        case search(query: String, page: Int)
+        case detail(id: Int)
+        case credits(id: Int)
+    }
+
+    private let lock = NSLock()
+    private var _calls: [Call] = []
+
+    /// When set, every method throws this instead of returning fixture data.
+    var error: Error?
+
+    var calls: [Call] { lock.withLock { _calls } }
+
+    init(error: Error? = nil) {
+        self.error = error
+    }
+
+    private func record(_ call: Call) throws {
+        lock.withLock { _calls.append(call) }
+        if let error { throw error }
+    }
+
+    private func load<T: Decodable>(_ name: String) throws -> T {
+        try JSONDecoder.tmdb.decode(T.self, from: Fixture.data(name))
+    }
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        try record(.popular(page: page))
+        return try load(page == 2 ? "popular_page2" : "popular_page1")
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        try record(.search(query: query, page: page))
+        let trimmed = query.trimmingCharacters(in: .whitespaces).lowercased()
+        return try load(trimmed.contains("inception") ? "search_inception" : "search_empty")
+    }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        try record(.detail(id: id))
+        return try load("movie_detail_27205")
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        try record(.credits(id: id))
+        return try load("movie_credits_27205")
+    }
+}
