+import Foundation
+import Testing
+@testable import TMDBApp
+
+private final class MockHTTPClient: HTTPClient, @unchecked Sendable {
+    private let lock = NSLock()
+    private var _endpoints: [Endpoint] = []
+    let fixture: String?
+    let error: Error?
+
+    init(fixture: String? = nil, error: Error? = nil) {
+        self.fixture = fixture
+        self.error = error
+    }
+
+    var endpoints: [Endpoint] { lock.withLock { _endpoints } }
+
+    func send<T: Decodable>(_ endpoint: Endpoint, as type: T.Type) async throws -> T {
+        lock.withLock { _endpoints.append(endpoint) }
+        if let error { throw error }
+        return try JSONDecoder.tmdb.decode(T.self, from: Fixture.data(fixture!))
+    }
+}
+
+@Suite("TMDBMovieService")
+struct MovieServiceTests {
+    @Test func popularRequestsEndpointAndDecodes() async throws {
+        let client = MockHTTPClient(fixture: "popular_page1")
+        let page = try await TMDBMovieService(client: client).popular(page: 1)
+        #expect(client.endpoints == [.popular(page: 1)])
+        #expect(page.results.count == 5)
+    }
+
+    @Test func searchRequestsEndpoint() async throws {
+        let client = MockHTTPClient(fixture: "search_inception")
+        let page = try await TMDBMovieService(client: client).search(query: "inception", page: 2)
+        #expect(client.endpoints == [.search(query: "inception", page: 2)])
+        #expect(page.results.contains { $0.title == "Inception" })
+    }
+
+    @Test func searchEmptyResults() async throws {
+        let client = MockHTTPClient(fixture: "search_empty")
+        let page = try await TMDBMovieService(client: client).search(query: "zzz", page: 1)
+        #expect(page.results.isEmpty)
+    }
+
+    @Test func detailRequestsEndpoint() async throws {
+        let client = MockHTTPClient(fixture: "movie_detail_27205")
+        let detail = try await TMDBMovieService(client: client).detail(id: 27205)
+        #expect(client.endpoints == [.movieDetail(id: 27205)])
+        #expect(detail.id == 27205)
+    }
+
+    @Test func creditsRequestsEndpoint() async throws {
+        let client = MockHTTPClient(fixture: "movie_credits_27205")
+        let credits = try await TMDBMovieService(client: client).credits(id: 27205)
+        #expect(client.endpoints == [.credits(movieID: 27205)])
+        #expect(credits.id == 27205)
+    }
+
+    @Test func propagatesClientError() async throws {
+        let client = MockHTTPClient(error: APIError.httpStatus(code: 401, message: "nope"))
+        do {
+            _ = try await TMDBMovieService(client: client).popular(page: 1)
+            Issue.record("expected error")
+        } catch APIError.httpStatus(let code, _) {
+            #expect(code == 401)
+        }
+    }
+
+    @Test func mockServiceRecordsCallsAndFailsOnDemand() async throws {
+        let mock = MockMovieService()
+        _ = try await mock.popular(page: 2)
+        _ = try await mock.detail(id: 5)
+        #expect(mock.calls == [.popular(page: 2), .detail(id: 5)])
+        mock.error = APIError.invalidResponse
+        await #expect(throws: APIError.self) { try await mock.credits(id: 1) }
+    }
+}
+
+@Suite("ImageURLBuilder")
+struct ImageURLBuilderTests {
+    let builder = ImageURLBuilder()
+
+    @Test func buildsURL() {
+        #expect(builder.url(path: "/inception.jpg", size: .w342)?.absoluteString
+                == "https://image.tmdb.org/t/p/w342/inception.jpg")
+    }
+
+    @Test(arguments: [ImageURLBuilder.Size.w185, .w342, .w780, .original])
+    func allSizes(size: ImageURLBuilder.Size) {
+        #expect(builder.url(path: "/a.jpg", size: size)?.absoluteString
+                == "https://image.tmdb.org/t/p/\(size.rawValue)/a.jpg")
+    }
+
+    @Test func nilAndEmptyPathGiveNil() {
+        #expect(builder.url(path: nil, size: .w185) == nil)
+        #expect(builder.url(path: "", size: .w185) == nil)
+        #expect(builder.url(path: "/", size: .w185) == nil)
+    }
+
+    @Test func pathWithoutLeadingSlash() {
+        #expect(builder.url(path: "a.jpg", size: .original)?.absoluteString
+                == "https://image.tmdb.org/t/p/original/a.jpg")
+    }
+
+    @Test func customBaseURL() {
+        let b = ImageURLBuilder(baseURL: URL(string: "https://example.test/img")!)
+        #expect(b.url(path: "/x.png", size: .w780)?.absoluteString == "https://example.test/img/w780/x.png")
+    }
+}
