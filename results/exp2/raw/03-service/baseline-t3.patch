+import Foundation
+
+struct ImageURLBuilder: Sendable {
+    enum Size: String, Sendable {
+        case w185, w342, w780, original
+    }
+
+    let baseURL: URL
+
+    init(baseURL: URL = TMDBApp.imageBaseURL) {
+        self.baseURL = baseURL
+    }
+
+    /// Full image URL for a TMDB path, or nil when the path is nil or empty.
+    func url(path: String?, size: Size) -> URL? {
+        guard let path, !path.isEmpty else { return nil }
+        let trimmed = path.hasPrefix("/") ? String(path.dropFirst()) : path
+        guard !trimmed.isEmpty else { return nil }
+        return baseURL.appendingPathComponent(size.rawValue).appendingPathComponent(trimmed)
+    }
+}
