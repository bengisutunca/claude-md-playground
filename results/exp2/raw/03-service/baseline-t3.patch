+import Foundation
+import Testing
+@testable import TMDBApp
+
+/// `HTTPClient` double that serves fixtures and records endpoints; never touches the network.
+private final class MockHTTPClient: HTTPClient, @unchecked Sendable {
+    private let lock = NSLock()
+    private var _endpoints: [Endpoint] = []
+    let fixture: String
+    let error: (any Error)?
+
+    init(fixture: String = "", error: (any Error)? = nil) {
+        self.fixture = fixture
+        self.error = error
+    }
+
+    var endpoints: [Endpoint] { lock.withLock { _endpoints } }
+
+    func send<T: Decodable>(_ endpoint: Endpoint, as type: T.Type) async throws -> T {
+        lock.withLock { _endpoints.append(endpoint) }
+        if let error { throw error }
+        do {
+            return try JSONDecoder.tmdb.decode(T.self, from: Fixture.data(fixture))
+        } catch let e as DecodingError {
+            throw APIError.decoding(e)
+        }
+    }
+}
+
+@Suite("TMDBMovieService")
+struct MovieServiceTests {
+    @Test func popularUsesEndpointAndDecodes() async throws {
+        let client = MockHTTPClient(fixture: "popular_page1")
+        let page = try await TMDBMovieService(client: client).popular(page: 1)
+        #expect(client.endpoints == [.popular(page: 1)])
+        #expect(page.results.count == 5)
+        #expect(page.results.first?.id == 27205)
+    }
+
+    @Test func popularForwardsPage() async throws {
+        let client = MockHTTPClient(fixture: "popular_page2")
+        let page = try await TMDBMovieService(client: client).popular(page: 2)
+        #expect(client.endpoints == [.popular(page: 2)])
+        #expect(page.page == 2)
+    }
+
+    @Test func searchUsesEndpoint() async throws {
+        let client = MockHTTPClient(fixture: "search_inception")
+        let page = try await TMDBMovieService(client: client).search(query: "inception", page: 1)
+        #expect(client.endpoints == [.search(query: "inception", page: 1)])
+        #expect(!page.results.isEmpty)
+    }
+
+    @Test func searchEmptyResults() async throws {
+        let client = MockHTTPClient(fixture: "search_empty")
+        let page = try await TMDBMovieService(client: client).search(query: "zzzz", page: 1)
+        #expect(page.results.isEmpty)
+    }
+
+    @Test func detailUsesEndpoint() async throws {
+        let client = MockHTTPClient(fixture: "movie_detail_27205")
+        let detail = try await TMDBMovieService(client: client).detail(id: 27205)
+        #expect(client.endpoints == [.movieDetail(id: 27205)])
+        #expect(detail.id == 27205)
+    }
+
+    @Test func creditsUsesEndpoint() async throws {
+        let client = MockHTTPClient(fixture: "movie_credits_27205")
+        let credits = try await TMDBMovieService(client: client).credits(id: 27205)
+        #expect(client.endpoints == [.credits(movieID: 27205)])
+        #expect(credits.cast.count == 4)
+    }
+
+    @Test func errorsPropagate() async throws {
+        let client = MockHTTPClient(error: APIError.httpStatus(code: 401, message: "nope"))
+        let service = TMDBMovieService(client: client)
+        do {
+            _ = try await service.popular(page: 1)
+            Issue.record("expected error")
+        } catch APIError.httpStatus(let code, _) {
+            #expect(code == 401)
+        }
+    }
+
+    @Test func decodingFailureSurfaces() async throws {
+        let client = MockHTTPClient(fixture: "popular_page1")
+        do {
+            _ = try await TMDBMovieService(client: client).detail(id: 1)
+            Issue.record("expected error")
+        } catch APIError.decoding {
+        }
+    }
+
+    @Test func mockMovieServiceRecordsCallsAndErrors() async throws {
+        let mock = MockMovieService()
+        _ = try await mock.popular(page: 3)
+        _ = try await mock.search(query: "x", page: 1)
+        _ = try await mock.detail(id: 5)
+        _ = try await mock.credits(id: 6)
+        #expect(mock.calls == [.popular(page: 3), .search(query: "x", page: 1), .detail(id: 5), .credits(id: 6)])
+        mock.error = APIError.invalidResponse
+        await #expect(throws: APIError.self) { try await mock.popular(page: 1) }
+        #expect(mock.calls.count == 5)
+    }
+}
