+import Foundation
+import Testing
+@testable import TMDBApp
+
+/// `HTTPClient` double: decodes a fixture (or throws) and records endpoints. No network.
+private final class MockHTTPClient: HTTPClient, @unchecked Sendable {
+    private let lock = NSLock()
+    private var _endpoints: [Endpoint] = []
+    let fixture: String?
+    let error: Error?
+
+    init(fixture: String? = nil, error: Error? = nil) {
+        self.fixture = fixture
+        self.error = error
+    }
+
+    var endpoints: [Endpoint] { lock.withLock { _endpoints } }
+
+    func send<T: Decodable>(_ endpoint: Endpoint, as type: T.Type) async throws -> T {
+        lock.withLock { _endpoints.append(endpoint) }
+        if let error { throw error }
+        return try JSONDecoder.tmdb.decode(T.self, from: Fixture.data(fixture!))
+    }
+}
+
+@Suite("TMDBMovieService")
+struct MovieServiceTests {
+    @Test func popularUsesEndpointAndDecodes() async throws {
+        let client = MockHTTPClient(fixture: "popular_page2")
+        let page = try await TMDBMovieService(client: client).popular(page: 2)
+        #expect(client.endpoints == [.popular(page: 2)])
+        #expect(page.page == 2)
+        #expect(!page.results.isEmpty)
+    }
+
+    @Test func searchUsesEndpointAndDecodes() async throws {
+        let client = MockHTTPClient(fixture: "search_inception")
+        let page = try await TMDBMovieService(client: client).search(query: "inception", page: 1)
+        #expect(client.endpoints == [.search(query: "inception", page: 1)])
+        #expect(!page.results.isEmpty)
+    }
+
+    @Test func searchEmpty() async throws {
+        let client = MockHTTPClient(fixture: "search_empty")
+        let page = try await TMDBMovieService(client: client).search(query: "zzzz", page: 1)
+        #expect(page.results.isEmpty)
+    }
+
+    @Test func detailUsesEndpointAndDecodes() async throws {
+        let client = MockHTTPClient(fixture: "movie_detail_27205")
+        let detail = try await TMDBMovieService(client: client).detail(id: 27205)
+        #expect(client.endpoints == [.movieDetail(id: 27205)])
+        #expect(detail.id == 27205)
+    }
+
+    @Test func creditsUsesEndpointAndDecodes() async throws {
+        let client = MockHTTPClient(fixture: "movie_credits_27205")
+        let credits = try await TMDBMovieService(client: client).credits(id: 27205)
+        #expect(client.endpoints == [.credits(movieID: 27205)])
+        #expect(credits.id == 27205)
+        #expect(!credits.cast.isEmpty)
+    }
+
+    @Test func propagatesClientError() async throws {
+        let client = MockHTTPClient(error: APIError.httpStatus(code: 401, message: "bad key"))
+        do {
+            _ = try await TMDBMovieService(client: client).popular(page: 1)
+            Issue.record("expected error")
+        } catch APIError.httpStatus(let code, let message) {
+            #expect(code == 401)
+            #expect(message == "bad key")
+        }
+    }
+
+    @Test func mockServiceRecordsCallsAndReturnsFixtures() async throws {
+        let mock = MockMovieService()
+        _ = try await mock.popular(page: 1)
+        _ = try await mock.search(query: "inception", page: 1)
+        _ = try await mock.detail(id: 27205)
+        _ = try await mock.credits(id: 27205)
+        #expect(mock.calls == [
+            .popular(page: 1), .search(query: "inception", page: 1),
+            .detail(id: 27205), .credits(id: 27205)
+        ])
+    }
+
+    @Test func mockServiceThrowsConfiguredError() async throws {
+        let mock = MockMovieService(error: APIError.invalidResponse)
+        await #expect(throws: APIError.self) { try await mock.popular(page: 1) }
+        #expect(mock.calls == [.popular(page: 1)])
+    }
+}
+
+@Suite("ImageURLBuilder")
+struct ImageURLBuilderTests {
+    let builder = ImageURLBuilder()
+
+    @Test func buildsURL() {
+        #expect(builder.url(path: "/inception.jpg", size: .w342)?.absoluteString
+                == "https://image.tmdb.org/t/p/w342/inception.jpg")
+    }
+
+    @Test func allSizes() {
+        #expect(builder.url(path: "/a.jpg", size: .w185)?.absoluteString == "https://image.tmdb.org/t/p/w185/a.jpg")
+        #expect(builder.url(path: "/a.jpg", size: .w780)?.absoluteString == "https://image.tmdb.org/t/p/w780/a.jpg")
+        #expect(builder.url(path: "/a.jpg", size: .original)?.absoluteString == "https://image.tmdb.org/t/p/original/a.jpg")
+    }
+
+    @Test func nilAndEmptyPath() {
+        #expect(builder.url(path: nil, size: .w185) == nil)
+        #expect(builder.url(path: "", size: .w185) == nil)
+        #expect(builder.url(path: "/", size: .w185) == nil)
+    }
+
+    @Test func pathWithoutLeadingSlash() {
+        #expect(builder.url(path: "a.jpg", size: .w185)?.absoluteString == "https://image.tmdb.org/t/p/w185/a.jpg")
+    }
+
+    @Test func customBaseURL() {
+        let b = ImageURLBuilder(baseURL: URL(string: "https://example.test/img")!)
+        #expect(b.url(path: "/a.jpg", size: .original)?.absoluteString == "https://example.test/img/original/a.jpg")
+    }
+}
