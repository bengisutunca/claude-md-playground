+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("ImageURLBuilder")
+struct ImageURLBuilderTests {
+    let builder = ImageURLBuilder()
+
+    @Test func buildsURLForEachSize() {
+        #expect(builder.url(path: "/inception.jpg", size: .w185)?.absoluteString == "https://image.tmdb.org/t/p/w185/inception.jpg")
+        #expect(builder.url(path: "/inception.jpg", size: .w342)?.absoluteString == "https://image.tmdb.org/t/p/w342/inception.jpg")
+        #expect(builder.url(path: "/inception.jpg", size: .w780)?.absoluteString == "https://image.tmdb.org/t/p/w780/inception.jpg")
+        #expect(builder.url(path: "/inception.jpg", size: .original)?.absoluteString == "https://image.tmdb.org/t/p/original/inception.jpg")
+    }
+
+    @Test func nilOrEmptyPathGivesNil() {
+        #expect(builder.url(path: nil, size: .w342) == nil)
+        #expect(builder.url(path: "", size: .w342) == nil)
+        #expect(builder.url(path: "/", size: .w342) == nil)
+    }
+
+    @Test func pathWithoutLeadingSlash() {
+        #expect(builder.url(path: "a.jpg", size: .w185)?.absoluteString == "https://image.tmdb.org/t/p/w185/a.jpg")
+    }
+
+    @Test func customBaseURL() {
+        let b = ImageURLBuilder(baseURL: URL(string: "https://example.test/img")!)
+        #expect(b.url(path: "/a.jpg", size: .original)?.absoluteString == "https://example.test/img/original/a.jpg")
+    }
+}
