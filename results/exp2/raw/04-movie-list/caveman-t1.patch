+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+struct MovieListViewModelTests {
+    private func loadedMovies(_ vm: MovieListViewModel) -> [Movie] {
+        if case .loaded(let movies) = vm.state { return movies }
+        return []
+    }
+
+    @Test func firstLoadShowsPageOne() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        #expect(vm.state == .idle)
+        await vm.load()
+        #expect(loadedMovies(vm).count == 5)
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func paginationAppendsPageTwo() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let last = try #require(loadedMovies(vm).last)
+        await vm.loadNextPageIfNeeded(currentItem: last)
+        #expect(loadedMovies(vm).count == 7)
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func nonLastItemDoesNotLoadMore() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let first = try #require(loadedMovies(vm).first)
+        await vm.loadNextPageIfNeeded(currentItem: first)
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func stopsAtTotalPages() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        await vm.loadNextPageIfNeeded(currentItem: try #require(loadedMovies(vm).last))
+        await vm.loadNextPageIfNeeded(currentItem: try #require(loadedMovies(vm).last))
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+        #expect(loadedMovies(vm).count == 7)
+    }
+
+    @Test func duplicateCallsWhileLoadingAreIgnored() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        async let a: Void = vm.load()
+        async let b: Void = vm.load()
+        _ = await (a, b)
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func errorOnFirstLoadSetsFailedState() async throws {
+        let service = MockMovieService(error: APIError.httpStatus(code: 401, message: nil))
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        #expect(vm.state == .failed("The TMDB API key was rejected."))
+    }
+
+    @Test func errorOnNextPageKeepsMoviesAndSetsMessage() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        await service.setError(APIError.invalidResponse)
+        await vm.loadNextPageIfNeeded(currentItem: try #require(loadedMovies(vm).last))
+        #expect(loadedMovies(vm).count == 5)
+        #expect(vm.errorMessage != nil)
+    }
+
+    @Test func refreshResetsToPageOne() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        await vm.loadNextPageIfNeeded(currentItem: try #require(loadedMovies(vm).last))
+        #expect(loadedMovies(vm).count == 7)
+        await vm.refresh()
+        #expect(loadedMovies(vm).count == 5)
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2), .popular(page: 1)])
+        await vm.loadNextPageIfNeeded(currentItem: try #require(loadedMovies(vm).last))
+        #expect(loadedMovies(vm).count == 7)
+    }
+}
