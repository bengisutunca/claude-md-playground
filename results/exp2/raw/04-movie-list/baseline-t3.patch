+import Foundation
+import Observation
+
+@MainActor
+@Observable
+final class MovieListViewModel {
+    private(set) var state: ViewState<[Movie]> = .idle
+    /// Set when loading a later page fails; the already loaded movies stay visible.
+    private(set) var paginationErrorMessage: String?
+    private(set) var isLoadingNextPage = false
+
+    private let service: any MovieService
+    private var movies: [Movie] = []
+    private var currentPage = 0
+    private var totalPages = 1
+    private var isFetching = false
+    /// Incremented on refresh so results of superseded requests are dropped.
+    private var generation = 0
+
+    init(service: any MovieService) {
+        self.service = service
+    }
+
+    var hasMorePages: Bool { currentPage < totalPages }
+
+    /// Loads the first page. No-op once content has been loaded or while a request is running.
+    func load() async {
+        switch state {
+        case .idle, .failed: await fetchNextPage()
+        case .loading, .loaded, .empty: break
+        }
+    }
+
+    /// Discards loaded pages and reloads from page 1.
+    func refresh() async {
+        generation += 1
+        isFetching = false
+        isLoadingNextPage = false
+        paginationErrorMessage = nil
+        movies = []
+        currentPage = 0
+        totalPages = 1
+        await fetchNextPage()
+    }
+
+    func loadNextPageIfNeeded(currentItem: Movie) async {
+        guard case .loaded = state, currentItem.id == movies.last?.id, hasMorePages else { return }
+        await fetchNextPage()
+    }
+
+    private func fetchNextPage() async {
+        guard !isFetching, currentPage < totalPages else { return }
+        isFetching = true
+        let token = generation
+        let page = currentPage + 1
+        if page == 1 {
+            // Keep current content visible during pull-to-refresh.
+            if case .loaded = state { } else { state = .loading }
+        } else {
+            isLoadingNextPage = true
+            paginationErrorMessage = nil
+        }
+        defer {
+            if token == generation {
+                isFetching = false
+                isLoadingNextPage = false
+            }
+        }
+        do {
+            let response = try await service.popular(page: page)
+            guard token == generation else { return }
+            currentPage = response.page
+            totalPages = response.totalPages
+            movies.append(contentsOf: response.results)
+            state = movies.isEmpty ? .empty : .loaded(movies)
+        } catch {
+            guard token == generation else { return }
+            if movies.isEmpty {
+                state = .failed(Self.message(for: error))
+            } else {
+                paginationErrorMessage = Self.message(for: error)
+            }
+        }
+    }
+
+    static func message(for error: Error) -> String {
+        let offline = "Couldn't connect. Check your internet connection and try again."
+        if let apiError = error as? APIError {
+            switch apiError {
+            case .missingAPIKey:
+                return "The TMDB API key is missing. Please configure it and try again."
+            case .httpStatus(let code, let message):
+                if code == 401 { return "Authentication failed. Please check your TMDB API key." }
+                return message ?? "The server returned an error (\(code))."
+            case .decoding:
+                return "We couldn't read the server's response."
+            case .transport:
+                return offline
+            case .invalidResponse:
+                return "The server sent an invalid response."
+            }
+        }
+        if error is URLError { return offline }
+        return error.localizedDescription
+    }
+}
