+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+struct MovieListViewModelTests {
+    private func movies(_ vm: MovieListViewModel) -> [Movie] {
+        if case .loaded(let m) = vm.state { return m }
+        return []
+    }
+
+    @Test func firstLoad() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        #expect(vm.state == .idle)
+        await vm.load()
+        #expect(!movies(vm).isEmpty)
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func paginationAcrossPagesAndEnd() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let firstCount = movies(vm).count
+        await vm.loadNextPageIfNeeded(currentItem: movies(vm)[0]) // not last: no-op
+        #expect(movies(vm).count == firstCount)
+
+        await vm.loadNextPageIfNeeded(currentItem: movies(vm).last!)
+        let total = movies(vm).count
+        #expect(total > firstCount)
+        #expect(Set(movies(vm).map(\.id)).count == total)
+
+        // totalPages reached: no further request.
+        await vm.loadNextPageIfNeeded(currentItem: movies(vm).last!)
+        #expect(movies(vm).count == total)
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func duplicateCallsWhileLoadingAreIgnored() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        async let a: Void = vm.load()
+        async let b: Void = vm.load()
+        _ = await (a, b)
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func errorState() async throws {
+        let service = MockMovieService(error: APIError.transport(URLError(.notConnectedToInternet)))
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        guard case .failed(let message) = vm.state else {
+            Issue.record("expected failed, got \(vm.state)")
+            return
+        }
+        #expect(!message.isEmpty)
+
+        // Recovers once the service works again.
+        await service.setError(nil)
+        await vm.load()
+        #expect(!movies(vm).isEmpty)
+    }
+
+    @Test func refreshResetsPages() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let firstPage = movies(vm)
+        await vm.loadNextPageIfNeeded(currentItem: firstPage.last!)
+        #expect(movies(vm).count > firstPage.count)
+
+        await vm.refresh()
+        #expect(movies(vm) == firstPage)
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2), .popular(page: 1)])
+
+        // Pagination works again after a refresh.
+        await vm.loadNextPageIfNeeded(currentItem: movies(vm).last!)
+        #expect(movies(vm).count > firstPage.count)
+    }
+}
