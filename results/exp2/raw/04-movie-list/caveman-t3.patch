+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+struct MovieListViewModelTests {
+    private func movies(_ vm: MovieListViewModel) -> [Movie] {
+        if case .loaded(let m) = vm.state { return m }
+        return []
+    }
+
+    @Test func firstLoadShowsPageOne() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        #expect(vm.state == .idle)
+        await vm.load()
+        #expect(movies(vm).count == 5)
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func paginatesAcrossPages() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let page1 = movies(vm)
+        await vm.loadNextPageIfNeeded(currentItem: page1.last!)
+        let all = movies(vm)
+        #expect(all.count == 7)
+        #expect(Array(all.prefix(5)) == page1)
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func nonLastItemDoesNotLoadMore() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        await vm.loadNextPageIfNeeded(currentItem: movies(vm)[0])
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func stopsAtTotalPages() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        await vm.loadNextPageIfNeeded(currentItem: movies(vm).last!)
+        await vm.loadNextPageIfNeeded(currentItem: movies(vm).last!)
+        #expect(movies(vm).count == 7)
+        #expect(await service.calls.count == 2)
+    }
+
+    @Test func duplicateCallsWhileLoadingAreIgnored() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        async let a: Void = vm.load()
+        async let b: Void = vm.load()
+        _ = await (a, b)
+        #expect(await service.calls == [.popular(page: 1)])
+        #expect(movies(vm).count == 5)
+    }
+
+    @Test func errorShowsUserFacingMessage() async throws {
+        let service = MockMovieService(error: APIError.transport(URLError(.notConnectedToInternet)))
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        #expect(vm.state == .failed("Can't reach the server. Check your connection and try again."))
+    }
+
+    @Test func httpErrorUsesServerMessage() async throws {
+        let service = MockMovieService(error: APIError.httpStatus(code: 401, message: "Invalid API key"))
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        #expect(vm.state == .failed("Invalid API key"))
+    }
+
+    @Test func failedLoadCanRecover() async throws {
+        let service = MockMovieService(error: APIError.invalidResponse)
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        await service.setError(nil)
+        await vm.load()
+        #expect(movies(vm).count == 5)
+    }
+
+    @Test func pageTwoErrorKeepsLoadedMovies() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        await service.setError(APIError.invalidResponse)
+        await vm.loadNextPageIfNeeded(currentItem: movies(vm).last!)
+        #expect(movies(vm).count == 5)
+        #expect(vm.errorMessage != nil)
+    }
+
+    @Test func refreshResetsPages() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        await vm.loadNextPageIfNeeded(currentItem: movies(vm).last!)
+        #expect(movies(vm).count == 7)
+        await vm.refresh()
+        #expect(movies(vm).count == 5)
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2), .popular(page: 1)])
+        // Pagination works again after reset.
+        await vm.loadNextPageIfNeeded(currentItem: movies(vm).last!)
+        #expect(movies(vm).count == 7)
+    }
+}
