+import Foundation
+import Observation
+
+@MainActor
+@Observable
+final class MovieListViewModel {
+    private(set) var state: ViewState<[Movie]> = .idle
+    /// Message for a failed refresh or next-page load while movies are still shown.
+    private(set) var errorMessage: String?
+
+    private let service: any MovieService
+    private var movies: [Movie] = []
+    private var currentPage = 0
+    private var totalPages = 1
+    private var isLoadingPage = false
+
+    init(service: any MovieService) {
+        self.service = service
+    }
+
+    var canLoadMore: Bool { currentPage < totalPages }
+
+    /// First load. Does nothing once movies are loaded or while a page is loading.
+    func load() async {
+        guard !isLoadingPage else { return }
+        if case .loaded = state { return }
+        await fetch(page: 1, reset: true)
+    }
+
+    /// Reloads page 1 and drops all later pages.
+    func refresh() async {
+        guard !isLoadingPage else { return }
+        await fetch(page: 1, reset: true)
+    }
+
+    /// Loads the next page when `currentItem` is the last loaded movie.
+    func loadNextPageIfNeeded(currentItem: Movie) async {
+        guard !isLoadingPage, canLoadMore, currentItem.id == movies.last?.id else { return }
+        await fetch(page: currentPage + 1, reset: false)
+    }
+
+    private func fetch(page: Int, reset: Bool) async {
+        isLoadingPage = true
+        defer { isLoadingPage = false }
+        errorMessage = nil
+        // Keep the current list visible during refresh and pagination.
+        if movies.isEmpty { state = .loading }
+        do {
+            let response = try await service.popular(page: page)
+            if reset { movies = response.results } else { movies.append(contentsOf: response.results) }
+            currentPage = response.page
+            totalPages = response.totalPages
+            state = movies.isEmpty ? .empty : .loaded(movies)
+        } catch {
+            let message = Self.message(for: error)
+            if movies.isEmpty {
+                state = .failed(message)
+            } else {
+                errorMessage = message
+            }
+        }
+    }
+
+    static func message(for error: Error) -> String {
+        guard let apiError = error as? APIError else {
+            return "Something went wrong. Please try again."
+        }
+        switch apiError {
+        case .transport:
+            return "Can't reach the server. Check your connection and try again."
+        case .httpStatus(let code, let message):
+            if let message, !message.isEmpty { return message }
+            return "The server returned an error (\(code)). Please try again."
+        case .missingAPIKey:
+            return "The API key is missing."
+        case .invalidResponse, .decoding:
+            return "Received an unexpected response from the server."
+        }
+    }
+}
