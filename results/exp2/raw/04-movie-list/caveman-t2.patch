@@ -0,0 +1,101 @@
+import Testing
+@testable import TMDBApp
+
+@MainActor
+struct MovieListViewModelTests {
+    private func movies(_ vm: MovieListViewModel) -> [Movie] {
+        if case .loaded(let m) = vm.state { return m }
+        return []
+    }
+
+    @Test func firstLoadShowsPageOne() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        #expect(vm.state == .idle)
+        await vm.load()
+        #expect(!movies(vm).isEmpty)
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func paginationAppendsPageTwoAndStops() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let page1 = movies(vm)
+        await vm.loadNextPageIfNeeded(currentItem: try #require(page1.last))
+        let all = movies(vm)
+        #expect(all.count > page1.count)
+        #expect(Array(all.prefix(page1.count)) == page1)
+        #expect(Set(all.map(\.id)).count == all.count)
+
+        // totalPages (2) reached: no further fetch.
+        await vm.loadNextPageIfNeeded(currentItem: try #require(all.last))
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+        #expect(movies(vm) == all)
+    }
+
+    @Test func nonLastItemDoesNotLoadNextPage() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        await vm.loadNextPageIfNeeded(currentItem: try #require(movies(vm).first))
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func duplicateCallsWhileLoadingAreIgnored() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        async let a: Void = vm.load()
+        async let b: Void = vm.load()
+        _ = await (a, b)
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func errorOnFirstLoadSetsFailedState() async {
+        let service = MockMovieService(error: APIError.invalidResponse)
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        guard case .failed(let message) = vm.state else {
+            Issue.record("expected failed, got \(vm.state)")
+            return
+        }
+        #expect(!message.isEmpty)
+    }
+
+    @Test func refreshAfterErrorRecovers() async {
+        let service = MockMovieService(error: APIError.invalidResponse)
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        await service.setError(nil)
+        await vm.refresh()
+        #expect(!movies(vm).isEmpty)
+    }
+
+    @Test func pageTwoErrorKeepsMoviesAndSetsMessage() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let page1 = movies(vm)
+        await service.setError(APIError.invalidResponse)
+        await vm.loadNextPageIfNeeded(currentItem: try #require(page1.last))
+        #expect(movies(vm) == page1)
+        #expect(vm.paginationErrorMessage != nil)
+    }
+
+    @Test func refreshResetsPagination() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let page1 = movies(vm)
+        await vm.loadNextPageIfNeeded(currentItem: try #require(page1.last))
+        #expect(movies(vm).count > page1.count)
+
+        await vm.refresh()
+        #expect(movies(vm) == page1)
+        #expect(await service.calls.suffix(1) == [.popular(page: 1)])
+
+        // Paging works again after the reset.
+        await vm.loadNextPageIfNeeded(currentItem: try #require(page1.last))
+        #expect(movies(vm).count > page1.count)
+    }
+}
