+import Foundation
+import Observation
+
+@MainActor
+@Observable
+final class MovieListViewModel {
+    private(set) var state: ViewState<[Movie]> = .idle
+    /// Set when loading a later page or a refresh fails while movies are already shown.
+    private(set) var paginationErrorMessage: String?
+
+    private let service: any MovieService
+    private var movies: [Movie] = []
+    private var currentPage = 0
+    private var totalPages = 1
+    private var isFetching = false
+    /// Bumped by `refresh()` so results of an older, superseded fetch are dropped.
+    private var generation = 0
+
+    init(service: any MovieService) {
+        self.service = service
+    }
+
+    /// First load. No-op while a fetch runs or after content was loaded.
+    func load() async {
+        guard !isFetching, movies.isEmpty else { return }
+        state = .loading
+        await fetch(page: 1)
+    }
+
+    /// Resets paging and reloads page 1. Keeps current movies visible while loading.
+    func refresh() async {
+        generation += 1
+        isFetching = false
+        await fetch(page: 1)
+    }
+
+    func loadNextPageIfNeeded(currentItem: Movie) async {
+        guard !isFetching,
+              currentPage < totalPages,
+              currentItem.id == movies.last?.id else { return }
+        await fetch(page: currentPage + 1)
+    }
+
+    private func fetch(page: Int) async {
+        guard !isFetching else { return }
+        isFetching = true
+        let token = generation
+        paginationErrorMessage = nil
+        defer { if token == generation { isFetching = false } }
+
+        do {
+            let response = try await service.popular(page: page)
+            guard token == generation else { return }
+            if page == 1 {
+                movies = response.results
+            } else {
+                let known = Set(movies.map(\.id))
+                movies += response.results.filter { !known.contains($0.id) }
+            }
+            currentPage = response.page
+            totalPages = response.totalPages
+            state = movies.isEmpty ? .empty : .loaded(movies)
+        } catch {
+            guard token == generation else { return }
+            let message = Self.message(for: error)
+            if movies.isEmpty {
+                state = .failed(message)
+            } else {
+                paginationErrorMessage = message
+            }
+        }
+    }
+
+    static func message(for error: Error) -> String {
+        guard let apiError = error as? APIError else {
+            return "Something went wrong. Please try again."
+        }
+        switch apiError {
+        case .missingAPIKey:
+            return "Missing TMDB API key."
+        case .httpStatus(let code, let message):
+            return message ?? "Server error (\(code)). Please try again."
+        case .decoding:
+            return "Could not read the server response."
+        case .invalidResponse, .transport:
+            return "Could not reach the server. Check your connection and try again."
+        }
+    }
+}
