+import Foundation
+import Observation
+
+@MainActor
+@Observable
+final class MovieListViewModel {
+    private(set) var state: ViewState<[Movie]> = .idle
+    /// Set when loading a subsequent page fails; already loaded movies stay visible.
+    private(set) var paginationErrorMessage: String?
+
+    @ObservationIgnored private let service: any MovieService
+    @ObservationIgnored private var movies: [Movie] = []
+    @ObservationIgnored private var currentPage = 0
+    @ObservationIgnored private var totalPages = 1
+    @ObservationIgnored private var isLoadingPage = false
+    /// Incremented on refresh so results of superseded requests are dropped.
+    @ObservationIgnored private var generation = 0
+
+    init(service: any MovieService) {
+        self.service = service
+    }
+
+    var hasMorePages: Bool { currentPage < totalPages }
+
+    func load() async {
+        guard !isLoadingPage, currentPage == 0 else { return }
+        state = .loading
+        await fetchNextPage()
+    }
+
+    func refresh() async {
+        generation += 1
+        isLoadingPage = false
+        movies = []
+        currentPage = 0
+        totalPages = 1
+        paginationErrorMessage = nil
+        await fetchNextPage()
+    }
+
+    func loadNextPageIfNeeded(currentItem: Movie) async {
+        guard currentPage > 0, !isLoadingPage, hasMorePages,
+              currentItem.id == movies.last?.id else { return }
+        await fetchNextPage()
+    }
+
+    private func fetchNextPage() async {
+        guard !isLoadingPage, currentPage < totalPages else { return }
+        isLoadingPage = true
+        paginationErrorMessage = nil
+        let token = generation
+        let page = currentPage + 1
+        do {
+            let response = try await service.popular(page: page)
+            guard token == generation else { return }
+            currentPage = response.page
+            totalPages = response.totalPages
+            movies.append(contentsOf: response.results)
+            state = movies.isEmpty ? .empty : .loaded(movies)
+        } catch {
+            guard token == generation else { return }
+            let message = Self.message(for: error)
+            if movies.isEmpty {
+                state = .failed(message)
+            } else {
+                paginationErrorMessage = message
+            }
+        }
+        isLoadingPage = false
+    }
+
+    static func message(for error: Error) -> String {
+        guard let apiError = error as? APIError else {
+            return "Something went wrong. Please try again."
+        }
+        switch apiError {
+        case .missingAPIKey:
+            return "The TMDB API key is missing."
+        case .httpStatus(let code, let message):
+            if code == 401 { return "Authentication failed. Check your TMDB API key." }
+            return message ?? "The server returned an error (\(code))."
+        case .transport:
+            return "Couldn't reach the server. Check your connection and try again."
+        case .decoding, .invalidResponse:
+            return "Received an unexpected response from the server."
+        }
+    }
+}
