@@ -0,0 +1,61 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+struct MovieListViewModelTests {
+    private func movies(_ vm: MovieListViewModel) -> [Movie] {
+        if case .loaded(let m) = vm.state { return m }
+        return []
+    }
+
+    @Test func firstLoad() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        #expect(vm.state == .idle)
+        await vm.load()
+        #expect(!movies(vm).isEmpty)
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func paginationAndEndOfPages() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let page1 = movies(vm)
+        await vm.loadNextPageIfNeeded(currentItem: page1[0]) // not last: no-op
+        #expect(await service.calls.count == 1)
+
+        await vm.loadNextPageIfNeeded(currentItem: page1.last!)
+        let both = movies(vm)
+        #expect(both.count > page1.count)
+        #expect(Array(both.prefix(page1.count)) == page1)
+
+        await vm.loadNextPageIfNeeded(currentItem: both.last!) // totalPages reached
+        #expect(movies(vm) == both)
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func errorState() async throws {
+        let service = MockMovieService(error: APIError.httpStatus(code: 401, message: nil))
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        guard case .failed(let message) = vm.state else {
+            Issue.record("expected failed, got \(vm.state)"); return
+        }
+        #expect(!message.isEmpty)
+    }
+
+    @Test func refreshResetsPages() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let page1 = movies(vm)
+        await vm.loadNextPageIfNeeded(currentItem: page1.last!)
+        await vm.refresh()
+        #expect(movies(vm) == page1)
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2), .popular(page: 1)])
+        await vm.loadNextPageIfNeeded(currentItem: page1.last!)
+        #expect(movies(vm).count > page1.count)
+    }
+}
