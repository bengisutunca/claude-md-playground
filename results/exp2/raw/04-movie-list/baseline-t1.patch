@@ -0,0 +1,97 @@
+import Foundation
+import Observation
+
+@MainActor
+@Observable
+final class MovieListViewModel {
+    private(set) var state: ViewState<[Movie]> = .idle
+    /// Set when loading a later page fails; the already loaded movies stay visible.
+    private(set) var paginationError: String?
+    private(set) var isLoadingNextPage = false
+
+    @ObservationIgnored private let service: any MovieService
+    @ObservationIgnored private var currentPage = 0
+    @ObservationIgnored private var totalPages = 1
+    @ObservationIgnored private var isFetching = false
+
+    init(service: any MovieService) {
+        self.service = service
+    }
+
+    var hasMorePages: Bool { currentPage < totalPages }
+
+    /// Loads the first page. Ignored if a request is already in flight.
+    func load() async {
+        guard !isFetching else { return }
+        isFetching = true
+        defer { isFetching = false }
+        state = .loading
+        await fetchFirstPage()
+    }
+
+    /// Reloads from page 1, keeping the current list visible until the new data arrives.
+    func refresh() async {
+        guard !isFetching else { return }
+        isFetching = true
+        defer { isFetching = false }
+        if case .loaded = state {} else { state = .loading }
+        await fetchFirstPage()
+    }
+
+    func loadNextPageIfNeeded(currentItem: Movie) async {
+        guard !isFetching, hasMorePages,
+              case .loaded(let movies) = state,
+              movies.last?.id == currentItem.id else { return }
+        isFetching = true
+        isLoadingNextPage = true
+        paginationError = nil
+        defer {
+            isFetching = false
+            isLoadingNextPage = false
+        }
+        do {
+            let response = try await service.popular(page: currentPage + 1)
+            let known = Set(movies.map(\.id))
+            let fresh = response.results.filter { !known.contains($0.id) }
+            currentPage = response.page
+            totalPages = response.totalPages
+            state = .loaded(movies + fresh)
+        } catch {
+            paginationError = Self.message(for: error)
+        }
+    }
+
+    private func fetchFirstPage() async {
+        do {
+            let response = try await service.popular(page: 1)
+            currentPage = response.page
+            totalPages = response.totalPages
+            paginationError = nil
+            state = response.results.isEmpty ? .empty : .loaded(response.results)
+        } catch {
+            currentPage = 0
+            totalPages = 1
+            state = .failed(Self.message(for: error))
+        }
+    }
+
+    static func message(for error: Error) -> String {
+        if error is CancellationError { return "The request was cancelled." }
+        if let apiError = error as? APIError {
+            switch apiError {
+            case .missingAPIKey:
+                return "The TMDB API key is missing. Add it to the app configuration."
+            case .httpStatus(let code, let message):
+                if code == 401 { return "The TMDB API key was rejected." }
+                return message ?? "The server returned an error (\(code))."
+            case .decoding:
+                return "The server response could not be read."
+            case .transport:
+                return "Could not reach the server. Check your connection and try again."
+            case .invalidResponse:
+                return "The server sent an invalid response."
+            }
+        }
+        return "Something went wrong. Please try again."
+    }
+}
diff --git a/Sources/TMDBApp/ViewModels/ViewState.swift b/Sources/TMDBApp/ViewModels/ViewState.swift
new file mode 100644
index 0000000..c62f003
--- /dev/null
+++ b/Sources/TMDBApp/ViewModels/ViewState.swift
@@ -0,0 +1,10 @@
+enum ViewState<Value> {
+    case idle
+    case loading
+    case loaded(Value)
+    case empty
+    case failed(String)
+}
+
+extension ViewState: Equatable where Value: Equatable {}
+extension ViewState: Sendable where Value: Sendable {}
