+++ b/Tests/TMDBAppTests/MovieListViewModelTests.swift
@@ -0,0 +1,87 @@
+import Testing
+import Foundation
+@testable import TMDBApp
+
+@MainActor
+struct MovieListViewModelTests {
+    private func movies(_ vm: MovieListViewModel) -> [Movie] {
+        if case .loaded(let m) = vm.state { return m }
+        return []
+    }
+
+    @Test func firstLoad() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        #expect(vm.state == .idle)
+        await vm.load()
+        let list = movies(vm)
+        #expect(!list.isEmpty)
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func paginationAppendsPageTwoAndStops() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let firstCount = movies(vm).count
+
+        await vm.loadNextPageIfNeeded(currentItem: try #require(movies(vm).last))
+        let afterTwo = movies(vm)
+        #expect(afterTwo.count > firstCount)
+        #expect(Set(afterTwo.map(\.id)).count == afterTwo.count)
+
+        // End of pages: no further request.
+        await vm.loadNextPageIfNeeded(currentItem: try #require(afterTwo.last))
+        #expect(movies(vm).count == afterTwo.count)
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func nonLastItemDoesNotLoadMore() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        await vm.loadNextPageIfNeeded(currentItem: try #require(movies(vm).first))
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func duplicateCallsWhileLoadingAreIgnored() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        async let a: Void = vm.load()
+        async let b: Void = vm.load()
+        _ = await (a, b)
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func errorState() async throws {
+        let service = MockMovieService(error: APIError.transport(URLError(.notConnectedToInternet)))
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        guard case .failed(let message) = vm.state else {
+            Issue.record("expected failed, got \(vm.state)")
+            return
+        }
+        #expect(!message.isEmpty)
+
+        // Recovers on retry.
+        await service.setError(nil)
+        await vm.load()
+        #expect(!movies(vm).isEmpty)
+    }
+
+    @Test func refreshResetsPages() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let firstCount = movies(vm).count
+        await vm.loadNextPageIfNeeded(currentItem: try #require(movies(vm).last))
+        #expect(movies(vm).count > firstCount)
+
+        await vm.refresh()
+        #expect(movies(vm).count == firstCount)
+        // Pagination works again after refresh.
+        await vm.loadNextPageIfNeeded(currentItem: try #require(movies(vm).last))
+        #expect(movies(vm).count > firstCount)
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2), .popular(page: 1), .popular(page: 2)])
+    }
+}
