+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("SearchViewModel")
+struct SearchViewModelTests {
+    /// Sleep double: records requested durations, never waits.
+    final class SleepRecorder: @unchecked Sendable {
+        private let lock = NSLock()
+        private var _durations: [Duration] = []
+        var durations: [Duration] { lock.withLock { _durations } }
+        func sleep(_ d: Duration) async throws {
+            lock.withLock { _durations.append(d) }
+            await Task.yield()
+        }
+    }
+
+    private func makeVM(_ service: MockMovieService, recorder: SleepRecorder = SleepRecorder()) -> SearchViewModel {
+        SearchViewModel(service: service, debounce: .milliseconds(300), sleep: { try await recorder.sleep($0) })
+    }
+
+    @Test func shortQueryDoesNotCallService() async {
+        let service = MockMovieService()
+        let vm = makeVM(service)
+        vm.query = "a"
+        await vm.waitForSearch()
+        vm.query = "  b "
+        await vm.waitForSearch()
+        #expect(vm.state == .idle)
+        #expect(await service.calls.isEmpty)
+    }
+
+    @Test func shortQueryClearsPreviousResults() async {
+        let service = MockMovieService()
+        let vm = makeVM(service)
+        vm.query = "inception"
+        await vm.waitForSearch()
+        #expect(vm.state != .idle)
+        vm.query = "i"
+        #expect(vm.state == .idle)
+    }
+
+    @Test func rapidTypingTriggersOneSearch() async {
+        let service = MockMovieService()
+        let vm = makeVM(service)
+        for text in ["in", "inc", "ince", "incep", "inception"] { vm.query = text }
+        await vm.waitForSearch()
+        #expect(await service.calls == [.search(query: "inception", page: 1)])
+    }
+
+    @Test func supersededSearchDoesNotCallService() async {
+        let service = MockMovieService()
+        let recorder = SleepRecorder()
+        let vm = makeVM(service, recorder: recorder)
+        vm.query = "inc"
+        await Task.yield()
+        vm.query = "inception"
+        await vm.waitForSearch()
+        #expect(await service.calls == [.search(query: "inception", page: 1)])
+        #expect(recorder.durations.first == .milliseconds(300))
+    }
+
+    @Test func searchInceptionLoads() async {
+        let service = MockMovieService()
+        let vm = makeVM(service)
+        vm.query = "inception"
+        await vm.waitForSearch()
+        guard case .loaded(let movies) = vm.state else { Issue.record("expected loaded"); return }
+        #expect(movies.first?.id == 27205)
+        #expect(movies.first?.title == "Inception")
+    }
+
+    @Test func searchEmptyGivesEmptyState() async {
+        let service = MockMovieService()
+        let vm = makeVM(service)
+        vm.query = "empty"
+        await vm.waitForSearch()
+        #expect(vm.state == .empty)
+    }
+
+    @Test func errorState() async {
+        let service = MockMovieService(error: APIError.httpStatus(code: 401, message: "bad key"))
+        let vm = makeVM(service)
+        vm.query = "inception"
+        await vm.waitForSearch()
+        #expect(vm.state == .failed("Invalid API key."))
+    }
+}
