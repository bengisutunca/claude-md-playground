+import Foundation
+import Testing
+@testable import TMDBApp
+
+private actor DelayRecorder {
+    var values: [Duration] = []
+    func add(_ d: Duration) { values.append(d) }
+}
+
+@MainActor
+@Suite("SearchViewModel")
+struct SearchViewModelTests {
+    private func makeVM(_ service: MockMovieService) -> SearchViewModel {
+        SearchViewModel(service: service, debounce: .milliseconds(300), sleep: { _ in await Task.yield() })
+    }
+
+    @Test func shortQueryDoesNotCallService() async {
+        let service = MockMovieService()
+        let vm = makeVM(service)
+        vm.query = "a"
+        await vm.waitForSearch()
+        vm.query = "  b "
+        await vm.waitForSearch()
+        #expect(vm.state == .idle)
+        #expect(await service.calls.isEmpty)
+    }
+
+    @Test func rapidTypingTriggersOneSearch() async {
+        let service = MockMovieService()
+        let vm = makeVM(service)
+        for q in ["in", "inc", "ince", "inception"] { vm.query = q }
+        await vm.waitForSearch()
+        #expect(await service.calls == [.search(query: "inception", page: 1)])
+    }
+
+    @Test func debounceDelayIsPassedToSleep() async {
+        let service = MockMovieService()
+        let recorder = DelayRecorder()
+        let vm = SearchViewModel(service: service, debounce: .milliseconds(300), sleep: { await recorder.add($0) })
+        vm.query = "inception"
+        await vm.waitForSearch()
+        #expect(await recorder.values == [.milliseconds(300)])
+    }
+
+    @Test func searchInceptionLoads() async {
+        let service = MockMovieService()
+        let vm = makeVM(service)
+        vm.query = "inception"
+        await vm.waitForSearch()
+        guard case .loaded(let movies) = vm.state else {
+            Issue.record("expected loaded, got \(vm.state)")
+            return
+        }
+        #expect(movies.contains { $0.id == 27205 })
+    }
+
+    @Test func emptyResultIsEmptyState() async {
+        let service = MockMovieService()
+        let vm = makeVM(service)
+        vm.query = "empty"
+        await vm.waitForSearch()
+        #expect(vm.state == .empty)
+    }
+
+    @Test func errorGivesFailedState() async {
+        let service = MockMovieService(error: APIError.httpStatus(code: 401, message: nil))
+        let vm = makeVM(service)
+        vm.query = "inception"
+        await vm.waitForSearch()
+        #expect(vm.state == .failed("Invalid API key."))
+    }
+
+    @Test func clearingQueryResetsToIdle() async {
+        let service = MockMovieService()
+        let vm = makeVM(service)
+        vm.query = "inception"
+        await vm.waitForSearch()
+        vm.query = ""
+        #expect(vm.state == .idle)
+    }
+}
