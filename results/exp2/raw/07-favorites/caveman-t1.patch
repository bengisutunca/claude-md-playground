index 0000000..49a6f15
--- /dev/null
+++ b/Tests/TMDBAppTests/FavoritesTests.swift
@@ -0,0 +1,96 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("Favorites")
+@MainActor
+struct FavoritesTests {
+    /// Fresh suite per test; removed by `cleanUp`.
+    private let suiteName = "FavoritesTests.\(UUID().uuidString)"
+    private let defaults: UserDefaults
+
+    init() throws {
+        defaults = try #require(UserDefaults(suiteName: suiteName))
+    }
+
+    private func cleanUp() {
+        defaults.removePersistentDomain(forName: suiteName)
+    }
+
+    private func store() -> UserDefaultsFavoritesStore {
+        UserDefaultsFavoritesStore(defaults: defaults)
+    }
+
+    private func movies() throws -> [Movie] {
+        try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page1")).results
+    }
+
+    @Test func toggleOnAndOff() throws {
+        defer { cleanUp() }
+        let movie = try #require(movies().first)
+        let vm = FavoritesViewModel(store: store())
+        #expect(!vm.isFavorite(movie))
+        vm.toggle(movie)
+        #expect(vm.isFavorite(movie))
+        #expect(vm.favorites == [movie])
+        vm.toggle(movie)
+        #expect(!vm.isFavorite(movie))
+        #expect(vm.favorites.isEmpty)
+    }
+
+    @Test func persistsAcrossStoreInstances() throws {
+        defer { cleanUp() }
+        let all = try movies()
+        let first = FavoritesViewModel(store: store())
+        first.toggle(all[0])
+        first.toggle(all[1])
+        let second = FavoritesViewModel(store: store())
+        #expect(second.favorites == [all[0], all[1]])
+        #expect(UserDefaultsFavoritesStore(defaults: defaults).load() == [all[0], all[1]])
+    }
+
+    @Test func fullMovieValuesRoundTrip() throws {
+        defer { cleanUp() }
+        let all = try movies()
+        store().save(all)
+        #expect(store().load() == all)
+    }
+
+    @Test func insertionOrderKept() throws {
+        defer { cleanUp() }
+        let all = try movies()
+        let vm = FavoritesViewModel(store: store())
+        let order = [all[2], all[0], all[3]]
+        order.forEach(vm.toggle)
+        #expect(vm.favorites == order)
+        #expect(FavoritesViewModel(store: store()).favorites == order)
+    }
+
+    @Test func removeAtOffsets() throws {
+        defer { cleanUp() }
+        let all = try movies()
+        let vm = FavoritesViewModel(store: store())
+        all.prefix(3).forEach(vm.toggle)
+        vm.remove(at: IndexSet(integer: 1))
+        #expect(vm.favorites == [all[0], all[2]])
+        #expect(!vm.isFavorite(all[1]))
+        #expect(FavoritesViewModel(store: store()).favorites == [all[0], all[2]])
+    }
+
+    @Test func noDuplicates() throws {
+        defer { cleanUp() }
+        let movie = try #require(movies().first)
+        let vm = FavoritesViewModel(store: store())
+        vm.toggle(movie)
+        vm.toggle(movie)
+        vm.toggle(movie)
+        #expect(vm.favorites.count == 1)
+        // Store holding a duplicate-free list stays that way after reload.
+        #expect(FavoritesViewModel(store: store()).favorites.count == 1)
+    }
+
+    @Test func emptyStoreLoadsEmpty() {
+        defer { cleanUp() }
+        #expect(store().load().isEmpty)
+    }
+}
