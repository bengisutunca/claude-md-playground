@@ -0,0 +1,101 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("Favorites")
+struct FavoritesTests {
+    /// Runs `body` with a unique `UserDefaults` suite that is removed afterwards.
+    private func withSuite(_ body: (UserDefaults, String) throws -> Void) throws {
+        let name = "FavoritesTests.\(UUID().uuidString)"
+        let defaults = try #require(UserDefaults(suiteName: name))
+        defer { defaults.removePersistentDomain(forName: name) }
+        try body(defaults, name)
+    }
+
+    private func movies() throws -> [Movie] {
+        let page = try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page1"))
+        return page.results
+    }
+
+    @Test func toggleOnAndOff() throws {
+        try withSuite { defaults, _ in
+            let movie = try #require(try movies().first)
+            let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            #expect(!vm.isFavorite(movie))
+            vm.toggle(movie)
+            #expect(vm.isFavorite(movie))
+            #expect(vm.favorites == [movie])
+            vm.toggle(movie)
+            #expect(!vm.isFavorite(movie))
+            #expect(vm.favorites.isEmpty)
+        }
+    }
+
+    @Test func persistsAcrossStoreInstances() throws {
+        try withSuite { defaults, _ in
+            let all = try movies()
+            let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            vm.toggle(all[0])
+            vm.toggle(all[1])
+
+            let reloaded = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            #expect(reloaded.favorites == [all[0], all[1]])
+            #expect(UserDefaultsFavoritesStore(defaults: defaults).load() == [all[0], all[1]])
+        }
+    }
+
+    @Test func keepsInsertionOrder() throws {
+        try withSuite { defaults, _ in
+            let all = try movies()
+            let order = [all[3], all[0], all[2]]
+            let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            order.forEach(vm.toggle)
+            #expect(vm.favorites.map(\.id) == order.map(\.id))
+            let reloaded = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            #expect(reloaded.favorites.map(\.id) == order.map(\.id))
+        }
+    }
+
+    @Test func removeAtOffsetsPersists() throws {
+        try withSuite { defaults, _ in
+            let all = try movies()
+            let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            all.prefix(3).forEach(vm.toggle)
+            vm.remove(at: IndexSet(integer: 1))
+            #expect(vm.favorites.map(\.id) == [all[0].id, all[2].id])
+            let reloaded = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            #expect(reloaded.favorites.map(\.id) == [all[0].id, all[2].id])
+        }
+    }
+
+    @Test func noDuplicates() throws {
+        try withSuite { defaults, _ in
+            let movie = try #require(try movies().first)
+            let store = UserDefaultsFavoritesStore(defaults: defaults)
+            // Even if the store already holds duplicates, the view model exposes each movie once.
+            store.save([movie, movie])
+            let vm = FavoritesViewModel(store: store)
+            #expect(vm.favorites.count == 1)
+            vm.toggle(movie)
+            vm.toggle(movie)
+            #expect(vm.favorites.count == 1)
+            #expect(vm.favorites.filter { $0.id == movie.id }.count == 1)
+        }
+    }
+
+    @Test func movieRoundTripsAllFields() throws {
+        try withSuite { defaults, _ in
+            let all = try movies()
+            let store = UserDefaultsFavoritesStore(defaults: defaults)
+            store.save(all)
+            #expect(store.load() == all)
+        }
+    }
+
+    @Test func emptyStoreLoadsEmpty() throws {
+        try withSuite { defaults, _ in
+            #expect(UserDefaultsFavoritesStore(defaults: defaults).load().isEmpty)
+        }
+    }
+}
