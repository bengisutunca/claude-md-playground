diff --git a/Tests/TMDBAppTests/FavoritesTests.swift b/Tests/TMDBAppTests/FavoritesTests.swift
new file mode 100644
index 0000000..7427432
--- /dev/null
+++ b/Tests/TMDBAppTests/FavoritesTests.swift
@@ -0,0 +1,87 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("Favorites")
+struct FavoritesTests {
+    private func movies() throws -> [Movie] {
+        try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page1")).results
+    }
+
+    /// Runs `body` with a unique suite, then removes it.
+    private func withSuite(_ body: (UserDefaults) throws -> Void) throws {
+        let name = "FavoritesTests.\(UUID().uuidString)"
+        let defaults = try #require(UserDefaults(suiteName: name))
+        defer { defaults.removePersistentDomain(forName: name) }
+        try body(defaults)
+    }
+
+    @Test func toggleOnAndOff() throws {
+        try withSuite { defaults in
+            let list = try movies()
+            let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            #expect(!vm.isFavorite(list[0]))
+            vm.toggle(list[0])
+            #expect(vm.isFavorite(list[0]))
+            vm.toggle(list[0])
+            #expect(!vm.isFavorite(list[0]))
+            #expect(vm.favorites.isEmpty)
+        }
+    }
+
+    @Test func persistsAcrossStoreInstances() throws {
+        try withSuite { defaults in
+            let list = try movies()
+            let first = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            first.toggle(list[0])
+            first.toggle(list[1])
+            let second = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            #expect(second.favorites == [list[0], list[1]])
+            #expect(second.favorites[0].releaseDate == list[0].releaseDate)
+        }
+    }
+
+    @Test func keepsInsertionOrder() throws {
+        try withSuite { defaults in
+            let list = try movies()
+            let store = UserDefaultsFavoritesStore(defaults: defaults)
+            let vm = FavoritesViewModel(store: store)
+            let order = [list[2], list[0], list[1]]
+            for m in order { vm.toggle(m) }
+            #expect(vm.favorites.map(\.id) == order.map(\.id))
+            #expect(store.load().map(\.id) == order.map(\.id))
+        }
+    }
+
+    @Test func removeAtOffsets() throws {
+        try withSuite { defaults in
+            let list = try movies()
+            let store = UserDefaultsFavoritesStore(defaults: defaults)
+            let vm = FavoritesViewModel(store: store)
+            for m in list.prefix(3) { vm.toggle(m) }
+            vm.remove(at: IndexSet(integer: 1))
+            #expect(vm.favorites.map(\.id) == [list[0].id, list[2].id])
+            #expect(store.load().map(\.id) == [list[0].id, list[2].id])
+        }
+    }
+
+    @Test func noDuplicates() throws {
+        try withSuite { defaults in
+            let list = try movies()
+            let store = UserDefaultsFavoritesStore(defaults: defaults)
+            store.save([list[0]])
+            let vm = FavoritesViewModel(store: store)
+            vm.toggle(list[0])
+            vm.toggle(list[0])
+            #expect(vm.favorites.filter { $0.id == list[0].id }.count == 1)
+            #expect(store.load().count == 1)
+        }
+    }
+
+    @Test func missingKeyLoadsEmpty() throws {
+        try withSuite { defaults in
+            #expect(UserDefaultsFavoritesStore(defaults: defaults).load().isEmpty)
+        }
+    }
+}
