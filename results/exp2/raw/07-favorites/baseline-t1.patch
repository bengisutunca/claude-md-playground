diff --git a/Tests/TMDBAppTests/FavoritesTests.swift b/Tests/TMDBAppTests/FavoritesTests.swift
new file mode 100644
index 0000000..1c8c108
--- /dev/null
+++ b/Tests/TMDBAppTests/FavoritesTests.swift
@@ -0,0 +1,82 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("Favorites")
+struct FavoritesTests {
+    private final class Env {
+        let name = "FavoritesTests.\(UUID().uuidString)"
+        let defaults: UserDefaults
+        init() { defaults = UserDefaults(suiteName: name)! }
+        func makeStore() -> UserDefaultsFavoritesStore { UserDefaultsFavoritesStore(defaults: defaults) }
+        func cleanUp() { defaults.removePersistentDomain(forName: name) }
+    }
+
+    private func movies() throws -> [Movie] {
+        try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page1")).results
+    }
+
+    @Test func toggleOnAndOff() throws {
+        let env = Env(); defer { env.cleanUp() }
+        let vm = FavoritesViewModel(store: env.makeStore())
+        let movie = try #require(movies().first)
+        #expect(!vm.isFavorite(movie))
+        vm.toggle(movie)
+        #expect(vm.isFavorite(movie))
+        #expect(vm.favorites == [movie])
+        vm.toggle(movie)
+        #expect(!vm.isFavorite(movie))
+        #expect(vm.favorites.isEmpty)
+    }
+
+    @Test func persistsAcrossStoreInstancesWithFullMovieValues() throws {
+        let env = Env(); defer { env.cleanUp() }
+        let all = try movies()
+        let vm = FavoritesViewModel(store: env.makeStore())
+        vm.toggle(all[0]); vm.toggle(all[2])
+
+        let reloaded = FavoritesViewModel(store: env.makeStore())
+        #expect(reloaded.favorites == [all[0], all[2]])
+        #expect(env.makeStore().load() == [all[0], all[2]])
+    }
+
+    @Test func insertionOrderKept() throws {
+        let env = Env(); defer { env.cleanUp() }
+        let all = try movies()
+        let vm = FavoritesViewModel(store: env.makeStore())
+        let expected = [all[3], all[1], all[4], all[0]]
+        for m in expected { vm.toggle(m) }
+        #expect(vm.favorites.map(\.id) == expected.map(\.id))
+        #expect(FavoritesViewModel(store: env.makeStore()).favorites.map(\.id) == expected.map(\.id))
+    }
+
+    @Test func removeAtOffsetsPersists() throws {
+        let env = Env(); defer { env.cleanUp() }
+        let all = try movies()
+        let vm = FavoritesViewModel(store: env.makeStore())
+        for m in all.prefix(3) { vm.toggle(m) }
+        vm.remove(at: IndexSet(integer: 1))
+        #expect(vm.favorites.map(\.id) == [all[0].id, all[2].id])
+        #expect(FavoritesViewModel(store: env.makeStore()).favorites.map(\.id) == [all[0].id, all[2].id])
+    }
+
+    @Test func noDuplicates() throws {
+        let env = Env(); defer { env.cleanUp() }
+        let movie = try #require(movies().first)
+        // Duplicates already present in storage are collapsed on load.
+        env.makeStore().save([movie, movie])
+        let vm = FavoritesViewModel(store: env.makeStore())
+        #expect(vm.favorites.count == 1)
+        // Toggling twice never leaves a second copy.
+        vm.toggle(movie)
+        vm.toggle(movie)
+        #expect(vm.favorites.count == 1)
+        #expect(vm.isFavorite(movie))
+    }
+
+    @Test func emptyStoreLoadsEmpty() {
+        let env = Env(); defer { env.cleanUp() }
+        #expect(env.makeStore().load().isEmpty)
+    }
+}
