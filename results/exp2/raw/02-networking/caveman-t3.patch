@@ -0,0 +1,87 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite(.serialized)
+struct NetworkingTests {
+    let config = APIConfiguration(apiKey: "test-key")
+
+    func client() -> TMDBClient {
+        TMDBClient(session: MockURLProtocol.makeSession(), configuration: config)
+    }
+
+    func items(_ request: URLRequest) -> [String: String] {
+        let comps = URLComponents(url: request.url!, resolvingAgainstBaseURL: false)!
+        return Dictionary(uniqueKeysWithValues: (comps.queryItems ?? []).map { ($0.name, $0.value ?? "") })
+    }
+
+    @Test func decodesPopularSuccess() async throws {
+        let data = try Fixture.data("popular_page1")
+        MockURLProtocol.handler = { _ in .init(status: 200, data: data) }
+        let page = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+        #expect(page.page == 1)
+        #expect(!page.results.isEmpty)
+    }
+
+    @Test func mapsUnauthorizedToHTTPStatus() async throws {
+        let data = try Fixture.data("error_401")
+        MockURLProtocol.handler = { _ in .init(status: 401, data: data) }
+        do {
+            _ = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected throw")
+        } catch let APIError.httpStatus(code, message) {
+            #expect(code == 401)
+            #expect(message == "Invalid API key: You must be granted a valid key.")
+        }
+    }
+
+    @Test func wrapsDecodingFailure() async throws {
+        let data = try Fixture.data("popular_page1")
+        MockURLProtocol.handler = { _ in .init(status: 200, data: data) }
+        do {
+            _ = try await client().send(.popular(page: 1), as: Credits.self)
+            Issue.record("expected throw")
+        } catch APIError.decoding {
+        }
+    }
+
+    @Test func sendsRequestToExpectedPath() async throws {
+        let data = try Fixture.data("search_inception")
+        nonisolated(unsafe) var captured: URLRequest?
+        MockURLProtocol.handler = { req in captured = req; return .init(status: 200, data: data) }
+        _ = try await client().send(.search(query: "inception", page: 1), as: PagedResponse<Movie>.self)
+        #expect(captured?.url?.path == "/3/search/movie")
+        #expect(captured.map(items)?["api_key"] == "test-key")
+    }
+
+    @Test func configurationLoadOrder() throws {
+        #expect(try APIConfiguration.load(environment: ["TMDB_API_KEY": "abc"]).apiKey == "abc")
+        #expect(throws: APIError.self) {
+            try APIConfiguration.load(environment: ["TMDB_API_KEY": ""], bundle: Bundle(for: MockURLProtocol.self))
+        }
+    }
+
+    @Test func popularQuery() throws {
+        let r = try Endpoint.popular(page: 2).urlRequest(configuration: config)
+        #expect(r.url?.path == "/3/movie/popular")
+        #expect(items(r) == ["api_key": "test-key", "language": "en-US", "page": "2"])
+    }
+
+    @Test func searchQuery() throws {
+        let r = try Endpoint.search(query: "star wars", page: 3).urlRequest(configuration: config)
+        #expect(r.url?.path == "/3/search/movie")
+        #expect(items(r) == ["api_key": "test-key", "language": "en-US", "query": "star wars", "page": "3"])
+    }
+
+    @Test func detailQuery() throws {
+        let r = try Endpoint.movieDetail(id: 27205).urlRequest(configuration: config)
+        #expect(r.url?.path == "/3/movie/27205")
+        #expect(items(r) == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func creditsQuery() throws {
+        let r = try Endpoint.credits(movieID: 27205).urlRequest(configuration: config)
+        #expect(r.url?.path == "/3/movie/27205/credits")
+        #expect(items(r) == ["api_key": "test-key", "language": "en-US"])
+    }
+}
