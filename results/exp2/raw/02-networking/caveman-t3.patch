@@ -0,0 +1,13 @@
+import Foundation
+
+public enum APIError: Error {
+    case invalidResponse
+    case httpStatus(code: Int, message: String?)
+    case decoding(Error)
+    case transport(Error)
+    case missingAPIKey
+}
+
+struct TMDBErrorBody: Decodable {
+    let statusMessage: String?
+}
