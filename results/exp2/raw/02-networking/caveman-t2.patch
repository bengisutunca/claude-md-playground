+import Foundation
+
+/// TMDB connection settings. The key is never hard-coded.
+public struct APIConfiguration: Sendable {
+    public static let keyName = "TMDB_API_KEY"
+
+    public let apiKey: String
+    public let baseURL: URL
+
+    public init(apiKey: String, baseURL: URL = TMDBApp.apiBaseURL) {
+        self.apiKey = apiKey
+        self.baseURL = baseURL
+    }
+
+    /// Reads the key from the environment first, then from the `Bundle` Info.plist.
+    /// Throws `APIError.missingAPIKey` when neither source has a non-empty key.
+    public static func load(
+        environment: [String: String] = ProcessInfo.processInfo.environment,
+        bundle: Bundle = .main
+    ) throws -> APIConfiguration {
+        if let key = environment[keyName], !key.isEmpty {
+            return APIConfiguration(apiKey: key)
+        }
+        if let key = bundle.object(forInfoDictionaryKey: keyName) as? String, !key.isEmpty {
+            return APIConfiguration(apiKey: key)
+        }
+        throw APIError.missingAPIKey
+    }
+}
diff --git a/Sources/TMDBApp/Networking/APIError.swift b/Sources/TMDBApp/Networking/APIError.swift
