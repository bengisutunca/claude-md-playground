+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("Networking", .serialized)
+struct NetworkingTests {
+    let config = APIConfiguration(apiKey: "test-key", baseURL: URL(string: "https://example.test/3")!)
+
+    private func client() -> TMDBClient {
+        TMDBClient(session: MockURLProtocol.makeSession(), configuration: config)
+    }
+
+    private func items(_ endpoint: Endpoint) throws -> (path: String, items: [String: String]) {
+        let url = try endpoint.urlRequest(configuration: config).url!
+        let comps = URLComponents(url: url, resolvingAgainstBaseURL: false)!
+        let dict = Dictionary(uniqueKeysWithValues: (comps.queryItems ?? []).map { ($0.name, $0.value ?? "") })
+        return (comps.path, dict)
+    }
+
+    // MARK: Client
+
+    @Test func decodesSuccess() async throws {
+        MockURLProtocol.serve(try Fixture.data("popular_page1"))
+        let page = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+        #expect(page.page == 1)
+        #expect(!page.results.isEmpty)
+    }
+
+    @Test func decodesDetailAndCredits() async throws {
+        MockURLProtocol.serve(try Fixture.data("movie_detail_27205"))
+        let detail = try await client().send(.movieDetail(id: 27205), as: MovieDetail.self)
+        #expect(detail.id == 27205)
+
+        MockURLProtocol.serve(try Fixture.data("movie_credits_27205"))
+        let credits = try await client().send(.credits(movieID: 27205), as: Credits.self)
+        #expect(credits.id == 27205)
+    }
+
+    @Test func unauthorizedMapsToHTTPStatus() async throws {
+        MockURLProtocol.serve(try Fixture.data("error_401"), status: 401)
+        do {
+            _ = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch let APIError.httpStatus(code, message) {
+            #expect(code == 401)
+            #expect(message == "Invalid API key: You must be granted a valid key.")
+        } catch {
+            Issue.record("wrong error: \(error)")
+        }
+    }
+
+    @Test func httpErrorWithUnparseableBodyHasNilMessage() async throws {
+        MockURLProtocol.serve(Data("oops".utf8), status: 500)
+        do {
+            _ = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch let APIError.httpStatus(code, message) {
+            #expect(code == 500)
+            #expect(message == nil)
+        } catch {
+            Issue.record("wrong error: \(error)")
+        }
+    }
+
+    @Test func decodingFailure() async throws {
+        // Valid JSON, wrong shape for the requested type.
+        MockURLProtocol.serve(try Fixture.data("movie_detail_27205"))
+        do {
+            _ = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch APIError.decoding {
+        } catch {
+            Issue.record("wrong error: \(error)")
+        }
+    }
+
+    @Test func transportFailure() async throws {
+        MockURLProtocol.handler = { _ in throw URLError(.notConnectedToInternet) }
+        do {
+            _ = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch APIError.transport {
+        } catch {
+            Issue.record("wrong error: \(error)")
+        }
+    }
+
+    // MARK: Endpoint
+
+    @Test func popularQuery() throws {
+        let (path, q) = try items(.popular(page: 2))
+        #expect(path == "/3/movie/popular")
+        #expect(q == ["api_key": "test-key", "language": "en-US", "page": "2"])
+    }
+
+    @Test func searchQuery() throws {
+        let (path, q) = try items(.search(query: "the dark knight", page: 3))
+        #expect(path == "/3/search/movie")
+        #expect(q == ["api_key": "test-key", "language": "en-US", "query": "the dark knight", "page": "3"])
+    }
+
+    @Test func detailQuery() throws {
+        let (path, q) = try items(.movieDetail(id: 27205))
+        #expect(path == "/3/movie/27205")
+        #expect(q == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func creditsQuery() throws {
+        let (path, q) = try items(.credits(movieID: 27205))
+        #expect(path == "/3/movie/27205/credits")
+        #expect(q == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    // MARK: Configuration
+
+    @Test func configurationPrefersEnvironment() throws {
+        let c = try APIConfiguration.load(environment: ["TMDB_API_KEY": "env"], bundle: Bundle(for: BundleToken.self))
+        #expect(c.apiKey == "env")
+    }
+
+    @Test func configurationMissingKeyThrows() {
+        #expect {
+            try APIConfiguration.load(environment: ["TMDB_API_KEY": ""], bundle: Bundle(for: BundleToken.self))
+        } throws: { error in
+            if case APIError.missingAPIKey = error { return true }
+            return false
+        }
+    }
+}
+
+private final class BundleToken {}
