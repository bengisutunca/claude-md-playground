@@ -0,0 +1,27 @@
+import Foundation
+
+public struct APIConfiguration: Sendable, Equatable {
+    public static let environmentKey = "TMDB_API_KEY"
+
+    public let apiKey: String
+    public let baseURL: URL
+
+    public init(apiKey: String, baseURL: URL = TMDBApp.apiBaseURL) {
+        self.apiKey = apiKey
+        self.baseURL = baseURL
+    }
+
+    /// Reads the key from the environment, falling back to the bundle's Info.plist.
+    public static func load(
+        environment: [String: String] = ProcessInfo.processInfo.environment,
+        bundle: Bundle = .main
+    ) throws -> APIConfiguration {
+        if let key = environment[environmentKey], !key.isEmpty {
+            return APIConfiguration(apiKey: key)
+        }
+        if let key = bundle.object(forInfoDictionaryKey: environmentKey) as? String, !key.isEmpty {
+            return APIConfiguration(apiKey: key)
+        }
+        throw APIError.missingAPIKey
+    }
+}
diff --git a/Sources/TMDBApp/Networking/APIError.swift b/Sources/TMDBApp/Networking/APIError.swift
