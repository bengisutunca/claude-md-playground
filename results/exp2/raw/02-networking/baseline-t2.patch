@@ -0,0 +1,92 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("Networking", .serialized)
+struct NetworkingTests {
+    let config = APIConfiguration(apiKey: "test-key")
+
+    private func client(status: Int = 200, body: Data) -> TMDBClient {
+        MockURLProtocol.handler = { request in
+            (HTTPURLResponse(url: request.url!, statusCode: status, httpVersion: nil, headerFields: nil)!, body)
+        }
+        return TMDBClient(session: MockURLProtocol.session(), configuration: config)
+    }
+
+    private func items(_ endpoint: Endpoint) throws -> (path: String, items: [String: String]) {
+        let url = try endpoint.urlRequest(configuration: config).url!
+        let comps = URLComponents(url: url, resolvingAgainstBaseURL: false)!
+        let dict = Dictionary(uniqueKeysWithValues: (comps.queryItems ?? []).map { ($0.name, $0.value ?? "") })
+        return (comps.path, dict)
+    }
+
+    @Test func successDecodesPopular() async throws {
+        let c = client(body: try Fixture.data("popular_page1"))
+        let page = try await c.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+        #expect(page.results.count == 5)
+    }
+
+    @Test func successDecodesDetailAndCredits() async throws {
+        let d = try await client(body: try Fixture.data("movie_detail_27205"))
+            .send(.movieDetail(id: 27205), as: MovieDetail.self)
+        #expect(d.id == 27205)
+        let credits = try await client(body: try Fixture.data("movie_credits_27205"))
+            .send(.credits(movieID: 27205), as: Credits.self)
+        #expect(credits.id == 27205)
+    }
+
+    @Test func unauthorizedMapsToHTTPStatus() async throws {
+        let c = client(status: 401, body: try Fixture.data("error_401"))
+        do {
+            _ = try await c.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch let APIError.httpStatus(code, message) {
+            #expect(code == 401)
+            #expect(message == "Invalid API key: You must be granted a valid key.")
+        }
+    }
+
+    @Test func decodingFailure() async throws {
+        let c = client(body: try Fixture.data("popular_page1"))
+        do {
+            _ = try await c.send(.popular(page: 1), as: Credits.self)
+            Issue.record("expected error")
+        } catch APIError.decoding {
+        }
+    }
+
+    @Test func transportFailure() async throws {
+        MockURLProtocol.handler = { _ in throw URLError(.notConnectedToInternet) }
+        let c = TMDBClient(session: MockURLProtocol.session(), configuration: config)
+        do {
+            _ = try await c.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch APIError.transport {
+        }
+    }
+
+    @Test func queryItems() throws {
+        let p = try items(.popular(page: 2))
+        #expect(p.path == "/3/movie/popular")
+        #expect(p.items == ["api_key": "test-key", "language": "en-US", "page": "2"])
+
+        let s = try items(.search(query: "the matrix & co", page: 3))
+        #expect(s.path == "/3/search/movie")
+        #expect(s.items == ["api_key": "test-key", "language": "en-US", "query": "the matrix & co", "page": "3"])
+
+        let d = try items(.movieDetail(id: 27205))
+        #expect(d.path == "/3/movie/27205")
+        #expect(d.items == ["api_key": "test-key", "language": "en-US"])
+
+        let c = try items(.credits(movieID: 27205))
+        #expect(c.path == "/3/movie/27205/credits")
+        #expect(c.items == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func configurationLoading() throws {
+        #expect(try APIConfiguration.load(environment: ["TMDB_API_KEY": "abc"], bundle: Bundle()).apiKey == "abc")
+        #expect(throws: APIError.self) {
+            try APIConfiguration.load(environment: ["TMDB_API_KEY": ""], bundle: Bundle())
+        }
+    }
+}
