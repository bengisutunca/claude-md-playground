--- /dev/null
+++ b/Sources/TMDBApp/Networking/APIError.swift
@@ -0,0 +1,25 @@
+import Foundation
+
+public enum APIError: Error {
+    case invalidResponse
+    case httpStatus(code: Int, message: String?)
+    case decoding(Error)
+    case transport(Error)
+    case missingAPIKey
+}
+
+extension APIError: LocalizedError {
+    public var errorDescription: String? {
+        switch self {
+        case .invalidResponse: return "The server returned an invalid response."
+        case let .httpStatus(code, message): return message ?? "Request failed with status \(code)."
+        case .decoding: return "The server response could not be read."
+        case .transport(let error): return error.localizedDescription
+        case .missingAPIKey: return "TMDB API key is missing."
+        }
+    }
+}
+
+struct TMDBErrorBody: Decodable {
+    let statusMessage: String?
+}
