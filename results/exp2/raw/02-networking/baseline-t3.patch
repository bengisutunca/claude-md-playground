@@ -0,0 +1,28 @@
+import Foundation
+
+public struct APIConfiguration: Sendable {
+    public static let keyName = "TMDB_API_KEY"
+
+    public let apiKey: String
+    public let baseURL: URL
+
+    public init(apiKey: String, baseURL: URL = TMDBApp.apiBaseURL) {
+        self.apiKey = apiKey
+        self.baseURL = baseURL
+    }
+
+    /// Reads the key from the environment, falling back to the bundle's Info.plist.
+    public static func load(
+        environment: [String: String] = ProcessInfo.processInfo.environment,
+        bundle: Bundle = .main
+    ) throws -> APIConfiguration {
+        if let key = environment[keyName]?.trimmingCharacters(in: .whitespacesAndNewlines), !key.isEmpty {
+            return APIConfiguration(apiKey: key)
+        }
+        if let key = (bundle.object(forInfoDictionaryKey: keyName) as? String)?
+            .trimmingCharacters(in: .whitespacesAndNewlines), !key.isEmpty {
+            return APIConfiguration(apiKey: key)
+        }
+        throw APIError.missingAPIKey
+    }
+}
