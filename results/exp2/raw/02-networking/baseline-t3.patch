+import Testing
+import Foundation
+@testable import TMDBApp
+
+final class MockURLProtocol: URLProtocol, @unchecked Sendable {
+    typealias Handler = (URLRequest) throws -> (HTTPURLResponse, Data)
+    nonisolated(unsafe) private static var handler: Handler?
+    private static let lock = NSLock()
+
+    static func setHandler(_ h: Handler?) {
+        lock.lock(); handler = h; lock.unlock()
+    }
+
+    override class func canInit(with request: URLRequest) -> Bool { true }
+    override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+
+    override func startLoading() {
+        Self.lock.lock(); let h = Self.handler; Self.lock.unlock()
+        guard let h else {
+            client?.urlProtocol(self, didFailWithError: URLError(.unknown)); return
+        }
+        do {
+            let (response, data) = try h(request)
+            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: data)
+            client?.urlProtocolDidFinishLoading(self)
+        } catch {
+            client?.urlProtocol(self, didFailWithError: error)
+        }
+    }
+
+    override func stopLoading() {}
+}
+
+@Suite(.serialized)
+struct NetworkingTests {
+    let config = APIConfiguration(apiKey: "test-key")
+
+    func makeClient(status: Int = 200, data: Data) -> TMDBClient {
+        MockURLProtocol.setHandler { request in
+            (HTTPURLResponse(url: request.url!, statusCode: status, httpVersion: nil, headerFields: nil)!, data)
+        }
+        return makeClient()
+    }
+
+    func makeClient() -> TMDBClient {
+        let cfg = URLSessionConfiguration.ephemeral
+        cfg.protocolClasses = [MockURLProtocol.self]
+        return TMDBClient(session: URLSession(configuration: cfg), configuration: config)
+    }
+
+    @Test func decodesSuccess() async throws {
+        let client = makeClient(data: try Fixture.data("popular_page1"))
+        let result = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+        #expect(result.page == 1)
+        #expect(!result.results.isEmpty)
+    }
+
+    @Test func http401ParsesMessage() async throws {
+        let client = makeClient(status: 401, data: try Fixture.data("error_401"))
+        do {
+            _ = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch let APIError.httpStatus(code, message) {
+            #expect(code == 401)
+            #expect(message == "Invalid API key: You must be granted a valid key.")
+        }
+    }
+
+    @Test func decodingFailure() async throws {
+        let client = makeClient(data: try Fixture.data("movie_credits_27205"))
+        do {
+            _ = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch APIError.decoding {
+            // expected
+        }
+    }
+
+    @Test func transportFailure() async throws {
+        MockURLProtocol.setHandler { _ in throw URLError(.notConnectedToInternet) }
+        let client = makeClient()
+        do {
+            _ = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch APIError.transport {
+            // expected
+        }
+    }
+
+    private func parts(_ e: Endpoint) throws -> (String, [String: String]) {
+        let url = try e.urlRequest(configuration: config).url!
+        let comps = URLComponents(url: url, resolvingAgainstBaseURL: false)!
+        var dict: [String: String] = [:]
+        for i in comps.queryItems ?? [] { dict[i.name] = i.value }
+        return (comps.path, dict)
+    }
+
+    @Test func popularQuery() throws {
+        let (path, q) = try parts(.popular(page: 2))
+        #expect(path == "/3/movie/popular")
+        #expect(q == ["api_key": "test-key", "language": "en-US", "page": "2"])
+    }
+
+    @Test func searchQuery() throws {
+        let (path, q) = try parts(.search(query: "the matrix & co", page: 3))
+        #expect(path == "/3/search/movie")
+        #expect(q == ["api_key": "test-key", "language": "en-US", "query": "the matrix & co", "page": "3"])
+    }
+
+    @Test func detailQuery() throws {
+        let (path, q) = try parts(.movieDetail(id: 27205))
+        #expect(path == "/3/movie/27205")
+        #expect(q == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func creditsQuery() throws {
+        let (path, q) = try parts(.credits(movieID: 27205))
+        #expect(path == "/3/movie/27205/credits")
+        #expect(q == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func configurationFromEnvironment() throws {
+        #expect(try APIConfiguration.load(environment: ["TMDB_API_KEY": "abc"]).apiKey == "abc")
+    }
+
+    @Test func configurationMissingKey() {
+        #expect(throws: APIError.self) {
+            try APIConfiguration.load(environment: ["TMDB_API_KEY": ""], bundle: Bundle(for: MockURLProtocol.self))
+        }
+    }
+}
