--- /dev/null
+++ b/Sources/TMDBApp/Networking/APIError.swift
@@ -0,0 +1,25 @@
+import Foundation
+
+public enum APIError: Error {
+    case invalidResponse
+    case httpStatus(code: Int, message: String?)
+    case decoding(Error)
+    case transport(Error)
+    case missingAPIKey
+}
+
+extension APIError: LocalizedError {
+    public var errorDescription: String? {
+        switch self {
+        case .invalidResponse: "The server returned an invalid response."
+        case let .httpStatus(code, message): message ?? "Request failed with status \(code)."
+        case .decoding: "Could not read the server response."
+        case .transport(let error): error.localizedDescription
+        case .missingAPIKey: "TMDB API key is missing."
+        }
+    }
+}
+
+struct TMDBErrorBody: Decodable {
+    let statusMessage: String?
+}
