@@ -0,0 +1,78 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("Networking", .serialized)
+struct NetworkingTests {
+    let config = APIConfiguration(apiKey: "test-key")
+
+    private func items(_ endpoint: Endpoint) throws -> (String, [String: String]) {
+        let req = try endpoint.urlRequest(configuration: config)
+        let comps = URLComponents(url: req.url!, resolvingAgainstBaseURL: false)!
+        let dict = Dictionary(uniqueKeysWithValues: (comps.queryItems ?? []).map { ($0.name, $0.value ?? "") })
+        return (comps.path, dict)
+    }
+
+    @Test func popularQuery() throws {
+        let (path, q) = try items(.popular(page: 2))
+        #expect(path == "/3/movie/popular")
+        #expect(q == ["api_key": "test-key", "language": "en-US", "page": "2"])
+    }
+
+    @Test func searchQuery() throws {
+        let (path, q) = try items(.search(query: "the dark & knight", page: 1))
+        #expect(path == "/3/search/movie")
+        #expect(q["query"] == "the dark & knight")
+        #expect(q["page"] == "1")
+        #expect(q["api_key"] == "test-key")
+    }
+
+    @Test func detailQuery() throws {
+        let (path, q) = try items(.movieDetail(id: 27205))
+        #expect(path == "/3/movie/27205")
+        #expect(q == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func creditsQuery() throws {
+        let (path, q) = try items(.credits(movieID: 27205))
+        #expect(path == "/3/movie/27205/credits")
+        #expect(q == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func successDecoding() async throws {
+        let data = try Fixture.data("popular_page1")
+        let client = TMDBClient(session: MockURLProtocol.session { _ in .init(status: 200, data: data) }, configuration: config)
+        let page = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+        #expect(page.results.count == 5)
+    }
+
+    @Test func unauthorizedParsesMessage() async throws {
+        let data = try Fixture.data("error_401")
+        let client = TMDBClient(session: MockURLProtocol.session { _ in .init(status: 401, data: data) }, configuration: config)
+        do {
+            _ = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch APIError.httpStatus(let code, let message) {
+            #expect(code == 401)
+            #expect(message == "Invalid API key: You must be granted a valid key.")
+        }
+    }
+
+    @Test func decodingFailure() async throws {
+        let data = try Fixture.data("movie_credits_27205")
+        let client = TMDBClient(session: MockURLProtocol.session { _ in .init(status: 200, data: data) }, configuration: config)
+        do {
+            _ = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch APIError.decoding {
+        }
+    }
+
+    @Test func missingKey() throws {
+        #expect(throws: APIError.self) {
+            try APIConfiguration.load(environment: [:], bundle: Bundle(for: MockURLProtocol.self))
+        }
+        let c = try APIConfiguration.load(environment: ["TMDB_API_KEY": "abc"])
+        #expect(c.apiKey == "abc")
+    }
+}
