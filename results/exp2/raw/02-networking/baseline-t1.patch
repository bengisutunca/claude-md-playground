--- /dev/null
+++ b/Tests/TMDBAppTests/MockURLProtocol.swift
@@ -0,0 +1,28 @@
+import Foundation
+
+final class MockURLProtocol: URLProtocol, @unchecked Sendable {
+    struct Stub { var status: Int; var data: Data }
+    nonisolated(unsafe) static var handler: (@Sendable (URLRequest) -> Stub)?
+
+    static func session(_ handler: @escaping @Sendable (URLRequest) -> Stub) -> URLSession {
+        Self.handler = handler
+        let config = URLSessionConfiguration.ephemeral
+        config.protocolClasses = [MockURLProtocol.self]
+        return URLSession(configuration: config)
+    }
+
+    override class func canInit(with request: URLRequest) -> Bool { true }
+    override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+
+    override func startLoading() {
+        guard let stub = Self.handler?(request), let url = request.url else {
+            client?.urlProtocol(self, didFailWithError: URLError(.badServerResponse)); return
+        }
+        let response = HTTPURLResponse(url: url, statusCode: stub.status, httpVersion: nil, headerFields: nil)!
+        client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+        client?.urlProtocol(self, didLoad: stub.data)
+        client?.urlProtocolDidFinishLoading(self)
+    }
+
+    override func stopLoading() {}
+}
