@@ -0,0 +1,93 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("Networking", .serialized)
+struct NetworkingTests {
+    private let config = APIConfiguration(apiKey: "test-key")
+
+    private func client() -> TMDBClient {
+        TMDBClient(session: MockURLProtocol.session(), configuration: config)
+    }
+
+    private func items(_ endpoint: Endpoint) throws -> (path: String, items: [String: String]) {
+        let url = try #require(endpoint.urlRequest(configuration: config).url)
+        let comps = try #require(URLComponents(url: url, resolvingAgainstBaseURL: false))
+        let dict = Dictionary(uniqueKeysWithValues: (comps.queryItems ?? []).map { ($0.name, $0.value ?? "") })
+        return (comps.path, dict)
+    }
+
+    @Test func successDecoding() async throws {
+        MockURLProtocol.respond(data: try Fixture.data("popular_page1"))
+        let page = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+        #expect(page.page == 1)
+        #expect(page.results.count == 5)
+    }
+
+    @Test func unauthorizedMapsToHTTPStatus() async throws {
+        MockURLProtocol.respond(status: 401, data: try Fixture.data("error_401"))
+        do {
+            _ = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected throw")
+        } catch let APIError.httpStatus(code, message) {
+            #expect(code == 401)
+            #expect(message == "Invalid API key: You must be granted a valid key.")
+        }
+    }
+
+    @Test func decodingFailure() async throws {
+        MockURLProtocol.respond(data: try Fixture.data("error_401"))
+        do {
+            _ = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected throw")
+        } catch APIError.decoding {
+        }
+    }
+
+    @Test func transportFailure() async throws {
+        MockURLProtocol.handler = { _ in throw URLError(.notConnectedToInternet) }
+        do {
+            _ = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected throw")
+        } catch APIError.transport {
+        }
+    }
+
+    @Test func popularQuery() throws {
+        let r = try items(.popular(page: 2))
+        #expect(r.path == "/3/movie/popular")
+        #expect(r.items == ["api_key": "test-key", "language": "en-US", "page": "2"])
+    }
+
+    @Test func searchQuery() throws {
+        let r = try items(.search(query: "the matrix & co", page: 3))
+        #expect(r.path == "/3/search/movie")
+        #expect(r.items == ["api_key": "test-key", "language": "en-US", "query": "the matrix & co", "page": "3"])
+    }
+
+    @Test func detailQuery() throws {
+        let r = try items(.movieDetail(id: 27205))
+        #expect(r.path == "/3/movie/27205")
+        #expect(r.items == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func creditsQuery() throws {
+        let r = try items(.credits(movieID: 27205))
+        #expect(r.path == "/3/movie/27205/credits")
+        #expect(r.items == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func configurationLoading() throws {
+        #expect(try APIConfiguration.load(environment: ["TMDB_API_KEY": "abc"]).apiKey == "abc")
+        #expect(throws: APIError.self) {
+            try APIConfiguration.load(environment: ["TMDB_API_KEY": ""], bundle: Bundle(for: MockURLProtocol.self))
+        }
+    }
+
+    @Test func missingKeyThrowsFromClient() async throws {
+        let c = TMDBClient(session: MockURLProtocol.session(), configuration: APIConfiguration(apiKey: ""))
+        await #expect(throws: APIError.self) {
+            _ = try await c.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+        }
+    }
+}
