@@ -0,0 +1,29 @@
+import Foundation
+
+public struct APIConfiguration: Sendable {
+    public static let keyName = "TMDB_API_KEY"
+
+    public let apiKey: String
+    public let baseURL: URL
+
+    public init(apiKey: String, baseURL: URL = TMDBApp.apiBaseURL) {
+        self.apiKey = apiKey
+        self.baseURL = baseURL
+    }
+
+    /// Reads `TMDB_API_KEY` from the environment, then from the bundle Info.plist.
+    public static func load(
+        environment: [String: String] = ProcessInfo.processInfo.environment,
+        bundle: Bundle = .main
+    ) throws -> APIConfiguration {
+        let candidates = [
+            environment[keyName],
+            bundle.object(forInfoDictionaryKey: keyName) as? String
+        ]
+        for case let candidate? in candidates {
+            let key = candidate.trimmingCharacters(in: .whitespacesAndNewlines)
+            if !key.isEmpty { return APIConfiguration(apiKey: key) }
+        }
+        throw APIError.missingAPIKey
+    }
+}
diff --git a/Sources/TMDBApp/Networking/APIError.swift b/Sources/TMDBApp/Networking/APIError.swift
new file mode 100644
index 0000000..fff5206
--- /dev/null
+++ b/Sources/TMDBApp/Networking/APIError.swift
@@ -0,0 +1,26 @@
+import Foundation
+
+public enum APIError: Error {
+    case invalidResponse
+    case httpStatus(code: Int, message: String?)
+    case decoding(Error)
+    case transport(Error)
+    case missingAPIKey
+}
+
+extension APIError: LocalizedError {
+    public var errorDescription: String? {
+        switch self {
+        case .invalidResponse: "The server returned an invalid response."
+        case let .httpStatus(code, message): message ?? "Request failed with status \(code)."
+        case let .decoding(error): "Could not decode response: \(error.localizedDescription)"
+        case let .transport(error): error.localizedDescription
+        case .missingAPIKey: "TMDB_API_KEY is not configured."
+        }
+    }
+}
+
+/// TMDB error body. Only `status_message` is read.
+struct TMDBErrorBody: Decodable {
+    let statusMessage: String?
+}
