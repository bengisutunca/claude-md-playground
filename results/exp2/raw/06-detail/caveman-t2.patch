diff --git a/Tests/TMDBAppTests/MovieDetailViewModelTests.swift b/Tests/TMDBAppTests/MovieDetailViewModelTests.swift
new file mode 100644
index 0000000..21e73ae
--- /dev/null
+++ b/Tests/TMDBAppTests/MovieDetailViewModelTests.swift
@@ -0,0 +1,88 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+/// Fails only the chosen request; the other returns fixture data.
+private struct PartialFailureService: MovieService {
+    enum Failing { case detail, credits }
+    let failing: Failing
+    let base = MockMovieService()
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> { try await base.popular(page: page) }
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        try await base.search(query: query, page: page)
+    }
+    func detail(id: Int) async throws -> MovieDetail {
+        if failing == .detail { throw APIError.transport(URLError(.timedOut)) }
+        return try await base.detail(id: id)
+    }
+    func credits(id: Int) async throws -> Credits {
+        if failing == .credits { throw APIError.transport(URLError(.timedOut)) }
+        return try await base.credits(id: id)
+    }
+}
+
+@MainActor
+@Suite("MovieDetailViewModel")
+struct MovieDetailViewModelTests {
+    @Test func successfulLoad() async throws {
+        let service = MockMovieService()
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        #expect(vm.state == .idle)
+        await vm.load()
+        guard case .loaded(let content) = vm.state else {
+            Issue.record("expected loaded, got \(vm.state)")
+            return
+        }
+        #expect(content.detail.id == 27205)
+        #expect(content.detail.title == "Inception")
+        #expect(content.cast.count <= 10)
+        #expect(!content.cast.isEmpty)
+        let orders = content.cast.compactMap(\.order)
+        #expect(orders == orders.sorted())
+        #expect(!content.directors.isEmpty)
+        #expect(content.directors.allSatisfy { $0.job == "Director" })
+        #expect(content.runtimeText == "2h 28m")
+        #expect(!content.genresText.isEmpty)
+        let calls = await service.calls
+        #expect(calls.count == 2)
+        #expect(calls.contains(.detail(id: 27205)))
+        #expect(calls.contains(.credits(id: 27205)))
+    }
+
+    @Test func detailFailureGivesFailed() async {
+        let vm = MovieDetailViewModel(movieID: 27205, service: PartialFailureService(failing: .detail))
+        await vm.load()
+        guard case .failed = vm.state else { Issue.record("expected failed, got \(vm.state)"); return }
+    }
+
+    @Test func creditsFailureGivesFailed() async {
+        let vm = MovieDetailViewModel(movieID: 27205, service: PartialFailureService(failing: .credits))
+        await vm.load()
+        guard case .failed = vm.state else { Issue.record("expected failed, got \(vm.state)"); return }
+    }
+
+    @Test func bothFailureGivesFailed() async {
+        let service = MockMovieService(error: APIError.httpStatus(code: 401, message: nil))
+        let vm = MovieDetailViewModel(movieID: 1, service: service)
+        await vm.load()
+        #expect(vm.state == .failed("Invalid API key."))
+    }
+
+    @Test func castIsCappedAndOrdered() throws {
+        let detail = try JSONDecoder.tmdb.decode(MovieDetail.self, from: Fixture.data("movie_detail_27205"))
+        let cast = (0..<15).reversed().map {
+            CastMember(id: $0, name: "A\($0)", character: nil, order: $0, profilePath: nil)
+        }
+        let content = MovieDetailContent(detail: detail, credits: Credits(id: 1, cast: cast, crew: []))
+        #expect(content.cast.map(\.order) == (0..<10).map { Optional($0) })
+    }
+
+    @Test(arguments: [
+        (0, "0m"), (1, "1m"), (45, "45m"), (59, "59m"),
+        (60, "1h"), (120, "2h"), (148, "2h 28m"), (61, "1h 1m"),
+    ])
+    func runtimeFormatting(minutes: Int, expected: String) {
+        #expect(MovieDetailContent.formatRuntime(minutes: minutes) == expected)
+    }
+}
