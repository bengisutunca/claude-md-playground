+import Foundation
+import Observation
+
+/// Everything the detail screen shows, built from the detail and credits responses.
+struct MovieDetailContent: Equatable, Sendable {
+    static let maxCastCount = 10
+
+    let detail: MovieDetail
+    let cast: [CastMember]
+    let directors: [CrewMember]
+
+    init(detail: MovieDetail, credits: Credits) {
+        self.init(detail: detail,
+                  cast: Self.topCast(credits.cast),
+                  directors: credits.crew.filter { $0.job == "Director" })
+    }
+
+    init(detail: MovieDetail, cast: [CastMember], directors: [CrewMember]) {
+        self.detail = detail
+        self.cast = cast
+        self.directors = directors
+    }
+
+    /// "2h 28m", or nil when the runtime is unknown.
+    var runtimeText: String? { detail.runtime.map(Self.formatRuntime(minutes:)) }
+
+    var genresText: String { detail.genres.map(\.name).joined(separator: ", ") }
+
+    var yearText: String? { detail.year }
+
+    /// 148 -> "2h 28m", 120 -> "2h", 45 -> "45m", 0 -> "0m".
+    static func formatRuntime(minutes: Int) -> String {
+        let minutes = max(minutes, 0)
+        let hours = minutes / 60
+        let rest = minutes % 60
+        if hours == 0 { return "\(rest)m" }
+        if rest == 0 { return "\(hours)h" }
+        return "\(hours)h \(rest)m"
+    }
+
+    /// Top cast by `order`; members without an order go last.
+    private static func topCast(_ cast: [CastMember]) -> [CastMember] {
+        let sorted = cast.enumerated().sorted { a, b in
+            let (x, y) = (a.element.order ?? .max, b.element.order ?? .max)
+            return x == y ? a.offset < b.offset : x < y
+        }
+        return Array(sorted.map(\.element).prefix(maxCastCount))
+    }
+}
+
+@MainActor
+@Observable
+final class MovieDetailViewModel {
+    private(set) var state: ViewState<MovieDetailContent> = .idle
+
+    let movieID: Int
+    @ObservationIgnored private let service: any MovieService
+
+    init(movieID: Int, service: any MovieService) {
+        self.movieID = movieID
+        self.service = service
+    }
+
+    /// Loads detail and credits concurrently. Either request failing gives `.failed`.
+    func load() async {
+        if case .loading = state { return }
+        state = .loading
+        do {
+            let id = movieID
+            let service = service
+            async let detail = service.detail(id: id)
+            async let credits = service.credits(id: id)
+            let content = try await MovieDetailContent(detail: detail, credits: credits)
+            state = .loaded(content)
+        } catch is CancellationError {
+            state = .idle
+        } catch {
+            state = .failed(MovieListViewModel.message(for: error))
+        }
+    }
+}
