@@ -0,0 +1,71 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("MovieDetailViewModel")
+struct MovieDetailViewModelTests {
+    @Test func successfulLoad() async throws {
+        let service = MockMovieService()
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        #expect(vm.state == .idle)
+        await vm.load()
+        guard case .loaded(let content) = vm.state else { Issue.record("got \(vm.state)"); return }
+        #expect(content.detail.id == 27205)
+        #expect(!content.cast.isEmpty)
+        #expect(content.cast.count <= 10)
+        let orders = content.cast.compactMap(\.order)
+        #expect(orders == orders.sorted())
+        #expect(!content.directors.isEmpty)
+        #expect(content.directors.allSatisfy { $0.job == "Director" })
+        let runtime = try #require(content.detail.runtime)
+        #expect(content.runtimeText == MovieDetailContent.formatRuntime(minutes: runtime))
+        #expect(content.genresText == content.detail.genres.map(\.name).joined(separator: ", "))
+        let calls = await service.calls
+        #expect(calls.contains(.detail(id: 27205)))
+        #expect(calls.contains(.credits(id: 27205)))
+    }
+
+    @Test func failureGivesFailed() async {
+        let service = MockMovieService(error: APIError.httpStatus(code: 401, message: nil))
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        await vm.load()
+        #expect(vm.state == .failed("Invalid API key."))
+    }
+
+    @Test func creditsFailureAloneGivesFailed() async {
+        let vm = MovieDetailViewModel(movieID: 27205, service: PartialFailingService(failDetail: false))
+        await vm.load()
+        #expect(vm.state == .failed("Couldn't reach the server. Check your connection."))
+    }
+
+    @Test func detailFailureAloneGivesFailed() async {
+        let vm = MovieDetailViewModel(movieID: 27205, service: PartialFailingService(failDetail: true))
+        await vm.load()
+        #expect(vm.state == .failed("Couldn't reach the server. Check your connection."))
+    }
+
+    @Test(arguments: [(148, "2h 28m"), (120, "2h"), (45, "45m"), (0, "0m"), (60, "1h"), (61, "1h 1m"), (59, "59m")])
+    func runtimeFormatting(minutes: Int, expected: String) {
+        #expect(MovieDetailContent.formatRuntime(minutes: minutes) == expected)
+    }
+}
+
+/// Fails exactly one of the two requests; the other returns fixture data.
+private struct PartialFailingService: MovieService {
+    let failDetail: Bool
+    private struct Unused: Error {}
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> { throw Unused() }
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> { throw Unused() }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        if failDetail { throw APIError.transport(URLError(.notConnectedToInternet)) }
+        return try JSONDecoder.tmdb.decode(MovieDetail.self, from: Fixture.data("movie_detail_27205"))
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        if !failDetail { throw APIError.transport(URLError(.notConnectedToInternet)) }
+        return try JSONDecoder.tmdb.decode(Credits.self, from: Fixture.data("movie_credits_27205"))
+    }
+}
