+import SwiftUI
+
+struct MovieDetailView: View {
+    @State private var viewModel: MovieDetailViewModel
+    var imageURLBuilder = ImageURLBuilder()
+
+    init(viewModel: MovieDetailViewModel) {
+        _viewModel = State(initialValue: viewModel)
+    }
+
+    var body: some View {
+        content
+            .navigationTitle("Details")
+            #if os(iOS)
+            .navigationBarTitleDisplayMode(.inline)
+            #endif
+            .task { await viewModel.load() }
+    }
+
+    @ViewBuilder
+    private var content: some View {
+        switch viewModel.state {
+        case .idle, .loading:
+            ProgressView().frame(maxWidth: .infinity, maxHeight: .infinity)
+        case .empty:
+            message("No details available.", retry: false)
+        case .failed(let text):
+            message(text, retry: true)
+        case .loaded(let content):
+            ScrollView { detail(content) }
+        }
+    }
+
+    private func detail(_ content: MovieDetailContent) -> some View {
+        let movie = content.detail
+        let info = [content.year, content.runtimeText].compactMap { $0 }.joined(separator: " · ")
+        return VStack(alignment: .leading, spacing: 16) {
+            backdrop(movie)
+            HStack(alignment: .top, spacing: 12) {
+                poster(movie)
+                VStack(alignment: .leading, spacing: 6) {
+                    Text(movie.title).font(.title2.bold())
+                    if let tagline = movie.tagline, !tagline.isEmpty {
+                        Text(tagline).font(.subheadline).italic().foregroundStyle(.secondary)
+                    }
+                    Label(movie.ratingText, systemImage: "star.fill").foregroundStyle(.orange)
+                    if !info.isEmpty { Text(info).font(.subheadline) }
+                    if !content.genresText.isEmpty {
+                        Text(content.genresText).font(.subheadline).foregroundStyle(.secondary)
+                    }
+                }
+            }
+            .padding(.horizontal)
+
+            if !movie.overview.isEmpty {
+                section("Overview") { Text(movie.overview) }
+            }
+            if !content.directors.isEmpty {
+                section(content.directors.count > 1 ? "Directors" : "Director") {
+                    Text(content.directors.map(\.name).joined(separator: ", "))
+                }
+            }
+            if !content.cast.isEmpty {
+                VStack(alignment: .leading, spacing: 8) {
+                    Text("Cast").font(.headline).padding(.horizontal)
+                    ScrollView(.horizontal, showsIndicators: false) {
+                        LazyHStack(alignment: .top, spacing: 12) {
+                            ForEach(content.cast) { castCard($0) }
+                        }
+                        .padding(.horizontal)
+                    }
+                }
+            }
+        }
+        .padding(.bottom)
+    }
+
+    private func backdrop(_ movie: MovieDetail) -> some View {
+        AsyncImage(url: imageURLBuilder.url(path: movie.backdropPath, size: .w780)) { image in
+            image.resizable().scaledToFill()
+        } placeholder: {
+            Rectangle().fill(.quaternary)
+        }
+        .frame(maxWidth: .infinity)
+        .frame(height: 200)
+        .clipped()
+    }
+
+    private func poster(_ movie: MovieDetail) -> some View {
+        AsyncImage(url: imageURLBuilder.url(path: movie.posterPath, size: .w342)) { image in
+            image.resizable().scaledToFill()
+        } placeholder: {
+            ZStack {
+                Rectangle().fill(.quaternary)
+                Image(systemName: "film").foregroundStyle(.secondary)
+            }
+        }
+        .frame(width: 100, height: 150)
+        .clipShape(RoundedRectangle(cornerRadius: 8))
+    }
+
+    private func castCard(_ member: CastMember) -> some View {
+        VStack(spacing: 4) {
+            AsyncImage(url: imageURLBuilder.url(path: member.profilePath, size: .w185)) { image in
+                image.resizable().scaledToFill()
+            } placeholder: {
+                ZStack {
+                    Rectangle().fill(.quaternary)
+                    Image(systemName: "person.fill").foregroundStyle(.secondary)
+                }
+            }
+            .frame(width: 80, height: 80)
+            .clipShape(Circle())
+            Text(member.name).font(.caption.bold()).lineLimit(2)
+            if let character = member.character, !character.isEmpty {
+                Text(character).font(.caption2).foregroundStyle(.secondary).lineLimit(2)
+            }
+        }
+        .multilineTextAlignment(.center)
+        .frame(width: 90)
+        .accessibilityElement(children: .combine)
+    }
+
+    private func section<Body: View>(_ title: String, @ViewBuilder body: () -> Body) -> some View {
+        VStack(alignment: .leading, spacing: 4) {
+            Text(title).font(.headline)
+            body()
+        }
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .padding(.horizontal)
+    }
+
+    private func message(_ text: String, retry: Bool) -> some View {
+        VStack(spacing: 12) {
+            Text(text).multilineTextAlignment(.center).foregroundStyle(.secondary)
+            if retry {
+                Button("Try Again") { Task { await viewModel.load() } }
+                    .buttonStyle(.borderedProminent)
+            }
+        }
+        .padding()
+        .frame(maxWidth: .infinity, maxHeight: .infinity)
+    }
+}
