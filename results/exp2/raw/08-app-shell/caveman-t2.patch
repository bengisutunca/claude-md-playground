+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("AppDependencies")
+struct AppDependenciesTests {
+    @Test func previewServesMockDataWithoutNetwork() async throws {
+        let deps = AppDependencies.preview
+        let popular = try await deps.movieService.popular(page: 1)
+        #expect(!popular.results.isEmpty)
+        let found = try await deps.movieService.search(query: "incep", page: 1)
+        #expect(found.results.map(\.title) == ["Inception"])
+        let detail = try await deps.movieService.detail(id: 27205)
+        #expect(detail.id == 27205)
+        let credits = try await deps.movieService.credits(id: 27205)
+        #expect(credits.crew.contains { $0.job == "Director" })
+    }
+
+    @Test func previewViewModelsLoad() async {
+        let deps = AppDependencies.preview
+        let list = deps.makeMovieListViewModel()
+        await list.load()
+        guard case .loaded(let movies) = list.state else {
+            Issue.record("expected loaded, got \(list.state)")
+            return
+        }
+        #expect(!movies.isEmpty)
+        #expect(deps.favorites.favorites.isEmpty)
+    }
+
+    @Test func injectedFavoritesStoreIsUsed() {
+        let movie = Movie(id: 1, title: "A")
+        let store = InMemoryFavoritesStore()
+        let deps = AppDependencies(movieService: PreviewMovieService(), favoritesStore: store)
+        deps.favorites.toggle(movie)
+        #expect(store.load() == [movie])
+    }
+
+    @Test func liveWithoutAPIKeyFailsWithMissingKey() async {
+        guard ProcessInfo.processInfo.environment["TMDB_API_KEY"] == nil else { return }
+        let deps = AppDependencies.live()
+        let list = deps.makeMovieListViewModel()
+        await list.load()
+        #expect(list.state == .failed("The TMDB API key is missing."))
+    }
