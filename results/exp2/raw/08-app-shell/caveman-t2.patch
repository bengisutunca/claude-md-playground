@@ -0,0 +1,60 @@
+import Foundation
+
+/// In-memory store for previews: nothing touches `UserDefaults`.
+final class InMemoryFavoritesStore: FavoritesStore {
+    private var movies: [Movie]
+
+    init(movies: [Movie] = []) { self.movies = movies }
+
+    func load() -> [Movie] { movies }
+    func save(_ movies: [Movie]) { self.movies = movies }
+}
+
+/// Serves canned data. Never touches the network.
+struct PreviewMovieService: MovieService {
+    static let movies: [Movie] = [
+        Movie(id: 27205, title: "Inception", overview: "A thief enters dreams.",
+              releaseDate: TMDBDate.parse("2010-07-15"), voteAverage: 8.4, voteCount: 35000,
+              genreIDs: [28, 878]),
+        Movie(id: 496243, title: "Parasite", overview: "Two families collide.",
+              releaseDate: TMDBDate.parse("2019-05-30"), voteAverage: 8.5, voteCount: 17000,
+              genreIDs: [35, 53]),
+        Movie(id: 129, title: "Spirited Away", overview: "A girl enters a spirit world.",
+              releaseDate: TMDBDate.parse("2001-07-20"), voteAverage: 8.5, voteCount: 16000,
+              genreIDs: [16])
+    ]
+
+    private static let detailJSON = """
+    {"id": 27205, "title": "Inception", "overview": "A thief enters dreams.",
+     "release_date": "2010-07-15", "vote_average": 8.4, "vote_count": 35000, "runtime": 148,
+     "tagline": "Your mind is the scene of the crime.", "status": "Released",
+     "genres": [{"id": 28, "name": "Action"}, {"id": 878, "name": "Science Fiction"}]}
+    """
+
+    private static let creditsJSON = """
+    {"id": 27205,
+     "cast": [{"id": 6193, "name": "Leonardo DiCaprio", "character": "Cobb", "order": 0}],
+     "crew": [{"id": 525, "name": "Christopher Nolan", "job": "Director", "department": "Directing"}]}
+    """
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        Self.page(Self.movies)
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        let needle = query.lowercased()
+        return Self.page(Self.movies.filter { $0.title.lowercased().contains(needle) })
+    }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        try JSONDecoder.tmdb.decode(MovieDetail.self, from: Data(Self.detailJSON.utf8))
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        try JSONDecoder.tmdb.decode(Credits.self, from: Data(Self.creditsJSON.utf8))
+    }
+
+    private static func page(_ results: [Movie]) -> PagedResponse<Movie> {
+        PagedResponse(page: 1, results: results, totalPages: 1, totalResults: results.count)
+    }
+}
