--- /dev/null
+++ b/Sources/TMDBApp/Services/PreviewMovieService.swift
@@ -0,0 +1,55 @@
+import Foundation
+
+/// Serves canned data without network access; backs `AppDependencies.preview`.
+struct PreviewMovieService: MovieService {
+    private static let sample: [(id: Int, title: String, overview: String, date: String, rating: Double)] = [
+        (27205, "Inception", "A thief who steals corporate secrets through dream-sharing technology.", "2010-07-15", 8.4),
+        (157336, "Interstellar", "Explorers travel through a wormhole in space.", "2014-11-05", 8.4),
+        (155, "The Dark Knight", "Batman faces the Joker, a criminal mastermind.", "2008-07-16", 8.5)
+    ]
+
+    static let movies: [Movie] = sample.map {
+        Movie(id: $0.id, title: $0.title, overview: $0.overview,
+              releaseDate: TMDBDate.parse($0.date), voteAverage: $0.rating, voteCount: 1000)
+    }
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        try Self.decode(Self.pagePayload(Self.sample))
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        try Self.decode(Self.pagePayload(Self.sample.filter { $0.title.range(of: query, options: .caseInsensitive) != nil }))
+    }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        let item = Self.sample.first { $0.id == id } ?? Self.sample[0]
+        var json = Self.movieJSON(item)
+        json["runtime"] = 148
+        json["tagline"] = "Preview tagline"
+        json["genres"] = [["id": 28, "name": "Action"], ["id": 878, "name": "Science Fiction"]]
+        json["status"] = "Released"
+        return try Self.decode(json)
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        let json: [String: Any] = [
+            "id": id,
+            "cast": [["id": 1, "name": "Leonardo DiCaprio", "character": "Cobb", "order": 0]],
+            "crew": [["id": 2, "name": "Christopher Nolan", "job": "Director", "department": "Directing"]]
+        ]
+        return try Self.decode(json)
+    }
+
+    private static func movieJSON(_ item: (id: Int, title: String, overview: String, date: String, rating: Double)) -> [String: Any] {
+        ["id": item.id, "title": item.title, "overview": item.overview,
+         "release_date": item.date, "vote_average": item.rating, "vote_count": 1000]
+    }
+
+    private static func pagePayload(_ items: [(id: Int, title: String, overview: String, date: String, rating: Double)]) -> [String: Any] {
+        ["page": 1, "results": items.map(movieJSON), "total_pages": 1, "total_results": items.count]
+    }
+
+    private static func decode<T: Decodable>(_ json: [String: Any]) throws -> T {
+        try JSONDecoder.tmdb.decode(T.self, from: JSONSerialization.data(withJSONObject: json))
+    }
+}
