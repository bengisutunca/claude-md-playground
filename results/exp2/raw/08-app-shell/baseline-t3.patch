--- /dev/null
+++ b/Tests/TMDBAppTests/AppDependenciesTests.swift
@@ -0,0 +1,46 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("AppDependencies")
+struct AppDependenciesTests {
+    @Test func previewServesMockDataWithoutNetwork() async throws {
+        let deps = AppDependencies.preview
+        let popular = try await deps.movieService.popular(page: 1)
+        #expect(!popular.results.isEmpty)
+        let detail = try await deps.movieService.detail(id: 27205)
+        #expect(detail.id == 27205)
+        let credits = try await deps.movieService.credits(id: 27205)
+        #expect(credits.crew.contains { $0.job == "Director" })
+    }
+
+    @Test func previewViewModelsLoad() async {
+        let deps = AppDependencies.preview
+        let list = deps.makeMovieListViewModel()
+        await list.load()
+        if case .loaded(let movies) = list.state { #expect(!movies.isEmpty) } else { Issue.record("not loaded") }
+    }
+
+    @Test func initInjectsServiceAndFavoritesStore() async throws {
+        let store = InMemoryFavoritesStore(movies: [Movie(id: 1, title: "A")])
+        let deps = AppDependencies(movieService: MockMovieService(), favoritesStore: store)
+        #expect(deps.favorites.favorites.map(\.id) == [1])
+        deps.favorites.toggle(Movie(id: 2, title: "B"))
+        #expect(store.load().map(\.id) == [1, 2])
+    }
+
+    @Test func liveDoesNotCrashAndReportsMissingKey() async {
+        // Only meaningful when no key is configured; skip the assertion otherwise to avoid real network.
+        guard (try? APIConfiguration.load()) == nil else { return }
+        let deps = AppDependencies.live()
+        do {
+            _ = try await deps.movieService.popular(page: 1)
+            Issue.record("expected failure")
+        } catch let error as APIError {
+            if case .missingAPIKey = error {} else { Issue.record("wrong error \(error)") }
+        } catch {
+            Issue.record("wrong error \(error)")
+        }
+    }
+}
