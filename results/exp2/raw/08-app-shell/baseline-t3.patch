+import SwiftUI
+
+struct RootView: View {
+    private let dependencies: AppDependencies
+
+    init(dependencies: AppDependencies) {
+        self.dependencies = dependencies
+    }
+
+    var body: some View {
+        TabView {
+            NavigationStack {
+                MovieListView(viewModel: dependencies.makeMovieListViewModel(), dependencies: dependencies)
+            }
+            .tabItem { Label("Popular", systemImage: "flame") }
+
+            NavigationStack {
+                SearchView(viewModel: dependencies.makeSearchViewModel(), dependencies: dependencies)
+            }
+            .tabItem { Label("Search", systemImage: "magnifyingglass") }
+
+            NavigationStack {
+                FavoritesView(dependencies: dependencies)
+            }
+            .tabItem { Label("Favorites", systemImage: "heart") }
+        }
+        .environment(dependencies.favorites)
+    }
+}
+
+extension View {
+    /// Pushes `MovieDetailView` for any `Movie` value; shared by every tab.
+    func movieDetailDestination(_ dependencies: AppDependencies) -> some View {
+        navigationDestination(for: Movie.self) { movie in
+            MovieDetailView(viewModel: dependencies.makeMovieDetailViewModel(movieID: movie.id))
+        }
+    }
+}
+
+#Preview {
+    RootView(dependencies: .preview)
+}
