@@ -0,0 +1,59 @@
+import Foundation
+
+/// In-memory `MovieService` with canned data for SwiftUI previews. Never touches the network.
+struct PreviewMovieService: MovieService {
+    static let movies: [Movie] = [
+        Movie(id: 27205, title: "Inception",
+              overview: "A thief who steals secrets through shared dreams is offered one last job.",
+              posterPath: "/inception.jpg", backdropPath: "/inception_bg.jpg",
+              releaseDate: TMDBDate.parse("2010-07-15"), voteAverage: 8.4, voteCount: 37000,
+              genreIDs: [28, 878, 12]),
+        Movie(id: 157336, title: "Interstellar",
+              overview: "A team of explorers travels through a wormhole in space.",
+              posterPath: "/interstellar.jpg",
+              releaseDate: TMDBDate.parse("2014-11-05"), voteAverage: 8.6, voteCount: 34000,
+              genreIDs: [12, 18, 878])
+    ]
+
+    private static let detailJSON = """
+    {"id": 27205, "title": "Inception",
+     "overview": "A thief who steals secrets through shared dreams is offered one last job.",
+     "poster_path": "/inception.jpg", "backdrop_path": "/inception_bg.jpg", "release_date": "2010-07-15",
+     "vote_average": 8.4, "vote_count": 37000, "runtime": 148, "tagline": "Your mind is the scene of the crime.",
+     "genres": [{"id": 28, "name": "Action"}, {"id": 878, "name": "Science Fiction"}], "status": "Released"}
+    """
+
+    private static let creditsJSON = """
+    {"id": 27205,
+     "cast": [{"id": 6193, "name": "Leonardo DiCaprio", "character": "Cobb", "order": 0, "profile_path": null}],
+     "crew": [{"id": 525, "name": "Christopher Nolan", "job": "Director", "department": "Directing",
+               "profile_path": null}]}
+    """
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        PagedResponse(page: 1, results: Self.movies, totalPages: 1, totalResults: Self.movies.count)
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        let hits = Self.movies.filter { $0.title.localizedCaseInsensitiveContains(query) }
+        return PagedResponse(page: 1, results: hits, totalPages: 1, totalResults: hits.count)
+    }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        try JSONDecoder.tmdb.decode(MovieDetail.self, from: Data(Self.detailJSON.utf8))
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        try JSONDecoder.tmdb.decode(Credits.self, from: Data(Self.creditsJSON.utf8))
+    }
+}
+
+/// `FavoritesStore` that keeps favorites in memory only (used by previews).
+final class InMemoryFavoritesStore: FavoritesStore {
+    private var movies: [Movie]
+
+    init(movies: [Movie] = []) { self.movies = movies }
+
+    func load() -> [Movie] { movies }
+    func save(_ movies: [Movie]) { self.movies = movies }
+}
