diff --git a/Sources/TMDBApp/Networking/APIError.swift b/Sources/TMDBApp/Networking/APIError.swift
index d7dd306..add0d03 100644
--- a/Sources/TMDBApp/Networking/APIError.swift
+++ b/Sources/TMDBApp/Networking/APIError.swift
@@ -8,6 +8,26 @@ enum APIError: Error {
     case missingAPIKey
 }
 
+extension Error {
+    /// User-facing text for any error thrown by the service layer.
+    var userMessage: String {
+        guard let apiError = self as? APIError else {
+            return "Something went wrong. Please try again."
+        }
+        switch apiError {
+        case .missingAPIKey:
+            return "The TMDB API key is missing. Set \(APIConfiguration.keyName) and relaunch."
+        case .httpStatus(let code, let message):
+            if code == 401 { return "Invalid API key." }
+            return message ?? "The server returned an error (\(code))."
+        case .transport:
+            return "Couldn't reach the server. Check your connection."
+        case .decoding, .invalidResponse:
+            return "Received an unexpected response from the server."
+        }
+    }
+}
+
 /// TMDB error body, e.g. `{"status_code": 7, "status_message": "...", "success": false}`.
 struct TMDBErrorBody: Decodable {
     let statusMessage: String
