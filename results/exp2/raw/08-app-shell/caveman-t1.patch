+import Foundation
+
+/// Offline `MovieService` with hard-coded sample data, for SwiftUI previews.
+/// Poster paths are nil so previews never fetch images.
+struct PreviewMovieService: MovieService {
+    static let movies: [Movie] = [
+        Movie(id: 27205, title: "Inception",
+              overview: "A thief who steals secrets through dreams is offered a final job.",
+              releaseDate: TMDBDate.parse("2010-07-15"), voteAverage: 8.4, voteCount: 36000,
+              genreIDs: [28, 878]),
+        Movie(id: 157336, title: "Interstellar",
+              overview: "Explorers travel through a wormhole in search of a new home for humanity.",
+              releaseDate: TMDBDate.parse("2014-11-05"), voteAverage: 8.5, voteCount: 34000,
+              genreIDs: [12, 878]),
+        Movie(id: 155, title: "The Dark Knight",
+              overview: "Batman faces the Joker, a criminal mastermind who plunges Gotham into chaos.",
+              releaseDate: TMDBDate.parse("2008-07-16"), voteAverage: 8.5, voteCount: 32000,
+              genreIDs: [18, 28])
+    ]
+
+    private static let detail = MovieDetail(
+        movie: movies[0], runtime: 148, tagline: "Your mind is the scene of the crime.",
+        genres: [Genre(id: 28, name: "Action"), Genre(id: 878, name: "Science Fiction")]
+    )
+
+    private static let credits = Credits(
+        id: 27205,
+        cast: [
+            CastMember(id: 6193, name: "Leonardo DiCaprio", character: "Cobb", order: 0, profilePath: nil),
+            CastMember(id: 24045, name: "Joseph Gordon-Levitt", character: "Arthur", order: 1, profilePath: nil)
+        ],
+        crew: [CrewMember(id: 525, name: "Christopher Nolan", job: "Director", department: "Directing", profilePath: nil)]
+    )
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        PagedResponse(page: 1, results: Self.movies, totalPages: 1, totalResults: Self.movies.count)
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        let hits = Self.movies.filter { $0.title.range(of: query, options: .caseInsensitive) != nil }
+        return PagedResponse(page: 1, results: hits, totalPages: 1, totalResults: hits.count)
+    }
+
+    func detail(id: Int) async throws -> MovieDetail { Self.detail }
+
+    func credits(id: Int) async throws -> Credits { Self.credits }
+}
+
+/// `FavoritesStore` that keeps movies in memory.
+final class InMemoryFavoritesStore: FavoritesStore {
+    private var movies: [Movie]
+
+    init(movies: [Movie] = []) { self.movies = movies }
+
+    func load() -> [Movie] { movies }
+    func save(_ movies: [Movie]) { self.movies = movies }
+}
