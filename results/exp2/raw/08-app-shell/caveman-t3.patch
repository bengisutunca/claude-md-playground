--- /dev/null
+++ b/Tests/TMDBAppTests/AppDependenciesTests.swift
@@ -0,0 +1,36 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("AppDependencies")
+struct AppDependenciesTests {
+    @Test func previewServesMockDataOffline() async throws {
+        let deps = AppDependencies.preview
+        let page = try await deps.movieService.popular(page: 1)
+        #expect(!page.results.isEmpty)
+        let hits = try await deps.movieService.search(query: "incep", page: 1)
+        #expect(hits.results.map(\.title) == ["Inception"])
+        #expect(try await deps.movieService.detail(id: 27205).title == "Inception")
+        #expect(try await deps.movieService.credits(id: 27205).crew.first?.job == "Director")
+    }
+
+    @Test func previewViewModelsLoad() async {
+        let deps = AppDependencies.preview
+        let list = deps.makeMovieListViewModel()
+        await list.load()
+        #expect(list.state == .loaded(PreviewMovieService.movies))
+    }
+
+    @Test func liveWithoutAPIKeyDoesNotCrashAndReportsMissingKey() async {
+        // Skip when the developer's environment actually has a key (would hit the network).
+        guard (try? APIConfiguration.load(environment: [:], bundle: Bundle(for: Probe.self))) == nil,
+              ProcessInfo.processInfo.environment[APIConfiguration.keyName] == nil else { return }
+        let deps = AppDependencies.live()
+        let list = deps.makeMovieListViewModel()
+        await list.load()
+        #expect(list.state == .failed("The TMDB API key is missing."))
+    }
+
+    private final class Probe {}
+}
