@@ -0,0 +1,42 @@
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("AppDependencies")
+struct AppDependenciesTests {
+    @Test func previewServesMockDataOffline() async throws {
+        let deps = AppDependencies.preview
+        let vm = deps.makeMovieListViewModel()
+        await vm.load()
+        guard case .loaded(let movies) = vm.state else {
+            Issue.record("expected loaded, got \(vm.state)")
+            return
+        }
+        #expect(!movies.isEmpty)
+        let detail = try await deps.movieService.detail(id: movies[0].id)
+        #expect(detail.id == movies[0].id)
+        _ = try await deps.movieService.credits(id: movies[0].id)
+    }
+
+    @Test func previewSearchFiltersByTitle() async throws {
+        let response = try await AppDependencies.preview.movieService.search(query: "incep", page: 1)
+        #expect(response.results.map(\.title) == ["Inception"])
+    }
+
+    @Test func liveWithoutAPIKeyFailsWithMissingKey() async throws {
+        // No API key configured in the test environment; skip if the developer has one set.
+        guard (try? APIConfiguration.load()) == nil else { return }
+        let deps = AppDependencies.live()
+        await #expect(throws: APIError.self) { _ = try await deps.movieService.popular(page: 1) }
+        let vm = deps.makeMovieListViewModel()
+        await vm.load()
+        #expect(vm.state == .failed("The TMDB API key is missing."))
+    }
+
+    @Test func factoriesBuildFreshViewModels() {
+        let deps = AppDependencies(movieService: PreviewMovieService(), favoritesStore: InMemoryFavoritesStore())
+        #expect(deps.favorites.favorites.isEmpty)
+        #expect(deps.makeMovieListViewModel() !== deps.makeMovieListViewModel())
+        #expect(deps.makeSearchViewModel() !== deps.makeSearchViewModel())
+    }
+}
