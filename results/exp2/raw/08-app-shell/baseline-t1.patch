@@ -0,0 +1,43 @@
+import Foundation
+
+/// Offline `MovieService` serving canned data for SwiftUI previews. Never touches the network.
+struct PreviewMovieService: MovieService {
+    static let movies: [Movie] = [
+        Movie(id: 27205, title: "Inception", overview: "A thief who steals secrets through dreams.",
+              releaseDate: TMDBDate.parse("2010-07-15"), voteAverage: 8.4, voteCount: 35000),
+        Movie(id: 157336, title: "Interstellar", overview: "Explorers travel through a wormhole.",
+              releaseDate: TMDBDate.parse("2014-11-05"), voteAverage: 8.5, voteCount: 33000),
+        Movie(id: 155, title: "The Dark Knight", overview: "Batman faces the Joker.",
+              releaseDate: TMDBDate.parse("2008-07-16"), voteAverage: 8.5, voteCount: 31000),
+    ]
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        PagedResponse(page: 1, results: Self.movies, totalPages: 1, totalResults: Self.movies.count)
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        let hits = Self.movies.filter { $0.title.range(of: query, options: .caseInsensitive) != nil }
+        return PagedResponse(page: 1, results: hits, totalPages: 1, totalResults: hits.count)
+    }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        let movie = Self.movies.first { $0.id == id } ?? Self.movies[0]
+        let json = """
+        {"id": \(movie.id), "title": "\(movie.title)", "overview": "\(movie.overview)",
+         "vote_average": \(movie.voteAverage), "vote_count": \(movie.voteCount),
+         "release_date": "\(movie.releaseDate.map(TMDBDate.string(from:)) ?? "")",
+         "runtime": 148, "tagline": "Preview tagline", "status": "Released",
+         "genres": [{"id": 28, "name": "Action"}, {"id": 878, "name": "Science Fiction"}]}
+        """
+        return try JSONDecoder.tmdb.decode(MovieDetail.self, from: Data(json.utf8))
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        let json = """
+        {"id": \(id),
+         "cast": [{"id": 6193, "name": "Leonardo DiCaprio", "character": "Cobb", "order": 0}],
+         "crew": [{"id": 525, "name": "Christopher Nolan", "job": "Director", "department": "Directing"}]}
+        """
+        return try JSONDecoder.tmdb.decode(Credits.self, from: Data(json.utf8))
+    }
+}
