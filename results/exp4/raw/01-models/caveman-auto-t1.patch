diff --git a/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift b/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift
new file mode 100644
index 0000000..a9b8055
--- /dev/null
+++ b/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift
@@ -0,0 +1,38 @@
+import Foundation
+
+extension JSONDecoder {
+    /// Decoder for every TMDB response. Returns a fresh instance each time
+    /// because `JSONDecoder` is a mutable, non-`Sendable` class.
+    public static var tmdb: JSONDecoder {
+        let decoder = JSONDecoder()
+        decoder.keyDecodingStrategy = .convertFromSnakeCase
+        return decoder
+    }
+}
+
+/// TMDB calendar dates (`"yyyy-MM-dd"`, interpreted in UTC).
+enum TMDBDate {
+    static let format = Date.ISO8601FormatStyle(timeZone: .gmt).year().month().day()
+    static let yearFormat = Date.ISO8601FormatStyle(timeZone: .gmt).year()
+
+    static func year(of date: Date?) -> String? {
+        date?.formatted(yearFormat)
+    }
+}
+
+extension KeyedDecodingContainer {
+    /// Decodes a TMDB date. A missing key, `null`, or `""` (TMDB's "unknown") decodes as `nil`;
+    /// any other value that is not `yyyy-MM-dd` is a decoding error.
+    func decodeTMDBDate(forKey key: Key) throws -> Date? {
+        guard let string = try decodeIfPresent(String.self, forKey: key), !string.isEmpty else {
+            return nil
+        }
+        do {
+            return try TMDBDate.format.parse(string)
+        } catch {
+            throw DecodingError.dataCorruptedError(
+                forKey: key, in: self,
+                debugDescription: "Expected a yyyy-MM-dd date, got \"\(string)\"")
+        }
+    }
+}
