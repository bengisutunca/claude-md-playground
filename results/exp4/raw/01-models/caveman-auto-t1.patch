+import Foundation
+
+/// Cast and crew from `GET /movie/{id}/credits`.
+public struct Credits: Identifiable, Hashable, Sendable, Decodable {
+    /// The movie id.
+    public let id: Int
+    public let cast: [CastMember]
+    public let crew: [CrewMember]
+}
+
+public struct CastMember: Identifiable, Hashable, Sendable, Decodable {
+    /// TMDB person id.
+    public let id: Int
+    public let name: String
+    public let character: String
+    /// Billing order (0 = top billed).
+    public let order: Int
+    public let profilePath: String?
+}
+
+public struct CrewMember: Identifiable, Hashable, Sendable, Decodable {
+    /// TMDB person id. One person can appear several times with different jobs,
+    /// so key lists by `id` + `job` rather than `id` alone.
+    public let id: Int
+    public let name: String
+    public let job: String
+    public let department: String
+}
