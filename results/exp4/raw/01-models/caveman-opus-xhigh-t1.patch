@@ -0,0 +1,13 @@
+import Foundation
+
+/// One page of a paginated TMDB list (popular, search).
+public struct PagedResponse<T: Decodable>: Decodable {
+    public let page: Int
+    public let results: [T]
+    public let totalPages: Int
+    public let totalResults: Int
+}
+
+extension PagedResponse: Sendable where T: Sendable {}
+extension PagedResponse: Equatable where T: Equatable {}
+extension PagedResponse: Hashable where T: Hashable {}
diff --git a/Tests/TMDBAppTests/ModelDecodingTests.swift b/Tests/TMDBAppTests/ModelDecodingTests.swift
new file mode 100644
index 0000000..b71d063
--- /dev/null
+++ b/Tests/TMDBAppTests/ModelDecodingTests.swift
@@ -0,0 +1,121 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("Model decoding")
+struct ModelDecodingTests {
+    private func decode<T: Decodable>(_ type: T.Type, fixture name: String) throws -> T {
+        try JSONDecoder.tmdb.decode(type, from: Fixture.data(name))
+    }
+
+    /// UTC midnight of a `yyyy-MM-dd` day.
+    private func utcMidnight(_ day: String) throws -> Date {
+        try Date("\(day)T00:00:00Z", strategy: .iso8601)
+    }
+
+    @Test func popularPage1() throws {
+        let page = try decode(PagedResponse<Movie>.self, fixture: "popular_page1")
+        #expect(page.page == 1)
+        #expect(page.totalPages == 2)
+        #expect(page.totalResults == 7)
+        #expect(page.results.map(\.id) == [27205, 157336, 155, 278, 550])
+
+        let inception = try #require(page.results.first)
+        let releaseDate = try utcMidnight("2010-07-15")
+        #expect(inception.title == "Inception")
+        #expect(inception.overview.hasPrefix("A thief who steals secrets"))
+        #expect(inception.posterPath == "/inception.jpg")
+        #expect(inception.backdropPath == "/inception_bg.jpg")
+        #expect(inception.releaseDate == releaseDate)
+        #expect(inception.voteAverage == 8.4)
+        #expect(inception.voteCount == 37000)
+        #expect(inception.genreIDs == [28, 878, 12])
+        #expect(inception.year == "2010")
+        #expect(inception.ratingText == "8.4")
+    }
+
+    @Test func nullImagePathsDecodeAsNil() throws {
+        let movies = try decode(PagedResponse<Movie>.self, fixture: "popular_page1").results
+
+        let shawshank = try #require(movies.first { $0.id == 278 })
+        #expect(shawshank.backdropPath == nil)
+        #expect(shawshank.posterPath == "/shawshank.jpg")
+
+        let fightClub = try #require(movies.first { $0.id == 550 })
+        #expect(fightClub.posterPath == nil)
+        #expect(fightClub.backdropPath == "/fight_club_bg.jpg")
+    }
+
+    @Test func popularPage2WithEmptyReleaseDate() throws {
+        let page = try decode(PagedResponse<Movie>.self, fixture: "popular_page2")
+        #expect(page.page == 2)
+        #expect(page.totalPages == 2)
+        #expect(page.totalResults == 7)
+        #expect(page.results.map(\.id) == [129, 496243])
+
+        let spiritedAway = try #require(page.results.first { $0.id == 129 })
+        #expect(spiritedAway.year == "2001")
+
+        let parasite = try #require(page.results.first { $0.id == 496243 })
+        #expect(parasite.releaseDate == nil)
+        #expect(parasite.year == nil)
+        #expect(parasite.ratingText == "8.5")
+    }
+
+    @Test func movieDetail() throws {
+        let detail = try decode(MovieDetail.self, fixture: "movie_detail_27205")
+        let releaseDate = try utcMidnight("2010-07-15")
+        #expect(detail.id == 27205)
+        #expect(detail.title == "Inception")
+        #expect(detail.posterPath == "/inception.jpg")
+        #expect(detail.backdropPath == "/inception_bg.jpg")
+        #expect(detail.releaseDate == releaseDate)
+        #expect(detail.year == "2010")
+        #expect(detail.voteAverage == 8.4)
+        #expect(detail.voteCount == 37000)
+        #expect(detail.runtime == 148)
+        #expect(detail.tagline == "Your mind is the scene of the crime.")
+        #expect(detail.status == "Released")
+        #expect(detail.genres == [
+            Genre(id: 28, name: "Action"),
+            Genre(id: 878, name: "Science Fiction"),
+            Genre(id: 12, name: "Adventure"),
+        ])
+    }
+
+    @Test func movieCredits() throws {
+        let credits = try decode(Credits.self, fixture: "movie_credits_27205")
+        #expect(credits.id == 27205)
+        #expect(credits.cast.map(\.order) == [0, 1, 2, 3])
+        #expect(credits.cast.first == CastMember(
+            id: 6193, name: "Leonardo DiCaprio", character: "Cobb", order: 0, profilePath: "/dicaprio.jpg"
+        ))
+
+        let elliotPage = try #require(credits.cast.first { $0.id == 27578 })
+        #expect(elliotPage.character == "Ariadne")
+        #expect(elliotPage.profilePath == nil)
+
+        #expect(credits.crew == [
+            CrewMember(id: 525, name: "Christopher Nolan", job: "Director", department: "Directing"),
+        ])
+    }
+
+    @Test func malformedReleaseDateFailsDecoding() {
+        let json = Data(#"""
+        {"id": 1, "title": "X", "overview": "", "poster_path": null, "backdrop_path": null,
+         "release_date": "15/07/2010", "vote_average": 0, "vote_count": 0, "genre_ids": []}
+        """#.utf8)
+        #expect(throws: DecodingError.self) {
+            try JSONDecoder.tmdb.decode(Movie.self, from: json)
+        }
+    }
+
+    @Test(arguments: [(7.0, "7.0"), (8.44, "8.4"), (8.46, "8.5"), (0.0, "0.0")])
+    func ratingTextHasOneDecimal(voteAverage: Double, expected: String) {
+        let movie = Movie(
+            id: 1, title: "X", overview: "", posterPath: nil, backdropPath: nil, releaseDate: nil,
+            voteAverage: voteAverage, voteCount: 0, genreIDs: []
+        )
+        #expect(movie.ratingText == expected)
+    }
+}
