+import Foundation
+
+/// Cast and crew from `/movie/{id}/credits`. `id` is the movie ID.
+public struct Credits: Decodable, Identifiable, Hashable, Sendable {
+    public let id: Int
+    public let cast: [CastMember]
+    public let crew: [CrewMember]
+}
+
+/// `id` is the TMDB person ID.
+public struct CastMember: Decodable, Identifiable, Hashable, Sendable {
+    public let id: Int
+    public let name: String
+    public let character: String
+    /// Billing position, `0` first.
+    public let order: Int
+    public let profilePath: String?
+}
+
+/// `id` is the TMDB person ID, so one person with several jobs appears once per job with the same `id`.
+public struct CrewMember: Decodable, Identifiable, Hashable, Sendable {
+    public let id: Int
+    public let name: String
+    public let job: String
+    public let department: String
+}
