diff --git a/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift b/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift
new file mode 100644
index 0000000..90a0e6a
--- /dev/null
+++ b/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift
@@ -0,0 +1,42 @@
+import Foundation
+
+extension JSONDecoder {
+    /// Decoder for every TMDB response. Returns a new instance on each access so callers never share mutable state.
+    ///
+    /// Dates are not handled by a `dateDecodingStrategy`: TMDB sends `""` for unknown dates, which a strategy
+    /// cannot map to `nil`. Models decode them with `KeyedDecodingContainer.decodeTMDBDate(forKey:)` instead.
+    public static var tmdb: JSONDecoder {
+        let decoder = JSONDecoder()
+        decoder.keyDecodingStrategy = .convertFromSnakeCase
+        return decoder
+    }
+}
+
+/// TMDB calendar dates (`"yyyy-MM-dd"`). Parsed and read back in UTC, so the day and year never
+/// shift with the device time zone.
+enum TMDBDate {
+    private static let fullDate = Date.ISO8601FormatStyle().year().month().day()
+    private static let yearOnly = Date.ISO8601FormatStyle().year()
+
+    static func parse(_ text: String) throws -> Date {
+        try fullDate.parse(text)
+    }
+
+    static func year(of date: Date) -> String {
+        date.formatted(yearOnly)
+    }
+}
+
+extension KeyedDecodingContainer {
+    /// Decodes a TMDB date. A missing key, `null` and `""` decode as `nil`; any other non-`yyyy-MM-dd` value throws.
+    func decodeTMDBDate(forKey key: Key) throws -> Date? {
+        guard let text = try decodeIfPresent(String.self, forKey: key), !text.isEmpty else { return nil }
+        do {
+            return try TMDBDate.parse(text)
+        } catch {
+            throw DecodingError.dataCorruptedError(
+                forKey: key, in: self, debugDescription: "Expected a yyyy-MM-dd date, got \"\(text)\"."
+            )
+        }
+    }
+}
