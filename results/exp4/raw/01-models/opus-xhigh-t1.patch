@@ -0,0 +1,149 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("Models")
+struct ModelTests {
+    /// 2010-07-15T00:00:00Z, Inception's release date in the fixtures.
+    private let inceptionRelease = Date(timeIntervalSince1970: 1_279_152_000)
+
+    // MARK: - Fixtures
+
+    @Test func decodesPopularPage1() throws {
+        let page = try decode(PagedResponse<Movie>.self, fromFixture: "popular_page1")
+
+        #expect(page.page == 1)
+        #expect(page.totalPages == 2)
+        #expect(page.totalResults == 7)
+        #expect(page.results.map(\.id) == [27205, 157336, 155, 278, 550])
+
+        let inception = try #require(page.results.first)
+        #expect(inception.title == "Inception")
+        #expect(inception.overview.hasPrefix("A thief who steals secrets"))
+        #expect(inception.posterPath == "/inception.jpg")
+        #expect(inception.backdropPath == "/inception_bg.jpg")
+        #expect(inception.releaseDate == inceptionRelease)
+        #expect(inception.voteAverage == 8.4)
+        #expect(inception.voteCount == 37000)
+        #expect(inception.genreIDs == [28, 878, 12])
+        #expect(inception.year == "2010")
+        #expect(inception.ratingText == "8.4")
+    }
+
+    @Test func decodesNullImagePathsAsNil() throws {
+        let movies = try decode(PagedResponse<Movie>.self, fromFixture: "popular_page1").results
+
+        let shawshank = try #require(movies.first { $0.id == 278 })
+        #expect(shawshank.backdropPath == nil)
+        #expect(shawshank.posterPath == "/shawshank.jpg")
+
+        let fightClub = try #require(movies.first { $0.id == 550 })
+        #expect(fightClub.posterPath == nil)
+        #expect(fightClub.backdropPath == "/fight_club_bg.jpg")
+    }
+
+    @Test func decodesPopularPage2WithEmptyReleaseDate() throws {
+        let page = try decode(PagedResponse<Movie>.self, fromFixture: "popular_page2")
+
+        #expect(page.page == 2)
+        #expect(page.totalPages == 2)
+        #expect(page.totalResults == 7)
+        #expect(page.results.map(\.id) == [129, 496243])
+
+        let spiritedAway = try #require(page.results.first { $0.id == 129 })
+        #expect(spiritedAway.year == "2001")
+
+        let parasite = try #require(page.results.first { $0.id == 496243 })
+        #expect(parasite.releaseDate == nil)
+        #expect(parasite.year == nil)
+        #expect(parasite.ratingText == "8.5")
+    }
+
+    @Test func decodesMovieDetail() throws {
+        let detail = try decode(MovieDetail.self, fromFixture: "movie_detail_27205")
+
+        #expect(detail.id == 27205)
+        #expect(detail.title == "Inception")
+        #expect(detail.runtime == 148)
+        #expect(detail.tagline == "Your mind is the scene of the crime.")
+        #expect(detail.status == "Released")
+        #expect(detail.genres == [
+            Genre(id: 28, name: "Action"),
+            Genre(id: 878, name: "Science Fiction"),
+            Genre(id: 12, name: "Adventure"),
+        ])
+        #expect(detail.posterPath == "/inception.jpg")
+        #expect(detail.backdropPath == "/inception_bg.jpg")
+        #expect(detail.releaseDate == inceptionRelease)
+        #expect(detail.year == "2010")
+        #expect(detail.voteAverage == 8.4)
+        #expect(detail.voteCount == 37000)
+        #expect(detail.ratingText == "8.4")
+    }
+
+    @Test func decodesCredits() throws {
+        let credits = try decode(Credits.self, fromFixture: "movie_credits_27205")
+
+        #expect(credits.id == 27205)
+        #expect(credits.cast.map(\.name) == ["Leonardo DiCaprio", "Joseph Gordon-Levitt", "Elliot Page", "Tom Hardy"])
+        #expect(credits.cast.map(\.order) == [0, 1, 2, 3])
+        #expect(credits.cast.first == CastMember(
+            id: 6193, name: "Leonardo DiCaprio", character: "Cobb", order: 0, profilePath: "/dicaprio.jpg"
+        ))
+
+        let elliotPage = try #require(credits.cast.first { $0.id == 27578 })
+        #expect(elliotPage.character == "Ariadne")
+        #expect(elliotPage.profilePath == nil)
+
+        #expect(credits.crew == [
+            CrewMember(id: 525, name: "Christopher Nolan", job: "Director", department: "Directing", profilePath: "/nolan.jpg"),
+        ])
+    }
+
+    // MARK: - Release date edge cases
+
+    @Test("Missing, null and empty release_date decode as nil", arguments: [nil, "null", #""""#])
+    func absentReleaseDateIsNil(releaseDateJSON: String?) throws {
+        let movie = try JSONDecoder.tmdb.decode(Movie.self, from: movieJSON(releaseDate: releaseDateJSON))
+
+        #expect(movie.releaseDate == nil)
+        #expect(movie.year == nil)
+        #expect(movie.posterPath == nil)
+        #expect(movie.backdropPath == nil)
+    }
+
+    @Test func malformedReleaseDateThrows() {
+        #expect(throws: DecodingError.self) {
+            try JSONDecoder.tmdb.decode(Movie.self, from: movieJSON(releaseDate: #""15/07/2010""#))
+        }
+    }
+
+    @Test("year matches the date as written at year boundaries",
+          arguments: [("2010-01-01", "2010"), ("1999-12-31", "1999")])
+    func yearAtYearBoundaries(date: String, expectedYear: String) throws {
+        let movie = try JSONDecoder.tmdb.decode(Movie.self, from: movieJSON(releaseDate: #""\#(date)""#))
+
+        #expect(movie.year == expectedYear)
+    }
+
+    // MARK: - Rating
+
+    @Test(arguments: [(8.4, "8.4"), (7.0, "7.0"), (6.789, "6.8"), (0.0, "0.0"), (10.0, "10.0")])
+    func ratingTextHasOneDecimal(voteAverage: Double, expected: String) {
+        #expect(Movie(id: 1, title: "Movie", voteAverage: voteAverage).ratingText == expected)
+        #expect(MovieDetail(id: 1, title: "Movie", voteAverage: voteAverage, status: "Released").ratingText == expected)
+    }
+
+    // MARK: - Helpers
+
+    private func decode<T: Decodable>(_ type: T.Type, fromFixture name: String) throws -> T {
+        try JSONDecoder.tmdb.decode(type, from: Fixture.data(name))
+    }
+
+    /// A minimal TMDB movie with no image paths. `releaseDate` is the raw JSON value; `nil` omits the key.
+    private func movieJSON(releaseDate: String?) -> Data {
+        let releaseDateField = releaseDate.map { #", "release_date": \#($0)"# } ?? ""
+        let json = #"{"id": 1, "title": "Movie", "overview": "", "genre_ids": [], "vote_average": 0, "vote_count": 0\#(releaseDateField)}"#
+        return Data(json.utf8)
+    }
+}
