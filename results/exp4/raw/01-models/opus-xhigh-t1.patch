+import Foundation
+
+/// Full details of one movie (`/movie/{id}`).
+public struct MovieDetail: Identifiable, Hashable, Sendable {
+    public let id: Int
+    public let title: String
+    public let overview: String
+    public let posterPath: String?
+    public let backdropPath: String?
+    /// `nil` when TMDB has no release date (it sends an empty string).
+    public let releaseDate: Date?
+    public let voteAverage: Double
+    public let voteCount: Int
+    /// Minutes; `nil` when TMDB doesn't know it yet.
+    public let runtime: Int?
+    public let tagline: String?
+    public let genres: [Genre]
+    /// e.g. `"Released"`, `"Post Production"`.
+    public let status: String
+
+    public init(
+        id: Int,
+        title: String,
+        overview: String = "",
+        posterPath: String? = nil,
+        backdropPath: String? = nil,
+        releaseDate: Date? = nil,
+        voteAverage: Double = 0,
+        voteCount: Int = 0,
+        runtime: Int? = nil,
+        tagline: String? = nil,
+        genres: [Genre] = [],
+        status: String
+    ) {
+        self.id = id
+        self.title = title
+        self.overview = overview
+        self.posterPath = posterPath
+        self.backdropPath = backdropPath
+        self.releaseDate = releaseDate
+        self.voteAverage = voteAverage
+        self.voteCount = voteCount
+        self.runtime = runtime
+        self.tagline = tagline
+        self.genres = genres
+        self.status = status
+    }
+}
+
+extension MovieDetail {
+    /// Release year, e.g. `"2010"`; `nil` without a release date.
+    public var year: String? {
+        releaseDate.map(TMDBDate.year(of:))
+    }
+
+    /// `voteAverage` with one decimal and a `.` separator in every locale, e.g. `"8.4"`.
+    public var ratingText: String {
+        String(format: "%.1f", voteAverage)
+    }
+}
+
+extension MovieDetail: Decodable {
+    private enum CodingKeys: String, CodingKey {
+        case id, title, overview, posterPath, backdropPath, releaseDate, voteAverage, voteCount
+        case runtime, tagline, genres, status
+    }
+
+    public init(from decoder: any Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        id = try container.decode(Int.self, forKey: .id)
+        title = try container.decode(String.self, forKey: .title)
+        overview = try container.decode(String.self, forKey: .overview)
+        posterPath = try container.decodeIfPresent(String.self, forKey: .posterPath)
+        backdropPath = try container.decodeIfPresent(String.self, forKey: .backdropPath)
+        releaseDate = try container.decodeTMDBDateIfPresent(forKey: .releaseDate)
+        voteAverage = try container.decode(Double.self, forKey: .voteAverage)
+        voteCount = try container.decode(Int.self, forKey: .voteCount)
+        runtime = try container.decodeIfPresent(Int.self, forKey: .runtime)
+        tagline = try container.decodeIfPresent(String.self, forKey: .tagline)
+        genres = try container.decode([Genre].self, forKey: .genres)
+        status = try container.decode(String.self, forKey: .status)
+    }
+}
