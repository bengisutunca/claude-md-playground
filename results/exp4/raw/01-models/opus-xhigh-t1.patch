@@ -0,0 +1,21 @@
+import Foundation
+
+/// One acting credit.
+///
+/// `id` is the TMDB person ID, so it isn't unique within a cast list when one actor plays several roles.
+public struct CastMember: Identifiable, Hashable, Sendable, Decodable {
+    public let id: Int
+    public let name: String
+    public let character: String
+    /// Billing position, `0` first.
+    public let order: Int
+    public let profilePath: String?
+
+    public init(id: Int, name: String, character: String, order: Int, profilePath: String? = nil) {
+        self.id = id
+        self.name = name
+        self.character = character
+        self.order = order
+        self.profilePath = profilePath
+    }
+}
