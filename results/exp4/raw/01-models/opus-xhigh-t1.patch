diff --git a/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift b/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift
new file mode 100644
index 0000000..9174511
--- /dev/null
+++ b/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift
@@ -0,0 +1,12 @@
+import Foundation
+
+extension JSONDecoder {
+    /// A decoder for TMDB responses: snake_case JSON keys map to camelCase properties.
+    ///
+    /// Each access returns a new instance, so no caller can change the configuration for others.
+    public static var tmdb: JSONDecoder {
+        let decoder = JSONDecoder()
+        decoder.keyDecodingStrategy = .convertFromSnakeCase
+        return decoder
+    }
+}
