+import Foundation
+
+/// One crew credit.
+///
+/// `id` is the TMDB person ID, so it isn't unique within a crew list when one person has
+/// several jobs (e.g. Director and Writer).
+public struct CrewMember: Identifiable, Hashable, Sendable, Decodable {
+    public let id: Int
+    public let name: String
+    public let job: String
+    public let department: String
+    public let profilePath: String?
+
+    public init(id: Int, name: String, job: String, department: String, profilePath: String? = nil) {
+        self.id = id
+        self.name = name
+        self.job = job
+        self.department = department
+        self.profilePath = profilePath
+    }
+}
