index 0000000..56b04e7
--- /dev/null
+++ b/Sources/TMDBApp/ViewModels/ViewState.swift
@@ -0,0 +1,18 @@
+/// Loading state of a screen, shared by view models.
+enum ViewState<Value> {
+    case idle
+    case loading
+    case loaded(Value)
+    case empty
+    case failed(String)
+}
+
+extension ViewState: Equatable where Value: Equatable {}
+extension ViewState: Sendable where Value: Sendable {}
+
+extension ViewState {
+    /// The loaded value, or nil in any other state.
+    var value: Value? {
+        if case .loaded(let value) = self { value } else { nil }
+    }
+}
