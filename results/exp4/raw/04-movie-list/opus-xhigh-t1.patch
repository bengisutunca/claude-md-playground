+import SwiftUI
+
+/// One movie in a list: poster thumbnail, title, release year and rating.
+struct MovieRowView: View {
+    let movie: Movie
+    var imageURLBuilder = ImageURLBuilder()
+
+    var body: some View {
+        HStack(spacing: 12) {
+            PosterImage(url: imageURLBuilder.url(path: movie.posterPath, size: .w185))
+                .frame(width: 60, height: 90)
+                .clipShape(RoundedRectangle(cornerRadius: 6))
+
+            VStack(alignment: .leading, spacing: 4) {
+                Text(movie.title)
+                    .font(.headline)
+                    .lineLimit(2)
+
+                if let year = movie.year {
+                    Text(year)
+                        .font(.subheadline)
+                        .foregroundStyle(.secondary)
+                }
+
+                HStack(spacing: 4) {
+                    Image(systemName: "star.fill")
+                        .foregroundStyle(.yellow)
+                    Text(movie.ratingText)
+                }
+                .font(.subheadline)
+                .accessibilityElement(children: .ignore)
+                .accessibilityLabel("Rated \(movie.ratingText) out of 10")
+            }
+        }
+        .padding(.vertical, 4)
+        .accessibilityElement(children: .combine)
+    }
+}
