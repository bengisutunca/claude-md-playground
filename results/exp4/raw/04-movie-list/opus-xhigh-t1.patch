+++ b/Sources/TMDBApp/ViewModels/MovieListViewModel.swift
@@ -0,0 +1,102 @@
+import Foundation
+import Observation
+
+/// Popular movies: loads page 1, appends later pages as the user scrolls, and refreshes from page 1.
+@MainActor
+@Observable
+final class MovieListViewModel {
+    /// TMDB rejects `page` values above 500, whatever `total_pages` says.
+    static let maxPage = 500
+
+    private(set) var state: ViewState<[Movie]> = .idle
+
+    /// User-facing message for the last failed request; nil once a request succeeds.
+    /// A first-page failure with nothing on screen is also reported as `.failed`;
+    /// later failures leave the loaded movies in place.
+    private(set) var errorMessage: String?
+
+    private let service: any MovieService
+    /// Page being requested right now, or nil when no request is in flight.
+    private var loadingPage: Int?
+    private var currentPage = 0
+    private var totalPages = 0
+    private var failedPage: Int?
+    /// Bumped for every request; a response whose token is no longer current is dropped,
+    /// so a page that arrives after a refresh can't be appended to the new list.
+    private var requestToken = 0
+
+    init(service: any MovieService) {
+        self.service = service
+    }
+
+    var movies: [Movie] { state.value ?? [] }
+
+    var isLoadingNextPage: Bool { (loadingPage ?? 0) > 1 }
+
+    var hasMorePages: Bool { currentPage < min(totalPages, Self.maxPage) }
+
+    /// Loads the first page. Does nothing if movies are already loaded or a request is in flight,
+    /// so it is safe to call every time the screen appears.
+    func load() async {
+        guard loadingPage == nil else { return }
+        switch state {
+        case .loaded, .empty: return
+        case .idle, .loading, .failed: break
+        }
+        await fetch(page: 1)
+    }
+
+    /// Reloads from page 1 and replaces the current movies, superseding any request in flight.
+    /// The current movies stay visible until the new page arrives.
+    func refresh() async {
+        await fetch(page: 1)
+    }
+
+    /// Loads the next page when `currentItem` is the last loaded movie, unless a request
+    /// is already in flight or the last page has been reached.
+    func loadNextPageIfNeeded(currentItem: Movie) async {
+        guard loadingPage == nil, hasMorePages, currentItem.id == movies.last?.id else { return }
+        await fetch(page: currentPage + 1)
+    }
+
+    /// Repeats the request that failed last.
+    func retry() async {
+        guard loadingPage == nil, let failedPage else { return }
+        await fetch(page: failedPage)
+    }
+
+    private func fetch(page: Int) async {
+        requestToken += 1
+        let token = requestToken
+        loadingPage = page
+        errorMessage = nil
+        if movies.isEmpty { state = .loading }
+        defer { if token == requestToken { loadingPage = nil } }
+
+        do {
+            let response = try await service.popular(page: page)
+            guard token == requestToken else { return }
+
+            let existing = page == 1 ? [] : movies
+            // TMDB can repeat a movie on adjacent pages when rankings shift; list IDs must stay unique.
+            var seen = Set(existing.map(\.id))
+            let merged = existing + response.results.filter { seen.insert($0.id).inserted }
+
+            currentPage = page
+            totalPages = response.totalPages
+            failedPage = nil
+            state = merged.isEmpty ? .empty : .loaded(merged)
+        } catch {
+            guard token == requestToken else { return }
+            if Task.isCancelled || error is CancellationError {
+                // Not a failure: the screen went away. Let the next `load()` start over.
+                if movies.isEmpty { state = .idle }
+                return
+            }
+            let message = error.userFacingMessage
+            errorMessage = message
+            failedPage = page
+            if movies.isEmpty { state = .failed(message) }
+        }
+    }
+}
diff --git a/Sources/TMDBApp/ViewModels/UserFacingError.swift b/Sources/TMDBApp/ViewModels/UserFacingError.swift
new file mode 100644
index 0000000..3946959
--- /dev/null
+++ b/Sources/TMDBApp/ViewModels/UserFacingError.swift
@@ -0,0 +1,26 @@
+import Foundation
+
+extension Error {
+    /// A short message that can be shown to the user as is.
+    var userFacingMessage: String {
+        guard let apiError = self as? APIError else {
+            return "Something went wrong. Please try again."
+        }
+        switch apiError {
+        case .missingAPIKey:
+            return "No TMDB API key is set. Add TMDB_API_KEY and try again."
+        case .transport:
+            return "Couldn't reach TMDB. Check your internet connection and try again."
+        case .httpStatus(code: 401, _):
+            return "TMDB rejected the API key. Check TMDB_API_KEY and try again."
+        case .httpStatus(code: 429, _):
+            return "Too many requests. Wait a moment and try again."
+        case .httpStatus(let code, _) where code >= 500:
+            return "TMDB is having problems right now. Please try again later."
+        case .httpStatus(_, let message):
+            return message ?? "The request failed. Please try again."
+        case .invalidResponse, .decoding:
+            return "TMDB sent an unexpected response. Please try again later."
+        }
+    }
+}
diff --git a/Sources/TMDBApp/ViewModels/ViewState.swift b/Sources/TMDBApp/ViewModels/ViewState.swift
