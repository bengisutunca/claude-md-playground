@@ -0,0 +1,28 @@
+import SwiftUI
+
+/// Remote poster that shows a placeholder while loading, on failure, or when there is no URL.
+/// Size and clip it at the call site.
+struct PosterImage: View {
+    let url: URL?
+
+    var body: some View {
+        AsyncImage(url: url) { phase in
+            if let image = phase.image {
+                image
+                    .resizable()
+                    .scaledToFill()
+            } else {
+                placeholder
+            }
+        }
+        .accessibilityHidden(true)
+    }
+
+    private var placeholder: some View {
+        ZStack {
+            Rectangle().fill(.quaternary)
+            Image(systemName: "film")
+                .foregroundStyle(.secondary)
+        }
+    }
+}
diff --git a/Tests/TMDBAppTests/MockMovieService.swift b/Tests/TMDBAppTests/MockMovieService.swift
index 4e89fe3..09022f4 100644
--- a/Tests/TMDBAppTests/MockMovieService.swift
+++ b/Tests/TMDBAppTests/MockMovieService.swift
@@ -13,10 +13,22 @@ actor MockMovieService: MovieService {
     var error: Error?
     private(set) var calls: [Call] = []
 
+    /// When set, the next `popular(page:)` call is recorded, then waits for `releaseHeldResponse()`.
+    /// Only that one call waits, so a stray extra call shows up in `calls` and can't deadlock a test.
+    private var holdsNextResponse = false
+    private var heldResponse: CheckedContinuation<Void, Never>?
+
     init(error: Error? = nil) { self.error = error }
 
     func setError(_ error: Error?) { self.error = error }
 
+    func holdNextResponse() { holdsNextResponse = true }
+
+    func releaseHeldResponse() {
+        heldResponse?.resume()
+        heldResponse = nil
+    }
+
     private func decode<T: Decodable>(_ fixture: String, as type: T.Type) throws -> T {
         if let error { throw error }
         return try JSONDecoder.tmdb.decode(T.self, from: Fixture.data(fixture))
@@ -24,6 +36,10 @@ actor MockMovieService: MovieService {
 
     func popular(page: Int) async throws -> PagedResponse<Movie> {
         calls.append(.popular(page: page))
+        if holdsNextResponse {
+            holdsNextResponse = false
+            await withCheckedContinuation { heldResponse = $0 }
+        }
         return try decode(page == 2 ? "popular_page2" : "popular_page1", as: PagedResponse<Movie>.self)
     }
 
diff --git a/Tests/TMDBAppTests/MovieListViewModelTests.swift b/Tests/TMDBAppTests/MovieListViewModelTests.swift
new file mode 100644
index 0000000..3a8fcb4
--- /dev/null
+++ b/Tests/TMDBAppTests/MovieListViewModelTests.swift
@@ -0,0 +1,147 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("MovieListViewModel")
+@MainActor
+struct MovieListViewModelTests {
+    let page1: [Movie]
+    let page2: [Movie]
+
+    init() throws {
+        page1 = try Self.movies(in: "popular_page1")
+        page2 = try Self.movies(in: "popular_page2")
+    }
+
+    private static func movies(in fixture: String) throws -> [Movie] {
+        try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data(fixture)).results
+    }
+
+    @Test func firstLoadShowsFirstPage() async throws {
+        let service = MockMovieService()
+        let viewModel = MovieListViewModel(service: service)
+        #expect(viewModel.state == .idle)
+
+        await viewModel.load()
+
+        #expect(viewModel.state == .loaded(page1))
+        #expect(viewModel.errorMessage == nil)
+        #expect(viewModel.hasMorePages)
+
+        // The view calls `load()` on every appearance; once loaded it must not refetch.
+        await viewModel.load()
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func lastItemLoadsAndAppendsNextPage() async throws {
+        let service = MockMovieService()
+        let viewModel = MovieListViewModel(service: service)
+        await viewModel.load()
+
+        await viewModel.loadNextPageIfNeeded(currentItem: page1[0])
+        #expect(await service.calls == [.popular(page: 1)], "only the last item triggers paging")
+
+        await viewModel.loadNextPageIfNeeded(currentItem: try #require(page1.last))
+
+        #expect(viewModel.state == .loaded(page1 + page2))
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func stopsAtTotalPages() async throws {
+        let service = MockMovieService()
+        let viewModel = MovieListViewModel(service: service)
+        await viewModel.load()
+        await viewModel.loadNextPageIfNeeded(currentItem: try #require(page1.last))
+        #expect(!viewModel.hasMorePages)
+
+        await viewModel.loadNextPageIfNeeded(currentItem: try #require(page2.last))
+
+        #expect(viewModel.state == .loaded(page1 + page2))
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test(.timeLimit(.minutes(1)))
+    func ignoresNextPageCallsWhileAPageIsLoading() async throws {
+        let service = MockMovieService()
+        let viewModel = MovieListViewModel(service: service)
+        await viewModel.load()
+        let last = try #require(page1.last)
+
+        await service.holdNextResponse()
+        let inFlight = Task { await viewModel.loadNextPageIfNeeded(currentItem: last) }
+        while await service.calls.count < 2 {
+            try Task.checkCancellation()
+            await Task.yield()
+        }
+        #expect(viewModel.isLoadingNextPage)
+
+        await viewModel.loadNextPageIfNeeded(currentItem: last)
+        await viewModel.loadNextPageIfNeeded(currentItem: last)
+        await service.releaseHeldResponse()
+        await inFlight.value
+
+        #expect(!viewModel.isLoadingNextPage)
+        #expect(viewModel.state == .loaded(page1 + page2))
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func firstLoadFailureShowsErrorAndCanRetry() async throws {
+        let service = MockMovieService(error: APIError.httpStatus(code: 401, message: "Invalid API key"))
+        let viewModel = MovieListViewModel(service: service)
+
+        await viewModel.load()
+
+        guard case .failed(let message) = viewModel.state else {
+            Issue.record("expected .failed, got \(viewModel.state)")
+            return
+        }
+        #expect(message.contains("API key"))
+        #expect(viewModel.errorMessage == message)
+
+        await service.setError(nil)
+        await viewModel.load()
+
+        #expect(viewModel.state == .loaded(page1))
+        #expect(viewModel.errorMessage == nil)
+    }
+
+    @Test func nextPageFailureKeepsMoviesAndCanRetry() async throws {
+        let service = MockMovieService()
+        let viewModel = MovieListViewModel(service: service)
+        await viewModel.load()
+
+        await service.setError(APIError.transport(URLError(.notConnectedToInternet)))
+        await viewModel.loadNextPageIfNeeded(currentItem: try #require(page1.last))
+
+        #expect(viewModel.state == .loaded(page1))
+        #expect(viewModel.errorMessage?.contains("internet connection") == true)
+        #expect(!viewModel.isLoadingNextPage)
+
+        await service.setError(nil)
+        await viewModel.retry()
+
+        #expect(viewModel.state == .loaded(page1 + page2))
+        #expect(viewModel.errorMessage == nil)
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2), .popular(page: 2)])
+    }
+
+    @Test func refreshResetsToFirstPage() async throws {
+        let service = MockMovieService()
+        let viewModel = MovieListViewModel(service: service)
+        await viewModel.load()
+        await viewModel.loadNextPageIfNeeded(currentItem: try #require(page1.last))
+        #expect(!viewModel.hasMorePages)
+
+        await viewModel.refresh()
+
+        #expect(viewModel.state == .loaded(page1))
+        #expect(viewModel.hasMorePages)
+
+        await viewModel.loadNextPageIfNeeded(currentItem: try #require(page1.last))
+
+        #expect(viewModel.state == .loaded(page1 + page2))
+        #expect(await service.calls == [
+            .popular(page: 1), .popular(page: 2), .popular(page: 1), .popular(page: 2)
+        ])
+    }
+}
