diff --git a/Sources/TMDBApp/Networking/APIError.swift b/Sources/TMDBApp/Networking/APIError.swift
index d7dd306..b5101a3 100644
--- a/Sources/TMDBApp/Networking/APIError.swift
+++ b/Sources/TMDBApp/Networking/APIError.swift
@@ -8,6 +8,24 @@ enum APIError: Error {
     case missingAPIKey
 }
 
+extension APIError: LocalizedError {
+    /// User-facing message, surfaced by view models through `localizedDescription`.
+    var errorDescription: String? {
+        switch self {
+        case .invalidResponse:
+            return "The server sent an unexpected response. Please try again."
+        case .httpStatus(let code, let message):
+            return message ?? "The server returned an error (\(code)). Please try again."
+        case .decoding:
+            return "The movie data couldn't be read. Please try again later."
+        case .transport:
+            return "Couldn't reach TMDB. Check your internet connection and try again."
+        case .missingAPIKey:
+            return "No TMDB API key is configured. Set TMDB_API_KEY in the environment or Info.plist."
+        }
+    }
+}
+
 /// TMDB error body, e.g. `{"status_code": 7, "status_message": "...", "success": false}`.
 struct TMDBErrorBody: Decodable {
     let statusMessage: String
