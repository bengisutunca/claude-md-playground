@@ -0,0 +1,37 @@
+import SwiftUI
+
+struct MovieRowView: View {
+    let movie: Movie
+
+    var body: some View {
+        HStack(spacing: 12) {
+            AsyncImage(url: ImageURLBuilder().url(path: movie.posterPath, size: .w185)) { image in
+                image.resizable().scaledToFill()
+            } placeholder: {
+                Rectangle()
+                    .fill(.quaternary)
+                    .overlay { Image(systemName: "film").foregroundStyle(.secondary) }
+            }
+            .frame(width: 60, height: 90)
+            .clipShape(RoundedRectangle(cornerRadius: 6))
+            .accessibilityHidden(true)
+
+            VStack(alignment: .leading, spacing: 4) {
+                Text(movie.title)
+                    .font(.headline)
+                    .lineLimit(2)
+                if let year = movie.year {
+                    Text(year)
+                        .font(.subheadline)
+                        .foregroundStyle(.secondary)
+                }
+                Label(movie.ratingText, systemImage: "star.fill")
+                    .font(.subheadline)
+                    .foregroundStyle(.secondary)
+                    .accessibilityLabel("Rating \(movie.ratingText)")
+            }
+        }
+        .padding(.vertical, 4)
+        .accessibilityElement(children: .combine)
+    }
+}
diff --git a/Tests/TMDBAppTests/MovieListViewModelTests.swift b/Tests/TMDBAppTests/MovieListViewModelTests.swift
new file mode 100644
index 0000000..a0766ae
--- /dev/null
+++ b/Tests/TMDBAppTests/MovieListViewModelTests.swift
@@ -0,0 +1,99 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+private func fixtureMovies(_ name: String) throws -> [Movie] {
+    try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data(name)).results
+}
+
+@MainActor
+@Suite("MovieListViewModel")
+struct MovieListViewModelTests {
+    let mock = MockMovieService()
+    let viewModel: MovieListViewModel
+    let page1: [Movie]
+    let page2: [Movie]
+
+    init() throws {
+        viewModel = MovieListViewModel(service: mock)
+        page1 = try fixtureMovies("popular_page1")
+        page2 = try fixtureMovies("popular_page2")
+    }
+
+    @Test func firstLoadShowsFirstPage() async {
+        #expect(viewModel.state == .idle)
+        await viewModel.load()
+        #expect(viewModel.state == .loaded(page1))
+        #expect(viewModel.errorMessage == nil)
+        #expect(await mock.calls == [.popular(page: 1)])
+    }
+
+    @Test func lastItemLoadsNextPage() async throws {
+        await viewModel.load()
+        await viewModel.loadNextPageIfNeeded(currentItem: page1[0])
+        #expect(await mock.calls == [.popular(page: 1)], "only the last item triggers a page load")
+
+        await viewModel.loadNextPageIfNeeded(currentItem: try #require(page1.last))
+        #expect(viewModel.state == .loaded(page1 + page2))
+        #expect(await mock.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func stopsAtTotalPages() async throws {
+        await viewModel.load()
+        await viewModel.loadNextPageIfNeeded(currentItem: try #require(page1.last))
+        await viewModel.loadNextPageIfNeeded(currentItem: try #require(page2.last))
+        #expect(viewModel.state == .loaded(page1 + page2))
+        #expect(await mock.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func ignoresNextPageRequestWhilePageIsLoading() async throws {
+        await viewModel.load()
+        let last = try #require(page1.last)
+        // Runs on the main actor once the direct call below suspends on the service.
+        let concurrent = Task { await viewModel.loadNextPageIfNeeded(currentItem: last) }
+        await viewModel.loadNextPageIfNeeded(currentItem: last)
+        await concurrent.value
+        #expect(viewModel.state == .loaded(page1 + page2))
+        #expect(await mock.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func failedLoadShowsMessageThenRetrySucceeds() async throws {
+        let body = try JSONDecoder.tmdb.decode(TMDBErrorBody.self, from: Fixture.data("error_401"))
+        await mock.setError(APIError.httpStatus(code: 401, message: body.statusMessage))
+        await viewModel.load()
+        #expect(viewModel.state == .failed(body.statusMessage))
+        #expect(viewModel.errorMessage == body.statusMessage)
+
+        await mock.setError(nil)
+        await viewModel.load()
+        #expect(viewModel.state == .loaded(page1))
+        #expect(viewModel.errorMessage == nil)
+    }
+
+    @Test func failedNextPageKeepsLoadedMovies() async throws {
+        let last = try #require(page1.last)
+        await viewModel.load()
+        await mock.setError(APIError.transport(URLError(.notConnectedToInternet)))
+        await viewModel.loadNextPageIfNeeded(currentItem: last)
+        #expect(viewModel.state == .loaded(page1))
+        #expect(viewModel.errorMessage
+                == "Couldn't reach TMDB. Check your internet connection and try again.")
+
+        await mock.setError(nil)
+        await viewModel.loadNextPageIfNeeded(currentItem: last)
+        #expect(viewModel.state == .loaded(page1 + page2))
+        #expect(viewModel.errorMessage == nil)
+    }
+
+    @Test func refreshResetsToFirstPage() async throws {
+        await viewModel.load()
+        await viewModel.loadNextPageIfNeeded(currentItem: try #require(page1.last))
+        await viewModel.refresh()
+        #expect(viewModel.state == .loaded(page1))
+
+        await viewModel.loadNextPageIfNeeded(currentItem: try #require(page1.last))
+        #expect(viewModel.state == .loaded(page1 + page2))
+        #expect(await mock.calls
+                == [.popular(page: 1), .popular(page: 2), .popular(page: 1), .popular(page: 2)])
+    }
+}
