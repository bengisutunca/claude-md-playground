+++ b/Sources/TMDBApp/ViewModels/MovieListViewModel.swift
@@ -0,0 +1,73 @@
+import Foundation
+import Observation
+
+/// Popular movies: loads page 1, appends later pages as the last row appears, supports pull to refresh.
+@MainActor
+@Observable
+final class MovieListViewModel {
+    private(set) var state: ViewState<[Movie]> = .idle
+    /// User-facing message for the most recent failed load; nil while loading or after a success.
+    /// A failed first page also moves `state` to `.failed`; a failed later page keeps the loaded list.
+    private(set) var errorMessage: String?
+
+    var isLoadingNextPage: Bool { (loadingPage ?? 0) > 1 }
+
+    private let service: any MovieService
+    /// Page being fetched. While set, other load calls are ignored, so pages are applied in order.
+    private var loadingPage: Int?
+    private var currentPage = 0
+    private var totalPages = 0
+
+    init(service: any MovieService) {
+        self.service = service
+    }
+
+    /// Loads the first page, unless content is already shown or a load is in flight.
+    func load() async {
+        guard loadingPage == nil else { return }
+        switch state {
+        case .idle, .failed: break
+        case .loading, .loaded, .empty: return
+        }
+        state = .loading
+        await loadPage(1, appendingTo: [])
+    }
+
+    /// Starts over from page 1. Current content stays visible until the response arrives
+    /// (removing the list mid-refresh would cancel SwiftUI's refresh task).
+    func refresh() async {
+        guard loadingPage == nil else { return }
+        await loadPage(1, appendingTo: [])
+    }
+
+    /// Loads the next page when `currentItem` is the last loaded movie and more pages remain.
+    func loadNextPageIfNeeded(currentItem: Movie) async {
+        guard loadingPage == nil, currentPage < totalPages,
+              case .loaded(let movies) = state, movies.last?.id == currentItem.id else { return }
+        await loadPage(currentPage + 1, appendingTo: movies)
+    }
+
+    private func loadPage(_ page: Int, appendingTo existing: [Movie]) async {
+        loadingPage = page
+        errorMessage = nil
+        defer { loadingPage = nil }
+        do {
+            let response = try await service.popular(page: page)
+            // Rankings can shift between requests; drop repeats so list identities stay unique.
+            var seen = Set(existing.map(\.id))
+            let movies = existing + response.results.filter { seen.insert($0.id).inserted }
+            currentPage = page
+            totalPages = response.totalPages
+            state = movies.isEmpty ? .empty : .loaded(movies)
+        } catch {
+            if Task.isCancelled {
+                // The view went away; not a failure to show. The next `load()` starts over.
+                if case .loading = state { state = .idle }
+                return
+            }
+            let message = error.localizedDescription
+            errorMessage = message
+            if page == 1 { state = .failed(message) }
+        }
+    }
+}
diff --git a/Sources/TMDBApp/ViewModels/ViewState.swift b/Sources/TMDBApp/ViewModels/ViewState.swift
new file mode 100644
index 0000000..d042d83
--- /dev/null
+++ b/Sources/TMDBApp/ViewModels/ViewState.swift
@@ -0,0 +1,11 @@
+/// Screen state shared by view models.
+enum ViewState<Value> {
+    case idle
+    case loading
+    case loaded(Value)
+    case empty
+    /// Carries a user-facing message.
+    case failed(String)
+}
+
+extension ViewState: Equatable where Value: Equatable {}
