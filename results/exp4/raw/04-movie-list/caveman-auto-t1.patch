+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("MovieListViewModel")
+struct MovieListViewModelTests {
+    let page1: [Movie]
+    let page2: [Movie]
+
+    init() throws {
+        page1 = try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page1")).results
+        page2 = try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page2")).results
+    }
+
+    @Test func startsIdle() {
+        let viewModel = MovieListViewModel(service: MockMovieService())
+        #expect(viewModel.state == .idle)
+    }
+
+    @Test func firstLoadShowsFirstPage() async {
+        let service = MockMovieService()
+        let viewModel = MovieListViewModel(service: service)
+
+        await viewModel.load()
+
+        #expect(viewModel.state == .loaded(page1))
+        #expect(viewModel.hasMorePages)
+        #expect(viewModel.errorMessage == nil)
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func loadIsIgnoredOnceLoaded() async {
+        let service = MockMovieService()
+        let viewModel = MovieListViewModel(service: service)
+
+        await viewModel.load()
+        await viewModel.load()
+
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func lastItemLoadsNextPageAndAppends() async throws {
+        let service = MockMovieService()
+        let viewModel = MovieListViewModel(service: service)
+        await viewModel.load()
+
+        await viewModel.loadNextPageIfNeeded(currentItem: try #require(page1.last))
+
+        #expect(viewModel.state == .loaded(page1 + page2))
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func nonLastItemDoesNotLoadNextPage() async throws {
+        let service = MockMovieService()
+        let viewModel = MovieListViewModel(service: service)
+        await viewModel.load()
+
+        await viewModel.loadNextPageIfNeeded(currentItem: try #require(page1.first))
+
+        #expect(viewModel.state == .loaded(page1))
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func stopsAtTotalPages() async throws {
+        let service = MockMovieService()
+        let viewModel = MovieListViewModel(service: service)
+        await viewModel.load()
+        await viewModel.loadNextPageIfNeeded(currentItem: try #require(page1.last))
+
+        #expect(!viewModel.hasMorePages)
+        await viewModel.loadNextPageIfNeeded(currentItem: try #require(page2.last))
+
+        #expect(viewModel.state == .loaded(page1 + page2))
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func ignoresDuplicateCallsWhileLoadingPage() async throws {
+        let service = MockMovieService()
+        let viewModel = MovieListViewModel(service: service)
+        await viewModel.load()
+        let last = try #require(page1.last)
+
+        async let first: Void = viewModel.loadNextPageIfNeeded(currentItem: last)
+        async let second: Void = viewModel.loadNextPageIfNeeded(currentItem: last)
+        _ = await (first, second)
+
+        #expect(viewModel.state == .loaded(page1 + page2))
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func firstLoadErrorShowsFailedState() async {
+        let service = MockMovieService(error: APIError.httpStatus(code: 401, message: "Invalid API key: You must be granted a valid key."))
+        let viewModel = MovieListViewModel(service: service)
+
+        await viewModel.load()
+
+        #expect(viewModel.state == .failed("Invalid API key: You must be granted a valid key."))
+        #expect(viewModel.errorMessage == "Invalid API key: You must be granted a valid key.")
+    }
+
+    @Test func retryAfterErrorLoads() async {
+        let service = MockMovieService(error: APIError.transport(URLError(.notConnectedToInternet)))
+        let viewModel = MovieListViewModel(service: service)
+        await viewModel.load()
+        #expect(viewModel.state == .failed(APIError.transport(URLError(.notConnectedToInternet)).userFacingMessage))
+
+        await service.setError(nil)
+        await viewModel.load()
+
+        #expect(viewModel.state == .loaded(page1))
+        #expect(viewModel.errorMessage == nil)
+    }
+
+    @Test func nextPageErrorKeepsLoadedMovies() async throws {
+        let service = MockMovieService()
+        let viewModel = MovieListViewModel(service: service)
+        await viewModel.load()
+        await service.setError(APIError.invalidResponse)
+
+        await viewModel.loadNextPageIfNeeded(currentItem: try #require(page1.last))
+
+        #expect(viewModel.state == .loaded(page1))
+        #expect(viewModel.errorMessage == APIError.invalidResponse.userFacingMessage)
+        #expect(viewModel.hasMorePages)
+    }
+
+    @Test func refreshResetsToFirstPage() async throws {
+        let service = MockMovieService()
+        let viewModel = MovieListViewModel(service: service)
+        await viewModel.load()
+        await viewModel.loadNextPageIfNeeded(currentItem: try #require(page1.last))
+
+        await viewModel.refresh()
+
+        #expect(viewModel.state == .loaded(page1))
+        #expect(viewModel.hasMorePages)
+
+        await viewModel.loadNextPageIfNeeded(currentItem: try #require(page1.last))
+        #expect(viewModel.state == .loaded(page1 + page2))
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2), .popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func nonAPIErrorUsesGenericMessage() async {
+        struct Unknown: Error {}
+        let viewModel = MovieListViewModel(service: MockMovieService(error: Unknown()))
+
+        await viewModel.load()
+
+        #expect(viewModel.state == .failed("Something went wrong. Please try again."))
+    }
+}
