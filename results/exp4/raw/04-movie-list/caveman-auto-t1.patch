--- a/Sources/TMDBApp/Networking/APIError.swift
+++ b/Sources/TMDBApp/Networking/APIError.swift
@@ -8,6 +8,25 @@ enum APIError: Error {
     case missingAPIKey
 }
 
+extension APIError: LocalizedError {
+    /// Short, user-facing description suitable for display in the UI.
+    var errorDescription: String? {
+        switch self {
+        case .invalidResponse:
+            return "The server returned an unexpected response."
+        case .httpStatus(let code, let message):
+            if let message, !message.isEmpty { return message }
+            return "The server returned an error (\(code))."
+        case .decoding:
+            return "The data from the server couldn't be read."
+        case .transport:
+            return "Couldn't connect to the server. Check your internet connection and try again."
+        case .missingAPIKey:
+            return "The TMDB API key is missing. Set TMDB_API_KEY and try again."
+        }
+    }
+}
+
