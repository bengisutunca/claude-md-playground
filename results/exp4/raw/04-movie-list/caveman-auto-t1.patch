@@ -0,0 +1,91 @@
+import Foundation
+import Observation
+
+/// Paginated list of popular movies.
+@MainActor
+@Observable
+final class MovieListViewModel {
+    private(set) var state: ViewState<[Movie]> = .idle
+    /// Last error, including failures to load a further page or to refresh while
+    /// movies are already shown (in which case `state` stays `.loaded`).
+    private(set) var errorMessage: String?
+
+    /// Movies loaded so far, across all pages.
+    private(set) var movies: [Movie] = []
+    private var currentPage = 0
+    private var totalPages = 1
+    /// Page currently being fetched, if any.
+    private var loadingPage: Int?
+    /// Incremented on every fetch so that results of a superseded fetch are dropped.
+    private var generation = 0
+
+    private let service: any MovieService
+
+    init(service: any MovieService) {
+        self.service = service
+    }
+
+    var isLoadingNextPage: Bool { (loadingPage ?? 0) > 1 }
+
+    var hasMorePages: Bool { currentPage < totalPages }
+
+    /// Loads the first page unless movies are already loaded or loading.
+    func load() async {
+        guard movies.isEmpty, loadingPage == nil else { return }
+        state = .loading
+        await fetch(page: 1)
+    }
+
+    /// Reloads from the first page, superseding any fetch in progress.
+    /// The current list stays visible until the new first page arrives.
+    func refresh() async {
+        if movies.isEmpty { state = .loading }
+        await fetch(page: 1)
+    }
+
+    /// Loads the next page when `currentItem` is the last loaded movie.
+    func loadNextPageIfNeeded(currentItem: Movie) async {
+        guard currentItem.id == movies.last?.id, hasMorePages, loadingPage == nil else { return }
+        await fetch(page: currentPage + 1)
+    }
+
+    private func fetch(page: Int) async {
+        generation += 1
+        let fetchGeneration = generation
+        loadingPage = page
+        errorMessage = nil
+
+        let result: Result<PagedResponse<Movie>, Error>
+        do {
+            result = .success(try await service.popular(page: page))
+        } catch {
+            result = .failure(error)
+        }
+
+        guard fetchGeneration == generation else { return }
+        loadingPage = nil
+        if Task.isCancelled {
+            // Leave state for the next `load()`; a cancelled view is not an error.
+            if movies.isEmpty { state = .idle }
+            return
+        }
+
+        switch result {
+        case .success(let response):
+            if page == 1 {
+                movies = response.results
+            } else {
+                // Pages can overlap when popularity shifts; keep IDs unique for the list.
+                let known = Set(movies.map(\.id))
+                movies += response.results.filter { !known.contains($0.id) }
+            }
+            currentPage = page
+            totalPages = response.totalPages
+            state = movies.isEmpty ? .empty : .loaded(movies)
+        case .failure(let error):
+            let message = error.userFacingMessage
+            errorMessage = message
+            if movies.isEmpty { state = .failed(message) }
+        }
+    }
+}
diff --git a/Sources/TMDBApp/ViewModels/ViewState.swift b/Sources/TMDBApp/ViewModels/ViewState.swift
new file mode 100644
index 0000000..d4d1606
--- /dev/null
+++ b/Sources/TMDBApp/ViewModels/ViewState.swift
@@ -0,0 +1,21 @@
+import Foundation
+
+/// Loading state shared by view models.
+enum ViewState<Value> {
+    case idle
+    case loading
+    case loaded(Value)
+    case empty
+    /// Carries a user-facing error message.
+    case failed(String)
+}
+
+extension ViewState: Equatable where Value: Equatable {}
+extension ViewState: Sendable where Value: Sendable {}
+
+extension Error {
+    /// Message for showing this error to the user (e.g. in `ViewState.failed`).
+    var userFacingMessage: String {
+        (self as? LocalizedError)?.errorDescription ?? "Something went wrong. Please try again."
+    }
+}
