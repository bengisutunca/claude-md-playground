+    /// Regression: the minutes part was computed with `% 6` instead of `% 60`, so
+    /// Inception (148 min) showed "2h 4m". Every runtime up to 24h must round-trip.
+    @Test func runtimeFormattingRoundTripsEveryMinute() {
+        for minutes in 0...(24 * 60) {
+            let text = MovieDetailContent.formatRuntime(minutes: minutes)
+            var total = 0
+            for part in text.split(separator: " ") {
+                if part.hasSuffix("h"), let h = Int(part.dropLast()) {
+                    total += h * 60
+                } else if part.hasSuffix("m"), let m = Int(part.dropLast()), (0..<60).contains(m) {
+                    total += m
+                } else {
+                    Issue.record("unexpected component \"\(part)\" in \"\(text)\"")
+                }
+            }
+            #expect(total == minutes, "\(minutes) min formatted as \"\(text)\"")
+        }
+    }
+
