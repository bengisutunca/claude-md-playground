+import SwiftUI
+
+/// App shell: Popular, Search and Favorites tabs, each with its own `NavigationStack`.
+public struct RootView: View {
+    private let dependencies: AppDependencies
+    // Owned here so each tab keeps its state (scroll position, query) across tab switches
+    // and re-creations of `RootView`.
+    @State private var movieList: MovieListViewModel
+    @State private var search: SearchViewModel
+
+    public init(dependencies: AppDependencies) {
+        self.dependencies = dependencies
+        _movieList = State(initialValue: dependencies.makeMovieListViewModel())
+        _search = State(initialValue: dependencies.makeSearchViewModel())
+    }
+
+    public var body: some View {
+        TabView {
+            NavigationStack {
+                MovieListView(viewModel: movieList)
+                    .movieDetailDestination(using: dependencies)
+            }
+            .tabItem { Label("Popular", systemImage: "film") }
+
+            NavigationStack {
+                SearchView(viewModel: search)
+                    .movieDetailDestination(using: dependencies)
+            }
+            .tabItem { Label("Search", systemImage: "magnifyingglass") }
+
+            NavigationStack {
+                FavoritesView()
+                    .movieDetailDestination(using: dependencies)
+            }
+            .tabItem { Label("Favorites", systemImage: "heart") }
+        }
+        .environment(dependencies.favorites)
+    }
+}
+
+#Preview {
+    RootView(dependencies: .preview)
+}
