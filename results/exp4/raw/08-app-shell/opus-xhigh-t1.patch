@@ -0,0 +1,19 @@
+import SwiftUI
+
+/// TMDB poster/backdrop/profile image, filling its frame; shows a film placeholder while loading
+/// or when `path` is nil. Callers set the frame and clip shape.
+struct MovieImageView: View {
+    let path: String?
+    let size: ImageURLBuilder.Size
+
+    var body: some View {
+        AsyncImage(url: ImageURLBuilder().url(path: path, size: size)) { image in
+            image.resizable().scaledToFill()
+        } placeholder: {
+            ZStack {
+                Rectangle().fill(.quaternary)
+                Image(systemName: "film").foregroundStyle(.secondary)
+            }
+        }
+    }
+}
