+++ b/Tests/TMDBAppTests/AppDependenciesTests.swift
@@ -0,0 +1,137 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("AppDependencies")
+struct AppDependenciesTests {
+    /// `live` with no key anywhere. Requests fail before reaching `session`; it is the mock
+    /// session anyway so a regression could never hit the real network.
+    private func liveWithoutKey() -> AppDependencies {
+        AppDependencies.live(
+            environment: [:],
+            bundle: Bundle(for: MockURLProtocol.self),
+            session: MockURLProtocol.session(),
+            favoritesStore: InMemoryFavoritesStore()
+        )
+    }
+
+    @Test func liveBuildsRealServiceWithoutCrashing() {
+        // Builds only; sends nothing, so it is safe whether or not TMDB_API_KEY is set.
+        let dependencies = AppDependencies.live()
+        #expect(dependencies.movieService is TMDBMovieService)
+    }
+
+    @Test func missingAPIKeyFailsRequestsWithMissingAPIKey() async {
+        let service = liveWithoutKey().movieService
+        do {
+            _ = try await service.popular(page: 1)
+            Issue.record("expected error")
+        } catch APIError.missingAPIKey {
+        } catch {
+            Issue.record("expected missingAPIKey, got \(error)")
+        }
+    }
+
+    @Test func missingAPIKeyShowsErrorStateOnEveryScreen() async {
+        let dependencies = liveWithoutKey()
+        let expected = ViewState<[Movie]>.failed(ErrorMessage.text(for: APIError.missingAPIKey))
+        #expect(ErrorMessage.text(for: APIError.missingAPIKey).contains("TMDB_API_KEY"))
+
+        let list = dependencies.makeMovieListViewModel()
+        await list.load()
+        #expect(list.state == expected)
+
+        let detail = dependencies.makeMovieDetailViewModel(movieID: 27205)
+        await detail.load()
+        guard case .failed(let message) = detail.state else { Issue.record("expected failed"); return }
+        #expect(message == ErrorMessage.text(for: APIError.missingAPIKey))
+    }
+
+    @Test func factoriesShareTheInjectedService() async throws {
+        let service = MockMovieService()
+        let dependencies = AppDependencies(movieService: service, favoritesStore: InMemoryFavoritesStore())
+        await dependencies.makeMovieListViewModel().load()
+        await dependencies.makeMovieDetailViewModel(movieID: 27205).load()
+        let calls = await service.calls
+        #expect(calls.first == .popular(page: 1))
+        #expect(calls.contains(.detail(id: 27205)))
+        #expect(calls.contains(.credits(id: 27205)))
+    }
+
+    @Test func favoritesUseTheInjectedStore() throws {
+        let page = try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page1"))
+        let store = InMemoryFavoritesStore(movies: [page.results[0]])
+        let dependencies = AppDependencies(movieService: MockMovieService(), favoritesStore: store)
+        #expect(dependencies.favorites.favorites == [page.results[0]])
+        dependencies.favorites.toggle(page.results[1])
+        #expect(store.load() == [page.results[0], page.results[1]])
+    }
+
+    @Test func previewServesMockData() async throws {
+        let dependencies = AppDependencies.preview
+        #expect(dependencies.movieService is PreviewMovieService)
+        #expect(!dependencies.favorites.favorites.isEmpty)
+
+        let list = dependencies.makeMovieListViewModel()
+        await list.load()
+        guard case .loaded(let movies) = list.state else { Issue.record("expected loaded, got \(list.state)"); return }
+        #expect(movies == PreviewMovieService.movies)
+
+        let detail = dependencies.makeMovieDetailViewModel(movieID: movies[0].id)
+        await detail.load()
+        guard case .loaded(let content) = detail.state else { Issue.record("expected loaded"); return }
+        #expect(content.detail.title == movies[0].title)
+        #expect(!content.detail.genres.isEmpty)
+        #expect(!content.cast.isEmpty)
+        #expect(!content.directors.isEmpty)
+    }
+
+    @Test func previewInstancesDoNotShareFavorites() throws {
+        let first = AppDependencies.preview
+        let movie = try #require(PreviewMovieService.movies.last)
+        #expect(!first.favorites.isFavorite(movie))
+        first.favorites.toggle(movie)
+        #expect(first.favorites.isFavorite(movie))
+        #expect(!AppDependencies.preview.favorites.isFavorite(movie))
+    }
+
+    @Test func requiredViewsConstruct() {
+        // Compile-time check of the shell's public view API.
+        _ = RootView(dependencies: .preview)
+        _ = LoadingView()
+        _ = EmptyStateView(title: "No Results", systemImage: "magnifyingglass", message: nil)
+        _ = ErrorView(message: "Oops", retry: nil)
+        _ = ErrorView(message: "Oops", retry: {})
+    }
+}
+
+@Suite("PreviewMovieService")
+struct PreviewMovieServiceTests {
+    let service = PreviewMovieService()
+
+    @Test func searchMatchesTitlesCaseInsensitively() async throws {
+        let page = try await service.search(query: "incep", page: 1)
+        #expect(page.results.map(\.title) == ["Inception"])
+        #expect(try await service.search(query: "zzz", page: 1).results.isEmpty)
+    }
+
+    @Test func detailForUnknownIDThrows() async {
+        await #expect(throws: APIError.self) { _ = try await service.detail(id: -1) }
+    }
+
+    @Test func noImagePathsSoPreviewsStayOffline() {
+        #expect(PreviewMovieService.movies.allSatisfy { $0.posterPath == nil && $0.backdropPath == nil })
+    }
+
+    @Test func configuredErrorIsThrown() async {
+        let failing = PreviewMovieService(error: APIError.missingAPIKey)
+        do {
+            _ = try await failing.popular(page: 1)
+            Issue.record("expected error")
+        } catch APIError.missingAPIKey {
+        } catch {
+            Issue.record("expected missingAPIKey, got \(error)")
+        }
+    }
+}
