+import Foundation
+
+/// In-memory `MovieService` for SwiftUI previews. Never touches the network: data is built in
+/// code, and image paths are nil so `AsyncImage` shows its placeholder instead of fetching.
+struct PreviewMovieService: MovieService {
+    /// When set, every call throws it (to preview error states).
+    var error: Error?
+
+    init(error: Error? = nil) {
+        self.error = error
+    }
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        try checkError()
+        return Self.page(Self.movies)
+    }
+
+    /// Case-insensitive title match over the sample movies. Not locale-dependent on purpose:
+    /// e.g. under a Turkish locale "I" lowercases to "ı", so "incep" wouldn't match "Inception".
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        try checkError()
+        return Self.page(Self.movies.filter {
+            $0.title.range(of: query, options: [.caseInsensitive, .diacriticInsensitive]) != nil
+        })
+    }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        try checkError()
+        guard let movie = Self.movies.first(where: { $0.id == id }) else {
+            throw APIError.httpStatus(code: 404, message: "The resource you requested could not be found.")
+        }
+        return MovieDetail(
+            id: movie.id, title: movie.title, overview: movie.overview,
+            releaseDate: movie.releaseDate, voteAverage: movie.voteAverage, voteCount: movie.voteCount,
+            runtime: Self.runtimes[id], tagline: Self.taglines[id],
+            genres: movie.genreIDs.compactMap { id in Self.genres.first { $0.id == id } },
+            status: "Released"
+        )
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        try checkError()
+        return Credits(id: id, cast: Self.cast, crew: Self.crew)
+    }
+
+    private func checkError() throws {
+        if let error { throw error }
+    }
+
+    private static func page(_ results: [Movie]) -> PagedResponse<Movie> {
+        PagedResponse(page: 1, results: results, totalPages: 1, totalResults: results.count)
+    }
+}
+
