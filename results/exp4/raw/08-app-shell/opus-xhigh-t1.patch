+import SwiftUI
+
+/// Full-screen placeholder for "nothing to show yet" states (no results, no favorites, …).
+struct EmptyStateView: View {
+    let title: String
+    let systemImage: String
+    let message: String?
+
+    init(title: String, systemImage: String, message: String? = nil) {
+        self.title = title
+        self.systemImage = systemImage
+        self.message = message
+    }
+
+    var body: some View {
+        ContentUnavailableView {
+            Label(title, systemImage: systemImage)
+        } description: {
+            if let message {
+                Text(message)
+            }
+        }
+    }
+}
+
+#Preview("With message") {
+    EmptyStateView(title: "No Favorites Yet", systemImage: "heart", message: "Tap the heart on a movie to add it.")
+}
+
+#Preview("Title only") {
+    EmptyStateView(title: "No Details", systemImage: "film", message: nil)
+}
