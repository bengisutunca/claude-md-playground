+++ b/Sources/TMDBApp/AppDependencies.swift
@@ -0,0 +1,61 @@
+import Foundation
+
+/// Composition root: builds the services once and hands out view models wired to them.
+///
+/// Create one instance per app launch and pass it to `RootView`, e.g.
+/// ```swift
+/// @main struct MoviesApp: App {
+///     private let dependencies = AppDependencies.live()
+///     var body: some Scene { WindowGroup { RootView(dependencies: dependencies) } }
+/// }
+/// ```
+@MainActor
+public final class AppDependencies {
+    let movieService: any MovieService
+    /// Shared by every screen (injected into the SwiftUI environment by `RootView`).
+    let favorites: FavoritesViewModel
+
+    init(movieService: any MovieService, favoritesStore: any FavoritesStore) {
+        self.movieService = movieService
+        self.favorites = FavoritesViewModel(store: favoritesStore)
+    }
+
+    /// Real TMDB client and `UserDefaults`-backed favorites. Never crashes when the API key is
+    /// missing: requests then fail with `APIError.missingAPIKey` and screens show an `ErrorView`.
+    public static func live() -> AppDependencies {
+        live(environment: ProcessInfo.processInfo.environment, bundle: .main)
+    }
+
+    /// `live()` with injectable key sources, network session and store (for tests).
+    static func live(
+        environment: [String: String],
+        bundle: Bundle,
+        session: URLSession = .shared,
+        favoritesStore: any FavoritesStore = UserDefaultsFavoritesStore()
+    ) -> AppDependencies {
+        let configuration = try? APIConfiguration.load(environment: environment, bundle: bundle)
+        let client = TMDBClient(session: session, configuration: configuration)
+        return AppDependencies(movieService: TMDBMovieService(client: client), favoritesStore: favoritesStore)
+    }
+
+    /// Sample data for SwiftUI previews: no network, nothing persisted. Each access returns a
+    /// fresh instance, so previews don't share favorites.
+    public static var preview: AppDependencies {
+        AppDependencies(
+            movieService: PreviewMovieService(),
+            favoritesStore: InMemoryFavoritesStore(movies: Array(PreviewMovieService.movies.prefix(2)))
+        )
+    }
+
+    func makeMovieListViewModel() -> MovieListViewModel {
+        MovieListViewModel(service: movieService)
+    }
+
+    func makeSearchViewModel() -> SearchViewModel {
+        SearchViewModel(service: movieService)
+    }
+
+    func makeMovieDetailViewModel(movieID: Int) -> MovieDetailViewModel {
+        MovieDetailViewModel(movieID: movieID, service: movieService)
+    }
+}
