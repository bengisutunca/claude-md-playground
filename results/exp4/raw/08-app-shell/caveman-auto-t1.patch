--- /dev/null
+++ b/Sources/TMDBApp/Services/AppDependencies.swift
@@ -0,0 +1,42 @@
+import Foundation
+
+/// Composition root: builds the app's services once and hands out view models wired to them.
+@MainActor
+final class AppDependencies {
+    let movieService: any MovieService
+    /// Shared across tabs and detail screens so favorite state stays in sync.
+    let favorites: FavoritesViewModel
+
+    init(movieService: any MovieService, favoritesStore: any FavoritesStore) {
+        self.movieService = movieService
+        self.favorites = FavoritesViewModel(store: favoritesStore)
+    }
+
+    /// Real TMDB backend with `UserDefaults` favorites.
+    ///
+    /// Never crashes when `TMDB_API_KEY` is missing: the client then resolves the key per request
+    /// and fails with `APIError.missingAPIKey`, which screens show as an `ErrorView`.
+    static func live() -> AppDependencies {
+        let client = TMDBClient(configuration: try? APIConfiguration.load())
+        return AppDependencies(movieService: TMDBMovieService(client: client),
+                               favoritesStore: UserDefaultsFavoritesStore())
+    }
+
+    /// Offline mock data for SwiftUI previews.
+    static var preview: AppDependencies {
+        AppDependencies(movieService: PreviewMovieService(),
+                        favoritesStore: InMemoryFavoritesStore(movies: [PreviewMovieService.movies[0]]))
+    }
+
+    func makeMovieListViewModel() -> MovieListViewModel {
+        MovieListViewModel(service: movieService)
+    }
+
+    func makeSearchViewModel() -> SearchViewModel {
+        SearchViewModel(service: movieService)
+    }
+
+    func makeMovieDetailViewModel(movieID: Int) -> MovieDetailViewModel {
+        MovieDetailViewModel(movieID: movieID, service: movieService)
+    }
+}
