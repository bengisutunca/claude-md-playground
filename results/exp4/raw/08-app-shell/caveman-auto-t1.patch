+import SwiftUI
+
+/// TMDB poster/backdrop/profile image with a film placeholder while loading or when `path` is nil.
+struct TMDBImage: View {
+    let path: String?
+    let size: ImageURLBuilder.Size
+    var imageURLBuilder = ImageURLBuilder()
+
+    var body: some View {
+        AsyncImage(url: imageURLBuilder.url(path: path, size: size)) { image in
+            image.resizable().scaledToFill()
+        } placeholder: {
+            ZStack {
+                Rectangle().fill(.quaternary)
+                Image(systemName: "film").foregroundStyle(.secondary)
+            }
+        }
+    }
+}
