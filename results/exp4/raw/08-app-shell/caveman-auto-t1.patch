@@ -0,0 +1,77 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("AppDependencies")
+struct AppDependenciesTests {
+    /// True when no key is configured, so `live()` is guaranteed not to reach the network.
+    nonisolated static let apiKeyMissing = (try? APIConfiguration.load()) == nil
+
+    @Test func previewServesMockData() async throws {
+        let deps = AppDependencies.preview
+
+        let list = deps.makeMovieListViewModel()
+        await list.load()
+        #expect(list.state == .loaded(PreviewMovieService.movies))
+
+        let search = try await deps.movieService.search(query: "inter", page: 1)
+        #expect(search.results.map(\.title) == ["Interstellar"])
+
+        let detail = deps.makeMovieDetailViewModel(movieID: PreviewMovieService.movies[0].id)
+        await detail.load()
+        guard case .loaded(let content) = detail.state else {
+            Issue.record("expected loaded detail, got \(detail.state)")
+            return
+        }
+        #expect(content.detail.title == "Inception")
+        #expect(content.directorsText == "Christopher Nolan")
+
+        #expect(deps.favorites.favorites == [PreviewMovieService.movies[0]])
+    }
+
+    @Test func previewFavoritesAreNotPersisted() {
+        let movie = PreviewMovieService.movies[1]
+        AppDependencies.preview.favorites.toggle(movie)
+        #expect(!AppDependencies.preview.favorites.isFavorite(movie))
+    }
+
+    @Test func viewModelsShareTheInjectedService() async {
+        let service = MockMovieService()
+        let deps = AppDependencies(movieService: service, favoritesStore: InMemoryFavoritesStore())
+        await deps.makeMovieListViewModel().load()
+        await deps.makeMovieDetailViewModel(movieID: 27205).load()
+        // Detail and credits load concurrently, so their order is not fixed.
+        let calls = await service.calls
+        #expect(calls.count == 3)
+        #expect(calls.first == .popular(page: 1))
+        #expect(calls.contains(.detail(id: 27205)) && calls.contains(.credits(id: 27205)))
+    }
+
+    @Test func missingAPIKeyShowsClearError() async {
+        let deps = AppDependencies(movieService: MockMovieService(error: APIError.missingAPIKey),
+                                   favoritesStore: InMemoryFavoritesStore())
+        let vm = deps.makeMovieListViewModel()
+        await vm.load()
+        guard case .failed(let message) = vm.state else {
+            Issue.record("expected failure, got \(vm.state)")
+            return
+        }
+        #expect(message.contains("TMDB_API_KEY"))
+    }
+
+    @Test(.enabled(if: apiKeyMissing, "a TMDB API key is configured; skipping to avoid network access"))
+    func liveWithoutAPIKeyFailsWithMissingAPIKey() async {
+        let deps = AppDependencies.live()
+        do {
+            _ = try await deps.movieService.popular(page: 1)
+            Issue.record("expected APIError.missingAPIKey")
+        } catch APIError.missingAPIKey {
+        } catch {
+            Issue.record("expected APIError.missingAPIKey, got \(error)")
+        }
+        let vm = deps.makeMovieListViewModel()
+        await vm.load()
+        #expect(vm.state == .failed(userFacingMessage(for: APIError.missingAPIKey)))
+    }
+}
