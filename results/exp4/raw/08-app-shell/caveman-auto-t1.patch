+        self.dependencies = dependencies
+    }
+
+    var body: some View {
+        TabView {
+            MovieNavigationStack(dependencies: dependencies) {
+                MovieListView(viewModel: dependencies.makeMovieListViewModel())
+            }
+            .tabItem { Label("Popular", systemImage: "film") }
+
+            MovieNavigationStack(dependencies: dependencies) {
+                SearchView(viewModel: dependencies.makeSearchViewModel())
+            }
+            .tabItem { Label("Search", systemImage: "magnifyingglass") }
+
+            MovieNavigationStack(dependencies: dependencies) {
+                FavoritesView()
+            }
+            .tabItem { Label("Favorites", systemImage: "heart") }
+        }
+    }
+}
+
+/// `NavigationStack` that routes `Movie` values to `MovieDetailView` and provides the shared
+/// favorites model to everything inside it.
+struct MovieNavigationStack<Content: View>: View {
+    let dependencies: AppDependencies
+    @ViewBuilder let content: Content
+
+    var body: some View {
+        NavigationStack {
+            content.navigationDestination(for: Movie.self) { movie in
+                MovieDetailView(viewModel: dependencies.makeMovieDetailViewModel(movieID: movie.id))
+            }
+        }
+        .environment(dependencies.favorites)
+    }
+}
+
+#Preview {
+    RootView(dependencies: .preview)
+}
