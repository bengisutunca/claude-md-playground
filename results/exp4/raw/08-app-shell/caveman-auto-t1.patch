@@ -0,0 +1,76 @@
+import Foundation
+
+/// In-memory `MovieService` for SwiftUI previews. Never touches the network
+/// (sample movies have no image paths, so no posters are fetched either).
+struct PreviewMovieService: MovieService {
+    /// When set, every request fails with this error (to preview error states).
+    var failure: APIError?
+
+    init(failure: APIError? = nil) {
+        self.failure = failure
+    }
+
+    static let movies: [Movie] = [
+        Movie(id: 27205, title: "Inception",
+              overview: "A thief who steals corporate secrets through dream-sharing technology is given one last job.",
+              releaseDate: TMDBDate.parse("2010-07-15"), voteAverage: 8.4, voteCount: 36000, genreIDs: [28, 878]),
+        Movie(id: 157336, title: "Interstellar",
+              overview: "A team of explorers travels through a wormhole in space to ensure humanity's survival.",
+              releaseDate: TMDBDate.parse("2014-11-05"), voteAverage: 8.4, voteCount: 34000, genreIDs: [12, 18, 878]),
+        Movie(id: 155, title: "The Dark Knight",
+              overview: "Batman faces the Joker, a criminal mastermind who wants to plunge Gotham into anarchy.",
+              releaseDate: TMDBDate.parse("2008-07-16"), voteAverage: 8.5, voteCount: 32000, genreIDs: [18, 28, 80]),
+        Movie(id: 129, title: "Spirited Away",
+              overview: "A young girl wanders into a world ruled by gods, witches and spirits.",
+              releaseDate: TMDBDate.parse("2001-07-20"), voteAverage: 8.5, voteCount: 16000, genreIDs: [16, 10751, 14])
+    ]
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        try checkFailure()
+        return PagedResponse(page: 1, results: Self.movies, totalPages: 1, totalResults: Self.movies.count)
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        try checkFailure()
+        // Locale-independent: e.g. in Turkish "I" does not case-fold to "i".
+        let results = Self.movies.filter {
+            $0.title.range(of: query, options: [.caseInsensitive, .diacriticInsensitive]) != nil
+        }
+        return PagedResponse(page: 1, results: results, totalPages: 1, totalResults: results.count)
+    }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        try checkFailure()
+        let movie = try Self.movie(id: id)
+        return MovieDetail(id: movie.id, title: movie.title, overview: movie.overview,
+                           releaseDate: movie.releaseDate, voteAverage: movie.voteAverage,
+                           voteCount: movie.voteCount, runtime: 148, tagline: "Your mind is the scene of the crime.",
+                           genres: [Genre(id: 28, name: "Action"), Genre(id: 878, name: "Science Fiction")],
+                           status: "Released")
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        try checkFailure()
+        _ = try Self.movie(id: id)
+        return Credits(
+            id: id,
+            cast: [
+                CastMember(id: 1, name: "Leonardo DiCaprio", character: "Cobb", order: 0, profilePath: nil),
+                CastMember(id: 2, name: "Joseph Gordon-Levitt", character: "Arthur", order: 1, profilePath: nil),
+                CastMember(id: 3, name: "Elliot Page", character: "Ariadne", order: 2, profilePath: nil)
+            ],
+            crew: [CrewMember(id: 4, name: "Christopher Nolan", job: "Director", department: "Directing", profilePath: nil)]
+        )
+    }
+
+    private func checkFailure() throws {
+        if let failure { throw failure }
+    }
+
+    private static func movie(id: Int) throws -> Movie {
+        guard let movie = movies.first(where: { $0.id == id }) else {
+            throw APIError.httpStatus(code: 404, message: "The resource you requested could not be found.")
+        }
+        return movie
+    }
+}
