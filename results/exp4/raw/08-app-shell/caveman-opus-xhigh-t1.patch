+import Foundation
+
+/// Canned `MovieService` for SwiftUI previews. Never touches the network: there are no
+/// image paths either, so rows and detail screens show their placeholders.
+struct PreviewMovieService: MovieService {
+    static let movies: [Movie] = [
+        Movie(id: 27205, title: "Inception",
+              overview: "A thief who steals corporate secrets through dream-sharing technology "
+                + "is given the inverse task of planting an idea into the mind of a C.E.O.",
+              releaseDate: TMDBDate.parse("2010-07-15"), voteAverage: 8.4, voteCount: 35000,
+              genreIDs: [28, 878, 12]),
+        Movie(id: 278, title: "The Shawshank Redemption",
+              overview: "Imprisoned in the 1940s for a double murder he did not commit, "
+                + "a banker spends two decades in Shawshank prison.",
+              releaseDate: TMDBDate.parse("1994-09-23"), voteAverage: 8.7, voteCount: 26000,
+              genreIDs: [18, 80]),
+        Movie(id: 155, title: "The Dark Knight",
+              overview: "Batman raises the stakes in his war on crime against a criminal "
+                + "mastermind known as the Joker.",
+              releaseDate: TMDBDate.parse("2008-07-16"), voteAverage: 8.5, voteCount: 32000,
+              genreIDs: [18, 28, 80]),
+        Movie(id: 129, title: "Spirited Away",
+              overview: "A young girl wanders into a world ruled by gods, witches and spirits.",
+              releaseDate: TMDBDate.parse("2001-07-20"), voteAverage: 8.5, voteCount: 16000,
+              genreIDs: [16, 10751, 14])
+    ]
+
+    private static let genres = [
+        Genre(id: 28, name: "Action"), Genre(id: 878, name: "Science Fiction"), Genre(id: 12, name: "Adventure"),
+        Genre(id: 18, name: "Drama"), Genre(id: 80, name: "Crime"), Genre(id: 16, name: "Animation"),
+        Genre(id: 10751, name: "Family"), Genre(id: 14, name: "Fantasy")
+    ]
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        PagedResponse(page: page, results: page == 1 ? Self.movies : [],
+                      totalPages: 1, totalResults: Self.movies.count)
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        let results = Self.movies.filter { $0.title.localizedCaseInsensitiveContains(query) }
+        return PagedResponse(page: page, results: results, totalPages: 1, totalResults: results.count)
+    }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        guard let movie = Self.movies.first(where: { $0.id == id }) else {
+            throw APIError.httpStatus(code: 404, message: "The movie could not be found.")
+        }
+        return MovieDetail(
+            id: movie.id, title: movie.title, overview: movie.overview,
+            posterPath: nil, backdropPath: nil, releaseDate: movie.releaseDate,
+            voteAverage: movie.voteAverage, voteCount: movie.voteCount, runtime: 128,
+            tagline: nil, genres: Self.genres.filter { movie.genreIDs.contains($0.id) },
+            status: "Released"
+        )
+    }
+
+    /// The same sample credits for every movie.
+    func credits(id: Int) async throws -> Credits {
+        Credits(
+            id: id,
+            cast: [
+                CastMember(id: 1, name: "Alex Rivera", character: "Lead", order: 0, profilePath: nil),
+                CastMember(id: 2, name: "Sam Okafor", character: "Partner", order: 1, profilePath: nil),
+                CastMember(id: 3, name: "Jordan Lee", character: "Rival", order: 2, profilePath: nil)
+            ],
