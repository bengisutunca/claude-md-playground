+++ b/Tests/TMDBAppTests/AppDependenciesTests.swift
@@ -0,0 +1,80 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("AppDependencies")
+struct AppDependenciesTests {
+    @Test func viewModelsUseInjectedService() async {
+        let service = MockMovieService()
+        let dependencies = AppDependencies(movieService: service, favoritesStore: InMemoryFavoritesStore())
+
+        await dependencies.makeMovieListViewModel().load()
+        await dependencies.makeMovieDetailViewModel(movieID: 27205).load()
+        let search = dependencies.makeSearchViewModel()
+        search.query = "inception"
+        await search.waitForSearch()
+
+        let calls = await service.calls
+        #expect(calls.contains(.popular(page: 1)))
+        #expect(calls.contains(.detail(id: 27205)))
+        #expect(calls.contains(.credits(id: 27205)))
+        #expect(calls.contains(.search(query: "inception", page: 1)))
+    }
+
+    @Test func favoritesUseInjectedStore() {
+        let movie = Movie(id: 1, title: "Stored")
+        let store = InMemoryFavoritesStore(movies: [movie])
+        let dependencies = AppDependencies(movieService: MockMovieService(), favoritesStore: store)
+        #expect(dependencies.favorites.favorites == [movie])
+        dependencies.favorites.toggle(movie)
+        #expect(store.load().isEmpty)
+    }
+
+    @Test func previewServesMockDataWithoutNetwork() async throws {
+        let dependencies = AppDependencies.preview
+        #expect(!dependencies.favorites.favorites.isEmpty)
+
+        let list = dependencies.makeMovieListViewModel()
+        await list.load()
+        guard case .loaded(let movies) = list.state else {
+            Issue.record("expected loaded, got \(list.state)"); return
+        }
+        #expect(movies == PreviewMovieService.movies)
+        // No image paths, so previews never fetch posters either.
+        #expect(movies.allSatisfy { $0.posterPath == nil && $0.backdropPath == nil })
+
+        let detail = dependencies.makeMovieDetailViewModel(movieID: movies[0].id)
+        await detail.load()
+        guard case .loaded(let content) = detail.state else {
+            Issue.record("expected loaded, got \(detail.state)"); return
+        }
+        #expect(content.detail.id == movies[0].id)
+        #expect(!content.cast.isEmpty)
+        #expect(!content.directors.isEmpty)
+
+        let results = try await dependencies.movieService.search(query: "dark", page: 1).results
+        #expect(results.map(\.title) == ["The Dark Knight"])
+    }
+
+    @Test(.enabled(if: (try? APIConfiguration.load()) == nil,
+                   "A TMDB API key is configured; skipped so tests never reach the real API"))
+    func liveWithoutAPIKeyFailsWithMissingKey() async {
+        let dependencies = AppDependencies.live()
+        do {
+            _ = try await dependencies.movieService.popular(page: 1)
+            Issue.record("expected APIError.missingAPIKey")
+        } catch APIError.missingAPIKey {
+        } catch {
+            Issue.record("expected APIError.missingAPIKey, got \(error)")
+        }
+
+        let list = dependencies.makeMovieListViewModel()
+        await list.load()
+        #expect(list.state == .failed(APIError.missingAPIKey.userMessage))
+    }
+
+    @Test func missingAPIKeyMessageNamesTheKey() {
+        #expect(APIError.missingAPIKey.userMessage.contains(APIConfiguration.keyName))
+    }
+}
