@@ -0,0 +1,22 @@
+import SwiftUI
+
+/// Navigation stack for one tab: pushes `MovieDetailView` for any `Movie` link and provides the
+/// shared `FavoritesViewModel` to everything inside.
+struct MovieNavigationStack<Root: View>: View {
+    private let dependencies: AppDependencies
+    private let root: Root
+
+    init(dependencies: AppDependencies, @ViewBuilder root: () -> Root) {
+        self.dependencies = dependencies
+        self.root = root()
+    }
+
+    var body: some View {
+        NavigationStack {
+            root.navigationDestination(for: Movie.self) { movie in
+                MovieDetailView(viewModel: dependencies.makeMovieDetailViewModel(movieID: movie.id))
+            }
+        }
+        .environment(dependencies.favorites)
+    }
+}
