+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("ImageURLBuilder")
+struct ImageURLBuilderTests {
+    let builder = ImageURLBuilder()
+
+    @Test func defaultsToTMDBImageBaseURL() {
+        #expect(builder.baseURL == TMDBApp.imageBaseURL)
+    }
+
+    @Test(arguments: [
+        (ImageURLBuilder.Size.w185, "https://image.tmdb.org/t/p/w185/inception.jpg"),
+        (.w342, "https://image.tmdb.org/t/p/w342/inception.jpg"),
+        (.w780, "https://image.tmdb.org/t/p/w780/inception.jpg"),
+        (.original, "https://image.tmdb.org/t/p/original/inception.jpg")
+    ])
+    func buildsURLForEachSize(size: ImageURLBuilder.Size, expected: String) {
+        #expect(builder.url(path: "/inception.jpg", size: size)?.absoluteString == expected)
+    }
+
+    @Test func pathWithoutLeadingSlash() {
+        #expect(builder.url(path: "inception.jpg", size: .w342)?.absoluteString
+                == "https://image.tmdb.org/t/p/w342/inception.jpg")
+    }
+
+    @Test func nilOrEmptyPathGivesNil() {
+        #expect(builder.url(path: nil, size: .w342) == nil)
+        #expect(builder.url(path: "", size: .original) == nil)
+    }
+
+    @Test func customBaseURL() throws {
+        let custom = ImageURLBuilder(baseURL: try #require(URL(string: "https://cdn.example.test/img/")))
+        #expect(custom.url(path: "/a.jpg", size: .w185)?.absoluteString == "https://cdn.example.test/img/w185/a.jpg")
+    }
+}
