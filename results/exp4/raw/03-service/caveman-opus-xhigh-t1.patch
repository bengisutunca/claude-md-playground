+import Foundation
+@testable import TMDBApp
+
+/// In-memory `MovieService` for tests. Never touches the network.
+///
+/// Serves fixtures from `Fixtures/`:
+/// - `popular(page:)`       → `popular_page<page>` (pages 1 and 2 exist)
+/// - `search(query:page:)`  → `search_inception` if the query contains "inception" (case-insensitive), else `search_empty`
+/// - `detail(id:)`          → `movie_detail_<id>` (27205 exists)
+/// - `credits(id:)`         → `movie_credits_<id>` (27205 exists)
+///
+/// When `error` is set, every method throws it instead. Every call is recorded in `calls`,
+/// including calls that throw.
+final class MockMovieService: MovieService, @unchecked Sendable {
+    enum Call: Equatable, Sendable {
+        case popular(page: Int)
+        case search(query: String, page: Int)
+        case detail(id: Int)
+        case credits(id: Int)
+    }
+
+    private let lock = NSLock()
+    private var _error: (any Error)?
+    private var _calls: [Call] = []
+
+    init(error: (any Error)? = nil) {
+        _error = error
+    }
+
+    var error: (any Error)? {
+        get { lock.withLock { _error } }
+        set { lock.withLock { _error = newValue } }
+    }
+
+    var calls: [Call] { lock.withLock { _calls } }
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        try respond(to: .popular(page: page), fixture: "popular_page\(page)")
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        let fixture = query.localizedCaseInsensitiveContains("inception") ? "search_inception" : "search_empty"
+        return try respond(to: .search(query: query, page: page), fixture: fixture)
+    }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        try respond(to: .detail(id: id), fixture: "movie_detail_\(id)")
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        try respond(to: .credits(id: id), fixture: "movie_credits_\(id)")
+    }
+
+    private func respond<T: Decodable>(to call: Call, fixture: String) throws -> T {
+        let error = lock.withLock {
+            _calls.append(call)
+            return _error
+        }
+        if let error { throw error }
+        return try JSONDecoder.tmdb.decode(T.self, from: Fixture.data(fixture))
+    }
+}
