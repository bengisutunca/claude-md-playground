@@ -0,0 +1,95 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+/// `HTTPClient` that decodes one canned fixture (or throws one error) and records each endpoint sent.
+private final class MockHTTPClient: HTTPClient, @unchecked Sendable {
+    private let lock = NSLock()
+    private let result: Result<Data, any Error>
+    private var _endpoints: [Endpoint] = []
+
+    init(fixture: String) throws { result = .success(try Fixture.data(fixture)) }
+    init(error: any Error) { result = .failure(error) }
+
+    var endpoints: [Endpoint] { lock.withLock { _endpoints } }
+
+    func send<T: Decodable>(_ endpoint: Endpoint, as type: T.Type) async throws -> T {
+        lock.withLock { _endpoints.append(endpoint) }
+        return try JSONDecoder.tmdb.decode(T.self, from: result.get())
+    }
+}
+
+@Suite("TMDBMovieService")
+struct TMDBMovieServiceTests {
+    @Test func popularRequestsPageAndDecodes() async throws {
+        let client = try MockHTTPClient(fixture: "popular_page2")
+        let page = try await TMDBMovieService(client: client).popular(page: 2)
+        #expect(client.endpoints == [.popular(page: 2)])
+        #expect(page.page == 2)
+        #expect(page.results.map(\.title).contains("Spirited Away"))
+    }
+
+    @Test func searchRequestsQueryAndPage() async throws {
+        let client = try MockHTTPClient(fixture: "search_inception")
+        let page = try await TMDBMovieService(client: client).search(query: "Inception", page: 1)
+        #expect(client.endpoints == [.search(query: "Inception", page: 1)])
+        #expect(page.results.map(\.id) == [27205])
+    }
+
+    @Test func searchWithNoResults() async throws {
+        let client = try MockHTTPClient(fixture: "search_empty")
+        let page = try await TMDBMovieService(client: client).search(query: "zzzz", page: 1)
+        #expect(page.results.isEmpty)
+        #expect(page.totalResults == 0)
+    }
+
+    @Test func detailRequestsMovieDetail() async throws {
+        let client = try MockHTTPClient(fixture: "movie_detail_27205")
+        let detail = try await TMDBMovieService(client: client).detail(id: 27205)
+        #expect(client.endpoints == [.movieDetail(id: 27205)])
+        #expect(detail.id == 27205)
+        #expect(detail.runtime == 148)
+    }
+
+    @Test func creditsRequestsCredits() async throws {
+        let client = try MockHTTPClient(fixture: "movie_credits_27205")
+        let credits = try await TMDBMovieService(client: client).credits(id: 27205)
+        #expect(client.endpoints == [.credits(movieID: 27205)])
+        #expect(credits.cast.first?.name == "Leonardo DiCaprio")
+    }
+
+    @Test func clientErrorsPropagate() async throws {
+        let client = MockHTTPClient(error: APIError.httpStatus(code: 401, message: "Invalid API key"))
+        do {
+            _ = try await TMDBMovieService(client: client).popular(page: 1)
+            Issue.record("expected error")
+        } catch APIError.httpStatus(let code, let message) {
+            #expect(code == 401)
+            #expect(message == "Invalid API key")
+        }
+    }
+}
+
+@Suite("MockMovieService")
+struct MockMovieServiceTests {
+    @Test func servesFixturesAndRecordsCalls() async throws {
+        let mock = MockMovieService()
+        #expect(try await mock.popular(page: 1).results.count == 5)
+        #expect(try await mock.popular(page: 2).page == 2)
+        #expect(try await mock.search(query: "inception", page: 1).results.count == 1)
+        #expect(try await mock.search(query: "nothing", page: 1).results.isEmpty)
+        #expect(try await mock.detail(id: 27205).title == "Inception")
+        #expect(try await mock.credits(id: 27205).cast.count == 4)
+        #expect(mock.calls == [
+            .popular(page: 1), .popular(page: 2),
+            .search(query: "inception", page: 1), .search(query: "nothing", page: 1),
+            .detail(id: 27205), .credits(id: 27205)
+        ])
+    }
+
+    @Test func throwsConfiguredErrorAndStillRecords() async throws {
+        let mock = MockMovieService(error: URLError(.notConnectedToInternet))
+        await #expect(throws: URLError.self) { try await mock.detail(id: 1) }
+        #expect(mock.calls == [.detail(id: 1)])
+    }
+}
