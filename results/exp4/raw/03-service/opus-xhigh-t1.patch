@@ -0,0 +1,164 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+private struct StubError: Error, Equatable {}
+
+/// One `MovieService` method call, with the endpoint `TMDBMovieService` should send for it
+/// and a fixture body that decodes as its result type.
+private enum ServiceCall: CaseIterable, Sendable, CustomTestStringConvertible {
+    case popular, search, detail, credits
+
+    var endpoint: Endpoint {
+        switch self {
+        case .popular: .popular(page: 2)
+        case .search: .search(query: "Inception", page: 1)
+        case .detail: .movieDetail(id: 27205)
+        case .credits: .credits(movieID: 27205)
+        }
+    }
+
+    var fixture: String {
+        switch self {
+        case .popular: "popular_page2"
+        case .search: "search_inception"
+        case .detail: "movie_detail_27205"
+        case .credits: "movie_credits_27205"
+        }
+    }
+
+    func run(_ service: some MovieService) async throws {
+        switch self {
+        case .popular: _ = try await service.popular(page: 2)
+        case .search: _ = try await service.search(query: "Inception", page: 1)
+        case .detail: _ = try await service.detail(id: 27205)
+        case .credits: _ = try await service.credits(id: 27205)
+        }
+    }
+
+    var testDescription: String { "\(self)" }
+}
+
+@Suite("TMDBMovieService")
+struct TMDBMovieServiceTests {
+    @Test(arguments: ServiceCall.allCases)
+    fileprivate func sendsOneMatchingRequest(_ call: ServiceCall) async throws {
+        let client = MockHTTPClient(fixture: call.fixture)
+        try await call.run(TMDBMovieService(client: client))
+        #expect(client.endpoints == [call.endpoint])
+    }
+
+    @Test(arguments: ServiceCall.allCases)
+    fileprivate func propagatesClientErrors(_ call: ServiceCall) async throws {
+        let client = MockHTTPClient(error: StubError())
+        await #expect(throws: StubError()) {
+            try await call.run(TMDBMovieService(client: client))
+        }
+        #expect(client.endpoints == [call.endpoint])
+    }
+
+    @Test func passesAPIErrorThroughUnchanged() async throws {
+        let message = "Invalid API key: You must be granted a valid key."
+        let service = TMDBMovieService(client: MockHTTPClient(error: APIError.httpStatus(code: 401, message: message)))
+        do {
+            _ = try await service.popular(page: 1)
+            Issue.record("expected error")
+        } catch APIError.httpStatus(let code, let received) {
+            #expect(code == 401)
+            #expect(received == message)
+        }
+    }
+
+    @Test func popularDecodesPage() async throws {
+        let client = MockHTTPClient(fixture: "popular_page1")
+        let page = try await TMDBMovieService(client: client).popular(page: 1)
+        #expect(client.endpoints == [.popular(page: 1)])
+        #expect(page.page == 1)
+        #expect(page.totalPages == 2)
+        #expect(page.totalResults == 7)
+        #expect(page.results.map(\.id) == [27205, 157336, 155, 278, 550])
+    }
+
+    @Test func searchSendsQueryAsGiven() async throws {
+        let client = MockHTTPClient(fixture: "search_empty")
+        let page = try await TMDBMovieService(client: client).search(query: "the matrix & co", page: 3)
+        #expect(client.endpoints == [.search(query: "the matrix & co", page: 3)])
+        #expect(page.results.isEmpty)
+        #expect(page.totalResults == 0)
+    }
+
+    @Test func searchDecodesResults() async throws {
+        let client = MockHTTPClient(fixture: "search_inception")
+        let page = try await TMDBMovieService(client: client).search(query: "Inception", page: 1)
+        #expect(page.results.map(\.title) == ["Inception"])
+        #expect(page.totalPages == 1)
+    }
+
+    @Test func detailDecodes() async throws {
+        let client = MockHTTPClient(fixture: "movie_detail_27205")
+        let detail = try await TMDBMovieService(client: client).detail(id: 27205)
+        #expect(detail.id == 27205)
+        #expect(detail.title == "Inception")
+        #expect(detail.runtime == 148)
+        #expect(detail.genres.map(\.name) == ["Action", "Science Fiction", "Adventure"])
+    }
+
+    @Test func creditsDecodes() async throws {
+        let client = MockHTTPClient(fixture: "movie_credits_27205")
+        let credits = try await TMDBMovieService(client: client).credits(id: 27205)
+        #expect(credits.id == 27205)
+        #expect(credits.cast.map(\.name) == ["Leonardo DiCaprio", "Joseph Gordon-Levitt", "Elliot Page", "Tom Hardy"])
+        #expect(credits.crew.map(\.job) == ["Director"])
+    }
+}
+
+@Suite("MockMovieService")
+struct MockMovieServiceTests {
+    @Test func defaultsToFixtures() async throws {
+        let mock = MockMovieService()
+        #expect(try await mock.popular(page: 1).results.count == 5)
+        #expect(try await mock.popular(page: 2).page == 2)
+        #expect(try await mock.search(query: "inCEPtion", page: 1).results.map(\.id) == [27205])
+        #expect(try await mock.search(query: "nothing here", page: 1).results.isEmpty)
+        #expect(try await mock.detail(id: 27205).runtime == 148)
+        #expect(try await mock.credits(id: 27205).cast.count == 4)
+    }
+
+    @Test func recordsCallsInOrder() async throws {
+        let mock = MockMovieService()
+        _ = try await mock.popular(page: 1)
+        _ = try await mock.search(query: "Inception", page: 1)
+        _ = try await mock.detail(id: 27205)
+        _ = try await mock.credits(id: 27205)
+        #expect(mock.calls == [.popular(page: 1), .search(query: "Inception", page: 1), .detail(id: 27205), .credits(id: 27205)])
+        mock.resetCalls()
+        #expect(mock.calls.isEmpty)
+    }
+
+    @Test func configuredErrorFailsEveryMethodAndIsStillRecorded() async throws {
+        let mock = MockMovieService(error: StubError())
+        mock.popularResult = .success(PagedResponse(page: 1, results: [], totalPages: 1, totalResults: 0))
+        await #expect(throws: StubError()) { _ = try await mock.popular(page: 1) }
+        await #expect(throws: StubError()) { _ = try await mock.search(query: "x", page: 1) }
+        await #expect(throws: StubError()) { _ = try await mock.detail(id: 1) }
+        await #expect(throws: StubError()) { _ = try await mock.credits(id: 1) }
+        #expect(mock.calls.count == 4)
+
+        mock.error = nil
+        #expect(try await mock.popular(page: 1).results.isEmpty)
+    }
+
+    @Test func stubsOverrideFixtures() async throws {
+        let mock = MockMovieService()
+        let custom = PagedResponse(page: 7, results: [Movie(id: 1, title: "Custom")], totalPages: 9, totalResults: 1)
+        mock.popularResult = .success(custom)
+        mock.creditsResult = .failure(StubError())
+        #expect(try await mock.popular(page: 1) == custom)
+        await #expect(throws: StubError()) { _ = try await mock.credits(id: 27205) }
+        #expect(try await mock.detail(id: 27205).id == 27205)
+    }
+
+    @Test func unknownFixtureThrows() async {
+        await #expect(throws: Fixture.FixtureError.self) { _ = try await MockMovieService().detail(id: 1) }
+    }
+}
