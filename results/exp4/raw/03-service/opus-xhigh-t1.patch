+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("ImageURLBuilder")
+struct ImageURLBuilderTests {
+    let builder = ImageURLBuilder()
+
+    @Test func defaultBaseURLIsTMDBImageBase() {
+        #expect(builder.baseURL == TMDBApp.imageBaseURL)
+    }
+
+    @Test func buildsFullURL() {
+        #expect(builder.url(path: "/inception.jpg", size: .w342)?.absoluteString
+                == "https://image.tmdb.org/t/p/w342/inception.jpg")
+    }
+
+    @Test func sizeRawValues() {
+        #expect(ImageURLBuilder.Size.allCases.map(\.rawValue) == ["w185", "w342", "w780", "original"])
+    }
+
+    @Test(arguments: ImageURLBuilder.Size.allCases)
+    func sizeIsAPathSegment(_ size: ImageURLBuilder.Size) {
+        #expect(builder.url(path: "/inception.jpg", size: size)?.absoluteString
+                == "https://image.tmdb.org/t/p/\(size.rawValue)/inception.jpg")
+    }
+
+    @Test(arguments: [nil, "", "   ", "/"] as [String?])
+    func missingPathGivesNil(_ path: String?) {
+        #expect(builder.url(path: path, size: .w185) == nil)
+    }
+
+    @Test func leadingSlashIsOptional() {
+        #expect(builder.url(path: "inception.jpg", size: .w780)?.absoluteString
+                == "https://image.tmdb.org/t/p/w780/inception.jpg")
+    }
+
+    @Test func customBaseURLWithTrailingSlash() {
+        let custom = ImageURLBuilder(baseURL: URL(string: "https://cdn.example.test/img/")!)
+        #expect(custom.url(path: "/poster.jpg", size: .original)?.absoluteString
+                == "https://cdn.example.test/img/original/poster.jpg")
+    }
+
+    @Test func fixturePosterPaths() throws {
+        let page = try Fixture.decode(PagedResponse<Movie>.self, "popular_page1")
+        let urls = page.results.map { builder.url(path: $0.posterPath, size: .w185)?.absoluteString }
+        #expect(urls == [
+            "https://image.tmdb.org/t/p/w185/inception.jpg",
+            "https://image.tmdb.org/t/p/w185/interstellar.jpg",
+            "https://image.tmdb.org/t/p/w185/dark_knight.jpg",
+            "https://image.tmdb.org/t/p/w185/shawshank.jpg",
+            nil, // Fight Club has a null poster_path
+        ])
+    }
+}
diff --git a/Tests/TMDBAppTests/MockHTTPClient.swift b/Tests/TMDBAppTests/MockHTTPClient.swift
new file mode 100644
index 0000000..8ff769a
--- /dev/null
+++ b/Tests/TMDBAppTests/MockHTTPClient.swift
@@ -0,0 +1,33 @@
+import Foundation
+@testable import TMDBApp
+
+/// `HTTPClient` that records every endpoint it is asked for and answers from a handler
+/// (fixture data or a thrown error). Never touches the network.
+final class MockHTTPClient: HTTPClient, @unchecked Sendable {
+    private let lock = NSLock()
+    private var _endpoints: [Endpoint] = []
+    private let handler: @Sendable (Endpoint) throws -> Data
+
+    /// - Parameter handler: returns the JSON body for an endpoint, or throws to simulate a failure.
+    init(handler: @escaping @Sendable (Endpoint) throws -> Data) {
+        self.handler = handler
+    }
+
+    /// Answers every request with the named fixture.
+    convenience init(fixture name: String) {
+        self.init { _ in try Fixture.data(name) }
+    }
+
+    /// Fails every request with `error`.
+    convenience init(error: any Error) {
+        self.init { _ in throw error }
+    }
+
+    /// Endpoints requested so far, in order.
+    var endpoints: [Endpoint] { lock.withLock { _endpoints } }
+
+    func send<T: Decodable>(_ endpoint: Endpoint, as type: T.Type) async throws -> T {
+        lock.withLock { _endpoints.append(endpoint) }
+        return try JSONDecoder.tmdb.decode(T.self, from: handler(endpoint))
+    }
+}
