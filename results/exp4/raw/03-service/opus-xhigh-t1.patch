@@ -0,0 +1,26 @@
+import Foundation
+
+/// Builds TMDB image URLs: `<baseURL>/<size>/<file>`, e.g.
+/// `https://image.tmdb.org/t/p/w342/inception.jpg`.
+struct ImageURLBuilder: Sendable {
+    enum Size: String, CaseIterable, Sendable {
+        case w185, w342, w780, original
+    }
+
+    let baseURL: URL
+
+    init(baseURL: URL = TMDBApp.imageBaseURL) {
+        self.baseURL = baseURL
+    }
+
+    /// - Parameter path: a TMDB image path such as `"/inception.jpg"` (the leading slash is optional).
+    /// - Returns: nil when `path` is nil, empty, or only whitespace/slashes.
+    func url(path: String?, size: Size) -> URL? {
+        guard let trimmed = path?.trimmingCharacters(in: .whitespacesAndNewlines) else { return nil }
+        let file = trimmed.drop(while: { $0 == "/" })
+        guard !file.isEmpty else { return nil }
+        return baseURL
+            .appending(path: size.rawValue, directoryHint: .notDirectory)
+            .appending(path: String(file), directoryHint: .notDirectory)
+    }
+}
