@@ -0,0 +1,106 @@
+import Foundation
+@testable import TMDBApp
+
+/// Reusable `MovieService` test double.
+///
+/// Resolution for every method, in order:
+/// 1. `error`, when set, is thrown.
+/// 2. The method's stub (`popularResult`, `searchResult`, `detailResult`, `creditsResult`), when set.
+/// 3. Fixture data from `Tests/TMDBAppTests/Fixtures/`:
+///    - `popular(page:)`      → `popular_page<page>` (pages 1 and 2 exist)
+///    - `search(query:page:)` → `search_inception` if the query contains "inception"
+///                              (case-insensitive), otherwise `search_empty`
+///    - `detail(id:)`         → `movie_detail_<id>` (27205 exists)
+///    - `credits(id:)`        → `movie_credits_<id>` (27205 exists)
+///    A missing fixture throws `Fixture.FixtureError.missing`.
+///
+/// Every call is recorded in `calls` before it resolves, including calls that throw.
+final class MockMovieService: MovieService, @unchecked Sendable {
+    enum Call: Equatable, Sendable {
+        case popular(page: Int)
+        case search(query: String, page: Int)
+        case detail(id: Int)
+        case credits(id: Int)
+    }
+
+    private let lock = NSLock()
+    private var _calls: [Call] = []
+    private var _error: (any Error)?
+    private var _popularResult: Result<PagedResponse<Movie>, any Error>?
+    private var _searchResult: Result<PagedResponse<Movie>, any Error>?
+    private var _detailResult: Result<MovieDetail, any Error>?
+    private var _creditsResult: Result<Credits, any Error>?
+
+    init(error: (any Error)? = nil) {
+        _error = error
+    }
+
+    // MARK: Configuration and recorded calls
+
+    /// Calls received so far, in order.
+    var calls: [Call] { lock.withLock { _calls } }
+
+    /// When set, every method throws this error.
+    var error: (any Error)? {
+        get { lock.withLock { _error } }
+        set { lock.withLock { _error = newValue } }
+    }
+
+    var popularResult: Result<PagedResponse<Movie>, any Error>? {
+        get { lock.withLock { _popularResult } }
+        set { lock.withLock { _popularResult = newValue } }
+    }
+
+    var searchResult: Result<PagedResponse<Movie>, any Error>? {
+        get { lock.withLock { _searchResult } }
+        set { lock.withLock { _searchResult = newValue } }
+    }
+
+    var detailResult: Result<MovieDetail, any Error>? {
+        get { lock.withLock { _detailResult } }
+        set { lock.withLock { _detailResult = newValue } }
+    }
+
+    var creditsResult: Result<Credits, any Error>? {
+        get { lock.withLock { _creditsResult } }
+        set { lock.withLock { _creditsResult = newValue } }
+    }
+
+    /// Forgets recorded calls; configuration is kept.
+    func resetCalls() {
+        lock.withLock { _calls.removeAll() }
+    }
+
+    // MARK: MovieService
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        try resolve(.popular(page: page), stub: \._popularResult, fixture: "popular_page\(page)")
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        let fixture = query.localizedCaseInsensitiveContains("inception") ? "search_inception" : "search_empty"
+        return try resolve(.search(query: query, page: page), stub: \._searchResult, fixture: fixture)
+    }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        try resolve(.detail(id: id), stub: \._detailResult, fixture: "movie_detail_\(id)")
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        try resolve(.credits(id: id), stub: \._creditsResult, fixture: "movie_credits_\(id)")
+    }
+
+    private func resolve<T: Decodable>(
+        _ call: Call,
+        stub: KeyPath<MockMovieService, Result<T, any Error>?>,
+        fixture: String
+    ) throws -> T {
+        let (error, result) = lock.withLock {
+            _calls.append(call)
+            return (_error, self[keyPath: stub])
+        }
+        if let error { throw error }
+        if let result { return try result.get() }
+        return try Fixture.decode(T.self, fixture)
+    }
+}
