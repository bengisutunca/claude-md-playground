@@ -0,0 +1,13 @@
+/// Data access for movies, used by view models. Implementations throw the errors of the
+/// layer below (for `TMDBMovieService`, `APIError`).
+protocol MovieService: Sendable {
+    /// Popular movies, 1-based `page`.
+    func popular(page: Int) async throws -> PagedResponse<Movie>
+
+    /// Movies whose title matches `query`, 1-based `page`. The query is sent as given.
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie>
+
+    func detail(id: Int) async throws -> MovieDetail
+
+    func credits(id: Int) async throws -> Credits
+}
diff --git a/Sources/TMDBApp/Services/TMDBMovieService.swift b/Sources/TMDBApp/Services/TMDBMovieService.swift
