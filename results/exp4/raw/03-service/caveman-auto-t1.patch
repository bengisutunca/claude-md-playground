+import Foundation
+import Testing
+@testable import TMDBApp
+
+/// `HTTPClient` double: decodes a fixture (or throws a configured error) and records endpoints.
+private final class MockHTTPClient: HTTPClient, @unchecked Sendable {
+    private let lock = NSLock()
+    private var _endpoints: [Endpoint] = []
+    private let fixture: String?
+    private let error: Error?
+
+    var endpoints: [Endpoint] { lock.withLock { _endpoints } }
+
+    init(fixture: String) {
+        self.fixture = fixture
+        self.error = nil
+    }
+
+    init(error: Error) {
+        self.fixture = nil
+        self.error = error
+    }
+
+    func send<T: Decodable>(_ endpoint: Endpoint, as type: T.Type) async throws -> T {
+        lock.withLock { _endpoints.append(endpoint) }
+        if let error { throw error }
+        return try JSONDecoder.tmdb.decode(T.self, from: Fixture.data(fixture!))
+    }
+}
+
+@Suite("TMDBMovieService")
+struct TMDBMovieServiceTests {
+    @Test func popularSendsPopularEndpoint() async throws {
+        let client = MockHTTPClient(fixture: "popular_page2")
+        let page = try await TMDBMovieService(client: client).popular(page: 2)
+        #expect(client.endpoints == [.popular(page: 2)])
+        #expect(page.page == 2)
+        #expect(page.results.count == 2)
+    }
+
+    @Test func searchSendsSearchEndpoint() async throws {
+        let client = MockHTTPClient(fixture: "search_inception")
+        let page = try await TMDBMovieService(client: client).search(query: "inception", page: 1)
+        #expect(client.endpoints == [.search(query: "inception", page: 1)])
+        #expect(page.results.first?.id == 27205)
+    }
+
+    @Test func searchEmptyResults() async throws {
+        let client = MockHTTPClient(fixture: "search_empty")
+        let page = try await TMDBMovieService(client: client).search(query: "zzzz", page: 1)
+        #expect(page.results.isEmpty)
+        #expect(page.totalResults == 0)
+    }
+
+    @Test func detailSendsDetailEndpoint() async throws {
+        let client = MockHTTPClient(fixture: "movie_detail_27205")
+        let detail = try await TMDBMovieService(client: client).detail(id: 27205)
+        #expect(client.endpoints == [.movieDetail(id: 27205)])
+        #expect(detail.id == 27205)
+        #expect(detail.title == "Inception")
+    }
+
+    @Test func creditsSendsCreditsEndpoint() async throws {
+        let client = MockHTTPClient(fixture: "movie_credits_27205")
+        let credits = try await TMDBMovieService(client: client).credits(id: 27205)
+        #expect(client.endpoints == [.credits(movieID: 27205)])
+        #expect(credits.id == 27205)
+        #expect(credits.cast.first?.name == "Leonardo DiCaprio")
+    }
+
+    @Test func propagatesClientErrors() async throws {
+        let client = MockHTTPClient(error: APIError.httpStatus(code: 401, message: "nope"))
+        let service = TMDBMovieService(client: client)
+        do {
+            _ = try await service.popular(page: 1)
+            Issue.record("expected error")
+        } catch APIError.httpStatus(let code, let message) {
+            #expect(code == 401)
+            #expect(message == "nope")
+        }
+    }
+}
+
+@Suite("ImageURLBuilder")
+struct ImageURLBuilderTests {
+    let builder = ImageURLBuilder()
+
+    @Test func buildsURLForEachSize() {
+        #expect(builder.url(path: "/inception.jpg", size: .w185)?.absoluteString == "https://image.tmdb.org/t/p/w185/inception.jpg")
+        #expect(builder.url(path: "/inception.jpg", size: .w342)?.absoluteString == "https://image.tmdb.org/t/p/w342/inception.jpg")
+        #expect(builder.url(path: "/inception.jpg", size: .w780)?.absoluteString == "https://image.tmdb.org/t/p/w780/inception.jpg")
+        #expect(builder.url(path: "/inception.jpg", size: .original)?.absoluteString == "https://image.tmdb.org/t/p/original/inception.jpg")
+    }
+
+    @Test func nilOrEmptyPathGivesNil() {
+        #expect(builder.url(path: nil, size: .w342) == nil)
+        #expect(builder.url(path: "", size: .w342) == nil)
+    }
+
+    @Test func customBaseURL() {
+        let custom = ImageURLBuilder(baseURL: URL(string: "https://cdn.example.test/img")!)
+        #expect(custom.url(path: "/a.jpg", size: .w185)?.absoluteString == "https://cdn.example.test/img/w185/a.jpg")
+    }
+}
+
+@Suite("MockMovieService")
+struct MockMovieServiceTests {
+    @Test func servesFixturesAndRecordsCalls() async throws {
+        let mock = try MockMovieService()
+        #expect(try await mock.popular(page: 1).page == 1)
+        #expect(try await mock.popular(page: 2).page == 2)
+        #expect(try await mock.search(query: "inception", page: 1).results.first?.id == 27205)
+        #expect(try await mock.detail(id: 27205).id == 27205)
+        #expect(try await mock.credits(id: 27205).id == 27205)
+        #expect(mock.calls == [
+            .popular(page: 1), .popular(page: 2), .search(query: "inception", page: 1),
+            .detail(id: 27205), .credits(id: 27205),
+        ])
+    }
+
+    @Test func throwsConfiguredError() async throws {
+        let mock = try MockMovieService(error: APIError.missingAPIKey)
+        await #expect(throws: APIError.self) { try await mock.detail(id: 1) }
+        #expect(mock.calls == [.detail(id: 1)])
+    }
+}
