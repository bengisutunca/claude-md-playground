+import Foundation
+@testable import TMDBApp
+
+/// Test double for `MovieService`: serves fixture data (or a configured error) and records every call.
+final class MockMovieService: MovieService, @unchecked Sendable {
+    enum Call: Equatable {
+        case popular(page: Int)
+        case search(query: String, page: Int)
+        case detail(id: Int)
+        case credits(id: Int)
+    }
+
+    private let lock = NSLock()
+    private var _calls: [Call] = []
+    private var _error: Error?
+
+    // Canned responses: set these before handing the mock to the code under test.
+    /// Popular responses keyed by page; requesting a missing page throws `APIError.invalidResponse`.
+    var popularPages: [Int: PagedResponse<Movie>]
+    var searchResponse: PagedResponse<Movie>
+    var detailResponse: MovieDetail
+    var creditsResponse: Credits
+
+    /// Calls received so far, in order.
+    var calls: [Call] { lock.withLock { _calls } }
+
+    /// When set, every method throws this error (the call is still recorded).
+    var error: Error? {
+        get { lock.withLock { _error } }
+        set { lock.withLock { _error = newValue } }
+    }
+
+    init(error: Error? = nil) throws {
+        popularPages = [
+            1: try Self.decode("popular_page1"),
+            2: try Self.decode("popular_page2"),
+        ]
+        searchResponse = try Self.decode("search_inception")
+        detailResponse = try Self.decode("movie_detail_27205")
+        creditsResponse = try Self.decode("movie_credits_27205")
+        _error = error
+    }
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        try record(.popular(page: page))
+        guard let response = popularPages[page] else { throw APIError.invalidResponse }
+        return response
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        try record(.search(query: query, page: page))
+        return searchResponse
+    }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        try record(.detail(id: id))
+        return detailResponse
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        try record(.credits(id: id))
+        return creditsResponse
+    }
+
+    private func record(_ call: Call) throws {
+        let error = lock.withLock { () -> Error? in
+            _calls.append(call)
+            return _error
+        }
+        if let error { throw error }
+    }
+
+    private static func decode<T: Decodable>(_ name: String) throws -> T {
+        try JSONDecoder.tmdb.decode(T.self, from: Fixture.data(name))
+    }
+}
