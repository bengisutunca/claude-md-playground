+++ b/Tests/TMDBAppTests/SearchViewModelTests.swift
@@ -0,0 +1,77 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+/// Stand-in for the debounce sleep: records the requested delay and returns immediately.
+private actor SleepRecorder {
+    private(set) var durations: [Duration] = []
+    func sleep(_ duration: Duration) { durations.append(duration) }
+}
+
+@MainActor
+@Suite("SearchViewModel")
+struct SearchViewModelTests {
+    private let service: MockMovieService
+    private let sleeper = SleepRecorder()
+    private let vm: SearchViewModel
+
+    init() {
+        service = MockMovieService()
+        vm = SearchViewModel(service: service, sleep: { [sleeper] in await sleeper.sleep($0) })
+    }
+
+    @Test(arguments: ["", "a", "  a  ", " \n "])
+    func shortQueryDoesNotCallService(query: String) async {
+        vm.query = query
+        await vm.waitForSearch()
+        #expect(vm.state == .idle)
+        #expect(await service.calls.isEmpty)
+        #expect(await sleeper.durations.isEmpty)
+    }
+
+    @Test func shortQueryClearsResults() async {
+        vm.query = "inception"
+        await vm.waitForSearch()
+        guard case .loaded = vm.state else { Issue.record("expected loaded, got \(vm.state)"); return }
+
+        vm.query = "i"
+        #expect(vm.state == .idle)
+        await vm.waitForSearch()
+        #expect(vm.state == .idle)
+        #expect(await service.calls == [.search(query: "inception", page: 1)])
+    }
+
+    @Test func rapidTypingTriggersOneSearch() async {
+        for query in ["in", "inc", "ince", "incep", "incept", "inception"] {
+            vm.query = query
+        }
+        await vm.waitForSearch()
+        #expect(await service.calls == [.search(query: "inception", page: 1)])
+    }
+
+    @Test func searchInceptionLoadsResults() async {
+        vm.query = "  inception "
+        await vm.waitForSearch()
+        guard case .loaded(let movies) = vm.state else {
+            Issue.record("expected loaded, got \(vm.state)"); return
+        }
+        #expect(movies.first?.id == 27205)
+        #expect(movies.first?.title == "Inception")
+        #expect(await service.calls == [.search(query: "inception", page: 1)])
+        #expect(await sleeper.durations == [.milliseconds(300)])
+    }
+
+    @Test func emptyResultIsEmptyState() async {
+        vm.query = "empty"
+        await vm.waitForSearch()
+        #expect(vm.state == .empty)
+        #expect(await service.calls == [.search(query: "empty", page: 1)])
+    }
+
+    @Test func errorState() async {
+        await service.setError(APIError.httpStatus(code: 401, message: "bad key"))
+        vm.query = "inception"
+        await vm.waitForSearch()
+        #expect(vm.state == .failed("Invalid API key."))
+    }
+}
