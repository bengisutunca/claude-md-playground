+import Foundation
+import Observation
+
+@MainActor
+@Observable
+final class SearchViewModel {
+    /// Queries shorter than this, after trimming whitespace, are not sent to the service.
+    nonisolated static let minimumQueryLength = 2
+
+    /// Bound to the search field. Every change schedules a new debounced search.
+    var query = "" {
+        didSet { scheduleSearch(debounced: true) }
+    }
+    private(set) var state: ViewState<[Movie]> = .idle
+
+    @ObservationIgnored private let service: any MovieService
+    @ObservationIgnored private let debounce: Duration
+    @ObservationIgnored private let sleep: @Sendable (Duration) async throws -> Void
+    @ObservationIgnored private var searchTask: Task<Void, Never>?
+
+    /// - Parameter sleep: Waits out the debounce. Tests inject a fake so they never wait in real time.
+    init(service: any MovieService,
+         debounce: Duration = .milliseconds(300),
+         sleep: @escaping @Sendable (Duration) async throws -> Void = { try await Task.sleep(for: $0) }) {
+        self.service = service
+        self.debounce = debounce
+        self.sleep = sleep
+    }
+
+    /// Returns once the currently scheduled search, if any, has finished.
+    func waitForSearch() async {
+        await searchTask?.value
+    }
+
+    /// Runs the search for the current query again, without the debounce.
+    func retry() {
+        scheduleSearch(debounced: false)
+    }
+
+    /// Cancels the previous search, so only the latest query reaches the service.
+    private func scheduleSearch(debounced: Bool) {
+        searchTask?.cancel()
+        searchTask = nil
+        let term = query.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard term.count >= Self.minimumQueryLength else {
+            state = .idle
+            return
+        }
+        searchTask = Task { await self.search(term, debounced: debounced) }
+    }
+
+    private func search(_ term: String, debounced: Bool) async {
+        if debounced {
+            do { try await self.sleep(debounce) } catch { return }
+        }
+        // `sleep` may return normally even after a newer query cancelled this search.
+        guard !Task.isCancelled else { return }
+        state = .loading
+        do {
+            let response = try await service.search(query: term, page: 1)
+            guard !Task.isCancelled else { return }
+            state = response.results.isEmpty ? .empty : .loaded(response.results)
+        } catch {
+            guard !Task.isCancelled else { return }
+            state = .failed(MovieListViewModel.message(for: error))
+        }
+    }
+}
