diff --git a/Sources/TMDBApp/ViewModels/SearchViewModel.swift b/Sources/TMDBApp/ViewModels/SearchViewModel.swift
new file mode 100644
index 0000000..ccb21a7
--- /dev/null
+++ b/Sources/TMDBApp/ViewModels/SearchViewModel.swift
@@ -0,0 +1,56 @@
+import Foundation
+import Observation
+
+@MainActor
+@Observable
+final class SearchViewModel {
+    /// Setting this schedules a debounced search, cancelling any search scheduled before it.
+    var query: String = "" {
+        didSet { if query != oldValue { scheduleSearch() } }
+    }
+    private(set) var state: ViewState<[Movie]> = .idle
+
+    static let minimumQueryLength = 2
+
+    @ObservationIgnored private let service: any MovieService
+    @ObservationIgnored private let debounce: Duration
+    @ObservationIgnored private let sleep: @Sendable (Duration) async throws -> Void
+    @ObservationIgnored private var searchTask: Task<Void, Never>?
+
+    init(service: any MovieService,
+         debounce: Duration = .milliseconds(300),
+         sleep: @escaping @Sendable (Duration) async throws -> Void = { try await Task.sleep(for: $0) }) {
+        self.service = service
+        self.debounce = debounce
+        self.sleep = sleep
+    }
+
+    /// Returns once the currently scheduled search, if any, has finished.
+    func waitForSearch() async {
+        await searchTask?.value
+    }
+
+    private func scheduleSearch() {
+        searchTask?.cancel()
+        searchTask = nil
+        let trimmed = query.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard trimmed.count >= Self.minimumQueryLength else {
+            state = .idle
+            return
+        }
+        state = .loading
+        searchTask = Task { [weak self, service, debounce, sleep] in
+            // An injected sleep may not throw on cancellation, so check explicitly too.
+            do { try await sleep(debounce) } catch { return }
+            guard !Task.isCancelled else { return }
+            do {
+                let response = try await service.search(query: trimmed, page: 1)
+                guard !Task.isCancelled, let self else { return }
+                self.state = response.results.isEmpty ? .empty : .loaded(response.results)
+            } catch {
+                guard !Task.isCancelled, !(error is CancellationError), let self else { return }
+                self.state = .failed(ErrorMessage.text(for: error))
+            }
+        }
+    }
+}
diff --git a/Sources/TMDBApp/Views/SearchView.swift b/Sources/TMDBApp/Views/SearchView.swift
