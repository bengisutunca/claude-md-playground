+++ b/Tests/TMDBAppTests/SearchViewModelTests.swift
@@ -0,0 +1,80 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+/// Records debounce sleeps without actually waiting.
+private actor SleepRecorder {
+    private(set) var durations: [Duration] = []
+    func record(_ duration: Duration) { durations.append(duration) }
+}
+
+@MainActor
+@Suite("SearchViewModel")
+struct SearchViewModelTests {
+    private func makeViewModel(service: MockMovieService, recorder: SleepRecorder = SleepRecorder()) -> SearchViewModel {
+        SearchViewModel(service: service, sleep: { await recorder.record($0) })
+    }
+
+    @Test func shortQueryDoesNotCallService() async {
+        let service = MockMovieService()
+        let recorder = SleepRecorder()
+        let vm = makeViewModel(service: service, recorder: recorder)
+        vm.query = " a "
+        await vm.waitForSearch()
+        #expect(vm.state == .idle)
+        #expect(await service.calls.isEmpty)
+        #expect(await recorder.durations.isEmpty)
+    }
+
+    @Test func shortQueryClearsPreviousResults() async {
+        let service = MockMovieService()
+        let vm = makeViewModel(service: service)
+        vm.query = "inception"
+        await vm.waitForSearch()
+        guard case .loaded = vm.state else { Issue.record("expected loaded"); return }
+        vm.query = "i"
+        await vm.waitForSearch()
+        #expect(vm.state == .idle)
+        #expect(await service.calls == [.search(query: "inception", page: 1)])
+    }
+
+    @Test func rapidTypingTriggersOneSearch() async {
+        let service = MockMovieService()
+        let recorder = SleepRecorder()
+        let vm = makeViewModel(service: service, recorder: recorder)
+        for prefix in ["in", "inc", "ince", "incep", "inception"] {
+            vm.query = prefix
+        }
+        await vm.waitForSearch()
+        #expect(await service.calls == [.search(query: "inception", page: 1)])
+        #expect(await recorder.durations.allSatisfy { $0 == .milliseconds(300) })
+        guard case .loaded = vm.state else { Issue.record("expected loaded"); return }
+    }
+
+    @Test func searchInceptionLoadsResults() async {
+        let service = MockMovieService()
+        let vm = makeViewModel(service: service)
+        vm.query = "  inception "
+        await vm.waitForSearch()
+        guard case .loaded(let movies) = vm.state else { Issue.record("expected loaded"); return }
+        #expect(movies.map(\.id) == [27205])
+        #expect(movies.first?.title == "Inception")
+        #expect(await service.calls == [.search(query: "inception", page: 1)])
+    }
+
+    @Test func emptyResultIsEmptyState() async {
+        let service = MockMovieService()
+        let vm = makeViewModel(service: service)
+        vm.query = "empty"
+        await vm.waitForSearch()
+        #expect(vm.state == .empty)
+    }
+
+    @Test func errorState() async {
+        let service = MockMovieService(error: APIError.httpStatus(code: 401, message: "bad key"))
+        let vm = makeViewModel(service: service)
+        vm.query = "inception"
+        await vm.waitForSearch()
+        #expect(vm.state == .failed("Invalid API key."))
+    }
+}
