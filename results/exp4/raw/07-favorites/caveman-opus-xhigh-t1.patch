diff --git a/Tests/TMDBAppTests/FavoritesTests.swift b/Tests/TMDBAppTests/FavoritesTests.swift
new file mode 100644
index 0000000..b05e092
--- /dev/null
+++ b/Tests/TMDBAppTests/FavoritesTests.swift
@@ -0,0 +1,121 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+/// A `UserDefaults` suite unique to one test; its domain is deleted when this object is released.
+final class TemporaryDefaultsSuite {
+    let name = "TMDBAppTests.favorites.\(UUID().uuidString)"
+
+    /// A new `UserDefaults` handle on this suite.
+    func makeDefaults() -> UserDefaults { UserDefaults(suiteName: name)! }
+
+    deinit {
+        UserDefaults.standard.removePersistentDomain(forName: name)
+        // cfprefsd leaves an empty plist behind on macOS; remove it so test runs don't accumulate files.
+        let plist = FileManager.default.urls(for: .libraryDirectory, in: .userDomainMask)[0]
+            .appendingPathComponent("Preferences/\(name).plist")
+        try? FileManager.default.removeItem(at: plist)
+    }
+}
+
+@MainActor
+@Suite("Favorites")
+struct FavoritesTests {
+    /// Swift Testing creates a new suite instance per test, so each test gets a fresh suite.
+    private let suite = TemporaryDefaultsSuite()
+
+    /// Inception, Interstellar, The Dark Knight, The Shawshank Redemption, Fight Club,
+    /// Spirited Away, Parasite (no release date).
+    private func movies() throws -> [Movie] {
+        try ["popular_page1", "popular_page2"].flatMap {
+            try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data($0)).results
+        }
+    }
+
+    private func makeStore() -> UserDefaultsFavoritesStore {
+        UserDefaultsFavoritesStore(defaults: suite.makeDefaults())
+    }
+
+    @Test func toggleOnAndOff() throws {
+        let inception = try #require(movies().first)
+        let store = makeStore()
+        let vm = FavoritesViewModel(store: store)
+        #expect(vm.favorites.isEmpty)
+        #expect(!vm.isFavorite(inception))
+
+        vm.toggle(inception)
+        #expect(vm.isFavorite(inception))
+        #expect(vm.favorites == [inception])
+        #expect(store.load() == [inception])
+
+        vm.toggle(inception)
+        #expect(!vm.isFavorite(inception))
+        #expect(vm.favorites.isEmpty)
+        #expect(store.load().isEmpty)
+    }
+
+    @Test func persistsFullMoviesAcrossStoreInstances() throws {
+        let all = try movies()
+        // Fight Club (nil poster) and Parasite (nil release date) cover the optional fields.
+        let picked = all.filter { [27205, 550, 496243].contains($0.id) }
+        #expect(picked.count == 3)
+        let vm = FavoritesViewModel(store: makeStore())
+        picked.forEach(vm.toggle)
+
+        let reloaded = FavoritesViewModel(store: makeStore())
+        #expect(reloaded.favorites == picked)
+        #expect(reloaded.favorites.map(\.title) == ["Inception", "Fight Club", "Parasite"])
+        #expect(reloaded.favorites[0].releaseDate == picked[0].releaseDate)
+        #expect(reloaded.favorites[0].genreIDs == [28, 878, 12])
+    }
+
+    @Test func keepsInsertionOrder() throws {
+        let all = try movies()
+        let order = [all[3], all[0], all[6], all[1]]
+        let vm = FavoritesViewModel(store: makeStore())
+        order.forEach(vm.toggle)
+        #expect(vm.favorites.map(\.id) == order.map(\.id))
+
+        // Re-adding a removed movie puts it at the end.
+        vm.toggle(all[0])
+        vm.toggle(all[0])
+        #expect(vm.favorites.map(\.id) == [all[3], all[6], all[1], all[0]].map(\.id))
+        #expect(FavoritesViewModel(store: makeStore()).favorites.map(\.id) == vm.favorites.map(\.id))
+    }
+
+    @Test func removeAtOffsets() throws {
+        let all = try movies()
+        let vm = FavoritesViewModel(store: makeStore())
+        all.prefix(4).forEach(vm.toggle)
+
+        vm.remove(at: IndexSet([0, 2]))
+        #expect(vm.favorites.map(\.id) == [all[1].id, all[3].id])
+        #expect(!vm.isFavorite(all[0]))
+        #expect(FavoritesViewModel(store: makeStore()).favorites.map(\.id) == [all[1].id, all[3].id])
+    }
+
+    @Test func noDuplicates() throws {
+        let inception = try #require(movies().first)
+        let vm = FavoritesViewModel(store: makeStore())
+        vm.toggle(inception)
+
+        // The same movie from another source (e.g. search) matches by id, so toggling removes it.
+        let sameID = Movie(id: inception.id, title: inception.title, voteAverage: 1)
+        #expect(vm.isFavorite(sameID))
+        vm.toggle(sameID)
+        #expect(vm.favorites.isEmpty)
+
+        // A view model loaded from the store sees existing favorites instead of appending again.
+        vm.toggle(inception)
+        let reloaded = FavoritesViewModel(store: makeStore())
+        #expect(reloaded.isFavorite(inception))
+        reloaded.toggle(inception)
+        #expect(reloaded.favorites.isEmpty)
+        #expect(makeStore().load().isEmpty)
+    }
+
+    @Test func unreadableDataLoadsAsEmpty() {
+        suite.makeDefaults().set(Data("not json".utf8), forKey: "favorites.movies")
+        #expect(makeStore().load().isEmpty)
+    }
+}
