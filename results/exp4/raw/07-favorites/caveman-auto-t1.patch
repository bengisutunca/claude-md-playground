diff --git a/Tests/TMDBAppTests/FavoritesTests.swift b/Tests/TMDBAppTests/FavoritesTests.swift
new file mode 100644
index 0000000..568e512
--- /dev/null
+++ b/Tests/TMDBAppTests/FavoritesTests.swift
@@ -0,0 +1,108 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+/// Each test gets its own `UserDefaults` suite, removed in `deinit`.
+@MainActor
+@Suite("Favorites")
+final class FavoritesTests {
+    private let suiteName = "FavoritesTests.\(UUID().uuidString)"
+    private let defaults: UserDefaults
+
+    init() throws {
+        defaults = try #require(UserDefaults(suiteName: suiteName))
+    }
+
+    deinit {
+        UserDefaults().removePersistentDomain(forName: suiteName)
+    }
+
+    private func makeStore() -> UserDefaultsFavoritesStore {
+        UserDefaultsFavoritesStore(defaults: defaults)
+    }
+
+    private func movies() throws -> [Movie] {
+        try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page1")).results
+    }
+
+    @Test func startsEmpty() {
+        #expect(FavoritesViewModel(store: makeStore()).favorites.isEmpty)
+    }
+
+    @Test func toggleOnAndOff() throws {
+        let movie = try #require(try movies().first)
+        let vm = FavoritesViewModel(store: makeStore())
+
+        vm.toggle(movie)
+        #expect(vm.isFavorite(movie))
+        #expect(vm.favorites == [movie])
+        #expect(makeStore().load() == [movie])
+
+        vm.toggle(movie)
+        #expect(!vm.isFavorite(movie))
+        #expect(vm.favorites.isEmpty)
+        #expect(makeStore().load().isEmpty)
+    }
+
+    @Test func persistsFullMoviesAcrossStoreInstances() throws {
+        let all = try movies()
+        let vm = FavoritesViewModel(store: makeStore())
+        all.forEach(vm.toggle)
+
+        // Fresh store and view model on the same suite.
+        let reloaded = FavoritesViewModel(store: makeStore())
+        #expect(reloaded.favorites == all)
+        // Includes nil image paths and release dates surviving the round trip.
+        #expect(reloaded.favorites.contains { $0.posterPath == nil })
+        #expect(reloaded.favorites.first?.year == "2010")
+    }
+
+    @Test func emptyReleaseDateRoundTrips() throws {
+        let page2 = try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page2")).results
+        let store = makeStore()
+        store.save(page2)
+        #expect(makeStore().load() == page2)
+    }
+
+    @Test func keepsInsertionOrder() throws {
+        let all = try movies()
+        let order = [all[3], all[0], all[4], all[1]]
+        let vm = FavoritesViewModel(store: makeStore())
+        order.forEach(vm.toggle)
+        #expect(vm.favorites.map(\.id) == order.map(\.id))
+        #expect(FavoritesViewModel(store: makeStore()).favorites.map(\.id) == order.map(\.id))
+    }
+
+    @Test func removeAtOffsets() throws {
+        let all = try movies()
+        let vm = FavoritesViewModel(store: makeStore())
+        all.forEach(vm.toggle)
+
+        vm.remove(at: IndexSet([0, 2]))
+        let expected = [all[1], all[3], all[4]]
+        #expect(vm.favorites == expected)
+        #expect(!vm.isFavorite(all[0]))
+        #expect(makeStore().load() == expected)
+    }
+
+    @Test func noDuplicates() throws {
+        let movie = try #require(try movies().first)
+        let vm = FavoritesViewModel(store: makeStore())
+        vm.toggle(movie)
+        vm.toggle(movie)
+        vm.toggle(movie)
+        #expect(vm.favorites == [movie])
+
+        // A differing copy with the same id counts as the same favorite.
+        let renamed = Movie(id: movie.id, title: "Other")
+        #expect(vm.isFavorite(renamed))
+        vm.toggle(renamed)
+        #expect(vm.favorites.isEmpty)
+    }
+
+    @Test func separateKeysAreIndependent() throws {
+        let movie = try #require(try movies().first)
+        UserDefaultsFavoritesStore(defaults: defaults, key: "other").save([movie])
+        #expect(makeStore().load().isEmpty)
+    }
+}
