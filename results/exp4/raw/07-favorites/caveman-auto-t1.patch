index 0000000..3ffa4c8
--- /dev/null
+++ b/Sources/TMDBApp/Services/FavoritesStore.swift
@@ -0,0 +1,29 @@
+import Foundation
+
+/// Persists the user's favorite movies, in insertion order.
+protocol FavoritesStore {
+    func load() -> [Movie]
+    func save(_ movies: [Movie])
+}
+
+/// Stores full `Movie` values as JSON under a single `UserDefaults` key.
+struct UserDefaultsFavoritesStore: FavoritesStore {
+    private let defaults: UserDefaults
+    private let key: String
+
+    init(defaults: UserDefaults = .standard, key: String = "favorites.movies") {
+        self.defaults = defaults
+        self.key = key
+    }
+
+    /// Returns an empty list when nothing is stored or the data is unreadable.
+    func load() -> [Movie] {
+        guard let data = defaults.data(forKey: key) else { return [] }
+        return (try? JSONDecoder.tmdb.decode([Movie].self, from: data)) ?? []
+    }
+
+    func save(_ movies: [Movie]) {
+        guard let data = try? JSONEncoder.tmdb.encode(movies) else { return }
+        defaults.set(data, forKey: key)
+    }
+}
