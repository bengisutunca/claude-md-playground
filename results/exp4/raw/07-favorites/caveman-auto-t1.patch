+import SwiftUI
+
+/// Top-level tabs. Owns the single `FavoritesViewModel` shared through the environment.
+struct RootView: View {
+    private let service: any MovieService
+    @State private var favorites: FavoritesViewModel
+
+    init(service: any MovieService, favorites: FavoritesViewModel) {
+        self.service = service
+        _favorites = State(initialValue: favorites)
+    }
+
+    var body: some View {
+        TabView {
+            MovieListView(viewModel: MovieListViewModel(service: service), service: service)
+                .tabItem { Label("Popular", systemImage: "film") }
+            SearchView(viewModel: SearchViewModel(service: service), service: service)
+                .tabItem { Label("Search", systemImage: "magnifyingglass") }
+            FavoritesView(service: service)
+                .tabItem { Label("Favorites", systemImage: "heart") }
+        }
+        .environment(favorites)
+    }
+}
