--- /dev/null
+++ b/Sources/TMDBApp/Services/UserDefaultsFavoritesStore.swift
@@ -0,0 +1,24 @@
+import Foundation
+
+/// Stores the full `Movie` values as one JSON array (TMDB's movie shape) under `key`.
+struct UserDefaultsFavoritesStore: FavoritesStore {
+    private let defaults: UserDefaults
+    private let key: String
+
+    init(defaults: UserDefaults = .standard, key: String = "favorites.movies") {
+        self.defaults = defaults
+        self.key = key
+    }
+
+    /// Returns `[]` when nothing is stored or the stored data can't be decoded.
+    func load() -> [Movie] {
+        guard let data = defaults.data(forKey: key),
+              let movies = try? JSONDecoder.tmdb.decode([Movie].self, from: data) else { return [] }
+        return movies
+    }
+
+    func save(_ movies: [Movie]) {
+        guard let data = try? JSONEncoder.tmdb.encode(movies) else { return }
+        defaults.set(data, forKey: key)
+    }
+}
