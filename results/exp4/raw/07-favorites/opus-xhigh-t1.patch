diff --git a/Tests/TMDBAppTests/FavoritesTests.swift b/Tests/TMDBAppTests/FavoritesTests.swift
new file mode 100644
index 0000000..b5ec374
--- /dev/null
+++ b/Tests/TMDBAppTests/FavoritesTests.swift
@@ -0,0 +1,149 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+/// Every test runs on its own `UserDefaults` suite, created in `init` and removed in `deinit`.
+@MainActor
+@Suite("Favorites")
+final class FavoritesTests {
+    private let suiteName: String
+    private let defaults: UserDefaults
+
+    init() throws {
+        let name = "TMDBAppTests.Favorites.\(UUID().uuidString)"
+        suiteName = name
+        defaults = try #require(UserDefaults(suiteName: name))
+    }
+
+    deinit {
+        defaults.removePersistentDomain(forName: suiteName)
+    }
+
+    private func makeStore() -> UserDefaultsFavoritesStore {
+        UserDefaultsFavoritesStore(defaults: defaults)
+    }
+
+    private func makeViewModel() -> FavoritesViewModel {
+        FavoritesViewModel(store: makeStore())
+    }
+
+    /// The 7 popular movies from both fixture pages. They include a nil poster, a nil backdrop
+    /// and a nil release date, so equality checks cover every field of `Movie`.
+    private func fixtureMovies() throws -> [Movie] {
+        try ["popular_page1", "popular_page2"].flatMap { name in
+            try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data(name)).results
+        }
+    }
+
+    @Test func startsEmpty() {
+        #expect(makeStore().load().isEmpty)
+        #expect(makeViewModel().favorites.isEmpty)
+    }
+
+    @Test func toggleOnAndOff() throws {
+        let movie = try #require(fixtureMovies().first)
+        let vm = makeViewModel()
+        #expect(!vm.isFavorite(movie))
+
+        vm.toggle(movie)
+        #expect(vm.isFavorite(movie))
+        #expect(vm.favorites == [movie])
+        #expect(makeStore().load() == [movie])
+
+        vm.toggle(movie)
+        #expect(!vm.isFavorite(movie))
+        #expect(vm.favorites.isEmpty)
+        #expect(makeStore().load().isEmpty)
+    }
+
+    @Test func storeRoundTripsFullMovies() throws {
+        let movies = try fixtureMovies()
+        #expect(movies.contains { $0.posterPath == nil })
+        #expect(movies.contains { $0.backdropPath == nil })
+        #expect(movies.contains { $0.releaseDate == nil })
+
+        makeStore().save(movies)
+        #expect(defaults.data(forKey: "favorites.movies") != nil)
+        #expect(makeStore().load() == movies)
+    }
+
+    @Test func persistsAcrossStoreInstancesOnSameSuite() throws {
+        let movies = try fixtureMovies()
+        let vm = makeViewModel()
+        for movie in movies { vm.toggle(movie) }
+
+        // A new `UserDefaults` object and store on the same suite, as after a relaunch.
+        let reopened = try #require(UserDefaults(suiteName: suiteName))
+        let restored = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: reopened))
+        #expect(restored.favorites == movies)
+        for movie in movies { #expect(restored.isFavorite(movie)) }
+    }
+
+    @Test func keepsInsertionOrder() throws {
+        let m = try fixtureMovies()
+        let vm = makeViewModel()
+        for movie in [m[3], m[0], m[5], m[1]] { vm.toggle(movie) }
+        #expect(vm.favorites == [m[3], m[0], m[5], m[1]])
+
+        // Removing and adding again moves a movie to the end.
+        vm.toggle(m[0])
+        vm.toggle(m[0])
+        let expected = [m[3], m[5], m[1], m[0]]
+        #expect(vm.favorites == expected)
+        #expect(makeStore().load() == expected)
+        #expect(makeViewModel().favorites == expected)
+    }
+
+    @Test func removeAtOffsets() throws {
+        let m = try fixtureMovies()
+        let vm = makeViewModel()
+        for movie in m.prefix(4) { vm.toggle(movie) }
+
+        vm.remove(at: IndexSet([0, 2]))
+        #expect(vm.favorites == [m[1], m[3]])
+        #expect(!vm.isFavorite(m[0]))
+        #expect(!vm.isFavorite(m[2]))
+        #expect(makeStore().load() == [m[1], m[3]])
+
+        vm.remove(at: IndexSet(integer: 10))
+        #expect(vm.favorites == [m[1], m[3]])
+    }
+
+    @Test func noDuplicates() throws {
+        let m = try fixtureMovies()
+        let vm = makeViewModel()
+        vm.toggle(m[0])
+        vm.toggle(m[1])
+
+        // Matching is by id: the same movie with other data is already a favorite,
+        // so toggling it removes the entry instead of adding a second one.
+        let sameID = Movie(id: m[0].id, title: "Renamed")
+        #expect(vm.isFavorite(sameID))
+        vm.toggle(sameID)
+        #expect(vm.favorites == [m[1]])
+        vm.toggle(m[0])
+        #expect(vm.favorites == [m[1], m[0]])
+        #expect(Set(vm.favorites.map(\.id)).count == vm.favorites.count)
+
+        // Duplicates already in storage are dropped on load; the first occurrence wins.
+        makeStore().save([m[2], m[3], m[2], m[4], m[3]])
+        #expect(makeViewModel().favorites == [m[2], m[3], m[4]])
+    }
+
+    @Test func unreadableDataLoadsAsEmpty() {
+        defaults.set(Data("not json".utf8), forKey: "favorites.movies")
+        #expect(makeStore().load().isEmpty)
+        #expect(makeViewModel().favorites.isEmpty)
+    }
+
+    @Test func storesWithDifferentKeysAreIndependent() throws {
+        let m = try fixtureMovies()
+        let first = UserDefaultsFavoritesStore(defaults: defaults, key: "first")
+        let second = UserDefaultsFavoritesStore(defaults: defaults, key: "second")
+        first.save([m[0]])
+        second.save([m[1], m[2]])
+        #expect(first.load() == [m[0]])
+        #expect(second.load() == [m[1], m[2]])
+        #expect(makeStore().load().isEmpty)
+    }
+}
