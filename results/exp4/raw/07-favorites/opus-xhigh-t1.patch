@@ -0,0 +1,42 @@
+import Foundation
+import Observation
+
+/// App-wide favorites. Create one and share it with `.environment(_:)` at the root view.
+///
+/// Movies are matched by `id`, kept in insertion order, and never duplicated.
+/// Every change is saved to the store right away.
+@MainActor
+@Observable
+final class FavoritesViewModel {
+    private(set) var favorites: [Movie]
+
+    @ObservationIgnored private let store: any FavoritesStore
+
+    init(store: any FavoritesStore) {
+        self.store = store
+        var seen = Set<Int>()
+        favorites = store.load().filter { seen.insert($0.id).inserted }
+    }
+
+    func isFavorite(_ movie: Movie) -> Bool {
+        favorites.contains { $0.id == movie.id }
+    }
+
+    /// Appends `movie` if it isn't a favorite yet, otherwise removes it.
+    func toggle(_ movie: Movie) {
+        if let index = favorites.firstIndex(where: { $0.id == movie.id }) {
+            favorites.remove(at: index)
+        } else {
+            favorites.append(movie)
+        }
+        store.save(favorites)
+    }
+
+    /// Removes the favorites at `offsets` (as passed by `onDelete`). Out-of-range offsets are ignored.
+    func remove(at offsets: IndexSet) {
+        for index in offsets.reversed() where favorites.indices.contains(index) {
+            favorites.remove(at: index)
+        }
+        store.save(favorites)
+    }
+}
diff --git a/Sources/TMDBApp/Views/FavoriteButton.swift b/Sources/TMDBApp/Views/FavoriteButton.swift
