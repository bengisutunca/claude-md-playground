index 0000000..c6b1414
--- /dev/null
+++ b/Sources/TMDBApp/Views/FavoriteButton.swift
@@ -0,0 +1,18 @@
+import SwiftUI
+
+/// Heart that toggles `movie` in the shared `FavoritesViewModel` from the environment.
+struct FavoriteButton: View {
+    let movie: Movie
+    @Environment(FavoritesViewModel.self) private var favorites
+
+    var body: some View {
+        let isFavorite = favorites.isFavorite(movie)
+        Button {
+            favorites.toggle(movie)
+        } label: {
+            Label(isFavorite ? "Remove from Favorites" : "Add to Favorites",
+                  systemImage: isFavorite ? "heart.fill" : "heart")
+        }
+        .tint(.red)
+    }
+}
