+++ b/Sources/TMDBApp/Networking/APIError.swift
@@ -0,0 +1,15 @@
+import Foundation
+
+enum APIError: Error {
+    case invalidResponse
+    case httpStatus(code: Int, message: String?)
+    case decoding(Error)
+    case transport(Error)
+    case missingAPIKey
+}
+
+/// TMDB error body, e.g. `{"status_code": 7, "status_message": "Invalid API key…", "success": false}`.
+struct TMDBErrorBody: Decodable, Sendable {
+    let statusCode: Int?
+    let statusMessage: String?
+}
