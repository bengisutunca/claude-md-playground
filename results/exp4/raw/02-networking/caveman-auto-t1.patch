@@ -0,0 +1,31 @@
+import Foundation
+
+/// TMDB credentials and base URL. The key is never hard-coded: it comes from the
+/// `TMDB_API_KEY` environment variable or the `TMDB_API_KEY` Info.plist entry.
+struct APIConfiguration: Equatable, Sendable {
+    static let apiKeyName = "TMDB_API_KEY"
+
+    let apiKey: String
+    let baseURL: URL
+
+    init(apiKey: String, baseURL: URL = TMDBApp.apiBaseURL) {
+        self.apiKey = apiKey
+        self.baseURL = baseURL
+    }
+
+    /// Environment wins over Info.plist; empty or whitespace-only values count as absent.
+    static func load(
+        environment: [String: String] = ProcessInfo.processInfo.environment,
+        bundle: Bundle = .main
+    ) throws -> APIConfiguration {
+        let candidates = [
+            environment[apiKeyName],
+            bundle.object(forInfoDictionaryKey: apiKeyName) as? String,
+        ]
+        for case let value? in candidates {
+            let key = value.trimmingCharacters(in: .whitespacesAndNewlines)
+            if !key.isEmpty { return APIConfiguration(apiKey: key) }
+        }
+        throw APIError.missingAPIKey
+    }
+}
