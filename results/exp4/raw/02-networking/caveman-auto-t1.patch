@@ -0,0 +1,166 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("Endpoint")
+struct EndpointTests {
+    private let config = APIConfiguration(apiKey: "test-key")
+
+    private func components(_ endpoint: Endpoint) throws -> URLComponents {
+        let request = try endpoint.urlRequest(configuration: config)
+        #expect(request.httpMethod == "GET")
+        let url = try #require(request.url)
+        return try #require(URLComponents(url: url, resolvingAgainstBaseURL: false))
+    }
+
+    private func items(_ c: URLComponents) -> [String: String] {
+        Dictionary(uniqueKeysWithValues: (c.queryItems ?? []).map { ($0.name, $0.value ?? "") })
+    }
+
+    @Test func popular() throws {
+        let c = try components(.popular(page: 2))
+        #expect(c.host == "api.themoviedb.org")
+        #expect(c.path == "/3/movie/popular")
+        #expect(items(c) == ["api_key": "test-key", "language": "en-US", "page": "2"])
+    }
+
+    @Test func search() throws {
+        let c = try components(.search(query: "the matrix & co", page: 1))
+        #expect(c.path == "/3/search/movie")
+        #expect(items(c) == ["api_key": "test-key", "language": "en-US", "query": "the matrix & co", "page": "1"])
+        // The `&` in the query must be percent-encoded, not split into a new item.
+        #expect(c.percentEncodedQuery?.contains("%26") == true)
+    }
+
+    @Test func movieDetail() throws {
+        let c = try components(.movieDetail(id: 27205))
+        #expect(c.path == "/3/movie/27205")
+        #expect(items(c) == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func credits() throws {
+        let c = try components(.credits(movieID: 27205))
+        #expect(c.path == "/3/movie/27205/credits")
+        #expect(items(c) == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func usesConfiguredBaseURL() throws {
+        let custom = APIConfiguration(apiKey: "k", baseURL: URL(string: "https://example.com/v9")!)
+        let url = try #require(Endpoint.popular(page: 1).urlRequest(configuration: custom).url)
+        #expect(url.host == "example.com")
+        #expect(url.path == "/v9/movie/popular")
+    }
+
+    @Test func equatable() {
+        #expect(Endpoint.popular(page: 1) == .popular(page: 1))
+        #expect(Endpoint.popular(page: 1) != .popular(page: 2))
+        #expect(Endpoint.search(query: "a", page: 1) != .search(query: "b", page: 1))
+    }
+}
+
+@Suite("APIConfiguration")
+struct APIConfigurationTests {
+    private static let emptyBundle = Bundle(for: BundleToken.self)
+
+    @Test func readsEnvironment() throws {
+        let config = try APIConfiguration.load(environment: ["TMDB_API_KEY": "env-key"], bundle: Self.emptyBundle)
+        #expect(config.apiKey == "env-key")
+        #expect(config.baseURL == TMDBApp.apiBaseURL)
+    }
+
+    @Test func fallsBackToInfoPlist() throws {
+        let bundle = try makeBundle(info: ["TMDB_API_KEY": "plist-key"])
+        #expect(try APIConfiguration.load(environment: [:], bundle: bundle).apiKey == "plist-key")
+        #expect(try APIConfiguration.load(environment: ["TMDB_API_KEY": ""], bundle: bundle).apiKey == "plist-key")
+        #expect(try APIConfiguration.load(environment: ["TMDB_API_KEY": "env"], bundle: bundle).apiKey == "env")
+    }
+
+    @Test func missingKeyThrows() throws {
+        #expect(throws: APIError.self) {
+            try APIConfiguration.load(environment: [:], bundle: Self.emptyBundle)
+        }
+        let blank = try makeBundle(info: ["TMDB_API_KEY": "  "])
+        do {
+            _ = try APIConfiguration.load(environment: ["TMDB_API_KEY": ""], bundle: blank)
+            Issue.record("expected missingAPIKey")
+        } catch APIError.missingAPIKey {
+        } catch {
+            Issue.record("unexpected error \(error)")
+        }
+    }
+
+    /// Writes a throwaway flat bundle containing only an Info.plist.
+    private func makeBundle(info: [String: String]) throws -> Bundle {
+        let dir = FileManager.default.temporaryDirectory.appendingPathComponent("\(UUID().uuidString).bundle")
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        var plist: [String: String] = ["CFBundleIdentifier": "test.\(UUID().uuidString)"]
+        plist.merge(info) { $1 }
+        let data = try PropertyListSerialization.data(fromPropertyList: plist, format: .xml, options: 0)
+        try data.write(to: dir.appendingPathComponent("Info.plist"))
+        return try #require(Bundle(url: dir))
+    }
+}
+
+private final class BundleToken {}
+
+@Suite("TMDBClient")
+struct TMDBClientTests {
+    private let config = APIConfiguration(apiKey: "test-key")
+
+    @Test func decodesSuccess() async throws {
+        let client = TMDBClient(session: try MockURLProtocol.session(fixture: "popular_page1"), configuration: config)
+        let page = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+        #expect(page.page == 1)
+        #expect(page.results.first?.title == "Inception")
+    }
+
+    @Test func sendsEndpointRequest() async throws {
+        let detail = try Fixture.data("movie_detail_27205")
+        let session = MockURLProtocol.makeSession { request in
+            let c = URLComponents(url: request.url!, resolvingAgainstBaseURL: false)!
+            guard c.path == "/3/movie/27205",
+                  c.queryItems?.contains(URLQueryItem(name: "api_key", value: "test-key")) == true else {
+                throw URLError(.badURL)
+            }
+            return (HTTPURLResponse(url: request.url!, statusCode: 200, httpVersion: nil, headerFields: nil)!, detail)
+        }
+        let movie = try await TMDBClient(session: session, configuration: config)
+            .send(.movieDetail(id: 27205), as: MovieDetail.self)
+        #expect(movie.id == 27205)
+    }
+
+    @Test func http401ParsesStatusMessage() async throws {
+        let client = TMDBClient(session: try MockURLProtocol.session(statusCode: 401, fixture: "error_401"),
+                                configuration: config)
+        do {
+            _ = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected httpStatus error")
+        } catch APIError.httpStatus(let code, let message) {
+            #expect(code == 401)
+            #expect(message == "Invalid API key: You must be granted a valid key.")
+        }
+    }
+
+    @Test func decodingFailure() async throws {
+        // A credits body cannot decode as a paged movie list.
+        let client = TMDBClient(session: try MockURLProtocol.session(fixture: "movie_credits_27205"),
+                                configuration: config)
+        do {
+            _ = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected decoding error")
+        } catch APIError.decoding(let underlying) {
+            #expect(underlying is DecodingError)
+        }
+    }
+
+    @Test func transportFailure() async throws {
+        let session = MockURLProtocol.makeSession { _ in throw URLError(.notConnectedToInternet) }
+        do {
+            _ = try await TMDBClient(session: session, configuration: config)
+                .send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected transport error")
+        } catch APIError.transport(let underlying) {
+            #expect((underlying as? URLError)?.code == .notConnectedToInternet)
+        }
+    }
+}
