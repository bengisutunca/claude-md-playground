+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("TMDBClient")
+struct TMDBClientTests {
+    private let configuration = APIConfiguration(apiKey: "test-key")
+
+    private func queryValue(_ name: String, in request: URLRequest?) -> String? {
+        guard let url = request?.url else { return nil }
+        return URLComponents(url: url, resolvingAgainstBaseURL: false)?
+            .queryItems?.first(where: { $0.name == name })?.value
+    }
+
+    // MARK: - Success
+
+    @Test func decodesPopularResponse() async throws {
+        let requests = Locked<[URLRequest]>([])
+        let session = try MockURLProtocol.makeSession(fixture: "popular_page1", recordingInto: requests)
+        let client = TMDBClient(session: session, configuration: configuration)
+
+        let page = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+
+        #expect(page.page == 1)
+        #expect(page.totalPages == 2)
+        #expect(page.results.count == 5)
+        #expect(page.results.first?.id == 27205)
+
+        let request = try #require(requests.current.only)
+        #expect(request.httpMethod == "GET")
+        #expect(request.url?.path == "/3/movie/popular")
+        #expect(queryValue("api_key", in: request) == "test-key")
+        #expect(queryValue("language", in: request) == "en-US")
+        #expect(queryValue("page", in: request) == "1")
+    }
+
+    @Test func decodesSearchDetailAndCredits() async throws {
+        let search = try await TMDBClient(session: MockURLProtocol.makeSession(fixture: "search_inception"),
+                                          configuration: configuration)
+            .send(.search(query: "Inception", page: 1), as: PagedResponse<Movie>.self)
+        #expect(search.results.contains(where: { $0.title == "Inception" }))
+
+        let empty = try await TMDBClient(session: MockURLProtocol.makeSession(fixture: "search_empty"),
+                                         configuration: configuration)
+            .send(.search(query: "zzzz", page: 1), as: PagedResponse<Movie>.self)
+        #expect(empty.results.isEmpty)
+        #expect(empty.totalResults == 0)
+
+        let detail = try await TMDBClient(session: MockURLProtocol.makeSession(fixture: "movie_detail_27205"),
+                                          configuration: configuration)
+            .send(.movieDetail(id: 27205), as: MovieDetail.self)
+        #expect(detail.id == 27205)
+        #expect(detail.runtime == 148)
+
+        let credits = try await TMDBClient(session: MockURLProtocol.makeSession(fixture: "movie_credits_27205"),
+                                           configuration: configuration)
+            .send(.credits(movieID: 27205), as: Credits.self)
+        #expect(credits.cast.first?.name == "Leonardo DiCaprio")
+    }
+
+    // MARK: - Errors
+
+    @Test func http401ParsesTMDBStatusMessage() async throws {
+        let session = try MockURLProtocol.makeSession(statusCode: 401, fixture: "error_401")
+        let client = TMDBClient(session: session, configuration: configuration)
+
+        let error = try await #require(throws: APIError.self) {
+            try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+        }
+        guard case let .httpStatus(code, message) = error else {
+            Issue.record("Expected .httpStatus, got \(error)")
+            return
+        }
+        #expect(code == 401)
+        #expect(message == "Invalid API key: You must be granted a valid key.")
+        #expect(error.localizedDescription == "Invalid API key: You must be granted a valid key.")
+    }
+
+    @Test func httpErrorWithoutTMDBBodyHasNilMessage() async throws {
+        let session = MockURLProtocol.makeSession(statusCode: 503, body: Data("<html>Service Unavailable</html>".utf8))
+        let client = TMDBClient(session: session, configuration: configuration)
+
+        let error = try await #require(throws: APIError.self) {
+            try await client.send(.movieDetail(id: 1), as: MovieDetail.self)
+        }
+        guard case let .httpStatus(code, message) = error else {
+            Issue.record("Expected .httpStatus, got \(error)")
+            return
+        }
+        #expect(code == 503)
+        #expect(message == nil)
+    }
+
+    @Test func decodingFailureIsWrapped() async throws {
+        // A valid 200 response whose shape doesn't match the requested type.
+        let session = try MockURLProtocol.makeSession(fixture: "movie_detail_27205")
