+    // MARK: - Configuration loading
+
+    @Test func configurationProviderIsCalledOnEachRequest() async throws {
+        let requests = Locked<[URLRequest]>([])
+        let session = try MockURLProtocol.makeSession(fixture: "movie_detail_27205", recordingInto: requests)
+        let environment = Locked<[String: String]>([:])
+        let client = TMDBClient(session: session, configurationProvider: {
+            let bundle = Bundle(for: MockURLProtocol.self)  // never holds TMDB_API_KEY
+            return try APIConfiguration.load(environment: environment.current, bundle: bundle)
+        })
+
+        // No key yet: fails before any request is sent.
+        let error = try await #require(throws: APIError.self) {
+            try await client.send(.movieDetail(id: 27205), as: MovieDetail.self)
+        }
+        guard case .missingAPIKey = error else {
+            Issue.record("Expected .missingAPIKey, got \(error)")
+            return
+        }
+        #expect(requests.current.isEmpty)
+
+        // Key becomes available: the same client picks it up without being rebuilt.
+        environment.withLock { $0["TMDB_API_KEY"] = "late-key" }
+        _ = try await client.send(.movieDetail(id: 27205), as: MovieDetail.self)
+        #expect(queryValue("api_key", in: requests.current.only) == "late-key")
+    }
+
+    @Test func nilConfigurationLoadsFromEnvironmentAndMainBundle() async throws {
+        let requests = Locked<[URLRequest]>([])
+        let session = try MockURLProtocol.makeSession(fixture: "movie_detail_27205", recordingInto: requests)
+        let client = TMDBClient(session: session)
+
+        // The outcome depends on the machine's TMDB_API_KEY; either way the mock session
+        // keeps the request off the network.
+        if let expected = try? APIConfiguration.load() {
+            _ = try await client.send(.movieDetail(id: 27205), as: MovieDetail.self)
+            #expect(queryValue("api_key", in: requests.current.only) == expected.apiKey)
+        } else {
+            let error = try await #require(throws: APIError.self) {
+                try await client.send(.movieDetail(id: 27205), as: MovieDetail.self)
+            }
+            guard case .missingAPIKey = error else {
+                Issue.record("Expected .missingAPIKey, got \(error)")
+                return
+            }
+            #expect(requests.current.isEmpty)
+        }
+    }
+}
+
+private extension Array {
+    /// The single element, or nil if the array doesn't have exactly one.
+    var only: Element? { count == 1 ? first : nil }
+}
