@@ -0,0 +1,39 @@
+import Foundation
+
+/// Every failure `HTTPClient.send(_:as:)` can report.
+enum APIError: Error {
+    /// The response was not an HTTP response.
+    case invalidResponse
+    /// Non-2xx status. `message` is TMDB's `status_message` when the body contains one.
+    case httpStatus(code: Int, message: String?)
+    /// A 2xx body that could not be decoded into the requested type.
+    case decoding(Error)
+    /// The request never produced a response (offline, timeout, cancelled, bad URL…).
+    case transport(Error)
+    /// No API key in the environment or Info.plist (or an empty key was configured).
+    case missingAPIKey
+}
+
+extension APIError: LocalizedError {
+    var errorDescription: String? {
+        switch self {
+        case .invalidResponse:
+            return "The server returned an invalid response."
+        case let .httpStatus(code, message):
+            return message ?? "The server returned HTTP status \(code)."
+        case .decoding:
+            return "The server response could not be read."
+        case let .transport(error):
+            return error.localizedDescription
+        case .missingAPIKey:
+            return "No TMDB API key found. Set TMDB_API_KEY in the environment or Info.plist."
+        }
+    }
+}
+
+/// Error body TMDB returns with non-2xx responses, e.g.
+/// `{"status_code": 7, "status_message": "Invalid API key…", "success": false}`.
+struct TMDBErrorResponse: Decodable, Sendable {
+    let statusCode: Int?
+    let statusMessage: String?
+}
