+import Foundation
+
+/// Sends TMDB requests and decodes their responses.
+///
+/// Implementations throw `APIError` for every failure.
+protocol HTTPClient: Sendable {
+    func send<T: Decodable>(_ endpoint: Endpoint, as type: T.Type) async throws -> T
+}
diff --git a/Sources/TMDBApp/Networking/TMDBClient.swift b/Sources/TMDBApp/Networking/TMDBClient.swift
new file mode 100644
index 0000000..2275876
--- /dev/null
+++ b/Sources/TMDBApp/Networking/TMDBClient.swift
@@ -0,0 +1,47 @@
+import Foundation
+
+/// `HTTPClient` for the TMDB v3 API, backed by an injected `URLSession`.
+struct TMDBClient: HTTPClient {
+    private let session: URLSession
+    private let configurationProvider: @Sendable () throws -> APIConfiguration
+
+    /// - Parameter configuration: Fixed configuration. When nil, `APIConfiguration.load()`
+    ///   is called on each request, so a key added later is picked up.
+    init(session: URLSession = .shared, configuration: APIConfiguration? = nil) {
+        if let configuration {
+            self.init(session: session, configurationProvider: { configuration })
+        } else {
+            self.init(session: session, configurationProvider: { try APIConfiguration.load() })
+        }
+    }
+
+    /// - Parameter configurationProvider: Called once per request; should throw `APIError`.
+    init(session: URLSession, configurationProvider: @escaping @Sendable () throws -> APIConfiguration) {
+        self.session = session
+        self.configurationProvider = configurationProvider
+    }
+
+    func send<T: Decodable>(_ endpoint: Endpoint, as type: T.Type) async throws -> T {
+        let request = try endpoint.urlRequest(configuration: configurationProvider())
+
+        let data: Data
+        let response: URLResponse
+        do {
+            (data, response) = try await session.data(for: request)
+        } catch {
+            throw APIError.transport(error)
+        }
+
+        guard let http = response as? HTTPURLResponse else { throw APIError.invalidResponse }
+        guard (200..<300).contains(http.statusCode) else {
+            let body = try? JSONDecoder.tmdb.decode(TMDBErrorResponse.self, from: data)
+            throw APIError.httpStatus(code: http.statusCode, message: body?.statusMessage)
+        }
+
+        do {
+            return try JSONDecoder.tmdb.decode(T.self, from: data)
+        } catch {
+            throw APIError.decoding(error)
+        }
+    }
+}
