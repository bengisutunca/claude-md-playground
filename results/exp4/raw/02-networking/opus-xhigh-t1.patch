+++ b/Tests/TMDBAppTests/EndpointTests.swift
@@ -0,0 +1,79 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("Endpoint")
+struct EndpointTests {
+    private let configuration = APIConfiguration(apiKey: "test-key")
+
+    private func components(of request: URLRequest) throws -> URLComponents {
+        let url = try #require(request.url)
+        return try #require(URLComponents(url: url, resolvingAgainstBaseURL: false))
+    }
+
+    /// Query items as sorted `name=value` strings, so duplicates and order-independence are both checked.
+    private func sortedPairs(_ items: [URLQueryItem]?) -> [String] {
+        (items ?? []).map { "\($0.name)=\($0.value ?? "<nil>")" }.sorted()
+    }
+
+    static let cases: [(endpoint: Endpoint, path: String, items: [String: String])] = [
+        (.popular(page: 2), "/3/movie/popular", ["page": "2"]),
+        (.search(query: "Inception", page: 3), "/3/search/movie", ["query": "Inception", "page": "3"]),
+        (.movieDetail(id: 27205), "/3/movie/27205", [:]),
+        (.credits(movieID: 27205), "/3/movie/27205/credits", [:]),
+    ]
+
+    @Test("Builds path and query items", arguments: cases)
+    func buildsRequest(endpoint: Endpoint, path: String, items: [String: String]) throws {
+        let request = try endpoint.urlRequest(configuration: configuration)
+        #expect(request.httpMethod == "GET")
+        #expect(request.value(forHTTPHeaderField: "Accept") == "application/json")
+
+        let components = try components(of: request)
+        #expect(components.scheme == "https")
+        #expect(components.host == "api.themoviedb.org")
+        #expect(components.path == path)
+
+        let expected = items.merging(["api_key": "test-key", "language": "en-US"]) { $1 }
+        #expect(sortedPairs(components.queryItems) == expected.map { "\($0.key)=\($0.value)" }.sorted())
+    }
+
+    @Test func searchQueryIsPercentEncoded() throws {
+        let query = "C++ & Amélie: a=b?"
+        let request = try Endpoint.search(query: query, page: 1).urlRequest(configuration: configuration)
+        let components = try components(of: request)
+
+        // `+`, `&`, `=` must be escaped or TMDB would read a space or a new parameter.
+        let encodedQuery = try #require(components.percentEncodedQuery)
+        #expect(encodedQuery.contains("query=C%2B%2B%20%26%20Am%C3%A9lie%3A%20a%3Db%3F"))
+        #expect(components.queryItems?.first(where: { $0.name == "query" })?.value == query)
+    }
+
+    @Test func appendsPathToCustomBaseURL() throws {
+        for base in ["https://example.com/api/3", "https://example.com/api/3/"] {
+            let configuration = APIConfiguration(apiKey: "k", baseURL: try #require(URL(string: base)))
+            let request = try Endpoint.credits(movieID: 7).urlRequest(configuration: configuration)
+            let components = try components(of: request)
+            #expect(components.host == "example.com")
+            #expect(components.path == "/api/3/movie/7/credits")
+        }
+    }
+
+    @Test func emptyAPIKeyThrowsMissingAPIKey() throws {
+        let configuration = APIConfiguration(apiKey: "")
+        let error = try #require(throws: APIError.self) {
+            try Endpoint.popular(page: 1).urlRequest(configuration: configuration)
+        }
+        guard case .missingAPIKey = error else {
+            Issue.record("Expected .missingAPIKey, got \(error)")
+            return
+        }
+    }
+
+    @Test func equatable() {
+        #expect(Endpoint.popular(page: 1) == .popular(page: 1))
+        #expect(Endpoint.popular(page: 1) != .popular(page: 2))
+        #expect(Endpoint.search(query: "a", page: 1) != .search(query: "b", page: 1))
+        #expect(Endpoint.movieDetail(id: 1) != .credits(movieID: 1))
+    }
+}
diff --git a/Tests/TMDBAppTests/MockURLProtocol.swift b/Tests/TMDBAppTests/MockURLProtocol.swift
new file mode 100644
index 0000000..ea31012
--- /dev/null
+++ b/Tests/TMDBAppTests/MockURLProtocol.swift
@@ -0,0 +1,87 @@
+import Foundation
+
+/// `URLProtocol` that answers requests with canned responses, so tests never touch the network.
+///
+/// Swift Testing runs tests in parallel, so there is no shared global handler: each session
+/// from `makeSession(_:)` gets its own handler, found through a per-session token header.
+final class MockURLProtocol: URLProtocol {
+    typealias Handler = @Sendable (URLRequest) throws -> (URLResponse, Data)
+
+    private static let tokenHeader = "X-MockURLProtocol-Token"
+    private static let handlers = Locked<[String: Handler]>([:])
+
+    /// An ephemeral session whose every request is answered by `handler`.
+    static func makeSession(_ handler: @escaping Handler) -> URLSession {
+        let token = UUID().uuidString
+        handlers.withLock { $0[token] = handler }
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.protocolClasses = [MockURLProtocol.self]
+        configuration.httpAdditionalHeaders = [tokenHeader: token]
+        return URLSession(configuration: configuration)
+    }
+
+    /// An ephemeral session that answers every request with `body` and `statusCode`,
+    /// appending each request it receives to `requests`.
+    static func makeSession(
+        statusCode: Int = 200,
+        body: Data,
+        recordingInto requests: Locked<[URLRequest]>? = nil
+    ) -> URLSession {
+        makeSession { request in
+            requests?.withLock { $0.append(request) }
+            guard let url = request.url,
+                  let response = HTTPURLResponse(url: url, statusCode: statusCode, httpVersion: "HTTP/1.1",
+                                                 headerFields: ["Content-Type": "application/json"]) else {
+                throw URLError(.badURL)
+            }
+            return (response, body)
+        }
+    }
+
+    /// Same as `makeSession(statusCode:body:recordingInto:)`, serving a JSON fixture.
+    static func makeSession(
+        statusCode: Int = 200,
+        fixture: String,
+        recordingInto requests: Locked<[URLRequest]>? = nil
+    ) throws -> URLSession {
+        makeSession(statusCode: statusCode, body: try Fixture.data(fixture), recordingInto: requests)
+    }
+
+    override class func canInit(with request: URLRequest) -> Bool { true }
+
+    override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+
+    override func startLoading() {
+        guard let token = request.value(forHTTPHeaderField: Self.tokenHeader),
+              let handler = Self.handlers.withLock({ $0[token] }) else {
+            client?.urlProtocol(self, didFailWithError: URLError(.unsupportedURL))
+            return
+        }
+        do {
+            let (response, data) = try handler(request)
+            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: data)
+            client?.urlProtocolDidFinishLoading(self)
+        } catch {
+            client?.urlProtocol(self, didFailWithError: error)
+        }
+    }
+
+    override func stopLoading() {}
+}
+
+/// A value guarded by a lock, for state shared between a test and `@Sendable` closures.
+final class Locked<Value>: @unchecked Sendable {
+    private let lock = NSLock()
+    private var value: Value
+
+    init(_ value: Value) { self.value = value }
+
+    func withLock<Result>(_ body: (inout Value) throws -> Result) rethrows -> Result {
+        lock.lock()
+        defer { lock.unlock() }
+        return try body(&value)
+    }
+
+    var current: Value { withLock { $0 } }
+}
