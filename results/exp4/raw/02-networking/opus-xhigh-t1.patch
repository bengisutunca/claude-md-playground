@@ -0,0 +1,38 @@
+import Foundation
+
+/// Credentials and base URL used to build TMDB requests.
+///
+/// The API key is never hard-coded: use `load(environment:bundle:)` to read it from the
+/// `TMDB_API_KEY` environment variable or the `TMDB_API_KEY` Info.plist key.
+struct APIConfiguration: Equatable, Sendable {
+    /// Name of both the environment variable and the Info.plist key holding the API key.
+    static let apiKeyName = "TMDB_API_KEY"
+
+    let apiKey: String
+    let baseURL: URL
+
+    init(apiKey: String, baseURL: URL = TMDBApp.apiBaseURL) {
+        self.apiKey = apiKey
+        self.baseURL = baseURL
+    }
+
+    /// Reads the API key from `environment`, falling back to `bundle`'s Info.plist.
+    ///
+    /// Values are trimmed; an empty or whitespace-only value counts as absent.
+    /// - Throws: `APIError.missingAPIKey` when neither source has a non-empty key.
+    static func load(
+        environment: [String: String] = ProcessInfo.processInfo.environment,
+        bundle: Bundle = .main
+    ) throws -> APIConfiguration {
+        let candidates = [
+            environment[apiKeyName],
+            bundle.object(forInfoDictionaryKey: apiKeyName) as? String,
+        ]
+        for candidate in candidates {
+            if let key = candidate?.trimmingCharacters(in: .whitespacesAndNewlines), !key.isEmpty {
+                return APIConfiguration(apiKey: key)
+            }
+        }
+        throw APIError.missingAPIKey
+    }
+}
