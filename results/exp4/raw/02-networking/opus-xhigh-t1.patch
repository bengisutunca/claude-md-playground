@@ -0,0 +1,67 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("APIConfiguration")
+struct APIConfigurationTests {
+    /// Runs `body` with a throwaway on-disk bundle whose Info.plist is `info`.
+    private func withBundle(info: [String: String], _ body: (Bundle) throws -> Void) throws {
+        let root = FileManager.default.temporaryDirectory
+            .appendingPathComponent("TMDBAppTests-\(UUID().uuidString).bundle")
+        defer { try? FileManager.default.removeItem(at: root) }
+        #if os(macOS)
+        let plistDirectory = root.appendingPathComponent("Contents")
+        #else
+        let plistDirectory = root
+        #endif
+        try FileManager.default.createDirectory(at: plistDirectory, withIntermediateDirectories: true)
+        let plist = try PropertyListSerialization.data(fromPropertyList: info, format: .xml, options: 0)
+        try plist.write(to: plistDirectory.appendingPathComponent("Info.plist"))
+        try body(try #require(Bundle(url: root)))
+    }
+
+    @Test func defaultsToTMDBBaseURL() {
+        let configuration = APIConfiguration(apiKey: "k")
+        #expect(configuration.apiKey == "k")
+        #expect(configuration.baseURL == TMDBApp.apiBaseURL)
+    }
+
+    @Test func environmentTakesPrecedenceOverInfoPlist() throws {
+        try withBundle(info: ["TMDB_API_KEY": "plist-key"]) { bundle in
+            let configuration = try APIConfiguration.load(environment: ["TMDB_API_KEY": "env-key"], bundle: bundle)
+            #expect(configuration.apiKey == "env-key")
+            #expect(configuration.baseURL == TMDBApp.apiBaseURL)
+        }
+    }
+
+    @Test("Falls back to Info.plist when the environment has no usable key",
+          arguments: [nil, "", "  \n"] as [String?])
+    func fallsBackToInfoPlist(environmentValue: String?) throws {
+        try withBundle(info: ["TMDB_API_KEY": "plist-key"]) { bundle in
+            let environment = environmentValue.map { ["TMDB_API_KEY": $0] } ?? [:]
+            let configuration = try APIConfiguration.load(environment: environment, bundle: bundle)
+            #expect(configuration.apiKey == "plist-key")
+        }
+    }
+
+    @Test func trimsWhitespace() throws {
+        try withBundle(info: [:]) { bundle in
+            let configuration = try APIConfiguration.load(environment: ["TMDB_API_KEY": " env-key\n"], bundle: bundle)
+            #expect(configuration.apiKey == "env-key")
+        }
+    }
+
+    @Test("Throws missingAPIKey when neither source has a key",
+          arguments: [[:], ["TMDB_API_KEY": ""]] as [[String: String]])
+    func throwsWhenNoKey(info: [String: String]) throws {
+        try withBundle(info: info) { bundle in
+            let error = try #require(throws: APIError.self) {
+                try APIConfiguration.load(environment: ["TMDB_API_KEY": "", "OTHER": "x"], bundle: bundle)
+            }
+            guard case .missingAPIKey = error else {
+                Issue.record("Expected .missingAPIKey, got \(error)")
+                return
+            }
+        }
+    }
+}
