@@ -0,0 +1,122 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("TMDBClient")
+struct TMDBClientTests {
+    @Test func decodesSuccessResponse() async throws {
+        let client = try MockURLProtocol.client(fixture: "popular_page1")
+        let page = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+        #expect(page.page == 1)
+        #expect(page.results.count == 5)
+        #expect(page.results.first?.title == "Inception")
+    }
+
+    @Test func mapsTMDBErrorBodyToHTTPStatus() async throws {
+        let client = try MockURLProtocol.client(statusCode: 401, fixture: "error_401")
+        do {
+            _ = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("Expected APIError.httpStatus")
+        } catch let APIError.httpStatus(code, message) {
+            #expect(code == 401)
+            #expect(message == "Invalid API key: You must be granted a valid key.")
+        }
+    }
+
+    @Test func httpStatusWithoutTMDBBodyHasNilMessage() async throws {
+        let client = MockURLProtocol.client(statusCode: 500, data: Data("<html>oops</html>".utf8))
+        do {
+            _ = try await client.send(.movieDetail(id: 1), as: MovieDetail.self)
+            Issue.record("Expected APIError.httpStatus")
+        } catch let APIError.httpStatus(code, message) {
+            #expect(code == 500)
+            #expect(message == nil)
+        }
+    }
+
+    @Test func reportsDecodingFailure() async throws {
+        // A valid 200 body of the wrong shape.
+        let client = try MockURLProtocol.client(fixture: "movie_credits_27205")
+        do {
+            _ = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("Expected APIError.decoding")
+        } catch APIError.decoding(let underlying) {
+            #expect(underlying is DecodingError)
+        }
+    }
+}
+
+@Suite("Endpoint")
+struct EndpointTests {
+    private let configuration = APIConfiguration(apiKey: "test-key")
+
+    @Test(arguments: [
+        (Endpoint.popular(page: 2), "/3/movie/popular", ["page": "2"]),
+        (Endpoint.search(query: "Spirited Away", page: 3), "/3/search/movie", ["query": "Spirited Away", "page": "3"]),
+        (Endpoint.movieDetail(id: 27205), "/3/movie/27205", [:]),
+        (Endpoint.credits(movieID: 27205), "/3/movie/27205/credits", [:]),
+    ])
+    func buildsRequest(endpoint: Endpoint, path: String, extraItems: [String: String]) throws {
+        let request = try endpoint.urlRequest(configuration: configuration)
+        let url = try #require(request.url)
+        #expect(url.scheme == "https")
+        #expect(url.host == "api.themoviedb.org")
+        #expect(url.path == path)
+        #expect(request.httpMethod == "GET")
+
+        let items = try #require(URLComponents(url: url, resolvingAgainstBaseURL: false)?.queryItems)
+        let expected = extraItems.merging(["api_key": "test-key", "language": "en-US"]) { $1 }
+        #expect(items.count == expected.count)
+        #expect(Dictionary(uniqueKeysWithValues: items.map { ($0.name, $0.value ?? "") }) == expected)
+    }
+
+    @Test func escapesReservedCharactersInSearchQuery() throws {
+        let query = "Fast & Furious + 10=?"
+        let url = try #require(try Endpoint.search(query: query, page: 1).urlRequest(configuration: configuration).url)
+        #expect(!(url.query ?? "").contains("+"))
+        let items = try #require(URLComponents(url: url, resolvingAgainstBaseURL: false)?.queryItems)
+        #expect(items.first(where: { $0.name == "query" })?.value == query)
+        #expect(items.count == 4)
+    }
+}
+
+@Suite("APIConfiguration")
+struct APIConfigurationTests {
+    /// The test resource bundle; its Info.plist has no `TMDB_API_KEY`.
+    private let bundleWithoutKey = Bundle.module
+
+    @Test func readsKeyFromEnvironment() throws {
+        let config = try APIConfiguration.load(environment: ["TMDB_API_KEY": "env-key"], bundle: bundleWithoutKey)
+        #expect(config.apiKey == "env-key")
+        #expect(config.baseURL == TMDBApp.apiBaseURL)
+    }
+
+    @Test func fallsBackToInfoPlist() throws {
+        let bundle = try makeBundle(infoPlist: ["CFBundleIdentifier": "test.\(UUID())", "TMDB_API_KEY": "plist-key"])
+        #expect(try APIConfiguration.load(environment: [:], bundle: bundle).apiKey == "plist-key")
+        #expect(try APIConfiguration.load(environment: ["TMDB_API_KEY": " "], bundle: bundle).apiKey == "plist-key")
+        #expect(try APIConfiguration.load(environment: ["TMDB_API_KEY": "env-key"], bundle: bundle).apiKey == "env-key")
+    }
+
+    @Test(arguments: [[:], ["TMDB_API_KEY": ""], ["TMDB_API_KEY": "  \n"]])
+    func throwsWhenKeyIsMissingOrBlank(environment: [String: String]) throws {
+        do {
+            _ = try APIConfiguration.load(environment: environment, bundle: bundleWithoutKey)
+            Issue.record("Expected APIError.missingAPIKey")
+        } catch APIError.missingAPIKey {}
+    }
+
+    /// Writes a bundle with the given Info.plist to a temporary directory.
+    private func makeBundle(infoPlist: [String: String]) throws -> Bundle {
+        let root = FileManager.default.temporaryDirectory.appending(path: "\(UUID().uuidString).bundle")
+        #if os(macOS)
+        let plistDirectory = root.appending(path: "Contents")
+        #else
+        let plistDirectory = root
+        #endif
+        try FileManager.default.createDirectory(at: plistDirectory, withIntermediateDirectories: true)
+        let data = try PropertyListSerialization.data(fromPropertyList: infoPlist, format: .xml, options: 0)
+        try data.write(to: plistDirectory.appending(path: "Info.plist"))
+        return try #require(Bundle(url: root))
+    }
+}
