--- /dev/null
+++ b/Sources/TMDBApp/Networking/APIError.swift
@@ -0,0 +1,23 @@
+import Foundation
+
+enum APIError: Error {
+    /// The response was not an HTTP response.
+    case invalidResponse
+    /// Non-2xx status; `message` is TMDB's `status_message` when the body carries one.
+    case httpStatus(code: Int, message: String?)
+    case decoding(Error)
+    case transport(Error)
+    case missingAPIKey
+}
+
+extension APIError {
+    /// Builds `.httpStatus` for a non-2xx response, extracting `status_message` from a TMDB error body.
+    static func httpStatus(code: Int, body: Data) -> APIError {
+        let message = try? JSONDecoder.tmdb.decode(ErrorBody.self, from: body).statusMessage
+        return .httpStatus(code: code, message: message)
+    }
+
+    private struct ErrorBody: Decodable {
+        let statusMessage: String?
+    }
+}
