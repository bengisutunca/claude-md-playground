--- /dev/null
+++ b/Tests/TMDBAppTests/MockURLProtocol.swift
@@ -0,0 +1,51 @@
+import Foundation
+@testable import TMDBApp
+
+/// Answers requests with canned responses so tests never reach the network.
+///
+/// Each stub gets its own fake host, so tests using different stubs can run in parallel.
+final class MockURLProtocol: URLProtocol {
+    struct Stub {
+        let statusCode: Int
+        let data: Data
+    }
+
+    private static let lock = NSLock()
+    private static var stubs: [String: Stub] = [:]
+
+    /// A client whose every request is answered with `statusCode` and `data`.
+    static func client(statusCode: Int = 200, data: Data) -> TMDBClient {
+        let host = "\(UUID().uuidString.lowercased()).mock"
+        lock.withLock { stubs[host] = Stub(statusCode: statusCode, data: data) }
+
+        let sessionConfiguration = URLSessionConfiguration.ephemeral
+        sessionConfiguration.protocolClasses = [MockURLProtocol.self]
+        let configuration = APIConfiguration(apiKey: "test-key", baseURL: URL(string: "https://\(host)/3")!)
+        return TMDBClient(session: URLSession(configuration: sessionConfiguration), configuration: configuration)
+    }
+
+    /// A client whose every request is answered with the named fixture.
+    static func client(statusCode: Int = 200, fixture: String) throws -> TMDBClient {
+        try client(statusCode: statusCode, data: Fixture.data(fixture))
+    }
+
+    override class func canInit(with request: URLRequest) -> Bool { true }
+
+    override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+
+    override func startLoading() {
+        guard let url = request.url,
+              let host = url.host,
+              let stub = Self.lock.withLock({ Self.stubs[host] }),
+              let response = HTTPURLResponse(url: url, statusCode: stub.statusCode, httpVersion: "HTTP/1.1",
+                                             headerFields: ["Content-Type": "application/json"]) else {
+            client?.urlProtocol(self, didFailWithError: URLError(.unsupportedURL))
+            return
+        }
+        client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+        client?.urlProtocol(self, didLoad: stub.data)
+        client?.urlProtocolDidFinishLoading(self)
+    }
+
+    override func stopLoading() {}
+}
