@@ -0,0 +1,28 @@
+import Foundation
+
+/// TMDB credentials and base URL. The key is supplied at runtime and never stored in source.
+struct APIConfiguration: Equatable, Sendable {
+    /// Name of both the environment variable and the Info.plist key holding the API key.
+    static let apiKeyName = "TMDB_API_KEY"
+
+    let apiKey: String
+    let baseURL: URL
+
+    init(apiKey: String, baseURL: URL = TMDBApp.apiBaseURL) {
+        self.apiKey = apiKey
+        self.baseURL = baseURL
+    }
+
+    /// Reads the key from the `TMDB_API_KEY` environment variable, falling back to the
+    /// `TMDB_API_KEY` entry of the bundle's Info.plist. Blank values count as absent.
+    static func load(environment: [String: String] = ProcessInfo.processInfo.environment,
+                     bundle: Bundle = .main) throws -> APIConfiguration {
+        let candidates = [environment[apiKeyName], bundle.object(forInfoDictionaryKey: apiKeyName) as? String]
+        guard let apiKey = candidates
+            .compactMap({ $0?.trimmingCharacters(in: .whitespacesAndNewlines) })
+            .first(where: { !$0.isEmpty }) else {
+            throw APIError.missingAPIKey
+        }
+        return APIConfiguration(apiKey: apiKey)
+    }
+}
diff --git a/Sources/TMDBApp/Networking/APIError.swift b/Sources/TMDBApp/Networking/APIError.swift
