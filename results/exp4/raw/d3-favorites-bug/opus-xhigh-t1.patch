diff --git a/Tests/TMDBAppTests/FavoritesTests.swift b/Tests/TMDBAppTests/FavoritesTests.swift
index 24574fe..1dcb53e 100644
--- a/Tests/TMDBAppTests/FavoritesTests.swift
+++ b/Tests/TMDBAppTests/FavoritesTests.swift
@@ -88,4 +88,22 @@ struct FavoritesTests {
         #expect(vm.favorites == [movie])
         #expect(vm.favorites.filter { $0.id == movie.id }.count == 1)
     }
+
+    /// Regression: de-duplication once kept only *repeat* occurrences of an id, so every unique
+    /// favorite was dropped on save and on load, and the Favorites tab was empty after relaunch.
+    @Test func storeKeepsFirstOccurrenceOfEachMovieAcrossRelaunch() throws {
+        let suite = TestSuite(); defer { suite.cleanUp() }
+        let all = try movies()
+        let (a, b, c) = (all[0], all[1], all[2])
+
+        // Save path: unique movies survive; duplicates collapse onto their first occurrence.
+        suite.makeStore().save([a, b, a, c, b])
+        // A fresh store over the same defaults simulates an app relaunch.
+        #expect(suite.makeStore().load() == [a, b, c])
+
+        // Load path: persisted data that already contains duplicates is collapsed, not emptied.
+        let raw = try JSONEncoder().encode([c, a, c, b])
+        suite.defaults.set(raw, forKey: UserDefaultsFavoritesStore.defaultKey)
+        #expect(suite.makeStore().load() == [c, a, b])
+    }
 }
