diff --git a/Tests/TMDBAppTests/MovieDetailViewModelTests.swift b/Tests/TMDBAppTests/MovieDetailViewModelTests.swift
new file mode 100644
index 0000000..7df82f6
--- /dev/null
+++ b/Tests/TMDBAppTests/MovieDetailViewModelTests.swift
@@ -0,0 +1,102 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("MovieDetailViewModel")
+struct MovieDetailViewModelTests {
+    private func loadedContent(_ vm: MovieDetailViewModel) -> MovieDetailContent? {
+        if case .loaded(let content) = vm.state { return content }
+        return nil
+    }
+
+    @Test func successfulLoad() async throws {
+        let service = MockMovieService()
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        #expect(vm.state == .idle)
+        await vm.load()
+
+        let content = try #require(loadedContent(vm))
+        #expect(content.detail.id == 27205)
+        #expect(content.detail.title == "Inception")
+        #expect(content.detail.tagline == "Your mind is the scene of the crime.")
+        #expect(content.cast.map(\.name) == ["Leonardo DiCaprio", "Joseph Gordon-Levitt", "Elliot Page", "Tom Hardy"])
+        #expect(content.directors.map(\.name) == ["Christopher Nolan"])
+        #expect(content.runtimeText == "2h 28m")
+        #expect(content.genresText == "Action, Science Fiction, Adventure")
+        #expect(content.releaseYear == "2010")
+
+        let calls = await service.calls
+        #expect(calls.count == 2)
+        #expect(calls.contains(.detail(id: 27205)))
+        #expect(calls.contains(.credits(id: 27205)))
+    }
+
+    @Test func secondLoadAfterSuccessIsNoOp() async {
+        let service = MockMovieService()
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        await vm.load()
+        await vm.load()
+        #expect(await service.calls.count == 2)
+    }
+
+    @Test func detailFailureGivesFailed() async {
+        let service = MockMovieService(detailError: APIError.httpStatus(code: 404, message: "Not found"))
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        await vm.load()
+        #expect(vm.state == .failed("Not found"))
+    }
+
+    @Test func creditsFailureGivesFailed() async {
+        let service = MockMovieService(creditsError: APIError.transport(URLError(.notConnectedToInternet)))
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        await vm.load()
+        #expect(vm.state == .failed("Couldn't reach the server. Check your connection."))
+    }
+
+    @Test func retryAfterFailureSucceeds() async {
+        let service = MockMovieService(error: APIError.transport(URLError(.timedOut)))
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        await vm.load()
+        guard case .failed = vm.state else { Issue.record("expected failed"); return }
+        await service.setError(nil)
+        await vm.load()
+        #expect(loadedContent(vm) != nil)
+    }
+}
+
+@Suite("MovieDetailContent")
+struct MovieDetailContentTests {
+    @Test(arguments: [
+        (0, "0m"),
+        (1, "1m"),
+        (45, "45m"),
+        (59, "59m"),
+        (60, "1h"),
+        (120, "2h"),
+        (180, "3h"),
+        (61, "1h 1m"),
+        (148, "2h 28m"),
+    ])
+    func formatRuntime(minutes: Int, expected: String) {
+        #expect(MovieDetailContent.formatRuntime(minutes: minutes) == expected)
+    }
+
+    @Test func castIsTopTenOrderedByOrderAndDirectorsAreFiltered() throws {
+        let detail = try JSONDecoder.tmdb.decode(MovieDetail.self, from: Fixture.data("movie_detail_27205"))
+        // 12 members in reverse order plus one without an order.
+        var cast = (0..<12).reversed().map {
+            CastMember(id: $0, name: "Actor \($0)", character: nil, order: $0, profilePath: nil)
+        }
+        cast.insert(CastMember(id: 99, name: "Unordered", character: nil, order: nil, profilePath: nil), at: 0)
+        let crew = [
+            CrewMember(id: 1, name: "Writer", job: "Screenplay", department: "Writing", profilePath: nil),
+            CrewMember(id: 2, name: "Director A", job: "Director", department: "Directing", profilePath: nil),
+            CrewMember(id: 3, name: "Director B", job: "Director", department: "Directing", profilePath: nil),
+        ]
+
+        let content = MovieDetailContent(detail: detail, credits: Credits(id: detail.id, cast: cast, crew: crew))
+        #expect(content.cast.map(\.id) == Array(0..<10))
+        #expect(content.directors.map(\.name) == ["Director A", "Director B"])
+    }
+}
