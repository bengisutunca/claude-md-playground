+import SwiftUI
+
+struct MovieDetailView: View {
+    @State private var viewModel: MovieDetailViewModel
+    var imageURLBuilder = ImageURLBuilder()
+
+    init(viewModel: MovieDetailViewModel) {
+        _viewModel = State(initialValue: viewModel)
+    }
+
+    var body: some View {
+        content
+            .navigationTitle(navigationTitle)
+            #if os(iOS)
+            .navigationBarTitleDisplayMode(.inline)
+            #endif
+            .task { await viewModel.load() }
+    }
+
+    private var navigationTitle: String {
+        if case .loaded(let content) = viewModel.state { return content.detail.title }
+        return ""
+    }
+
+    @ViewBuilder
+    private var content: some View {
+        switch viewModel.state {
+        case .idle, .loading:
+            ProgressView().frame(maxWidth: .infinity, maxHeight: .infinity)
+        case .empty:
+            Text("Movie not found.")
+                .foregroundStyle(.secondary)
+                .frame(maxWidth: .infinity, maxHeight: .infinity)
+        case .failed(let text):
+            VStack(spacing: 12) {
+                Text(text).multilineTextAlignment(.center).foregroundStyle(.secondary)
+                Button("Try Again") { Task { await viewModel.load() } }
+                    .buttonStyle(.borderedProminent)
+            }
+            .padding()
+            .frame(maxWidth: .infinity, maxHeight: .infinity)
+        case .loaded(let content):
+            loaded(content)
+        }
+    }
+
+    private func loaded(_ content: MovieDetailContent) -> some View {
+        ScrollView {
+            VStack(alignment: .leading, spacing: 16) {
+                backdrop(content.detail)
+                header(content)
+                    .padding(.horizontal)
+                if !content.detail.overview.isEmpty {
+                    section("Overview") {
+                        Text(content.detail.overview).padding(.horizontal)
+                    }
+                }
+                if !content.cast.isEmpty {
+                    section("Cast") { castList(content.cast) }
+                }
+                if let directors = content.directorsText {
+                    section(content.directors.count > 1 ? "Directors" : "Director") {
+                        Text(directors).padding(.horizontal)
+                    }
+                }
+            }
+            .padding(.bottom)
+        }
+    }
+
+    private func backdrop(_ detail: MovieDetail) -> some View {
+        AsyncImage(url: imageURLBuilder.url(path: detail.backdropPath, size: .w780)) { image in
+            image.resizable().scaledToFill()
+        } placeholder: {
+            Rectangle().fill(.quaternary)
+        }
+        .frame(maxWidth: .infinity)
+        .frame(height: 220)
+        .clipped()
+        .accessibilityHidden(true)
+    }
+
+    private func header(_ content: MovieDetailContent) -> some View {
+        HStack(alignment: .top, spacing: 16) {
+            AsyncImage(url: imageURLBuilder.url(path: content.detail.posterPath, size: .w342)) { image in
+                image.resizable().scaledToFill()
+            } placeholder: {
+                ZStack {
+                    Rectangle().fill(.quaternary)
+                    Image(systemName: "film").foregroundStyle(.secondary)
+                }
+            }
+            .frame(width: 110, height: 165)
+            .clipShape(RoundedRectangle(cornerRadius: 8))
+            .accessibilityHidden(true)
+
+            VStack(alignment: .leading, spacing: 6) {
+                Text(content.detail.title).font(.title2).bold()
+                if let tagline = content.detail.tagline, !tagline.isEmpty {
+                    Text(tagline).font(.subheadline).italic().foregroundStyle(.secondary)
+                }
+                Label(content.detail.ratingText, systemImage: "star.fill")
+                    .foregroundStyle(.orange)
+                let facts = [content.releaseYear, content.runtimeText].compactMap { $0 }
+                if !facts.isEmpty {
+                    Text(facts.joined(separator: " · ")).foregroundStyle(.secondary)
+                }
+                if !content.genresText.isEmpty {
+                    Text(content.genresText).font(.footnote).foregroundStyle(.secondary)
+                }
+            }
+            .font(.subheadline)
+            Spacer(minLength: 0)
+        }
+        .accessibilityElement(children: .combine)
+    }
+
+    /// Content supplies its own horizontal padding so the cast row can scroll edge to edge.
+    private func section<Content: View>(_ title: String, @ViewBuilder content: () -> Content) -> some View {
+        VStack(alignment: .leading, spacing: 8) {
+            Text(title).font(.headline).padding(.horizontal)
+            content()
+        }
+    }
+
+    private func castList(_ cast: [CastMember]) -> some View {
+        ScrollView(.horizontal, showsIndicators: false) {
+            HStack(alignment: .top, spacing: 12) {
+                ForEach(cast) { member in
+                    VStack(spacing: 4) {
+                        AsyncImage(url: imageURLBuilder.url(path: member.profilePath, size: .w185)) { image in
+                            image.resizable().scaledToFill()
+                        } placeholder: {
+                            ZStack {
+                                Circle().fill(.quaternary)
+                                Image(systemName: "person.fill").foregroundStyle(.secondary)
+                            }
+                        }
+                        .frame(width: 72, height: 72)
+                        .clipShape(Circle())
+
+                        Text(member.name).font(.caption).bold().lineLimit(2)
+                        if let character = member.character, !character.isEmpty {
+                            Text(character).font(.caption2).foregroundStyle(.secondary).lineLimit(2)
+                        }
+                    }
+                    .multilineTextAlignment(.center)
+                    .frame(width: 88)
+                    .accessibilityElement(children: .combine)
+                }
+            }
+        }
+        .contentMargins(.horizontal, 16, for: .scrollContent)
+    }
+}
