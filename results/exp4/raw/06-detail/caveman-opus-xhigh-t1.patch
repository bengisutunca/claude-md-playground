+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("MovieDetailViewModel")
+struct MovieDetailViewModelTests {
+    enum FailingRequest: CaseIterable, Sendable {
+        case detail, credits
+    }
+
+    private func loadedContent(_ vm: MovieDetailViewModel) -> MovieDetailContent? {
+        if case .loaded(let content) = vm.state { return content }
+        return nil
+    }
+
+    @Test func loadsDetailAndCredits() async throws {
+        let service = MockMovieService()
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        #expect(vm.state == .idle)
+
+        await vm.load()
+
+        let content = try #require(loadedContent(vm), "state: \(vm.state)")
+        #expect(content.detail.id == 27205)
+        #expect(content.detail.title == "Inception")
+        #expect(content.cast.map(\.name) == ["Leonardo DiCaprio", "Joseph Gordon-Levitt", "Elliot Page", "Tom Hardy"])
+        #expect(content.directors.map(\.name) == ["Christopher Nolan"])
+        #expect(content.runtimeText == "2h 28m")
+        #expect(content.genresText == "Action, Science Fiction, Adventure")
+        #expect(content.directorsText == "Christopher Nolan")
+        #expect(content.detail.year == "2010")
+
+        let calls = await service.calls
+        #expect(calls.count == 2)
+        #expect(calls.contains(.detail(id: 27205)))
+        #expect(calls.contains(.credits(id: 27205)))
+    }
+
+    @Test(arguments: FailingRequest.allCases)
+    func failureOfEitherRequestFails(_ failing: FailingRequest) async {
+        let error = APIError.httpStatus(code: 401, message: "bad key")
+        let service = switch failing {
+        case .detail: MockMovieService(detailError: error)
+        case .credits: MockMovieService(creditsError: error)
+        }
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+
+        await vm.load()
+
+        #expect(vm.state == .failed("Invalid API key."))
+    }
+
+    @Test func retryAfterFailureLoads() async {
+        let service = MockMovieService(creditsError: APIError.transport(URLError(.timedOut)))
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        await vm.load()
+        guard case .failed = vm.state else { Issue.record("expected failed, got \(vm.state)"); return }
+
+        await service.clearErrors()
+        await vm.load()
+
+        #expect(loadedContent(vm)?.detail.id == 27205)
+    }
+
+    @Test func repeatedLoadsFetchOnce() async {
+        let service = MockMovieService()
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        async let a: Void = vm.load()
+        async let b: Void = vm.load()
+        _ = await (a, b)
+        await vm.load()
+
+        #expect(await service.calls.count == 2)
+        #expect(loadedContent(vm) != nil)
+    }
+}
+
+@Suite("MovieDetailContent")
+struct MovieDetailContentTests {
+    @Test func castIsTopTenByOrderAndDirectorsAreFiltered() throws {
+        let detail = try JSONDecoder.tmdb.decode(MovieDetail.self, from: Fixture.data("movie_detail_27205"))
+        let unordered = CastMember(id: 100, name: "Unordered", character: nil, order: nil, profilePath: nil)
+        let cast = [unordered] + (0..<12).reversed().map {
+            CastMember(id: $0, name: "Actor \($0)", character: nil, order: $0, profilePath: nil)
+        }
+        let crew = [
+            CrewMember(id: 1, name: "Producer", job: "Producer", department: "Production", profilePath: nil),
+            CrewMember(id: 2, name: "Director A", job: "Director", department: "Directing", profilePath: nil),
+            CrewMember(id: 3, name: "Director B", job: "Director", department: "Directing", profilePath: nil),
+        ]
+
+        let content = MovieDetailContent(detail: detail, credits: Credits(id: detail.id, cast: cast, crew: crew))
+
+        #expect(content.cast.map(\.order) == Array(0..<10))
+        #expect(content.directors.map(\.name) == ["Director A", "Director B"])
+        #expect(content.directorsText == "Director A, Director B")
+    }
+
+    @Test(arguments: [
+        (148, "2h 28m"),
+        (120, "2h"),
+        (60, "1h"),
+        (61, "1h 1m"),
+        (59, "59m"),
+        (45, "45m"),
+        (1, "1m"),
+        (0, "0m"),
+    ])
+    func formatRuntime(minutes: Int, expected: String) {
+        #expect(MovieDetailContent.formatRuntime(minutes: minutes) == expected)
+    }
+}
