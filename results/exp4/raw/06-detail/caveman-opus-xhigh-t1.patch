@@ -0,0 +1,40 @@
+import Foundation
+
+/// Everything the movie detail screen shows, derived from the detail and credits responses.
+struct MovieDetailContent: Equatable, Sendable {
+    static let castLimit = 10
+
+    let detail: MovieDetail
+    /// Top-billed cast, at most `castLimit`, ordered by `order` (entries without one go last).
+    let cast: [CastMember]
+    let directors: [CrewMember]
+
+    init(detail: MovieDetail, credits: Credits) {
+        self.detail = detail
+        // `sorted` is stable, so equal or missing orders keep their response order.
+        cast = Array(credits.cast.sorted { ($0.order ?? .max) < ($1.order ?? .max) }.prefix(Self.castLimit))
+        directors = credits.crew.filter { $0.job == "Director" }
+    }
+
+    /// Nil when the runtime is unknown; TMDB reports unknown runtimes as null or 0.
+    var runtimeText: String? {
+        guard let runtime = detail.runtime, runtime > 0 else { return nil }
+        return Self.formatRuntime(minutes: runtime)
+    }
+
+    var genresText: String { detail.genres.map(\.name).joined(separator: ", ") }
+
+    var directorsText: String { directors.map(\.name).joined(separator: ", ") }
+
+    /// 148 → "2h 28m", 120 → "2h", 45 → "45m", 0 → "0m". Negative values count as 0.
+    static func formatRuntime(minutes: Int) -> String {
+        let total = max(minutes, 0)
+        let hours = total / 60
+        let remainder = total % 60
+        switch (hours, remainder) {
+        case (0, _): return "\(remainder)m"
+        case (_, 0): return "\(hours)h"
+        default: return "\(hours)h \(remainder)m"
+        }
+    }
+}
