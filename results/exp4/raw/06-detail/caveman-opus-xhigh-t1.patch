+++ b/Sources/TMDBApp/Views/MovieDetailView.swift
@@ -0,0 +1,162 @@
+import SwiftUI
+
+struct MovieDetailView: View {
+    @State private var viewModel: MovieDetailViewModel
+    var imageURLBuilder = ImageURLBuilder()
+
+    private let backdropHeight: CGFloat = 220
+    private let posterSize = CGSize(width: 110, height: 165)
+    /// How far the poster hangs below the backdrop.
+    private let posterOverhang: CGFloat = 60
+
+    init(viewModel: MovieDetailViewModel) {
+        _viewModel = State(initialValue: viewModel)
+    }
+
+    var body: some View {
+        content
+            #if os(iOS)
+            .navigationBarTitleDisplayMode(.inline)
+            #endif
+            .task { await viewModel.load() }
+    }
+
+    @ViewBuilder
+    private var content: some View {
+        switch viewModel.state {
+        case .idle, .loading:
+            ProgressView().frame(maxWidth: .infinity, maxHeight: .infinity)
+        case .empty:
+            failure("No details available.")
+        case .failed(let text):
+            failure(text)
+        case .loaded(let content):
+            details(content).navigationTitle(content.detail.title)
+        }
+    }
+
+    private func details(_ content: MovieDetailContent) -> some View {
+        let detail = content.detail
+        return ScrollView {
+            VStack(alignment: .leading, spacing: 20) {
+                header(detail)
+
+                VStack(alignment: .leading, spacing: 8) {
+                    Text(detail.title).font(.title).bold()
+                    if let tagline = detail.tagline, !tagline.isEmpty {
+                        Text(tagline).font(.subheadline).italic().foregroundStyle(.secondary)
+                    }
+                    facts(content)
+                    if !content.genresText.isEmpty {
+                        Text(content.genresText).font(.subheadline).foregroundStyle(.secondary)
+                    }
+                }
+                .padding(.horizontal)
+
+                if !detail.overview.isEmpty {
+                    section("Overview") { Text(detail.overview) }
+                        .padding(.horizontal)
+                }
+
+                if !content.directors.isEmpty {
+                    section(content.directors.count == 1 ? "Director" : "Directors") {
+                        Text(content.directorsText)
+                    }
+                    .padding(.horizontal)
+                }
+
+                if !content.cast.isEmpty {
+                    // The cast row scrolls edge to edge, so only its title is inset.
+                    VStack(alignment: .leading, spacing: 8) {
+                        sectionTitle("Cast").padding(.horizontal)
+                        castList(content.cast)
+                    }
+                }
+            }
+            .padding(.bottom)
+        }
+    }
+
+    /// Backdrop with the poster overlapping its bottom edge.
+    private func header(_ detail: MovieDetail) -> some View {
+        // A fixed-size clear base keeps the fill-scaled backdrop from widening the layout.
+        Color.clear
+            .frame(maxWidth: .infinity)
+            .frame(height: backdropHeight)
+            .overlay {
+                RemoteImage(url: imageURLBuilder.url(path: detail.backdropPath, size: .w780),
+                            placeholderSystemImage: "photo")
+            }
+            .clipped()
+            .overlay(alignment: .bottomLeading) {
+                RemoteImage(url: imageURLBuilder.url(path: detail.posterPath, size: .w342))
+                    .frame(width: posterSize.width, height: posterSize.height)
+                    .clipShape(RoundedRectangle(cornerRadius: 8))
+                    .shadow(radius: 6)
+                    .padding(.leading)
+                    .offset(y: posterOverhang)
+            }
+            .padding(.bottom, posterOverhang)
+    }
+
+    /// Rating, release year and runtime on one line.
+    private func facts(_ content: MovieDetailContent) -> some View {
+        HStack(spacing: 12) {
+            Label(content.detail.ratingText, systemImage: "star.fill")
+                .foregroundStyle(.orange)
+                .accessibilityLabel("Rating \(content.detail.ratingText) out of 10")
+            if let year = content.detail.year {
+                Text(year)
+            }
+            if let runtime = content.runtimeText {
+                Label(runtime, systemImage: "clock")
+            }
+        }
+        .font(.subheadline)
+        .foregroundStyle(.secondary)
+    }
+
+    private func castList(_ cast: [CastMember]) -> some View {
+        ScrollView(.horizontal, showsIndicators: false) {
+            LazyHStack(alignment: .top, spacing: 12) {
+                // `id: \.self`: one person can hold several cast entries, so `id` alone is not unique.
+                ForEach(cast, id: \.self) { member in
+                    VStack(alignment: .leading, spacing: 4) {
+                        RemoteImage(url: imageURLBuilder.url(path: member.profilePath, size: .w185),
+                                    placeholderSystemImage: "person.fill")
+                            .frame(width: 90, height: 135)
+                            .clipShape(RoundedRectangle(cornerRadius: 8))
+                        Text(member.name).font(.caption).bold().lineLimit(2)
+                        if let character = member.character, !character.isEmpty {
+                            Text(character).font(.caption2).foregroundStyle(.secondary).lineLimit(2)
+                        }
+                    }
+                    .frame(width: 90, alignment: .leading)
+                    .accessibilityElement(children: .combine)
+                }
+            }
+            .padding(.horizontal)
+        }
+    }
+
+    private func section<Content: View>(_ title: String, @ViewBuilder content: () -> Content) -> some View {
+        VStack(alignment: .leading, spacing: 8) {
+            sectionTitle(title)
+            content()
+        }
+    }
+
+    private func sectionTitle(_ title: String) -> some View {
+        Text(title).font(.title3).bold().accessibilityAddTraits(.isHeader)
+    }
+
+    private func failure(_ text: String) -> some View {
+        VStack(spacing: 12) {
+            Text(text).multilineTextAlignment(.center).foregroundStyle(.secondary)
+            Button("Try Again") { Task { await viewModel.load() } }
+                .buttonStyle(.borderedProminent)
+        }
+        .padding()
+        .frame(maxWidth: .infinity, maxHeight: .infinity)
+    }
+}
