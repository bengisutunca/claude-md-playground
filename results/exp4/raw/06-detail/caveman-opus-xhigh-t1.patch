+import Foundation
+import Observation
+
+@MainActor
+@Observable
+final class MovieDetailViewModel {
+    private(set) var state: ViewState<MovieDetailContent> = .idle
+
+    @ObservationIgnored private let movieID: Int
+    @ObservationIgnored private let service: any MovieService
+
+    init(movieID: Int, service: any MovieService) {
+        self.movieID = movieID
+        self.service = service
+    }
+
+    /// Fetches detail and credits concurrently; both must succeed.
+    /// No-op while loading or once loaded; call again after a failure to retry.
+    func load() async {
+        switch state {
+        case .loading, .loaded: return
+        case .idle, .empty, .failed: break
+        }
+        state = .loading
+        let service = self.service
+        let id = movieID
+        do {
+            async let detail = service.detail(id: id)
+            async let credits = service.credits(id: id)
+            let (loadedDetail, loadedCredits) = try await (detail, credits)
+            state = .loaded(MovieDetailContent(detail: loadedDetail, credits: loadedCredits))
+        } catch {
+            // A cancelled load (e.g. the view disappeared) returns to idle so the next appearance reloads.
+            state = Task.isCancelled ? .idle : .failed(MovieListViewModel.message(for: error))
+        }
+    }
+}
