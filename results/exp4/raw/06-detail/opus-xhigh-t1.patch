@@ -0,0 +1,42 @@
+import Foundation
+import Observation
+
+@MainActor
+@Observable
+final class MovieDetailViewModel {
+    let movieID: Int
+    private(set) var state: ViewState<MovieDetailContent> = .idle
+
+    @ObservationIgnored private let service: any MovieService
+
+    init(movieID: Int, service: any MovieService) {
+        self.movieID = movieID
+        self.service = service
+    }
+
+    /// Fetches detail and credits concurrently. No-op if already loaded or a request is in flight;
+    /// call again after a failure to retry.
+    func load() async {
+        switch state {
+        case .loading, .loaded: return
+        case .idle, .empty, .failed: break
+        }
+        state = .loading
+
+        let service = service
+        let id = movieID
+        do {
+            async let detail = service.detail(id: id)
+            async let credits = service.credits(id: id)
+            state = .loaded(try await MovieDetailContent(detail: detail, credits: credits))
+        } catch {
+            // The client reports cancellation as a transport error, so check the task too.
+            // Going back to idle lets the next `load()` (e.g. when the screen reappears) start over.
+            if error is CancellationError || Task.isCancelled {
+                state = .idle
+            } else {
+                state = .failed(MovieListViewModel.message(for: error))
+            }
+        }
+    }
+}
