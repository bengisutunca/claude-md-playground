diff --git a/Sources/TMDBApp/Views/MovieDetailView.swift b/Sources/TMDBApp/Views/MovieDetailView.swift
new file mode 100644
index 0000000..5102fdf
--- /dev/null
+++ b/Sources/TMDBApp/Views/MovieDetailView.swift
@@ -0,0 +1,170 @@
+import SwiftUI
+
+struct MovieDetailView: View {
+    @State private var viewModel: MovieDetailViewModel
+    var imageURLBuilder = ImageURLBuilder()
+
+    init(viewModel: MovieDetailViewModel) {
+        _viewModel = State(initialValue: viewModel)
+    }
+
+    var body: some View {
+        content
+            .navigationTitle(title)
+            #if os(iOS)
+            .navigationBarTitleDisplayMode(.inline)
+            #endif
+            .task { await viewModel.load() }
+    }
+
+    private var title: String {
+        if case .loaded(let content) = viewModel.state { return content.detail.title }
+        return ""
+    }
+
+    @ViewBuilder
+    private var content: some View {
+        switch viewModel.state {
+        case .idle, .loading:
+            ProgressView().frame(maxWidth: .infinity, maxHeight: .infinity)
+        case .empty:
+            message("No details available.", retry: false)
+        case .failed(let text):
+            message(text, retry: true)
+        case .loaded(let content):
+            ScrollView {
+                VStack(alignment: .leading, spacing: 20) {
+                    backdrop(content.detail)
+                    header(content).padding(.horizontal)
+                    if !content.detail.overview.isEmpty {
+                        section("Overview") { Text(content.detail.overview) }
+                    }
+                    if !content.cast.isEmpty {
+                        // Not a padded `section`: the carousel scrolls edge to edge.
+                        VStack(alignment: .leading, spacing: 8) {
+                            heading("Cast").padding(.horizontal)
+                            castList(content.cast)
+                        }
+                    }
+                    if let directors = content.directorsText {
+                        section(content.directors.count > 1 ? "Directors" : "Director") { Text(directors) }
+                    }
+                }
+                .padding(.bottom)
+            }
+        }
+    }
+
+    // MARK: - Sections
+
+    private func backdrop(_ detail: MovieDetail) -> some View {
+        // A fixed-ratio container keeps the scaled-to-fill image from widening the layout.
+        Color.clear
+            .aspectRatio(16 / 9, contentMode: .fit)
+            .overlay {
+                remoteImage(imageURLBuilder.url(path: detail.backdropPath, size: .w780), symbol: "photo")
+            }
+            .clipped()
+            .accessibilityHidden(true)
+    }
+
+    private func header(_ content: MovieDetailContent) -> some View {
+        HStack(alignment: .top, spacing: 16) {
+            remoteImage(imageURLBuilder.url(path: content.detail.posterPath, size: .w342), symbol: "film")
+                .frame(width: 100, height: 150)
+                .clipShape(RoundedRectangle(cornerRadius: 8))
+                .accessibilityHidden(true)
+
+            VStack(alignment: .leading, spacing: 8) {
+                Text(content.detail.title)
+                    .font(.title2.bold())
+                    .accessibilityAddTraits(.isHeader)
+                if let tagline = content.detail.tagline, !tagline.isEmpty {
+                    Text(tagline).font(.subheadline).italic().foregroundStyle(.secondary)
+                }
+                facts(content)
+                if !content.genresText.isEmpty {
+                    Text(content.genresText).font(.footnote).foregroundStyle(.secondary)
+                }
+            }
+        }
+    }
+
+    private func facts(_ content: MovieDetailContent) -> some View {
+        HStack(spacing: 12) {
+            Label(content.detail.ratingText, systemImage: "star.fill")
+                .foregroundStyle(.orange)
+                .accessibilityLabel("Rating \(content.detail.ratingText) out of 10")
+            if let runtime = content.runtimeText {
+                Label(runtime, systemImage: "clock")
+            }
+            if let year = content.releaseYear {
+                Label(year, systemImage: "calendar")
+            }
+        }
+        .font(.subheadline)
+    }
+
+    private func castList(_ cast: [CastMember]) -> some View {
+        ScrollView(.horizontal, showsIndicators: false) {
+            LazyHStack(alignment: .top, spacing: 12) {
+                // Indexed: the same person can be credited twice (e.g. two roles), so `id` isn't unique.
+                ForEach(cast.indices, id: \.self) { index in
+                    castCard(cast[index])
+                }
+            }
+            .padding(.horizontal)
+        }
+    }
+
+    private func castCard(_ member: CastMember) -> some View {
+        VStack(alignment: .leading, spacing: 4) {
+            remoteImage(imageURLBuilder.url(path: member.profilePath, size: .w185), symbol: "person.fill")
+                .frame(width: 90, height: 120)
+                .clipShape(RoundedRectangle(cornerRadius: 8))
+            Text(member.name).font(.caption.bold()).lineLimit(2)
+            if let character = member.character, !character.isEmpty {
+                Text(character).font(.caption2).foregroundStyle(.secondary).lineLimit(2)
+            }
+        }
+        .frame(width: 90, alignment: .leading)
+        .accessibilityElement(children: .combine)
+    }
+
+    // MARK: - Helpers
+
+    private func section<Body: View>(_ title: String, @ViewBuilder body: () -> Body) -> some View {
+        VStack(alignment: .leading, spacing: 8) {
+            heading(title)
+            body()
+        }
+        .padding(.horizontal)
+    }
+
+    private func heading(_ text: String) -> some View {
+        Text(text).font(.headline).accessibilityAddTraits(.isHeader)
+    }
+
+    private func remoteImage(_ url: URL?, symbol: String) -> some View {
+        AsyncImage(url: url) { image in
+            image.resizable().scaledToFill()
+        } placeholder: {
+            ZStack {
+                Rectangle().fill(.quaternary)
+                Image(systemName: symbol).foregroundStyle(.secondary)
+            }
+        }
+    }
+
+    private func message(_ text: String, retry: Bool) -> some View {
+        VStack(spacing: 12) {
+            Text(text).multilineTextAlignment(.center).foregroundStyle(.secondary)
+            if retry {
+                Button("Try Again") { Task { await viewModel.load() } }
+                    .buttonStyle(.borderedProminent)
+            }
+        }
+        .padding()
+        .frame(maxWidth: .infinity, maxHeight: .infinity)
+    }
+}
