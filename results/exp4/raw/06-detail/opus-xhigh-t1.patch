diff --git a/Tests/TMDBAppTests/MovieDetailViewModelTests.swift b/Tests/TMDBAppTests/MovieDetailViewModelTests.swift
new file mode 100644
index 0000000..c14f9c1
--- /dev/null
+++ b/Tests/TMDBAppTests/MovieDetailViewModelTests.swift
@@ -0,0 +1,192 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+/// Counts overlapping requests. Each request waits (a bounded number of yields) for the other to
+/// start, so concurrent callers reach 2 in flight while sequential ones never do — and never hang.
+private actor ConcurrencyProbeService: MovieService {
+    private var inFlight = 0
+    private(set) var maxInFlight = 0
+
+    private func respond<T: Decodable>(with fixture: String) async throws -> T {
+        inFlight += 1
+        maxInFlight = max(maxInFlight, inFlight)
+        defer { inFlight -= 1 }
+        var spins = 0
+        while maxInFlight < 2, spins < 1_000 {
+            spins += 1
+            await Task.yield()
+        }
+        return try JSONDecoder.tmdb.decode(T.self, from: Fixture.data(fixture))
+    }
+
+    func detail(id: Int) async throws -> MovieDetail { try await respond(with: "movie_detail_27205") }
+    func credits(id: Int) async throws -> Credits { try await respond(with: "movie_credits_27205") }
+    func popular(page: Int) async throws -> PagedResponse<Movie> { throw APIError.invalidResponse }
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> { throw APIError.invalidResponse }
+}
+
+@MainActor
+@Suite("MovieDetailViewModel")
+struct MovieDetailViewModelTests {
+    enum FailingRequest: CaseIterable, Sendable {
+        case detail, credits, both
+    }
+
+    private func loadedContent(_ vm: MovieDetailViewModel) -> MovieDetailContent? {
+        if case .loaded(let content) = vm.state { return content }
+        return nil
+    }
+
+    @Test func loadsDetailAndCredits() async throws {
+        let service = MockMovieService()
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        #expect(vm.state == .idle)
+
+        await vm.load()
+
+        let content = try #require(loadedContent(vm), "expected loaded, got \(vm.state)")
+        #expect(content.detail.id == 27205)
+        #expect(content.detail.title == "Inception")
+        #expect(content.detail.tagline == "Your mind is the scene of the crime.")
+        #expect(content.cast.map(\.name) == ["Leonardo DiCaprio", "Joseph Gordon-Levitt", "Elliot Page", "Tom Hardy"])
+        #expect(content.directors.map(\.name) == ["Christopher Nolan"])
+        #expect(content.directorsText == "Christopher Nolan")
+        #expect(content.runtimeText == "2h 28m")
+        #expect(content.genresText == "Action, Science Fiction, Adventure")
+        #expect(content.releaseYear == "2010")
+
+        // Both requests use the movie id; their order is unspecified because they run concurrently.
+        let calls = await service.calls
+        #expect(calls.count == 2)
+        #expect(calls.contains(.detail(id: 27205)))
+        #expect(calls.contains(.credits(id: 27205)))
+    }
+
+    @Test func requestsRunConcurrently() async throws {
+        let service = ConcurrencyProbeService()
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        await vm.load()
+        #expect(loadedContent(vm) != nil)
+        #expect(await service.maxInFlight == 2)
+    }
+
+    @Test(arguments: FailingRequest.allCases)
+    func failedRequestGivesFailedState(_ failing: FailingRequest) async {
+        let error = APIError.httpStatus(code: 401, message: "bad key")
+        let service = MockMovieService(detailError: failing == .credits ? nil : error,
+                                       creditsError: failing == .detail ? nil : error)
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        await vm.load()
+        #expect(vm.state == .failed("Invalid API key."))
+    }
+
+    @Test func retryAfterFailureLoads() async {
+        let service = MockMovieService(error: APIError.transport(URLError(.notConnectedToInternet)))
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        await vm.load()
+        #expect(vm.state == .failed("Couldn't reach the server. Check your connection."))
+
+        await service.setError(nil)
+        await vm.load()
+        #expect(loadedContent(vm) != nil)
+    }
+
+    @Test func loadIsNoOpOnceLoaded() async {
+        let service = MockMovieService()
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        await vm.load()
+        await vm.load()
+        #expect(loadedContent(vm) != nil)
+        #expect(await service.calls.count == 2)
+    }
+
+    @Test func cancelledLoadReturnsToIdle() async {
+        // TMDBClient reports a cancelled URLSession request as a transport error.
+        let service = MockMovieService(error: APIError.transport(URLError(.cancelled)))
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        let task = Task { await vm.load() }
+        task.cancel()
+        await task.value
+        #expect(vm.state == .idle)
+    }
+
+    @Test func listAndSearchCreateDetailViewModelsSharingTheirService() async {
+        let service = MockMovieService()
+        let movie = Movie(id: 27205, title: "Inception")
+
+        let fromList = MovieListViewModel(service: service).detailViewModel(for: movie)
+        let fromSearch = SearchViewModel(service: service).detailViewModel(for: movie)
+        #expect(fromList.movieID == 27205)
+        #expect(fromSearch.movieID == 27205)
+
+        await fromList.load()
+        await fromSearch.load()
+        #expect(await service.calls.count == 4)
+    }
+}
+
+@Suite("MovieDetailContent")
+struct MovieDetailContentTests {
+    private func detail(_ json: String) throws -> MovieDetail {
+        try JSONDecoder.tmdb.decode(MovieDetail.self, from: Data(json.utf8))
+    }
+
+    private func cast(id: Int, order: Int?) -> CastMember {
+        CastMember(id: id, name: "Actor \(id)", character: nil, order: order, profilePath: nil)
+    }
+
+    @Test(arguments: [
+        (0, "0m"), (1, "1m"), (45, "45m"), (59, "59m"),  // zero and under an hour
+        (60, "1h"), (120, "2h"), (180, "3h"),            // exact hours
+        (61, "1h 1m"), (148, "2h 28m"),                  // hours and minutes
+        (-5, "0m"),                                      // invalid input clamps to zero
+    ])
+    func formatRuntime(minutes: Int, expected: String) {
+        #expect(MovieDetailContent.formatRuntime(minutes: minutes) == expected)
+    }
+
+    @Test(arguments: ["null", "0"])
+    func unknownRuntimeHasNoText(runtime: String) throws {
+        let d = try detail(#"{"id": 1, "title": "Untitled", "runtime": \#(runtime)}"#)
+        #expect(MovieDetailContent(detail: d, cast: [], directors: []).runtimeText == nil)
+    }
+
+    @Test func missingOptionalFields() throws {
+        let content = MovieDetailContent(detail: try detail(#"{"id": 1, "title": "Untitled"}"#),
+                                         credits: Credits(id: 1, cast: [], crew: []))
+        #expect(content.genresText == "")
+        #expect(content.releaseYear == nil)
+        #expect(content.cast.isEmpty)
+        #expect(content.directors.isEmpty)
+        #expect(content.directorsText == nil)
+    }
+
+    @Test func castIsOrderedAndCappedAtTen() throws {
+        let d = try JSONDecoder.tmdb.decode(MovieDetail.self, from: Fixture.data("movie_detail_27205"))
+        let shuffled = [7, 2, 11, 0, 9, 4, 1, 10, 3, 8, 6, 5].map { cast(id: $0, order: $0) }
+        let content = MovieDetailContent(detail: d, credits: Credits(id: d.id, cast: shuffled, crew: []))
+        #expect(content.cast.map(\.id) == Array(0..<10))
+    }
+
+    @Test func castWithoutOrderGoesLastInOriginalOrder() throws {
+        let d = try detail(#"{"id": 1, "title": "Untitled"}"#)
+        let members = [cast(id: 100, order: nil), cast(id: 1, order: 1), cast(id: 101, order: nil), cast(id: 0, order: 0)]
+        let content = MovieDetailContent(detail: d, credits: Credits(id: 1, cast: members, crew: []))
+        #expect(content.cast.map(\.id) == [0, 1, 100, 101])
+    }
+
+    @Test func onlyDirectorsAreKept() throws {
+        let d = try detail(#"{"id": 1, "title": "Untitled"}"#)
+        let crew = [
+            CrewMember(id: 1, name: "Lana Wachowski", job: "Director", department: "Directing", profilePath: nil),
+            CrewMember(id: 2, name: "Bill Pope", job: "Director of Photography", department: "Camera", profilePath: nil),
+            CrewMember(id: 3, name: "Lilly Wachowski", job: "Director", department: "Directing", profilePath: nil),
+            CrewMember(id: 4, name: "Joel Silver", job: "Producer", department: "Production", profilePath: nil),
+            CrewMember(id: 5, name: "Unknown", job: nil, department: nil, profilePath: nil),
+        ]
+        let content = MovieDetailContent(detail: d, credits: Credits(id: 1, cast: [], crew: crew))
+        #expect(content.directors.map(\.id) == [1, 3])
+        #expect(content.directorsText == "Lana Wachowski, Lilly Wachowski")
+    }
+}
