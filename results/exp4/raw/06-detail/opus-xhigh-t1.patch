--- /dev/null
+++ b/Sources/TMDBApp/ViewModels/MovieDetailContent.swift
@@ -0,0 +1,58 @@
+import Foundation
+
+/// Everything the movie detail screen shows, derived from the detail and credits responses.
+struct MovieDetailContent: Hashable, Sendable {
+    static let castLimit = 10
+
+    let detail: MovieDetail
+    /// Top billed cast (at most `castLimit`), ordered by TMDB billing `order`.
+    let cast: [CastMember]
+    let directors: [CrewMember]
+}
+
+extension MovieDetailContent {
+    /// Kept in an extension so the memberwise initializer stays available.
+    init(detail: MovieDetail, credits: Credits) {
+        self.init(detail: detail,
+                  cast: Self.topCast(credits.cast),
+                  directors: credits.crew.filter { $0.job == "Director" })
+    }
+
+    /// e.g. "2h 28m"; nil when the runtime is unknown (TMDB sends null or 0).
+    var runtimeText: String? {
+        guard let runtime = detail.runtime, runtime > 0 else { return nil }
+        return Self.formatRuntime(minutes: runtime)
+    }
+
+    /// e.g. "Action, Science Fiction, Adventure"; empty when there are no genres.
+    var genresText: String {
+        detail.genres.map(\.name).joined(separator: ", ")
+    }
+
+    var releaseYear: String? { detail.year }
+
+    /// e.g. "Christopher Nolan"; nil when no director is credited.
+    var directorsText: String? {
+        directors.isEmpty ? nil : directors.map(\.name).joined(separator: ", ")
+    }
+
+    /// 148 -> "2h 28m", 120 -> "2h", 45 -> "45m", 0 -> "0m". Negative values count as 0.
+    static func formatRuntime(minutes: Int) -> String {
+        let total = max(0, minutes)
+        let hours = total / 60
+        let mins = total % 60
+        switch (hours, mins) {
+        case (0, _): return "\(mins)m"
+        case (_, 0): return "\(hours)h"
+        default: return "\(hours)h \(mins)m"
+        }
+    }
+
+    /// Sorts by `order` (members without one go last, keeping their original order) and keeps the first `castLimit`.
+    static func topCast(_ cast: [CastMember]) -> [CastMember] {
+        cast.enumerated()
+            .sorted { ($0.element.order ?? .max, $0.offset) < ($1.element.order ?? .max, $1.offset) }
+            .prefix(castLimit)
+            .map(\.element)
+    }
+}
