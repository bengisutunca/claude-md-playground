diff --git a/Sources/TMDBApp/Models/TMDBDecoding.swift b/Sources/TMDBApp/Models/TMDBDecoding.swift
new file mode 100644
index 0000000..9aeefe9
--- /dev/null
+++ b/Sources/TMDBApp/Models/TMDBDecoding.swift
@@ -0,0 +1,32 @@
+import Foundation
+
+extension JSONDecoder {
+    /// Decodes every TMDB response (snake_case keys).
+    static var tmdb: JSONDecoder {
+        let decoder = JSONDecoder()
+        decoder.keyDecodingStrategy = .convertFromSnakeCase
+        return decoder
+    }
+}
+
+/// TMDB sends release dates as `yyyy-MM-dd`, an empty string, or nothing.
+enum TMDBDate {
+    private static let style = Date.ISO8601FormatStyle().year().month().day()
+
+    static func parse(_ string: String) -> Date? {
+        string.isEmpty ? nil : try? Date(string, strategy: style)
+    }
+
+    /// Four-digit year (UTC), e.g. 2010.
+    static func year(of date: Date?) -> String? {
+        guard let date else { return nil }
+        return String(date.formatted(style).prefix(4))
+    }
+}
+
+extension KeyedDecodingContainer {
+    func decodeTMDBDate(forKey key: Key) throws -> Date? {
+        guard let string = try decodeIfPresent(String.self, forKey: key) else { return nil }
+        return TMDBDate.parse(string)
+    }
+}
