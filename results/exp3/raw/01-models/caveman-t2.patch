@@ -0,0 +1,66 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("Model decoding")
+struct ModelDecodingTests {
+    private func decode<T: Decodable>(_ type: T.Type, _ fixture: String) throws -> T {
+        try JSONDecoder.tmdb.decode(type, from: Fixture.data(fixture))
+    }
+
+    @Test func popularPage1() throws {
+        let page = try decode(PagedResponse<Movie>.self, "popular_page1")
+        #expect(page.page == 1)
+        #expect(page.totalPages == 2)
+        #expect(page.totalResults == 7)
+        #expect(page.results.count == 5)
+
+        let inception = try #require(page.results.first)
+        #expect(inception.id == 27205)
+        #expect(inception.title == "Inception")
+        #expect(inception.genreIDs == [28, 878, 12])
+        #expect(inception.posterPath == "/inception.jpg")
+        #expect(inception.voteCount == 37000)
+        #expect(inception.year == "2010")
+        #expect(inception.ratingText == "8.4")
+    }
+
+    @Test func nullImagePathsDecodeAsNil() throws {
+        let movies = try decode(PagedResponse<Movie>.self, "popular_page1").results
+        let noBackdrop = try #require(movies.first { $0.backdropPath == nil })
+        #expect(noBackdrop.posterPath != nil)
+        let noPoster = try #require(movies.first { $0.posterPath == nil })
+        #expect(noPoster.title == "Fight Club")
+        #expect(noPoster.backdropPath != nil)
+    }
+
+    @Test func popularPage2EmptyReleaseDateIsNil() throws {
+        let page = try decode(PagedResponse<Movie>.self, "popular_page2")
+        #expect(page.page == 2)
+        let parasite = try #require(page.results.first { $0.title == "Parasite" })
+        #expect(parasite.releaseDate == nil)
+        #expect(parasite.year == nil)
+        let spirited = try #require(page.results.first { $0.title == "Spirited Away" })
+        #expect(spirited.year == "2001")
+    }
+
+    @Test func movieDetail() throws {
+        let detail = try decode(MovieDetail.self, "movie_detail_27205")
+        #expect(detail.id == 27205)
+        #expect(detail.runtime == 148)
+        #expect(detail.tagline == "Your mind is the scene of the crime.")
+        #expect(detail.status == "Released")
+        #expect(detail.genres.map(\.name) == ["Action", "Science Fiction", "Adventure"])
+        #expect(detail.year == "2010")
+    }
+
+    @Test func movieCredits() throws {
+        let credits = try decode(Credits.self, "movie_credits_27205")
+        #expect(credits.id == 27205)
+        #expect(credits.cast.count == 4)
+        #expect(credits.cast[0].character == "Cobb")
+        #expect(credits.cast[2].profilePath == nil)
+        #expect(credits.crew.first?.job == "Director")
+        #expect(credits.crew.first?.department == "Directing")
+    }
+}
