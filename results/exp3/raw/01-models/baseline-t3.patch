index 0000000..507a895
--- /dev/null
+++ b/Tests/TMDBAppTests/ModelDecodingTests.swift
@@ -0,0 +1,55 @@
+import Testing
+import Foundation
+@testable import TMDBApp
+
+struct ModelDecodingTests {
+    @Test func popularPage1() throws {
+        let page = try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page1"))
+        #expect(page.page == 1)
+        #expect(page.totalPages == 2)
+        #expect(page.totalResults == 7)
+        #expect(page.results.count == 5)
+        let inception = try #require(page.results.first)
+        #expect(inception.id == 27205)
+        #expect(inception.genreIDs == [28, 878, 12])
+        #expect(inception.year == "2010")
+        #expect(inception.ratingText == "8.4")
+        #expect(inception.voteCount == 37000)
+        #expect(page.results.contains { $0.backdropPath == nil })
+        #expect(page.results.contains { $0.posterPath == nil })
+    }
+
+    @Test func popularPage2EmptyReleaseDate() throws {
+        let page = try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page2"))
+        #expect(page.page == 2)
+        #expect(page.results.count == 2)
+        let undated = try #require(page.results.first { $0.releaseDate == nil })
+        #expect(undated.year == nil)
+    }
+
+    @Test func movieDetail() throws {
+        let d = try JSONDecoder.tmdb.decode(MovieDetail.self, from: Fixture.data("movie_detail_27205"))
+        #expect(d.id == 27205)
+        #expect(d.runtime == 148)
+        #expect(d.tagline == "Your mind is the scene of the crime.")
+        #expect(d.status == "Released")
+        #expect(d.genres.map(\.name) == ["Action", "Science Fiction", "Adventure"])
+        #expect(d.year == "2010")
+        #expect(d.releaseDate != nil)
+    }
+
+    @Test func credits() throws {
+        let c = try JSONDecoder.tmdb.decode(Credits.self, from: Fixture.data("movie_credits_27205"))
+        #expect(c.id == 27205)
+        #expect(c.cast.count == 4)
+        #expect(c.cast[0].character == "Cobb")
+        #expect(c.cast[2].profilePath == nil)
+        #expect(c.cast.map(\.order) == [0, 1, 2, 3])
+        #expect(c.crew.first?.job == "Director")
+        #expect(c.crew.first?.department == "Directing")
+    }
+
+    @Test func ratingTextOneDecimal() {
+        #expect(Movie(id: 1, title: "x", voteAverage: 7).ratingText == "7.0")
+    }
+}
