diff --git a/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift b/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift
new file mode 100644
index 0000000..5420895
--- /dev/null
+++ b/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift
@@ -0,0 +1,37 @@
+import Foundation
+
+extension JSONDecoder {
+    /// Decoder for every TMDB response (snake_case keys).
+    /// Dates are decoded by the models themselves via `TMDBDate`, because TMDB
+    /// sends `""` for unknown dates.
+    static var tmdb: JSONDecoder {
+        let decoder = JSONDecoder()
+        decoder.keyDecodingStrategy = .convertFromSnakeCase
+        return decoder
+    }
+}
+
+enum TMDBDate {
+    private static func makeFormatter() -> DateFormatter {
+        let f = DateFormatter()
+        f.calendar = Calendar(identifier: .gregorian)
+        f.locale = Locale(identifier: "en_US_POSIX")
+        f.timeZone = TimeZone(identifier: "UTC")
+        f.dateFormat = "yyyy-MM-dd"
+        return f
+    }
+
+    /// Parses `"yyyy-MM-dd"`; empty or malformed strings yield `nil`.
+    static func parse(_ string: String?) -> Date? {
+        guard let string, !string.isEmpty else { return nil }
+        return makeFormatter().date(from: string)
+    }
+
+    /// Four-digit year (UTC) of the date.
+    static func year(_ date: Date?) -> String? {
+        guard let date else { return nil }
+        var cal = Calendar(identifier: .gregorian)
+        cal.timeZone = TimeZone(identifier: "UTC")!
+        return String(cal.component(.year, from: date))
+    }
+}
diff --git a/Sources/TMDBApp/Models/Movie.swift b/Sources/TMDBApp/Models/Movie.swift
new file mode 100644
index 0000000..6e3c23f
--- /dev/null
+++ b/Sources/TMDBApp/Models/Movie.swift
@@ -0,0 +1,48 @@
+import Foundation
+
+struct Movie: Identifiable, Hashable, Sendable, Decodable {
+    let id: Int
+    let title: String
+    let overview: String
+    let posterPath: String?
+    let backdropPath: String?
+    let releaseDate: Date?
+    let voteAverage: Double
+    let voteCount: Int
+    let genreIDs: [Int]
+
+    init(id: Int, title: String, overview: String = "", posterPath: String? = nil,
+         backdropPath: String? = nil, releaseDate: Date? = nil, voteAverage: Double = 0,
+         voteCount: Int = 0, genreIDs: [Int] = []) {
+        self.id = id
+        self.title = title
+        self.overview = overview
+        self.posterPath = posterPath
+        self.backdropPath = backdropPath
+        self.releaseDate = releaseDate
+        self.voteAverage = voteAverage
+        self.voteCount = voteCount
+        self.genreIDs = genreIDs
+    }
+
+    private enum CodingKeys: String, CodingKey {
+        case id, title, overview, posterPath, backdropPath, releaseDate, voteAverage, voteCount
+        case genreIDs = "genreIds"
+    }
+
+    init(from decoder: Decoder) throws {
+        let c = try decoder.container(keyedBy: CodingKeys.self)
+        id = try c.decode(Int.self, forKey: .id)
+        title = try c.decode(String.self, forKey: .title)
+        overview = try c.decodeIfPresent(String.self, forKey: .overview) ?? ""
+        posterPath = try c.decodeIfPresent(String.self, forKey: .posterPath)
+        backdropPath = try c.decodeIfPresent(String.self, forKey: .backdropPath)
+        releaseDate = TMDBDate.parse(try c.decodeIfPresent(String.self, forKey: .releaseDate))
+        voteAverage = try c.decodeIfPresent(Double.self, forKey: .voteAverage) ?? 0
+        voteCount = try c.decodeIfPresent(Int.self, forKey: .voteCount) ?? 0
+        genreIDs = try c.decodeIfPresent([Int].self, forKey: .genreIDs) ?? []
+    }
+
+    var year: String? { TMDBDate.year(releaseDate) }
+    var ratingText: String { String(format: "%.1f", voteAverage) }
+}
