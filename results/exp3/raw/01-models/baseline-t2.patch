+++ b/Sources/TMDBApp/Models/PagedResponse.swift
@@ -0,0 +1,17 @@
+public struct PagedResponse<T: Decodable>: Decodable {
+    public let page: Int
+    public let results: [T]
+    public let totalPages: Int
+    public let totalResults: Int
+
+    public init(page: Int, results: [T], totalPages: Int, totalResults: Int) {
+        self.page = page
+        self.results = results
+        self.totalPages = totalPages
+        self.totalResults = totalResults
+    }
+}
+
+extension PagedResponse: Sendable where T: Sendable {}
+extension PagedResponse: Equatable where T: Equatable {}
+extension PagedResponse: Hashable where T: Hashable {}
diff --git a/Tests/TMDBAppTests/ModelDecodingTests.swift b/Tests/TMDBAppTests/ModelDecodingTests.swift
new file mode 100644
index 0000000..29c53e9
--- /dev/null
+++ b/Tests/TMDBAppTests/ModelDecodingTests.swift
@@ -0,0 +1,66 @@
+import Testing
+import Foundation
+@testable import TMDBApp
+
+struct ModelDecodingTests {
+    @Test func popularPage1() throws {
+        let page = try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page1"))
+        #expect(page.page == 1)
+        #expect(page.totalPages == 2)
+        #expect(page.totalResults == 7)
+        #expect(page.results.count == 5)
+        let inception = try #require(page.results.first)
+        #expect(inception.id == 27205)
+        #expect(inception.genreIDs == [28, 878, 12])
+        #expect(inception.year == "2010")
+        #expect(inception.ratingText == "8.4")
+        #expect(inception.voteCount == 37000)
+    }
+
+    @Test func nullImagePaths() throws {
+        let page = try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page1"))
+        let shawshank = try #require(page.results.first(where: { $0.id == 278 }))
+        #expect(shawshank.backdropPath == nil)
+        #expect(shawshank.posterPath != nil)
+        let fight = try #require(page.results.first(where: { $0.id == 550 }))
+        #expect(fight.posterPath == nil)
+        #expect(fight.backdropPath != nil)
+    }
+
+    @Test func emptyReleaseDateIsNil() throws {
+        let page = try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page2"))
+        #expect(page.page == 2)
+        #expect(page.results.count == 2)
+        let parasite = try #require(page.results.first(where: { $0.id == 496243 }))
+        #expect(parasite.releaseDate == nil)
+        #expect(parasite.year == nil)
+    }
+
+    @Test func movieDetail() throws {
+        let d = try JSONDecoder.tmdb.decode(MovieDetail.self, from: Fixture.data("movie_detail_27205"))
+        #expect(d.id == 27205)
+        #expect(d.runtime == 148)
+        #expect(d.tagline == "Your mind is the scene of the crime.")
+        #expect(d.status == "Released")
+        #expect(d.genres.map(\.name) == ["Action", "Science Fiction", "Adventure"])
+        #expect(d.year == "2010")
+    }
+
+    @Test func credits() throws {
+        let c = try JSONDecoder.tmdb.decode(Credits.self, from: Fixture.data("movie_credits_27205"))
+        #expect(c.id == 27205)
+        let lead = try #require(c.cast.first)
+        #expect(lead.name == "Leonardo DiCaprio")
+        #expect(lead.character == "Cobb")
+        #expect(lead.order == 0)
+        #expect(c.cast.first(where: { $0.id == 27578 })?.profilePath == nil)
+        let director = try #require(c.crew.first)
+        #expect(director.job == "Director")
+        #expect(director.department == "Directing")
+    }
+
+    @Test func ratingTextRounds() {
+        #expect(Movie(id: 1, title: "x", voteAverage: 7).ratingText == "7.0")
+        #expect(Movie(id: 1, title: "x", voteAverage: 8.46).ratingText == "8.5")
+    }
+}
