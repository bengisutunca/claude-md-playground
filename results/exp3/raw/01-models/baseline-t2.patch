diff --git a/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift b/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift
new file mode 100644
index 0000000..4675528
--- /dev/null
+++ b/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift
@@ -0,0 +1,36 @@
+import Foundation
+
+extension JSONDecoder {
+    /// Decoder for all TMDB responses (snake_case keys).
+    /// Dates are decoded by the models themselves via `TMDBDate`, since TMDB sends `""` for unknown dates.
+    public static var tmdb: JSONDecoder {
+        let decoder = JSONDecoder()
+        decoder.keyDecodingStrategy = .convertFromSnakeCase
+        return decoder
+    }
+}
+
+enum TMDBDate {
+    private static func calendar() -> Calendar {
+        var cal = Calendar(identifier: .gregorian)
+        cal.timeZone = TimeZone(identifier: "UTC")!
+        return cal
+    }
+
+    /// Parses `"yyyy-MM-dd"` (UTC). Returns nil for nil, empty or malformed strings.
+    static func parse(_ string: String?) -> Date? {
+        guard let string, !string.isEmpty else { return nil }
+        let parts = string.split(separator: "-", omittingEmptySubsequences: false)
+        guard parts.count == 3, let y = Int(parts[0]), let m = Int(parts[1]), let d = Int(parts[2]) else { return nil }
+        return calendar().date(from: DateComponents(year: y, month: m, day: d))
+    }
+
+    static func year(_ date: Date?) -> String? {
+        guard let date else { return nil }
+        return String(calendar().component(.year, from: date))
+    }
+
+    static func decode<K: CodingKey>(_ c: KeyedDecodingContainer<K>, forKey key: K) throws -> Date? {
+        parse(try c.decodeIfPresent(String.self, forKey: key))
+    }
+}
diff --git a/Sources/TMDBApp/Models/Movie.swift b/Sources/TMDBApp/Models/Movie.swift
new file mode 100644
index 0000000..cc854cb
--- /dev/null
+++ b/Sources/TMDBApp/Models/Movie.swift
@@ -0,0 +1,49 @@
+import Foundation
+
+public struct Movie: Identifiable, Hashable, Sendable, Decodable {
+    public let id: Int
+    public let title: String
+    public let overview: String
+    public let posterPath: String?
+    public let backdropPath: String?
+    public let releaseDate: Date?
+    public let voteAverage: Double
+    public let voteCount: Int
+    public let genreIDs: [Int]
+
+    public init(id: Int, title: String, overview: String = "", posterPath: String? = nil,
+                backdropPath: String? = nil, releaseDate: Date? = nil,
+                voteAverage: Double = 0, voteCount: Int = 0, genreIDs: [Int] = []) {
+        self.id = id
+        self.title = title
+        self.overview = overview
+        self.posterPath = posterPath
+        self.backdropPath = backdropPath
+        self.releaseDate = releaseDate
+        self.voteAverage = voteAverage
+        self.voteCount = voteCount
+        self.genreIDs = genreIDs
+    }
+
+    private enum CodingKeys: String, CodingKey {
+        case id, title, overview, posterPath, backdropPath, releaseDate, voteAverage, voteCount
+        case genreIDs = "genreIds"
+    }
+
+    public init(from decoder: Decoder) throws {
+        let c = try decoder.container(keyedBy: CodingKeys.self)
+        id = try c.decode(Int.self, forKey: .id)
+        title = try c.decode(String.self, forKey: .title)
+        overview = try c.decodeIfPresent(String.self, forKey: .overview) ?? ""
+        posterPath = try c.decodeIfPresent(String.self, forKey: .posterPath)
+        backdropPath = try c.decodeIfPresent(String.self, forKey: .backdropPath)
+        releaseDate = try TMDBDate.decode(c, forKey: .releaseDate)
+        voteAverage = try c.decodeIfPresent(Double.self, forKey: .voteAverage) ?? 0
+        voteCount = try c.decodeIfPresent(Int.self, forKey: .voteCount) ?? 0
+        genreIDs = try c.decodeIfPresent([Int].self, forKey: .genreIDs) ?? []
+    }
+
+    public var year: String? { TMDBDate.year(releaseDate) }
+
+    public var ratingText: String { String(format: "%.1f", voteAverage) }
+}
