diff --git a/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift b/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift
new file mode 100644
index 0000000..0775b80
--- /dev/null
+++ b/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift
@@ -0,0 +1,39 @@
+import Foundation
+
+private let utcCalendar: Calendar = {
+    var calendar = Calendar(identifier: .gregorian)
+    calendar.timeZone = TimeZone(identifier: "UTC")!
+    return calendar
+}()
+
+extension JSONDecoder {
+    /// Decoder for every TMDB response: snake_case keys, `yyyy-MM-dd` dates (UTC).
+    static var tmdb: JSONDecoder {
+        let decoder = JSONDecoder()
+        decoder.keyDecodingStrategy = .convertFromSnakeCase
+        decoder.dateDecodingStrategy = .custom { decoder in
+            let string = try decoder.singleValueContainer().decode(String.self)
+            let parts = string.split(separator: "-").compactMap { Int($0) }
+            guard parts.count == 3,
+                  let date = utcCalendar.date(from: DateComponents(year: parts[0], month: parts[1], day: parts[2]))
+            else {
+                throw DecodingError.dataCorrupted(.init(codingPath: decoder.codingPath,
+                                                        debugDescription: "Invalid TMDB date: \(string)"))
+            }
+            return date
+        }
+        return decoder
+    }
+}
+
+extension KeyedDecodingContainer {
+    /// TMDB sends `null`, a missing key, or `""` for unknown release dates; all become `nil`.
+    func decodeTMDBDate(forKey key: Key) throws -> Date? {
+        guard let raw = try decodeIfPresent(String.self, forKey: key), !raw.isEmpty else { return nil }
+        return try decode(Date.self, forKey: key)
+    }
+}
+
+extension Date {
+    var tmdbYear: String { String(utcCalendar.component(.year, from: self)) }
+}
diff --git a/Sources/TMDBApp/Models/Movie.swift b/Sources/TMDBApp/Models/Movie.swift
