diff --git a/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift b/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift
new file mode 100644
index 0000000..60282c9
--- /dev/null
+++ b/Sources/TMDBApp/Models/JSONDecoder+TMDB.swift
@@ -0,0 +1,43 @@
+import Foundation
+
+extension JSONDecoder {
+    /// Decoder for every TMDB response: snake_case keys and `"yyyy-MM-dd"` dates.
+    ///
+    /// TMDB sends an empty string for unknown release dates; models decode those
+    /// fields with `KeyedDecodingContainer.decodeTMDBDate(forKey:)`, which maps `""` to `nil`.
+    public static var tmdb: JSONDecoder {
+        let decoder = JSONDecoder()
+        decoder.keyDecodingStrategy = .convertFromSnakeCase
+        decoder.dateDecodingStrategy = .custom { decoder in
+            let container = try decoder.singleValueContainer()
+            let string = try container.decode(String.self)
+            guard let date = try? Date(string, strategy: TMDBDate.parseStrategy) else {
+                throw DecodingError.dataCorruptedError(
+                    in: container, debugDescription: "Expected yyyy-MM-dd date, got \"\(string)\"")
+            }
+            return date
+        }
+        return decoder
+    }
+}
+
+/// TMDB calendar dates (`yyyy-MM-dd`), interpreted in UTC.
+enum TMDBDate {
+    static let parseStrategy = Date.ISO8601FormatStyle().year().month().day()
+
+    static func year(of date: Date) -> String {
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = TimeZone(identifier: "UTC")!
+        return String(calendar.component(.year, from: date))
+    }
+}
+
+extension KeyedDecodingContainer {
+    /// Decodes an optional TMDB date, treating a missing key, `null` or `""` as `nil`.
+    func decodeTMDBDate(forKey key: Key) throws -> Date? {
+        guard let string = try decodeIfPresent(String.self, forKey: key), !string.isEmpty else {
+            return nil
+        }
+        return try decode(Date.self, forKey: key)
+    }
+}
