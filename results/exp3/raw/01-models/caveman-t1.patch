diff --git a/Sources/TMDBApp/Models/TMDBDecoding.swift b/Sources/TMDBApp/Models/TMDBDecoding.swift
new file mode 100644
index 0000000..f30bf2f
--- /dev/null
+++ b/Sources/TMDBApp/Models/TMDBDecoding.swift
@@ -0,0 +1,38 @@
+import Foundation
+
+extension JSONDecoder {
+    /// Decoder for every TMDB response. Dates are decoded per-model via `decodeTMDBDate`
+    /// because TMDB sends `""` for unknown release dates.
+    static var tmdb: JSONDecoder {
+        let decoder = JSONDecoder()
+        decoder.keyDecodingStrategy = .convertFromSnakeCase
+        return decoder
+    }
+}
+
+/// `"yyyy-MM-dd"` parsing and year extraction, always in UTC so results don't depend on the device time zone.
+enum TMDBDate {
+    private static let utc = TimeZone(identifier: "UTC")!
+
+    static func parse(_ string: String) -> Date? {
+        let style = Date.ISO8601FormatStyle(timeZone: utc).year().month().day()
+        return try? style.parse(string)
+    }
+
+    static func year(of date: Date) -> String {
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = utc
+        return String(calendar.component(.year, from: date))
+    }
+}
+
+extension KeyedDecodingContainer {
+    /// Decodes an optional `yyyy-MM-dd` date; missing, null and `""` all yield `nil`.
+    func decodeTMDBDate(forKey key: Key) throws -> Date? {
+        guard let string = try decodeIfPresent(String.self, forKey: key), !string.isEmpty else { return nil }
+        guard let date = TMDBDate.parse(string) else {
+            throw DecodingError.dataCorruptedError(forKey: key, in: self, debugDescription: "Expected yyyy-MM-dd, got \(string)")
+        }
+        return date
+    }
+}
