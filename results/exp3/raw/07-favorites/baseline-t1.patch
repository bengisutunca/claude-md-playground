+extension Movie {
+    /// Encodes using the same keys `init(from:)` reads (camelCase, dates as "yyyy-MM-dd"),
+    /// so values round-trip through a plain `JSONEncoder`/`JSONDecoder`.
+    func encode(to encoder: Encoder) throws {
+        var c = encoder.container(keyedBy: CodingKeys.self)
+        try c.encode(id, forKey: .id)
+        try c.encode(title, forKey: .title)
+        try c.encode(overview, forKey: .overview)
+        try c.encodeIfPresent(posterPath, forKey: .posterPath)
+        try c.encodeIfPresent(backdropPath, forKey: .backdropPath)
+        if let releaseDate {
+            let d = TMDBDate.calendar.dateComponents([.year, .month, .day], from: releaseDate)
+            let text = String(format: "%04d-%02d-%02d", d.year ?? 0, d.month ?? 0, d.day ?? 0)
+            try c.encode(text, forKey: .releaseDate)
+        }
+        try c.encode(voteAverage, forKey: .voteAverage)
+        try c.encode(voteCount, forKey: .voteCount)
+        try c.encode(genreIDs, forKey: .genreIDs)
+    }
+}
+
 extension Movie {
     var year: String? { releaseDate.map(TMDBDate.year(of:)) }
 
