@@ -0,0 +1,34 @@
+import Foundation
+import Observation
+
+@MainActor
+@Observable
+final class FavoritesViewModel {
+    private(set) var favorites: [Movie]
+    @ObservationIgnored private let store: any FavoritesStore
+
+    init(store: any FavoritesStore) {
+        self.store = store
+        var seen = Set<Int>()
+        self.favorites = store.load().filter { seen.insert($0.id).inserted }
+    }
+
+    func isFavorite(_ movie: Movie) -> Bool {
+        favorites.contains { $0.id == movie.id }
+    }
+
+    /// Adds the movie at the end, or removes it if already a favorite.
+    func toggle(_ movie: Movie) {
+        if let index = favorites.firstIndex(where: { $0.id == movie.id }) {
+            favorites.remove(at: index)
+        } else {
+            favorites.append(movie)
+        }
+        store.save(favorites)
+    }
+
+    func remove(at offsets: IndexSet) {
+        favorites.remove(atOffsets: offsets)
+        store.save(favorites)
+    }
+}
