+import Foundation
+
+/// Persistence for the user's favorite movies. Order is insertion order.
+protocol FavoritesStore {
+    func load() -> [Movie]
+    func save(_ movies: [Movie])
+}
+
+/// Stores full `Movie` values as JSON in `UserDefaults`.
+struct UserDefaultsFavoritesStore: FavoritesStore {
+    nonisolated(unsafe) private let defaults: UserDefaults
+    private let key: String
+
+    init(defaults: UserDefaults = .standard, key: String = "favorites.movies") {
+        self.defaults = defaults
+        self.key = key
+    }
+
+    func load() -> [Movie] {
+        guard let data = defaults.data(forKey: key),
+              let records = try? JSONDecoder().decode([Record].self, from: data) else { return [] }
+        return records.map(\.movie)
+    }
+
+    func save(_ movies: [Movie]) {
+        guard let data = try? JSONEncoder().encode(movies.map(Record.init)) else { return }
+        defaults.set(data, forKey: key)
+    }
+
+    /// Own storage format, independent of the TMDB wire format `Movie` decodes.
+    private struct Record: Codable {
+        var id: Int
+        var title: String
+        var overview: String
+        var posterPath: String?
+        var backdropPath: String?
+        var releaseDate: Date?
+        var voteAverage: Double
+        var voteCount: Int
+        var genreIDs: [Int]
+
+        init(_ m: Movie) {
+            id = m.id; title = m.title; overview = m.overview
+            posterPath = m.posterPath; backdropPath = m.backdropPath
+            releaseDate = m.releaseDate; voteAverage = m.voteAverage
+            voteCount = m.voteCount; genreIDs = m.genreIDs
+        }
+
+        var movie: Movie {
+            Movie(id: id, title: title, overview: overview, posterPath: posterPath,
+                  backdropPath: backdropPath, releaseDate: releaseDate,
+                  voteAverage: voteAverage, voteCount: voteCount, genreIDs: genreIDs)
+        }
+    }
+}
