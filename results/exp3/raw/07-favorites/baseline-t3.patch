diff --git a/Tests/TMDBAppTests/FavoritesTests.swift b/Tests/TMDBAppTests/FavoritesTests.swift
new file mode 100644
index 0000000..02a11e9
--- /dev/null
+++ b/Tests/TMDBAppTests/FavoritesTests.swift
@@ -0,0 +1,84 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("Favorites")
+struct FavoritesTests {
+    /// Runs `body` with a unique UserDefaults suite, removed afterwards.
+    private func withSuite(_ body: (UserDefaults) throws -> Void) rethrows {
+        let name = "FavoritesTests.\(UUID().uuidString)"
+        let defaults = UserDefaults(suiteName: name)!
+        defer { defaults.removePersistentDomain(forName: name) }
+        try body(defaults)
+    }
+
+    private func movies() throws -> [Movie] {
+        try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page1")).results
+    }
+
+    private func makeVM(_ defaults: UserDefaults) -> FavoritesViewModel {
+        FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+    }
+
+    @Test func toggleOnAndOff() throws {
+        let all = try movies()
+        withSuite { defaults in
+            let vm = makeVM(defaults)
+            #expect(!vm.isFavorite(all[0]))
+            vm.toggle(all[0])
+            #expect(vm.isFavorite(all[0]))
+            vm.toggle(all[0])
+            #expect(!vm.isFavorite(all[0]))
+            #expect(vm.favorites.isEmpty)
+        }
+    }
+
+    @Test func persistsFullValuesAcrossStoreInstances() throws {
+        let all = try movies()
+        withSuite { defaults in
+            let vm = makeVM(defaults)
+            vm.toggle(all[0])
+            vm.toggle(all[1])
+            #expect(makeVM(defaults).favorites == [all[0], all[1]])
+        }
+    }
+
+    @Test func keepsInsertionOrder() throws {
+        let all = try movies()
+        withSuite { defaults in
+            let vm = makeVM(defaults)
+            let order = [all[3], all[0], all[2]]
+            for m in order { vm.toggle(m) }
+            #expect(vm.favorites.map(\.id) == order.map(\.id))
+            #expect(makeVM(defaults).favorites.map(\.id) == order.map(\.id))
+        }
+    }
+
+    @Test func removeAtOffsetsPersists() throws {
+        let all = try movies()
+        withSuite { defaults in
+            let vm = makeVM(defaults)
+            for m in all.prefix(3) { vm.toggle(m) }
+            vm.remove(at: IndexSet(integer: 1))
+            let expected = [all[0].id, all[2].id]
+            #expect(vm.favorites.map(\.id) == expected)
+            #expect(makeVM(defaults).favorites.map(\.id) == expected)
+        }
+    }
+
+    @Test func noDuplicates() throws {
+        let all = try movies()
+        withSuite { defaults in
+            let store = UserDefaultsFavoritesStore(defaults: defaults)
+            let vm = FavoritesViewModel(store: store)
+            vm.toggle(all[0])
+            vm.toggle(all[0])
+            vm.toggle(all[0])
+            #expect(vm.favorites.count == 1)
+            // Duplicates already in storage are collapsed on load.
+            store.save([all[1], all[1], all[2]])
+            #expect(FavoritesViewModel(store: store).favorites.map(\.id) == [all[1].id, all[2].id])
+        }
+    }
+}
