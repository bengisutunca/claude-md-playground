diff --git a/Tests/TMDBAppTests/FavoritesTests.swift b/Tests/TMDBAppTests/FavoritesTests.swift
new file mode 100644
index 0000000..8502473
--- /dev/null
+++ b/Tests/TMDBAppTests/FavoritesTests.swift
@@ -0,0 +1,98 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("Favorites")
+struct FavoritesTests {
+    /// Runs `body` against a fresh, uniquely named `UserDefaults` suite and removes it afterwards.
+    private func withDefaults(_ body: (UserDefaults) throws -> Void) throws {
+        let name = "FavoritesTests.\(UUID().uuidString)"
+        let defaults = try #require(UserDefaults(suiteName: name))
+        defer { defaults.removePersistentDomain(forName: name) }
+        try body(defaults)
+    }
+
+    private func movies() throws -> [Movie] {
+        let page = try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page1"))
+        try #require(page.results.count >= 3)
+        return page.results
+    }
+
+    @Test func toggleOnAndOff() throws {
+        try withDefaults { defaults in
+            let movie = try movies()[0]
+            let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            #expect(vm.favorites.isEmpty)
+            #expect(!vm.isFavorite(movie))
+
+            vm.toggle(movie)
+            #expect(vm.isFavorite(movie))
+            #expect(vm.favorites == [movie])
+
+            vm.toggle(movie)
+            #expect(!vm.isFavorite(movie))
+            #expect(vm.favorites.isEmpty)
+            #expect(UserDefaultsFavoritesStore(defaults: defaults).load().isEmpty)
+        }
+    }
+
+    @Test func persistsFullMoviesAcrossStoreInstances() throws {
+        try withDefaults { defaults in
+            let all = try movies()
+            #expect(all[0].releaseDate != nil)
+            let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            vm.toggle(all[0])
+            vm.toggle(all[1])
+
+            let reloaded = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            #expect(reloaded.favorites == [all[0], all[1]])
+        }
+    }
+
+    @Test func keepsInsertionOrder() throws {
+        try withDefaults { defaults in
+            let all = try movies()
+            let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            vm.toggle(all[2])
+            vm.toggle(all[0])
+            vm.toggle(all[1])
+            #expect(vm.favorites.map(\.id) == [all[2].id, all[0].id, all[1].id])
+            #expect(UserDefaultsFavoritesStore(defaults: defaults).load().map(\.id) == [all[2].id, all[0].id, all[1].id])
+        }
+    }
+
+    @Test func removeAtOffsets() throws {
+        try withDefaults { defaults in
+            let all = try movies()
+            let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            all.prefix(3).forEach(vm.toggle)
+
+            vm.remove(at: IndexSet([0, 2]))
+            #expect(vm.favorites == [all[1]])
+            #expect(UserDefaultsFavoritesStore(defaults: defaults).load() == [all[1]])
+        }
+    }
+
+    @Test func noDuplicates() throws {
+        try withDefaults { defaults in
+            let all = try movies()
+            let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            vm.toggle(all[0])
+            vm.toggle(all[1])
+            vm.toggle(all[0])  // removes, does not duplicate
+            vm.toggle(all[0])  // re-adds at the end
+            #expect(vm.favorites.map(\.id) == [all[1].id, all[0].id])
+            #expect(Set(vm.favorites.map(\.id)).count == vm.favorites.count)
+        }
+    }
+
+    @Test func separateKeysAreIndependent() throws {
+        try withDefaults { defaults in
+            let movie = try movies()[0]
+            UserDefaultsFavoritesStore(defaults: defaults, key: "a").save([movie])
+            #expect(UserDefaultsFavoritesStore(defaults: defaults, key: "b").load().isEmpty)
+            #expect(UserDefaultsFavoritesStore(defaults: defaults, key: "a").load() == [movie])
+        }
+    }
+}
