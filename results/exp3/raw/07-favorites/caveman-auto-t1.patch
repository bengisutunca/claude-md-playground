+import SwiftUI
+
+/// Lists favorites from the environment's shared `FavoritesViewModel`.
+struct FavoritesView: View {
+    @Environment(FavoritesViewModel.self) private var favorites
+    private let service: any MovieService
+
+    init(service: any MovieService) {
+        self.service = service
+    }
+
+    var body: some View {
+        NavigationStack {
+            content
+                .navigationTitle("Favorites")
+                .navigationDestination(for: Movie.self) { movie in
+                    MovieDetailView(movie: movie, viewModel: MovieDetailViewModel(movieID: movie.id, service: service))
+                }
+        }
+    }
+
+    @ViewBuilder
+    private var content: some View {
+        if favorites.favorites.isEmpty {
+            ContentUnavailableView(
+                "No Favorites",
+                systemImage: "heart",
+                description: Text("Tap the heart on a movie to save it here.")
+            )
+        } else {
+            List {
+                ForEach(favorites.favorites) { movie in
+                    NavigationLink(value: movie) { MovieRowView(movie: movie) }
+                }
+                .onDelete { favorites.remove(at: $0) }
+            }
+        }
+    }
+}
