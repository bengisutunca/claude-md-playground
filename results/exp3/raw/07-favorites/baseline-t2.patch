diff --git a/Tests/TMDBAppTests/FavoritesTests.swift b/Tests/TMDBAppTests/FavoritesTests.swift
new file mode 100644
index 0000000..550e7bc
--- /dev/null
+++ b/Tests/TMDBAppTests/FavoritesTests.swift
@@ -0,0 +1,94 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("Favorites")
+struct FavoritesTests {
+    private func movies() throws -> [Movie] {
+        try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page1")).results
+    }
+
+    /// Runs `body` with a fresh, uniquely named suite that is removed afterwards.
+    private func withSuite(_ body: (UserDefaults) throws -> Void) throws {
+        let name = "favorites.tests." + UUID().uuidString
+        let defaults = try #require(UserDefaults(suiteName: name))
+        defer { defaults.removePersistentDomain(forName: name) }
+        try body(defaults)
+    }
+
+    @Test func toggleOnAndOff() throws {
+        try withSuite { defaults in
+            let movie = try movies()[0]
+            let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            #expect(!vm.isFavorite(movie))
+            vm.toggle(movie)
+            #expect(vm.isFavorite(movie))
+            #expect(vm.favorites == [movie])
+            vm.toggle(movie)
+            #expect(!vm.isFavorite(movie))
+            #expect(vm.favorites.isEmpty)
+        }
+    }
+
+    @Test func persistsAcrossStoreInstances() throws {
+        try withSuite { defaults in
+            let all = try movies()
+            let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            vm.toggle(all[0])
+            vm.toggle(all[1])
+            let reloaded = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            #expect(reloaded.favorites == [all[0], all[1]])
+            #expect(UserDefaultsFavoritesStore(defaults: defaults).load() == [all[0], all[1]])
+        }
+    }
+
+    @Test func keepsInsertionOrder() throws {
+        try withSuite { defaults in
+            let all = try movies()
+            let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            let order = [all[3], all[0], all[2]]
+            for movie in order { vm.toggle(movie) }
+            #expect(vm.favorites.map(\.id) == order.map(\.id))
+            let reloaded = UserDefaultsFavoritesStore(defaults: defaults).load()
+            #expect(reloaded.map(\.id) == order.map(\.id))
+        }
+    }
+
+    @Test func removeAtOffsetsPersists() throws {
+        try withSuite { defaults in
+            let all = try movies()
+            let store = UserDefaultsFavoritesStore(defaults: defaults)
+            let vm = FavoritesViewModel(store: store)
+            for movie in all.prefix(3) { vm.toggle(movie) }
+            vm.remove(at: IndexSet(integer: 1))
+            #expect(vm.favorites.map(\.id) == [all[0].id, all[2].id])
+            #expect(store.load().map(\.id) == [all[0].id, all[2].id])
+        }
+    }
+
+    @Test func noDuplicates() throws {
+        try withSuite { defaults in
+            let movie = try movies()[0]
+            let store = UserDefaultsFavoritesStore(defaults: defaults)
+            // Duplicates already in storage are dropped on load.
+            store.save([movie, movie])
+            let vm = FavoritesViewModel(store: store)
+            #expect(vm.favorites.count == 1)
+            // Toggling the same movie twice never leaves two copies.
+            vm.toggle(movie)
+            vm.toggle(movie)
+            #expect(vm.favorites.count == 1)
+            #expect(store.load().count == 1)
+        }
+    }
+
+    @Test func movieRoundTripKeepsAllFields() throws {
+        try withSuite { defaults in
+            let store = UserDefaultsFavoritesStore(defaults: defaults)
+            let all = try movies()
+            store.save(all)
+            #expect(store.load() == all)
+        }
+    }
+}
