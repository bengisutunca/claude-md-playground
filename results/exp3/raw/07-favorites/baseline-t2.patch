@@ -0,0 +1,38 @@
+import SwiftUI
+
+struct FavoritesView: View {
+    @Environment(FavoritesViewModel.self) private var viewModel
+    private let service: any MovieService
+
+    init(service: any MovieService) {
+        self.service = service
+    }
+
+    var body: some View {
+        NavigationStack {
+            Group {
+                if viewModel.favorites.isEmpty {
+                    VStack(spacing: 8) {
+                        Image(systemName: "heart").font(.largeTitle).foregroundStyle(.secondary)
+                        Text("No favorites yet.").foregroundStyle(.secondary)
+                        Text("Tap the heart on a movie to save it here.")
+                            .font(.footnote).foregroundStyle(.secondary)
+                    }
+                    .padding()
+                    .frame(maxWidth: .infinity, maxHeight: .infinity)
+                } else {
+                    List {
+                        ForEach(viewModel.favorites) { movie in
+                            NavigationLink(value: movie) { MovieRowView(movie: movie) }
+                        }
+                        .onDelete { viewModel.remove(at: $0) }
+                    }
+                }
+            }
+            .navigationTitle("Favorites")
+            .navigationDestination(for: Movie.self) { movie in
+                MovieDetailView(viewModel: MovieDetailViewModel(movieID: movie.id, service: service), movie: movie)
+            }
+        }
+    }
+}
