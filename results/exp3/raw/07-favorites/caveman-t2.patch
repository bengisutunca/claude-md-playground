diff --git a/Tests/TMDBAppTests/FavoritesTests.swift b/Tests/TMDBAppTests/FavoritesTests.swift
new file mode 100644
index 0000000..1d8b953
--- /dev/null
+++ b/Tests/TMDBAppTests/FavoritesTests.swift
@@ -0,0 +1,71 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("Favorites")
+struct FavoritesTests {
+    /// Unique defaults suite per test; call `cleanup()` (via defer) to remove it.
+    struct Env {
+        let name = "FavoritesTests.\(UUID().uuidString)"
+        let defaults: UserDefaults
+        init() { defaults = UserDefaults(suiteName: name)! }
+        func store() -> UserDefaultsFavoritesStore { UserDefaultsFavoritesStore(defaults: defaults) }
+        func cleanup() { defaults.removePersistentDomain(forName: name) }
+    }
+
+    private func movies() throws -> [Movie] {
+        try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page1")).results
+    }
+
+    @Test func toggleOnAndOff() throws {
+        let env = Env(); defer { env.cleanup() }
+        let m = try movies()[0]
+        let vm = FavoritesViewModel(store: env.store())
+        #expect(!vm.isFavorite(m))
+        vm.toggle(m)
+        #expect(vm.isFavorite(m))
+        #expect(vm.favorites == [m])
+        vm.toggle(m)
+        #expect(!vm.isFavorite(m))
+        #expect(vm.favorites.isEmpty)
+    }
+
+    @Test func persistsAcrossStoreInstancesWithFullValues() throws {
+        let env = Env(); defer { env.cleanup() }
+        let all = try movies()
+        let vm = FavoritesViewModel(store: env.store())
+        vm.toggle(all[0]); vm.toggle(all[1])
+        #expect(FavoritesViewModel(store: env.store()).favorites == [all[0], all[1]])
+        #expect(env.store().load() == [all[0], all[1]])
+    }
+
+    @Test func keepsInsertionOrder() throws {
+        let env = Env(); defer { env.cleanup() }
+        let all = try movies()
+        let vm = FavoritesViewModel(store: env.store())
+        let picks = [all[2], all[0], all[1]]
+        for m in picks { vm.toggle(m) }
+        #expect(vm.favorites == picks)
+        #expect(FavoritesViewModel(store: env.store()).favorites == picks)
+    }
+
+    @Test func removeAtOffsetsPersists() throws {
+        let env = Env(); defer { env.cleanup() }
+        let all = try movies()
+        let vm = FavoritesViewModel(store: env.store())
+        for m in all.prefix(3) { vm.toggle(m) }
+        vm.remove(at: IndexSet(integer: 1))
+        #expect(vm.favorites == [all[0], all[2]])
+        #expect(FavoritesViewModel(store: env.store()).favorites == [all[0], all[2]])
+    }
+
+    @Test func noDuplicates() throws {
+        let env = Env(); defer { env.cleanup() }
+        let m = try movies()[0]
+        let vm = FavoritesViewModel(store: env.store())
+        vm.toggle(m); vm.toggle(m); vm.toggle(m)
+        #expect(vm.favorites.count == 1)
+        #expect(env.store().load().count == 1)
+    }
+}
