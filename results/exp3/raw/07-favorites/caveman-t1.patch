diff --git a/Tests/TMDBAppTests/FavoritesTests.swift b/Tests/TMDBAppTests/FavoritesTests.swift
new file mode 100644
index 0000000..f8ad15a
--- /dev/null
+++ b/Tests/TMDBAppTests/FavoritesTests.swift
@@ -0,0 +1,65 @@
+import Testing
+import Foundation
+@testable import TMDBApp
+
+@MainActor
+@Suite("Favorites")
+struct FavoritesTests {
+    private func makeSuite() -> (UserDefaults, String) {
+        let name = "FavoritesTests.\(UUID().uuidString)"
+        return (UserDefaults(suiteName: name)!, name)
+    }
+
+    private func movies() throws -> [Movie] {
+        try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page1")).results
+    }
+
+    @Test func toggleOnOff() throws {
+        let (defaults, name) = makeSuite()
+        defer { defaults.removePersistentDomain(forName: name) }
+        let movie = try #require(movies().first)
+        let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+        #expect(!vm.isFavorite(movie))
+        vm.toggle(movie)
+        #expect(vm.isFavorite(movie))
+        vm.toggle(movie)
+        #expect(!vm.isFavorite(movie))
+        #expect(vm.favorites.isEmpty)
+    }
+
+    @Test func persistsAcrossInstancesKeepingOrderAndValues() throws {
+        let (defaults, name) = makeSuite()
+        defer { defaults.removePersistentDomain(forName: name) }
+        let list = Array(try movies().prefix(3))
+        let ordered = [list[2], list[0], list[1]]
+        let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+        ordered.forEach(vm.toggle)
+        #expect(vm.favorites == ordered)
+        let reloaded = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+        #expect(reloaded.favorites == ordered)
+    }
+
+    @Test func removalPersists() throws {
+        let (defaults, name) = makeSuite()
+        defer { defaults.removePersistentDomain(forName: name) }
+        let list = Array(try movies().prefix(3))
+        let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+        list.forEach(vm.toggle)
+        vm.remove(at: IndexSet(integer: 1))
+        #expect(vm.favorites == [list[0], list[2]])
+        let reloaded = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+        #expect(reloaded.favorites == [list[0], list[2]])
+    }
+
+    @Test func noDuplicates() throws {
+        let (defaults, name) = makeSuite()
+        defer { defaults.removePersistentDomain(forName: name) }
+        let movie = try #require(movies().first)
+        let store = UserDefaultsFavoritesStore(defaults: defaults)
+        store.save([movie])
+        let vm = FavoritesViewModel(store: store)
+        vm.toggle(movie)
+        vm.toggle(movie)
+        #expect(vm.favorites.filter { $0.id == movie.id }.count == 1)
+    }
+}
