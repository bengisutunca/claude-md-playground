index 0000000..cc59635
--- /dev/null
+++ b/Tests/TMDBAppTests/FavoritesTests.swift
@@ -0,0 +1,79 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("Favorites")
+struct FavoritesTests {
+    private func movies() throws -> [Movie] {
+        try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data("popular_page1")).results
+    }
+
+    /// Runs `body` with a unique, empty suite and removes it afterwards.
+    private func withSuite(_ body: (UserDefaults) throws -> Void) rethrows {
+        let name = "FavoritesTests.\(UUID().uuidString)"
+        let defaults = UserDefaults(suiteName: name)!
+        defer { defaults.removePersistentDomain(forName: name) }
+        try body(defaults)
+    }
+
+    @Test func toggleOnAndOff() throws {
+        let movie = try #require(movies().first)
+        try withSuite { defaults in
+            let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            #expect(!vm.isFavorite(movie))
+            vm.toggle(movie)
+            #expect(vm.isFavorite(movie))
+            vm.toggle(movie)
+            #expect(!vm.isFavorite(movie))
+            #expect(vm.favorites.isEmpty)
+        }
+    }
+
+    @Test func persistsFullMoviesAcrossStoreInstances() throws {
+        let movie = try #require(movies().first { $0.releaseDate != nil })
+        withSuite { defaults in
+            FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults)).toggle(movie)
+            let reloaded = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            #expect(reloaded.favorites == [movie])
+        }
+    }
+
+    @Test func keepsInsertionOrder() throws {
+        let three = Array(try movies().prefix(3))
+        let order = [three[2], three[0], three[1]].map(\.id)
+        withSuite { defaults in
+            let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            for id in order { vm.toggle(three.first { $0.id == id }!) }
+            #expect(vm.favorites.map(\.id) == order)
+            let reloaded = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            #expect(reloaded.favorites.map(\.id) == order)
+        }
+    }
+
+    @Test func removeAtOffsetsPersists() throws {
+        let three = Array(try movies().prefix(3))
+        let expected = [three[0].id, three[2].id]
+        withSuite { defaults in
+            let vm = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            three.forEach { vm.toggle($0) }
+            vm.remove(at: IndexSet(integer: 1))
+            #expect(vm.favorites.map(\.id) == expected)
+            let reloaded = FavoritesViewModel(store: UserDefaultsFavoritesStore(defaults: defaults))
+            #expect(reloaded.favorites.map(\.id) == expected)
+        }
+    }
+
+    @Test func noDuplicates() throws {
+        let movie = try #require(movies().first)
+        withSuite { defaults in
+            let store = UserDefaultsFavoritesStore(defaults: defaults)
+            let vm = FavoritesViewModel(store: store)
+            vm.toggle(movie)
+            vm.toggle(movie)
+            vm.toggle(movie)
+            #expect(vm.favorites.count == 1)
+            #expect(store.load().count == 1)
+        }
+    }
+}
