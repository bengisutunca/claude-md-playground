@@ -0,0 +1,94 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("MovieDetailViewModel")
+struct MovieDetailViewModelTests {
+    @Test func loadsDetailAndCredits() async throws {
+        let service = MockMovieService()
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        #expect(vm.state == .idle)
+        await vm.load()
+
+        guard case .loaded(let content) = vm.state else {
+            Issue.record("Expected loaded, got \(vm.state)")
+            return
+        }
+        #expect(content.detail.id == 27205)
+        #expect(content.detail.title == "Inception")
+        #expect(content.cast.count <= 10)
+        #expect(!content.cast.isEmpty)
+        let orders = content.cast.compactMap(\.order)
+        #expect(orders == orders.sorted())
+        #expect(!content.directors.isEmpty)
+        #expect(content.directors.allSatisfy { $0.job == "Director" })
+        let runtime = try #require(content.detail.runtime)
+        #expect(content.runtimeText == MovieDetailContent.formatRuntime(minutes: runtime))
+        #expect(content.genresText.contains(", "))
+        let calls = await service.calls
+        #expect(calls.contains(.detail(id: 27205)))
+        #expect(calls.contains(.credits(id: 27205)))
+    }
+
+    @Test func topTenCastKeepsLowestOrders() throws {
+        let credits = try JSONDecoder.tmdb.decode(Credits.self, from: Fixture.data("movie_credits_27205"))
+        let detail = try JSONDecoder.tmdb.decode(MovieDetail.self, from: Fixture.data("movie_detail_27205"))
+        let content = MovieDetailContent(detail: detail, credits: credits)
+        let expected = credits.cast.compactMap(\.order).sorted().prefix(10)
+        #expect(content.cast.compactMap(\.order) == Array(expected))
+    }
+
+    @Test func failureOfBothGivesFailed() async {
+        let vm = MovieDetailViewModel(movieID: 27205, service: MockMovieService(error: APIError.invalidResponse))
+        await vm.load()
+        guard case .failed = vm.state else {
+            Issue.record("Expected failed, got \(vm.state)")
+            return
+        }
+    }
+
+    @Test func failureOfDetailOnlyGivesFailed() async {
+        let vm = MovieDetailViewModel(movieID: 1, service: PartialService(failing: .detail))
+        await vm.load()
+        guard case .failed = vm.state else {
+            Issue.record("Expected failed, got \(vm.state)")
+            return
+        }
+    }
+
+    @Test func failureOfCreditsOnlyGivesFailed() async {
+        let vm = MovieDetailViewModel(movieID: 1, service: PartialService(failing: .credits))
+        await vm.load()
+        guard case .failed = vm.state else {
+            Issue.record("Expected failed, got \(vm.state)")
+            return
+        }
+    }
+
+    @Test(arguments: [(0, "0m"), (1, "1m"), (45, "45m"), (59, "59m"), (60, "1h"),
+                      (120, "2h"), (148, "2h 28m"), (61, "1h 1m")])
+    func runtimeFormatting(minutes: Int, expected: String) {
+        #expect(MovieDetailContent.formatRuntime(minutes: minutes) == expected)
+    }
+}
+
+/// Succeeds with fixtures for one request and fails the other.
+private struct PartialService: MovieService {
+    enum Target { case detail, credits }
+    let failing: Target
+    private let inner = MockMovieService()
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> { try await inner.popular(page: page) }
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        try await inner.search(query: query, page: page)
+    }
+    func detail(id: Int) async throws -> MovieDetail {
+        if failing == .detail { throw APIError.invalidResponse }
+        return try await inner.detail(id: id)
+    }
+    func credits(id: Int) async throws -> Credits {
+        if failing == .credits { throw APIError.invalidResponse }
+        return try await inner.credits(id: id)
+    }
+}
