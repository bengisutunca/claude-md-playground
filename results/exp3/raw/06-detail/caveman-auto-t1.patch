+import Foundation
+import Observation
+
+/// Everything the detail screen shows: the movie plus the relevant parts of its credits.
+struct MovieDetailContent: Hashable, Sendable {
+    static let castLimit = 10
+
+    let detail: MovieDetail
+    /// Top-billed cast (lowest `order` first), at most `castLimit` members.
+    let cast: [CastMember]
+    let directors: [CrewMember]
+
+    init(detail: MovieDetail, credits: Credits) {
+        self.detail = detail
+        cast = Array(credits.cast
+            .sorted { ($0.order ?? .max) < ($1.order ?? .max) }
+            .prefix(Self.castLimit))
+        directors = credits.crew.filter { $0.job == "Director" }
+    }
+
+    /// Nil when TMDB has no runtime for the movie (missing or 0).
+    var runtimeText: String? {
+        guard let runtime = detail.runtime, runtime > 0 else { return nil }
+        return Self.formatRuntime(minutes: runtime)
+    }
+
+    var genresText: String { detail.genres.map(\.name).joined(separator: ", ") }
+
+    var releaseYear: String? { detail.year }
+
+    /// 148 → "2h 28m", 120 → "2h", 45 → "45m", 0 → "0m".
+    static func formatRuntime(minutes: Int) -> String {
+        let total = max(minutes, 0)
+        let hours = total / 60
+        let mins = total % 60
+        switch (hours, mins) {
+        case (0, _): return "\(mins)m"
+        case (_, 0): return "\(hours)h"
+        default: return "\(hours)h \(mins)m"
+        }
+    }
+}
+
+@MainActor
+@Observable
+final class MovieDetailViewModel {
+    let movieID: Int
+    private(set) var state: ViewState<MovieDetailContent> = .idle
+
+    @ObservationIgnored private let service: any MovieService
+
+    init(movieID: Int, service: any MovieService) {
+        self.movieID = movieID
+        self.service = service
+    }
+
+    /// Loads detail and credits concurrently; either failing fails the screen.
+    /// No-op while a load is in flight or after content has loaded.
+    func load() async {
+        switch state {
+        case .loading, .loaded: return
+        case .idle, .empty, .failed: break
+        }
+        state = .loading
+        do {
+            async let detail = service.detail(id: movieID)
+            async let credits = service.credits(id: movieID)
+            state = .loaded(MovieDetailContent(detail: try await detail, credits: try await credits))
+        } catch is CancellationError {
+            state = .idle
+        } catch {
+            state = .failed(MovieListViewModel.message(for: error))
+        }
+    }
+}
