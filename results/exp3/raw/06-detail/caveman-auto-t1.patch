+++ b/Sources/TMDBApp/Views/RemoteImage.swift
@@ -0,0 +1,19 @@
+import SwiftUI
+
+/// Remote image that fills its frame, with a symbol placeholder while loading or when `url` is nil.
+struct RemoteImage: View {
+    let url: URL?
+    var placeholderSystemImage = "film"
+
+    var body: some View {
+        AsyncImage(url: url) { image in
+            image.resizable().scaledToFill()
+        } placeholder: {
+            ZStack {
+                Rectangle().fill(.quaternary)
+                Image(systemName: placeholderSystemImage).foregroundStyle(.secondary)
+            }
+        }
+        .accessibilityHidden(true)
+    }
+}
