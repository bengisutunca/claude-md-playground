+++ b/Tests/TMDBAppTests/MovieDetailViewModelTests.swift
@@ -0,0 +1,75 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("MovieDetailViewModel")
+struct MovieDetailViewModelTests {
+    @Test func loadsDetailAndCredits() async throws {
+        let service = MockMovieService()
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        await vm.load()
+
+        guard case .loaded(let content) = vm.state else {
+            Issue.record("expected loaded, got \(vm.state)"); return
+        }
+        #expect(content.detail.id == 27205)
+        #expect(content.detail.title == "Inception")
+        #expect(content.cast.map(\.name) == ["Leonardo DiCaprio", "Joseph Gordon-Levitt", "Elliot Page", "Tom Hardy"])
+        #expect(content.directors.map(\.name) == ["Christopher Nolan"])
+        #expect(content.runtimeText == "2h 28m")
+        #expect(content.genresText == "Action, Science Fiction, Adventure")
+        #expect(content.releaseYear == "2010")
+
+        let calls = await service.calls
+        #expect(calls.count == 2)
+        #expect(calls.contains(.detail(id: 27205)))
+        #expect(calls.contains(.credits(id: 27205)))
+    }
+
+    @Test(arguments: [true, false])
+    func eitherRequestFailingGivesFailed(detailFails: Bool) async {
+        let error = APIError.httpStatus(code: 401, message: "bad key")
+        let service = detailFails ? MockMovieService(detailError: error) : MockMovieService(creditsError: error)
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        await vm.load()
+        #expect(vm.state == .failed("Invalid API key."))
+    }
+
+    @Test func retryAfterFailureLoads() async {
+        let service = MockMovieService(creditsError: APIError.transport(URLError(.notConnectedToInternet)))
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        await vm.load()
+        guard case .failed = vm.state else { Issue.record("expected failed, got \(vm.state)"); return }
+
+        await service.setCreditsError(nil)
+        await vm.load()
+        guard case .loaded = vm.state else { Issue.record("expected loaded, got \(vm.state)"); return }
+    }
+}
+
+@Suite("MovieDetailContent")
+struct MovieDetailContentTests {
+    @Test(arguments: [
+        (0, "0m"), (1, "1m"), (45, "45m"), (59, "59m"),
+        (60, "1h"), (61, "1h 1m"), (120, "2h"), (148, "2h 28m"), (180, "3h"),
+    ])
+    func formatRuntime(minutes: Int, expected: String) {
+        #expect(MovieDetailContent.formatRuntime(minutes: minutes) == expected)
+    }
+
+    @Test func castIsTopTenByOrderAndDirectorsFiltered() throws {
+        let detail = try JSONDecoder.tmdb.decode(MovieDetail.self, from: Fixture.data("movie_detail_27205"))
+        let cast = (0..<12).reversed().map {
+            CastMember(id: $0, name: "Actor \($0)", character: nil, order: $0, profilePath: nil)
+        }
+        let crew = [
+            CrewMember(id: 100, name: "A", job: "Director", department: "Directing", profilePath: nil),
+            CrewMember(id: 101, name: "B", job: "Writer", department: "Writing", profilePath: nil),
+            CrewMember(id: 102, name: "C", job: "Director", department: "Directing", profilePath: nil),
+        ]
+        let content = MovieDetailContent(detail: detail, credits: Credits(id: detail.id, cast: cast, crew: crew))
+        #expect(content.cast.map(\.order) == Array(0..<10))
+        #expect(content.directors.map(\.name) == ["A", "C"])
+    }
+}
