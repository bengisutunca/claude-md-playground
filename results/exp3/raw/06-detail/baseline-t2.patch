index 0000000..2bd0f28
--- /dev/null
+++ b/Tests/TMDBAppTests/MovieDetailViewModelTests.swift
@@ -0,0 +1,81 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+/// Serves fixtures but can fail either request independently.
+private struct PartialFailureService: MovieService {
+    var failDetail = false
+    var failCredits = false
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> { throw APIError.invalidResponse }
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> { throw APIError.invalidResponse }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        if failDetail { throw APIError.invalidResponse }
+        return try JSONDecoder.tmdb.decode(MovieDetail.self, from: Fixture.data("movie_detail_27205"))
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        if failCredits { throw APIError.invalidResponse }
+        return try JSONDecoder.tmdb.decode(Credits.self, from: Fixture.data("movie_credits_27205"))
+    }
+}
+
+@MainActor
+@Suite("MovieDetailViewModel")
+struct MovieDetailViewModelTests {
+    @Test func successfulLoad() async throws {
+        let service = MockMovieService()
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        #expect(vm.state == .idle)
+        await vm.load()
+        guard case .loaded(let content) = vm.state else {
+            Issue.record("expected loaded, got \(vm.state)")
+            return
+        }
+        #expect(content.detail.id == 27205)
+        #expect(content.detail.title == "Inception")
+        #expect(!content.cast.isEmpty)
+        #expect(content.cast.count <= 10)
+        let orders = content.cast.compactMap(\.order)
+        #expect(orders == orders.sorted())
+        #expect(!content.directors.isEmpty)
+        #expect(content.directors.allSatisfy { $0.job == "Director" })
+        #expect(content.runtimeText == "2h 28m")
+        #expect(content.year == "2010")
+        let calls = await service.calls
+        #expect(calls.contains(.detail(id: 27205)))
+        #expect(calls.contains(.credits(id: 27205)))
+    }
+
+    @Test func castIsTopTenByOrder() throws {
+        let credits = try JSONDecoder.tmdb.decode(Credits.self, from: Fixture.data("movie_credits_27205"))
+        let detail = try JSONDecoder.tmdb.decode(MovieDetail.self, from: Fixture.data("movie_detail_27205"))
+        let content = MovieDetailContent(detail: detail, credits: credits)
+        let expected = credits.cast.sorted { ($0.order ?? .max) < ($1.order ?? .max) }.prefix(10).map(\.id)
+        #expect(content.cast.map(\.id) == Array(expected))
+    }
+
+    @Test func genresAreJoined() throws {
+        let detail = try JSONDecoder.tmdb.decode(MovieDetail.self, from: Fixture.data("movie_detail_27205"))
+        let content = MovieDetailContent(detail: detail, credits: Credits(id: 27205, cast: [], crew: []))
+        #expect(content.genresText == detail.genres.map(\.name).joined(separator: ", "))
+    }
+
+    @Test func detailFailureGivesFailed() async {
+        let vm = MovieDetailViewModel(movieID: 27205, service: PartialFailureService(failDetail: true))
+        await vm.load()
+        guard case .failed = vm.state else { Issue.record("expected failed, got \(vm.state)"); return }
+    }
+
+    @Test func creditsFailureGivesFailed() async {
+        let vm = MovieDetailViewModel(movieID: 27205, service: PartialFailureService(failCredits: true))
+        await vm.load()
+        guard case .failed = vm.state else { Issue.record("expected failed, got \(vm.state)"); return }
+    }
+
+    @Test(arguments: [(148, "2h 28m"), (120, "2h"), (60, "1h"), (61, "1h 1m"), (45, "45m"), (1, "1m"), (0, "0m")])
+    func runtimeFormatting(minutes: Int, expected: String) {
+        #expect(MovieDetailContent.formatRuntime(minutes: minutes) == expected)
+    }
+}
