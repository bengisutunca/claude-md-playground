+import Foundation
+import Observation
+
+/// Everything the detail screen renders, assembled from the detail and credits responses.
+struct MovieDetailContent: Equatable, Sendable {
+    static let maxCastCount = 10
+
+    let detail: MovieDetail
+    let cast: [CastMember]
+    let directors: [CrewMember]
+
+    init(detail: MovieDetail, credits: Credits) {
+        self.detail = detail
+        self.cast = Array(
+            credits.cast
+                .sorted { ($0.order ?? .max) < ($1.order ?? .max) }
+                .prefix(Self.maxCastCount)
+        )
+        self.directors = credits.crew.filter { $0.job == "Director" }
+    }
+
+    /// "2h 28m"; nil when the runtime is unknown.
+    var runtimeText: String? {
+        detail.runtime.map(Self.formatRuntime(minutes:))
+    }
+
+    var genresText: String {
+        detail.genres.map(\.name).joined(separator: ", ")
+    }
+
+    var year: String? { detail.year }
+
+    var directorsText: String {
+        directors.map(\.name).joined(separator: ", ")
+    }
+
+    static func formatRuntime(minutes: Int) -> String {
+        let minutes = max(0, minutes)
+        let hours = minutes / 60
+        let remainder = minutes % 60
+        if hours == 0 { return "\(remainder)m" }
+        if remainder == 0 { return "\(hours)h" }
+        return "\(hours)h \(remainder)m"
+    }
+}
+
+@MainActor
+@Observable
+final class MovieDetailViewModel {
+    let movieID: Int
+    private(set) var state: ViewState<MovieDetailContent> = .idle
+
+    @ObservationIgnored private let service: any MovieService
+
+    init(movieID: Int, service: any MovieService) {
+        self.movieID = movieID
+        self.service = service
+    }
+
+    func load() async {
+        state = .loading
+        do {
+            async let detail = service.detail(id: movieID)
+            async let credits = service.credits(id: movieID)
+            let content = try await MovieDetailContent(detail: detail, credits: credits)
+            state = .loaded(content)
+        } catch is CancellationError {
+            return
+        } catch {
+            state = .failed(MovieListViewModel.message(for: error))
+        }
+    }
+}
