@@ -0,0 +1,73 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("MovieDetailViewModel")
+struct MovieDetailViewModelTests {
+    /// Fails only the chosen request; the other one returns fixture data.
+    private struct PartialFailureService: MovieService {
+        let base = MockMovieService()
+        var failDetail = false
+        var failCredits = false
+
+        func popular(page: Int) async throws -> PagedResponse<Movie> { try await base.popular(page: page) }
+        func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+            try await base.search(query: query, page: page)
+        }
+        func detail(id: Int) async throws -> MovieDetail {
+            if failDetail { throw APIError.transport(URLError(.notConnectedToInternet)) }
+            return try await base.detail(id: id)
+        }
+        func credits(id: Int) async throws -> Credits {
+            if failCredits { throw APIError.transport(URLError(.notConnectedToInternet)) }
+            return try await base.credits(id: id)
+        }
+    }
+
+    @Test func successfulLoad() async throws {
+        let service = MockMovieService()
+        let vm = MovieDetailViewModel(movieID: 27205, service: service)
+        #expect(vm.state == .idle)
+        await vm.load()
+
+        guard case .loaded(let content) = vm.state else {
+            Issue.record("expected .loaded, got \(vm.state)")
+            return
+        }
+        #expect(content.detail.title == "Inception")
+        #expect(content.runtimeText == "2h 28m")
+        #expect(content.genresText == content.detail.genres.map(\.name).joined(separator: ", "))
+        #expect(content.cast.count <= 10)
+        #expect(content.cast.map(\.order) == content.cast.compactMap(\.order).sorted())
+        #expect(content.directors.map(\.name) == ["Christopher Nolan"])
+        let calls = await service.calls
+        #expect(calls.count == 2)
+        #expect(calls.contains(.detail(id: 27205)))
+        #expect(calls.contains(.credits(id: 27205)))
+    }
+
+    @Test func detailFailureGivesFailed() async {
+        let vm = MovieDetailViewModel(movieID: 27205, service: PartialFailureService(failDetail: true))
+        await vm.load()
+        guard case .failed = vm.state else {
+            Issue.record("expected .failed, got \(vm.state)")
+            return
+        }
+    }
+
+    @Test func creditsFailureGivesFailed() async {
+        let vm = MovieDetailViewModel(movieID: 27205, service: PartialFailureService(failCredits: true))
+        await vm.load()
+        guard case .failed = vm.state else {
+            Issue.record("expected .failed, got \(vm.state)")
+            return
+        }
+    }
+
+    @Test(arguments: [(0, "0m"), (1, "1m"), (45, "45m"), (59, "59m"), (60, "1h"),
+                      (120, "2h"), (148, "2h 28m"), (61, "1h 1m")])
+    func runtimeFormatting(minutes: Int, expected: String) {
+        #expect(MovieDetailContent.formatRuntime(minutes: minutes) == expected)
+    }
+}
