diff --git a/Sources/TMDBApp/ViewModels/ViewState.swift b/Sources/TMDBApp/ViewModels/ViewState.swift
index 212b030..7ad49f2 100644
--- a/Sources/TMDBApp/ViewModels/ViewState.swift
+++ b/Sources/TMDBApp/ViewModels/ViewState.swift
@@ -11,3 +11,23 @@ enum ViewState<Value> {
 
 extension ViewState: Equatable where Value: Equatable {}
 extension ViewState: Sendable where Value: Sendable {}
+
+extension Error {
+    /// Text shown to the user when a request fails.
+    var userMessage: String {
+        guard let apiError = self as? APIError else {
+            return "Something went wrong. Please try again."
+        }
+        switch apiError {
+        case .missingAPIKey:
+            return "The TMDB API key is missing. Set \(APIConfiguration.keyName) in the environment or the app's Info.plist."
+        case .httpStatus(let code, let message):
+            if code == 401 { return "Invalid API key." }
+            return message ?? "The server returned an error (\(code))."
+        case .transport:
+            return "Couldn't reach the server. Check your connection."
+        case .decoding, .invalidResponse:
+            return "Received an unexpected response from the server."
+        }
+    }
+}
