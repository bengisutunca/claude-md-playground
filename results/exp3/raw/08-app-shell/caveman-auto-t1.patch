+import Foundation
+
+/// `MovieService` backed by in-memory sample data, for SwiftUI previews. Never touches the network.
+struct PreviewMovieService: MovieService {
+    static let movies: [Movie] = [
+        Movie(id: 27205, title: "Inception",
+              overview: "A thief who steals corporate secrets through dream-sharing technology is given the inverse task of planting an idea.",
+              posterPath: "/inception.jpg", releaseDate: TMDBDate.parse("2010-07-15"),
+              voteAverage: 8.4, voteCount: 35000, genreIDs: [28, 878, 12]),
+        Movie(id: 278, title: "The Shawshank Redemption",
+              overview: "Imprisoned in the 1940s for the double murder of his wife and her lover, Andy Dufresne begins a new life at Shawshank prison.",
+              posterPath: "/shawshank.jpg", releaseDate: TMDBDate.parse("1994-09-23"),
+              voteAverage: 8.7, voteCount: 26000, genreIDs: [18, 80]),
+        Movie(id: 550, title: "Fight Club",
+              overview: "A ticking-time-bomb insomniac and a slippery soap salesman channel primal male aggression into a shocking new form of therapy.",
+              releaseDate: TMDBDate.parse("1999-10-15"), voteAverage: 8.4, voteCount: 29000, genreIDs: [18]),
+        Movie(id: 129, title: "Spirited Away",
+              overview: "A young girl wanders into a world ruled by gods, witches and spirits.",
+              releaseDate: TMDBDate.parse("2001-07-20"), voteAverage: 8.5, voteCount: 16000, genreIDs: [16, 10751, 14])
+    ]
+
+    private static let genres = [
+        Genre(id: 12, name: "Adventure"), Genre(id: 14, name: "Fantasy"), Genre(id: 16, name: "Animation"),
+        Genre(id: 18, name: "Drama"), Genre(id: 28, name: "Action"), Genre(id: 80, name: "Crime"),
+        Genre(id: 878, name: "Science Fiction"), Genre(id: 10751, name: "Family")
+    ]
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        PagedResponse(page: page, results: page == 1 ? Self.movies : [], totalPages: 1,
+                      totalResults: Self.movies.count)
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        let results = Self.movies.filter { $0.title.range(of: query, options: [.caseInsensitive, .diacriticInsensitive]) != nil }
+        return PagedResponse(page: page, results: results, totalPages: 1, totalResults: results.count)
+    }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        guard let movie = Self.movies.first(where: { $0.id == id }) else {
+            throw APIError.httpStatus(code: 404, message: "The resource you requested could not be found.")
+        }
+        return MovieDetail(id: movie.id, title: movie.title, overview: movie.overview,
+                           posterPath: movie.posterPath, backdropPath: movie.backdropPath,
+                           releaseDate: movie.releaseDate, voteAverage: movie.voteAverage,
+                           voteCount: movie.voteCount, runtime: 128, tagline: nil,
+                           genres: Self.genres.filter { movie.genreIDs.contains($0.id) },
+                           status: "Released")
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        Credits(id: id,
+                cast: [CastMember(id: 1, name: "Lead Actor", character: "Protagonist", order: 0, profilePath: nil),
+                       CastMember(id: 2, name: "Supporting Actor", character: "Sidekick", order: 1, profilePath: nil)],
+                crew: [CrewMember(id: 3, name: "Film Director", job: "Director", department: "Directing", profilePath: nil)])
+    }
+}
