+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("AppDependencies")
+struct AppDependenciesTests {
+    @Test func previewServesMockData() async throws {
+        let dependencies = AppDependencies.preview
+        #expect(!dependencies.favorites.favorites.isEmpty)
+
+        let list = dependencies.makeMovieListViewModel()
+        await list.load()
+        guard case .loaded(let movies) = list.state else { Issue.record("expected loaded, got \(list.state)"); return }
+        #expect(!movies.isEmpty)
+
+        let detail = dependencies.makeMovieDetailViewModel(movieID: try #require(movies.first).id)
+        await detail.load()
+        guard case .loaded = detail.state else { Issue.record("expected loaded, got \(detail.state)"); return }
+
+        let search = dependencies.makeSearchViewModel()
+        search.query = "incep"
+        await search.waitForSearch()
+        guard case .loaded(let results) = search.state else { Issue.record("expected loaded, got \(search.state)"); return }
+        #expect(results.map(\.title) == ["Inception"])
+    }
+
+    @Test func injectedServiceAndStoreAreUsed() async {
+        let service = MockMovieService()
+        let movie = Movie(id: 1, title: "Stored")
+        let dependencies = AppDependencies(movieService: service, favoritesStore: InMemoryFavoritesStore([movie]))
+        #expect(dependencies.favorites.favorites == [movie])
+        await dependencies.makeMovieListViewModel().load()
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    /// Only runs when no key is configured, so it can never reach the real API.
+    @Test(.enabled(if: ProcessInfo.processInfo.environment[APIConfiguration.keyName] == nil))
+    func liveWithoutAPIKeyFailsWithMissingAPIKey() async {
+        let dependencies = AppDependencies.live()
+        do {
+            _ = try await dependencies.movieService.popular(page: 1)
+            Issue.record("expected missingAPIKey")
+        } catch APIError.missingAPIKey {
+        } catch {
+            Issue.record("unexpected error \(error)")
+        }
+
+        let list = dependencies.makeMovieListViewModel()
+        await list.load()
+        #expect(list.state == .failed(APIError.missingAPIKey.userMessage))
+    }
+}
