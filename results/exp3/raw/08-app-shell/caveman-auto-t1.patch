--- /dev/null
+++ b/Sources/TMDBApp/Views/RootView.swift
@@ -0,0 +1,36 @@
+import SwiftUI
+
+/// App entry view: one tab per screen, each with its own navigation stack.
+struct RootView: View {
+    let dependencies: AppDependencies
+    @State private var movieList: MovieListViewModel
+    @State private var search: SearchViewModel
+
+    init(dependencies: AppDependencies) {
+        self.dependencies = dependencies
+        _movieList = State(initialValue: dependencies.makeMovieListViewModel())
+        _search = State(initialValue: dependencies.makeSearchViewModel())
+    }
+
+    var body: some View {
+        TabView {
+            tab { MovieListView(viewModel: movieList) }
+                .tabItem { Label("Popular", systemImage: "film") }
+            tab { SearchView(viewModel: search) }
+                .tabItem { Label("Search", systemImage: "magnifyingglass") }
+            tab { FavoritesView() }
+                .tabItem { Label("Favorites", systemImage: "heart") }
+        }
+        .environment(dependencies.favorites)
+    }
+
+    private func tab<Content: View>(@ViewBuilder _ content: () -> Content) -> some View {
+        NavigationStack {
+            content().movieDetailDestination(using: dependencies)
+        }
+    }
+}
+
+#Preview {
+    RootView(dependencies: .preview)
+}
