@@ -0,0 +1,30 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("AppDependencies")
+@MainActor
+struct AppDependenciesTests {
+    @Test func previewServesMockData() async throws {
+        let deps = AppDependencies.preview
+        let popular = try await deps.movieService.popular(page: 1)
+        #expect(!popular.results.isEmpty)
+        let detail = try await deps.movieService.detail(id: 27205)
+        #expect(detail.title == "Inception")
+        let credits = try await deps.movieService.credits(id: 27205)
+        #expect(credits.crew.contains { $0.job == "Director" })
+    }
+
+    @Test func previewViewModelsLoad() async {
+        let deps = AppDependencies.preview
+        let list = deps.makeMovieListViewModel()
+        await list.load()
+        #expect(list.state == .loaded(PreviewMovieService.movies))
+    }
+
+    @Test func liveDoesNotCrashAndMissingKeyHasClearMessage() {
+        _ = AppDependencies.live()
+        #expect(throws: APIError.self) { try APIConfiguration.load(environment: [:], bundle: Bundle()) }
+        #expect(APIError.userMessage(for: APIError.missingAPIKey).contains("TMDB_API_KEY"))
+    }
+}
