+    var body: some View {
+        TabView {
+            NavigationStack {
+                MovieListView(viewModel: movieList, service: dependencies.movieService)
+            }
+            .tabItem { Label("Popular", systemImage: "flame") }
+
+            NavigationStack {
+                SearchView(viewModel: search, service: dependencies.movieService)
