+import SwiftUI
+
+/// Async image filling its frame, with a film-icon placeholder while loading or when `url` is nil.
+struct RemoteImage: View {
+    let url: URL?
+
+    var body: some View {
+        AsyncImage(url: url) { image in
+            image.resizable().scaledToFill()
+        } placeholder: {
+            ZStack {
+                Rectangle().fill(.quaternary)
+                Image(systemName: "film").foregroundStyle(.secondary)
+            }
+        }
+    }
+}
