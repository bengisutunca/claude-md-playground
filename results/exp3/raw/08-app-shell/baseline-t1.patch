+++ b/Tests/TMDBAppTests/AppDependenciesTests.swift
@@ -0,0 +1,36 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("AppDependencies")
+struct AppDependenciesTests {
+    @Test func previewServesMockDataOffline() async throws {
+        let deps = AppDependencies.preview
+        let popular = try await deps.movieService.popular(page: 1)
+        #expect(!popular.results.isEmpty)
+        let hits = try await deps.movieService.search(query: "inception", page: 1)
+        #expect(hits.results.map(\.title) == ["Inception"])
+        let detail = try await deps.movieService.detail(id: 27205)
+        #expect(detail.title == "Inception")
+        let credits = try await deps.movieService.credits(id: 27205)
+        #expect(credits.crew.first?.job == "Director")
+    }
+
+    @Test func previewViewModelsLoad() async {
+        let vm = AppDependencies.preview.makeMovieListViewModel()
+        await vm.load()
+        #expect(vm.state == .loaded(PreviewMovieService.movies))
+    }
+
+    @Test func missingKeyMapsToClearMessage() {
+        let message = MovieListViewModel.message(for: APIError.missingAPIKey)
+        #expect(message.contains("TMDB_API_KEY"))
+    }
+
+    @Test func liveDoesNotCrashAndInjectsFavorites() {
+        let deps = AppDependencies(movieService: PreviewMovieService(), favoritesStore: InMemoryFavoritesStore())
+        #expect(deps.favorites.favorites.isEmpty)
+        _ = AppDependencies.live()
+    }
+}
