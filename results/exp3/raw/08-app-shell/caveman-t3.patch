@@ -0,0 +1,34 @@
+import Foundation
+
+/// Composition root: builds the services and shared state once and hands them to the views.
+@MainActor
+final class AppDependencies {
+    let movieService: any MovieService
+    let favorites: FavoritesViewModel
+
+    init(movieService: any MovieService, favoritesStore: any FavoritesStore) {
+        self.movieService = movieService
+        self.favorites = FavoritesViewModel(store: favoritesStore)
+    }
+
+    /// Real TMDB client. A missing `TMDB_API_KEY` doesn't fail here: each request throws
+    /// `APIError.missingAPIKey`, which screens show as an `ErrorView`.
+    static func live() -> AppDependencies {
+        AppDependencies(movieService: TMDBMovieService(client: TMDBClient()),
+                        favoritesStore: UserDefaultsFavoritesStore())
+    }
+
+    /// Mock data, no network, nothing persisted.
+    static var preview: AppDependencies {
+        AppDependencies(movieService: PreviewMovieService(),
+                        favoritesStore: InMemoryFavoritesStore(initial: [PreviewMovieService.movies[0]]))
+    }
+
+    func makeMovieListViewModel() -> MovieListViewModel {
+        MovieListViewModel(service: movieService)
+    }
+
+    func makeSearchViewModel() -> SearchViewModel {
+        SearchViewModel(service: movieService)
+    }
+}
