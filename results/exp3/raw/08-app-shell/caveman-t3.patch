diff --git a/Tests/TMDBAppTests/AppDependenciesTests.swift b/Tests/TMDBAppTests/AppDependenciesTests.swift
new file mode 100644
index 0000000..31509a3
--- /dev/null
+++ b/Tests/TMDBAppTests/AppDependenciesTests.swift
@@ -0,0 +1,27 @@
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("AppDependencies")
+struct AppDependenciesTests {
+    @Test func previewServesMockDataWithoutNetwork() async throws {
+        let deps = AppDependencies.preview
+        let page = try await deps.movieService.popular(page: 1)
+        #expect(!page.results.isEmpty)
+        let vm = deps.makeMovieListViewModel()
+        await vm.load()
+        #expect(vm.state == .loaded(page.results))
+        let detail = try await deps.movieService.detail(id: page.results[0].id)
+        #expect(detail.id == page.results[0].id)
+        _ = try await deps.movieService.credits(id: detail.id)
+    }
+
+    @Test func liveDoesNotCrashWithoutAPIKey() {
+        // Construction must succeed regardless of the environment; failures surface per request.
+        _ = AppDependencies.live()
+    }
+
+    @Test func missingKeyMessageIsClear() {
+        #expect(APIError.message(for: APIError.missingAPIKey).contains("API key"))
+    }
+}
