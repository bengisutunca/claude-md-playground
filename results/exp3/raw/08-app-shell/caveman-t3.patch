+++ b/Sources/TMDBApp/Services/PreviewMovieService.swift
@@ -0,0 +1,53 @@
+import Foundation
+
+/// In-memory `MovieService` for SwiftUI previews. Never touches the network.
+struct PreviewMovieService: MovieService {
+    static let movies: [Movie] = [
+        Movie(id: 27205, title: "Inception", overview: "A thief who steals secrets through dreams.",
+              releaseDate: DateComponents(calendar: .current, year: 2010, month: 7, day: 16).date,
+              voteAverage: 8.4, voteCount: 35000, genreIDs: [28, 878]),
+        Movie(id: 157336, title: "Interstellar", overview: "Explorers travel through a wormhole.",
+              releaseDate: DateComponents(calendar: .current, year: 2014, month: 11, day: 5).date,
+              voteAverage: 8.4, voteCount: 33000, genreIDs: [12, 878]),
+        Movie(id: 155, title: "The Dark Knight", overview: "Batman faces the Joker.",
+              releaseDate: DateComponents(calendar: .current, year: 2008, month: 7, day: 16).date,
+              voteAverage: 8.5, voteCount: 31000, genreIDs: [18, 28])
+    ]
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        PagedResponse(page: 1, results: Self.movies, totalPages: 1, totalResults: Self.movies.count)
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        let matches = Self.movies.filter { $0.title.localizedCaseInsensitiveContains(query) }
+        return PagedResponse(page: 1, results: matches, totalPages: 1, totalResults: matches.count)
+    }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        let movie = Self.movies.first { $0.id == id } ?? Self.movies[0]
+        let json = """
+        {"id": \(movie.id), "title": "\(movie.title)", "overview": "\(movie.overview)",
+         "vote_average": \(movie.voteAverage), "vote_count": \(movie.voteCount),
+         "runtime": 148, "tagline": "Preview data.", "status": "Released",
+         "genres": [{"id": 878, "name": "Science Fiction"}]}
+        """
+        return try JSONDecoder.tmdb.decode(MovieDetail.self, from: Data(json.utf8))
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        let json = """
+        {"id": \(id),
+         "cast": [{"id": 1, "name": "Preview Actor", "character": "Lead", "order": 0}],
+         "crew": [{"id": 2, "name": "Preview Director", "job": "Director", "department": "Directing"}]}
+        """
+        return try JSONDecoder.tmdb.decode(Credits.self, from: Data(json.utf8))
+    }
+}
+
+/// Non-persistent `FavoritesStore` for previews.
+struct InMemoryFavoritesStore: FavoritesStore {
+    let initial: [Movie]
+
+    func load() -> [Movie] { initial }
+    func save(_ movies: [Movie]) {}
+}
