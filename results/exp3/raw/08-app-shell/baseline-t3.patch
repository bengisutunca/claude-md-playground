+
+@MainActor
+@Suite("AppDependencies")
+struct AppDependenciesTests {
+    @Test func previewServesMockDataOffline() async throws {
+        let deps = AppDependencies.preview
+        let popular = try await deps.movieService.popular(page: 1)
+        #expect(!popular.results.isEmpty)
+        let detail = try await deps.movieService.detail(id: popular.results[0].id)
+        #expect(!detail.title.isEmpty)
+        let credits = try await deps.movieService.credits(id: detail.id)
+        #expect(!credits.crew.isEmpty)
+        #expect(deps.favorites.favorites.isEmpty)
+    }
+
+    @Test func previewViewModelsLoad() async {
+        let vm = AppDependencies.preview.makeMovieListViewModel()
+        await vm.load()
+        #expect(vm.state == .loaded(PreviewData.movies))
+    }
+
+    @Test func previewFavoritesDoNotPersist() {
+        let first = AppDependencies.preview
+        first.favorites.toggle(PreviewData.movies[0])
+        #expect(AppDependencies.preview.favorites.favorites.isEmpty)
+    }
+
+    @Test func liveWithoutAPIKeyDoesNotCrashAndFailsRequests() async {
+        // Skip the assertion if a real key is configured, to avoid touching the network.
+        guard (try? APIConfiguration.load()) == nil else { return }
+        let deps = AppDependencies.live()
+        let vm = deps.makeMovieListViewModel()
+        await vm.load()
+        #expect(vm.state == .failed(APIError.missingAPIKey.userMessage))
+    }
+
+    @Test func missingKeyMessageIsClear() {
+        #expect(APIError.missingAPIKey.userMessage.contains("TMDB_API_KEY"))
+    }
+}
