+++ b/Sources/TMDBApp/Services/AppDependencies.swift
@@ -0,0 +1,33 @@
+import Foundation
+
+/// Composition root: builds the shared services once and creates view models from them.
+@MainActor
+final class AppDependencies {
+    let movieService: any MovieService
+    let favorites: FavoritesViewModel
+
+    init(movieService: any MovieService, favoritesStore: any FavoritesStore) {
+        self.movieService = movieService
+        self.favorites = FavoritesViewModel(store: favoritesStore)
+    }
+
+    /// Real networking and persistent favorites. A missing `TMDB_API_KEY` does not crash here;
+    /// requests fail with `APIError.missingAPIKey`.
+    static func live() -> AppDependencies {
+        AppDependencies(movieService: TMDBMovieService(client: TMDBClient()),
+                        favoritesStore: UserDefaultsFavoritesStore())
+    }
+
+    /// Mock data and in-memory favorites; no network or disk access.
+    static var preview: AppDependencies {
+        AppDependencies(movieService: PreviewMovieService(), favoritesStore: InMemoryFavoritesStore())
+    }
+
+    func makeMovieListViewModel() -> MovieListViewModel {
+        MovieListViewModel(service: movieService)
+    }
+
+    func makeSearchViewModel() -> SearchViewModel {
+        SearchViewModel(service: movieService)
+    }
+}
diff --git a/Sources/TMDBApp/Services/PreviewSupport.swift b/Sources/TMDBApp/Services/PreviewSupport.swift
new file mode 100644
index 0000000..dfce51b
--- /dev/null
+++ b/Sources/TMDBApp/Services/PreviewSupport.swift
@@ -0,0 +1,75 @@
+import Foundation
+
+/// Inline mock data (no fixtures, no network) backing `AppDependencies.preview`.
+enum PreviewData {
+    static let movies: [Movie] = [
+        Movie(id: 1, title: "Inception", overview: "A thief enters dreams to steal secrets.",
+              releaseDate: Date(timeIntervalSince1970: 1_279_065_600), voteAverage: 8.4,
+              voteCount: 35000, genreIDs: [28, 878]),
+        Movie(id: 2, title: "Interstellar", overview: "Explorers travel through a wormhole.",
+              releaseDate: Date(timeIntervalSince1970: 1_415_145_600), voteAverage: 8.4,
+              voteCount: 33000, genreIDs: [12, 878]),
+        Movie(id: 3, title: "The Dark Knight", overview: "Batman faces the Joker.",
+              releaseDate: Date(timeIntervalSince1970: 1_216_080_000), voteAverage: 8.5,
+              voteCount: 31000, genreIDs: [18, 28])
+    ]
+
+    static let detail: MovieDetail = decode("""
+        {"id": 1, "title": "Inception", "overview": "A thief enters dreams to steal secrets.",
+         "tagline": "Your mind is the scene of the crime.", "runtime": 148,
+         "release_date": "2010-07-16", "vote_average": 8.4, "vote_count": 35000,
+         "status": "Released",
+         "genres": [{"id": 28, "name": "Action"}, {"id": 878, "name": "Science Fiction"}]}
+        """)
+
+    static let credits: Credits = decode("""
+        {"id": 1,
+         "cast": [{"id": 10, "name": "Leonardo DiCaprio", "character": "Cobb", "order": 0}],
+         "crew": [{"id": 20, "name": "Christopher Nolan", "job": "Director"}]}
+        """)
+
+    private static func decode<T: Decodable>(_ json: String) -> T {
+        // Static literals above; a failure here is a programmer error in preview-only data.
+        try! JSONDecoder.tmdb.decode(T.self, from: Data(json.utf8))
+    }
+}
+
+/// Offline `MovieService` serving `PreviewData`, or throwing `error` when set.
+struct PreviewMovieService: MovieService {
+    var error: Error?
+
+    init(error: Error? = nil) { self.error = error }
+
+    private func page(_ movies: [Movie]) throws -> PagedResponse<Movie> {
+        if let error { throw error }
+        return PagedResponse(page: 1, results: movies, totalPages: 1, totalResults: movies.count)
+    }
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        try self.page(PreviewData.movies)
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        try self.page(PreviewData.movies.filter { $0.title.localizedCaseInsensitiveContains(query) })
+    }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        if let error { throw error }
+        return PreviewData.detail
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        if let error { throw error }
+        return PreviewData.credits
+    }
+}
+
+/// Non-persistent favorites storage for previews.
+final class InMemoryFavoritesStore: FavoritesStore {
+    private var movies: [Movie]
+
+    init(movies: [Movie] = []) { self.movies = movies }
+
+    func load() -> [Movie] { movies }
+    func save(_ movies: [Movie]) { self.movies = movies }
+}
