@@ -0,0 +1,57 @@
+import Foundation
+
+/// Offline `MovieService` serving a few built-in movies, for SwiftUI previews.
+struct PreviewMovieService: MovieService {
+    private static let movies: [Movie] = decode("""
+    [{"id": 27205, "title": "Inception", "overview": "A thief who steals secrets through dreams.",
+      "release_date": "2010-07-15", "vote_average": 8.4, "vote_count": 35000, "genre_ids": [28, 878]},
+     {"id": 157336, "title": "Interstellar", "overview": "Explorers travel through a wormhole.",
+      "release_date": "2014-11-05", "vote_average": 8.5, "vote_count": 33000, "genre_ids": [12, 878]},
+     {"id": 155, "title": "The Dark Knight", "overview": "Batman faces the Joker.",
+      "release_date": "2008-07-16", "vote_average": 8.5, "vote_count": 31000, "genre_ids": [18, 28]}]
+    """)
+
+    private static let detail: MovieDetail = decode("""
+    {"id": 27205, "title": "Inception", "overview": "A thief who steals secrets through dreams.",
+     "release_date": "2010-07-15", "vote_average": 8.4, "vote_count": 35000, "runtime": 148,
+     "tagline": "Your mind is the scene of the crime.", "status": "Released",
+     "genres": [{"id": 28, "name": "Action"}, {"id": 878, "name": "Science Fiction"}]}
+    """)
+
+    private static let credits: Credits = decode("""
+    {"id": 27205,
+     "cast": [{"id": 6193, "name": "Leonardo DiCaprio", "character": "Cobb", "order": 0}],
+     "crew": [{"id": 525, "name": "Christopher Nolan", "job": "Director", "department": "Directing"}]}
+    """)
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        singlePage(Self.movies)
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        singlePage(Self.movies.filter { $0.title.range(of: query, options: .caseInsensitive) != nil })
+    }
+
+    func detail(id: Int) async throws -> MovieDetail { Self.detail }
+
+    func credits(id: Int) async throws -> Credits { Self.credits }
+
+    private func singlePage(_ results: [Movie]) -> PagedResponse<Movie> {
+        PagedResponse(page: 1, results: results, totalPages: 1, totalResults: results.count)
+    }
+
+    private static func decode<T: Decodable>(_ json: String) -> T {
+        do { return try JSONDecoder.tmdb.decode(T.self, from: Data(json.utf8)) }
+        catch { fatalError("Invalid preview data: \(error)") }
+    }
+}
+
+/// In-memory `FavoritesStore` so previews never touch `UserDefaults`.
+final class InMemoryFavoritesStore: FavoritesStore {
+    private var movies: [Movie]
+
+    init(movies: [Movie] = []) { self.movies = movies }
+
+    func load() -> [Movie] { movies }
+    func save(_ movies: [Movie]) { self.movies = movies }
+}
