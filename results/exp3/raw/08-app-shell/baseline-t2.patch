@@ -0,0 +1,27 @@
+import SwiftUI
+
+/// Maps a `ViewState` onto the shared loading / empty / error views, so screens only
+/// describe their loaded content.
+struct ViewStateContent<Value, Loaded: View>: View {
+    let state: ViewState<Value>
+    /// Shown for `.idle`; defaults to `LoadingView` when nil.
+    var idle: EmptyStateView?
+    let empty: EmptyStateView
+    var retry: (() -> Void)?
+    @ViewBuilder let loaded: (Value) -> Loaded
+
+    var body: some View {
+        switch state {
+        case .idle:
+            if let idle { idle } else { LoadingView() }
+        case .loading:
+            LoadingView()
+        case .empty:
+            empty
+        case .failed(let message):
+            ErrorView(message: message, retry: retry)
+        case .loaded(let value):
+            loaded(value)
+        }
+    }
+}
