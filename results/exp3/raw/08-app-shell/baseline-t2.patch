+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("AppDependencies")
+struct AppDependenciesTests {
+    @Test func liveDoesNotCrash() {
+        let dependencies = AppDependencies.live()
+        _ = dependencies.makeMovieListViewModel()
+        _ = dependencies.makeSearchViewModel()
+    }
+
+    @Test func missingKeyMessageIsClear() {
+        #expect(APIError.missingAPIKey.userMessage == "The TMDB API key is missing.")
+    }
+
+    @Test func previewServesMockDataOffline() async throws {
+        let dependencies = AppDependencies.preview
+        let vm = dependencies.makeMovieListViewModel()
+        await vm.load()
+        guard case .loaded(let movies) = vm.state else {
+            Issue.record("expected loaded state, got \(vm.state)")
+            return
+        }
+        #expect(!movies.isEmpty)
+        let detail = try await dependencies.movieService.detail(id: movies[0].id)
+        #expect(detail.id == movies[0].id)
+        let credits = try await dependencies.movieService.credits(id: movies[0].id)
+        #expect(credits.crew.contains { $0.job == "Director" })
+    }
+
+    @Test func previewSearchFiltersByTitle() async throws {
+        let response = try await AppDependencies.preview.movieService.search(query: "incep", page: 1)
+        #expect(response.results.map(\.title) == ["Inception"])
+    }
+}
