@@ -0,0 +1,58 @@
+import Foundation
+
+/// In-memory `MovieService` and `FavoritesStore` serving canned data, for SwiftUI previews.
+/// Never touches the network or disk.
+struct PreviewMovieService: MovieService {
+    static let movies: [Movie] = [
+        Movie(id: 27205, title: "Inception",
+              overview: "A thief who steals corporate secrets through dream-sharing technology.",
+              releaseDate: TMDBDate.parse("2010-07-15"), voteAverage: 8.4, voteCount: 35000, genreIDs: [28, 878]),
+        Movie(id: 157336, title: "Interstellar",
+              overview: "A team of explorers travels through a wormhole in space.",
+              releaseDate: TMDBDate.parse("2014-11-05"), voteAverage: 8.4, voteCount: 33000, genreIDs: [12, 878]),
+        Movie(id: 155, title: "The Dark Knight",
+              overview: "Batman faces the Joker, a criminal mastermind.",
+              releaseDate: TMDBDate.parse("2008-07-16"), voteAverage: 8.5, voteCount: 31000, genreIDs: [18, 28])
+    ]
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        PagedResponse(page: 1, results: Self.movies, totalPages: 1, totalResults: Self.movies.count)
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        let matches = Self.movies.filter { $0.title.range(of: query, options: .caseInsensitive) != nil }
+        return PagedResponse(page: 1, results: matches, totalPages: 1, totalResults: matches.count)
+    }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        let movie = Self.movies.first { $0.id == id } ?? Self.movies[0]
+        let json = """
+        {"id": \(movie.id), "title": "\(movie.title)", "overview": "\(movie.overview)",
+         "release_date": "\(movie.releaseDate.map(TMDBDate.string(from:)) ?? "")",
+         "vote_average": \(movie.voteAverage), "vote_count": \(movie.voteCount),
+         "runtime": 148, "tagline": "Preview tagline.", "status": "Released",
+         "genres": [{"id": 28, "name": "Action"}, {"id": 878, "name": "Science Fiction"}]}
+        """
+        return try JSONDecoder.tmdb.decode(MovieDetail.self, from: Data(json.utf8))
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        let json = """
+        {"id": \(id),
+         "cast": [{"id": 1, "name": "Leonardo DiCaprio", "character": "Cobb", "order": 0},
+                  {"id": 2, "name": "Elliot Page", "character": "Ariadne", "order": 1}],
+         "crew": [{"id": 3, "name": "Christopher Nolan", "job": "Director", "department": "Directing"}]}
+        """
+        return try JSONDecoder.tmdb.decode(Credits.self, from: Data(json.utf8))
+    }
+}
+
+/// Non-persistent favorites store.
+final class InMemoryFavoritesStore: FavoritesStore {
+    private var movies: [Movie]
+
+    init(movies: [Movie] = []) { self.movies = movies }
+
+    func load() -> [Movie] { movies }
+    func save(_ movies: [Movie]) { self.movies = movies }
+}
