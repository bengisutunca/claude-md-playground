@@ -0,0 +1,79 @@
+import Testing
+import Foundation
+@testable import TMDBApp
+
+@MainActor
+struct MovieListViewModelTests {
+    private func movies(_ vm: MovieListViewModel) -> [Movie] {
+        if case .loaded(let m) = vm.state { return m }
+        return []
+    }
+
+    @Test func firstLoadShowsPageOne() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        #expect(vm.state == .idle)
+        await vm.load()
+        #expect(!movies(vm).isEmpty)
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func paginationAppendsPageTwoThenStops() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let firstCount = movies(vm).count
+
+        await vm.loadNextPageIfNeeded(currentItem: movies(vm)[0]) // not last: ignored
+        #expect(movies(vm).count == firstCount)
+
+        await vm.loadNextPageIfNeeded(currentItem: movies(vm).last!)
+        let secondCount = movies(vm).count
+        #expect(secondCount > firstCount)
+        #expect(Set(movies(vm).map(\.id)).count == secondCount)
+
+        // totalPages == 2: no further request
+        await vm.loadNextPageIfNeeded(currentItem: movies(vm).last!)
+        #expect(movies(vm).count == secondCount)
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func errorOnFirstLoadFails() async throws {
+        let service = MockMovieService(error: APIError.transport(URLError(.notConnectedToInternet)))
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        guard case .failed(let text) = vm.state else {
+            Issue.record("expected failed, got \(vm.state)")
+            return
+        }
+        #expect(!text.isEmpty)
+    }
+
+    @Test func paginationErrorKeepsLoadedMovies() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let count = movies(vm).count
+        await service.setError(APIError.httpStatus(code: 500, message: nil))
+        await vm.loadNextPageIfNeeded(currentItem: movies(vm).last!)
+        #expect(movies(vm).count == count)
+        #expect(vm.paginationErrorMessage != nil)
+    }
+
+    @Test func refreshResetsPages() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let firstCount = movies(vm).count
+        await vm.loadNextPageIfNeeded(currentItem: movies(vm).last!)
+        #expect(movies(vm).count > firstCount)
+
+        await vm.refresh()
+        #expect(movies(vm).count == firstCount)
+        #expect(await service.calls.last == .popular(page: 1))
+
+        // pagination works again after the reset
+        await vm.loadNextPageIfNeeded(currentItem: movies(vm).last!)
+        #expect(movies(vm).count > firstCount)
+    }
+}
