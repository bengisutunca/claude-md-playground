+import Foundation
+import Observation
+
+@MainActor
+@Observable
+final class MovieListViewModel {
+    private(set) var state: ViewState<[Movie]> = .idle
+    /// Set when loading a page after the first fails; the already loaded movies stay visible.
+    private(set) var paginationErrorMessage: String?
+    private(set) var isLoadingNextPage = false
+
+    private let service: any MovieService
+    private var movies: [Movie] = []
+    private var currentPage = 0
+    private var totalPages = Int.max
+    private var isFetching = false
+    private var generation = 0
+
+    init(service: any MovieService) {
+        self.service = service
+    }
+
+    var hasMorePages: Bool { currentPage < totalPages }
+
+    /// Loads the first page. Ignored while a page is already loading.
+    func load() async {
+        guard !isFetching else { return }
+        reset()
+        state = .loading
+        await fetch(page: 1)
+    }
+
+    /// Discards loaded pages and reloads the first one. The current list stays visible until it succeeds.
+    func refresh() async {
+        generation += 1 // invalidate any in-flight request
+        isFetching = false
+        isLoadingNextPage = false
+        await fetch(page: 1, replacing: true)
+    }
+
+    func loadNextPageIfNeeded(currentItem: Movie) async {
+        guard !isFetching, hasMorePages, currentPage > 0,
+              movies.last?.id == currentItem.id else { return }
+        isLoadingNextPage = true
+        await fetch(page: currentPage + 1)
+    }
+
+    private func reset() {
+        movies = []
+        currentPage = 0
+        totalPages = Int.max
+        paginationErrorMessage = nil
+    }
+
+    private func fetch(page: Int, replacing: Bool = false) async {
+        let token = generation
+        isFetching = true
+        paginationErrorMessage = nil
+        defer {
+            if token == generation {
+                isFetching = false
+                isLoadingNextPage = false
+            }
+        }
+        do {
+            let response = try await service.popular(page: page)
+            guard token == generation else { return }
+            if replacing { reset() }
+            var seen = Set(movies.map(\.id))
+            movies += response.results.filter { seen.insert($0.id).inserted }
+            currentPage = response.page
+            totalPages = response.totalPages
+            state = movies.isEmpty ? .empty : .loaded(movies)
+        } catch is CancellationError {
+            guard token == generation else { return }
+            if movies.isEmpty { state = .idle }
+        } catch {
+            guard token == generation else { return }
+            let message = Self.message(for: error)
+            if movies.isEmpty {
+                state = .failed(message)
+            } else {
+                paginationErrorMessage = message
+            }
+        }
+    }
+
+    static func message(for error: Error) -> String {
+        guard let apiError = error as? APIError else {
+            return "Something went wrong. Please try again."
+        }
+        switch apiError {
+        case .missingAPIKey:
+            return "The TMDB API key is missing. Add TMDB_API_KEY and try again."
+        case .httpStatus(let code, let message):
+            if code == 401 { return "Invalid API key. Check TMDB_API_KEY." }
+            return message ?? "The server returned an error (\(code))."
+        case .transport:
+            return "Can't reach the server. Check your connection and try again."
+        case .decoding, .invalidResponse:
+            return "Received an unexpected response from the server."
+        }
+    }
+}
