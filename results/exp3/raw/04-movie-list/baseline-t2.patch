+import Foundation
+import Observation
+
+@MainActor
+@Observable
+final class MovieListViewModel {
+    private(set) var state: ViewState<[Movie]> = .idle
+    /// Set when loading a further page failed; the already loaded movies stay visible.
+    private(set) var paginationErrorMessage: String?
+    private(set) var isLoadingNextPage = false
+
+    @ObservationIgnored private let service: any MovieService
+    @ObservationIgnored private var movies: [Movie] = []
+    @ObservationIgnored private var currentPage = 0
+    @ObservationIgnored private var totalPages = 1
+    @ObservationIgnored private var isFetching = false
+    /// Bumped by `refresh()` so results of superseded requests are dropped.
+    @ObservationIgnored private var generation = 0
+
+    init(service: any MovieService) {
+        self.service = service
+    }
+
+    /// Loads the first page. Ignored if something is already loaded or loading.
+    func load() async {
+        guard !isFetching else { return }
+        switch state {
+        case .idle, .failed, .empty: break
+        case .loading, .loaded: return
+        }
+        state = .loading
+        await fetchFirstPage(showError: true)
+    }
+
+    /// Reloads from page 1, replacing all pages on success. Keeps current content on failure.
+    func refresh() async {
+        generation += 1
+        let hadContent: Bool
+        if case .loaded = state { hadContent = true } else { hadContent = false }
+        if !hadContent { state = .loading }
+        await fetchFirstPage(showError: !hadContent)
+    }
+
+    func loadNextPageIfNeeded(currentItem: Movie) async {
+        guard case .loaded = state,
+              !isFetching,
+              currentPage < totalPages,
+              currentItem.id == movies.last?.id else { return }
+        isFetching = true
+        isLoadingNextPage = true
+        paginationErrorMessage = nil
+        let gen = generation
+        defer {
+            if gen == generation {
+                isFetching = false
+                isLoadingNextPage = false
+            }
+        }
+        do {
+            let response = try await service.popular(page: currentPage + 1)
+            guard gen == generation else { return }
+            let known = Set(movies.map(\.id))
+            movies += response.results.filter { !known.contains($0.id) }
+            currentPage = response.page
+            totalPages = response.totalPages
+            state = .loaded(movies)
+        } catch {
+            guard gen == generation else { return }
+            paginationErrorMessage = Self.message(for: error)
+        }
+    }
+
+    private func fetchFirstPage(showError: Bool) async {
+        isFetching = true
+        isLoadingNextPage = false
+        paginationErrorMessage = nil
+        let gen = generation
+        defer { if gen == generation { isFetching = false } }
+        do {
+            let response = try await service.popular(page: 1)
+            guard gen == generation else { return }
+            movies = response.results
+            currentPage = response.page
+            totalPages = response.totalPages
+            state = movies.isEmpty ? .empty : .loaded(movies)
+        } catch {
+            guard gen == generation else { return }
+            if showError {
+                movies = []
+                currentPage = 0
+                totalPages = 1
+                state = .failed(Self.message(for: error))
+            } else {
+                paginationErrorMessage = Self.message(for: error)
+            }
+        }
+    }
+
+    static func message(for error: Error) -> String {
+        if let apiError = error as? APIError {
+            switch apiError {
+            case .missingAPIKey:
+                return "The TMDB API key is missing. Add it and try again."
+            case .httpStatus(let code, let message):
+                if code == 401 { return "The TMDB API key was rejected." }
+                return message ?? "The server returned an error (\(code))."
+            case .decoding:
+                return "Received unexpected data from the server."
+            case .transport, .invalidResponse:
+                return "Could not reach the server. Check your connection and try again."
+            }
+        }
+        if error is URLError {
+            return "Could not reach the server. Check your connection and try again."
+        }
+        return "Something went wrong. Please try again."
+    }
+}
diff --git a/Sources/TMDBApp/ViewModels/ViewState.swift b/Sources/TMDBApp/ViewModels/ViewState.swift
