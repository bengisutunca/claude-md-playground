@@ -0,0 +1,107 @@
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("MovieListViewModel")
+struct MovieListViewModelTests {
+    private func movies(_ vm: MovieListViewModel) -> [Movie] {
+        if case .loaded(let list) = vm.state { return list }
+        return []
+    }
+
+    @Test func firstLoad() async {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        if case .idle = vm.state {} else { Issue.record("expected idle") }
+        await vm.load()
+        #expect(!movies(vm).isEmpty)
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func loadTwiceDoesNotRefetch() async {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        await vm.load()
+        #expect(await service.calls.count == 1)
+    }
+
+    @Test func paginationAppendsAndStopsAtTotalPages() async {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let page1 = movies(vm)
+        await vm.loadNextPageIfNeeded(currentItem: page1[0]) // not last: no-op
+        #expect(await service.calls == [.popular(page: 1)])
+
+        await vm.loadNextPageIfNeeded(currentItem: page1.last!)
+        let both = movies(vm)
+        #expect(both.count > page1.count)
+        #expect(Array(both.prefix(page1.count)) == page1)
+        #expect(Set(both.map(\.id)).count == both.count)
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+
+        await vm.loadNextPageIfNeeded(currentItem: both.last!) // totalPages == 2
+        #expect(await service.calls.count == 2)
+        #expect(movies(vm) == both)
+    }
+
+    @Test func duplicateCallsWhileLoadingAreIgnored() async {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        async let a: Void = vm.load()
+        async let b: Void = vm.load()
+        _ = await (a, b)
+        #expect(await service.calls.count == 1)
+
+        let last = movies(vm).last!
+        async let c: Void = vm.loadNextPageIfNeeded(currentItem: last)
+        async let d: Void = vm.loadNextPageIfNeeded(currentItem: last)
+        _ = await (c, d)
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func errorState() async {
+        let service = MockMovieService(error: APIError.httpStatus(code: 401, message: "Invalid API key"))
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        guard case .failed(let message) = vm.state else {
+            Issue.record("expected failed, got \(vm.state)")
+            return
+        }
+        #expect(!message.isEmpty)
+
+        await service.setError(nil)
+        await vm.refresh()
+        #expect(!movies(vm).isEmpty)
+    }
+
+    @Test func paginationErrorKeepsExistingMovies() async {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let page1 = movies(vm)
+        await service.setError(APIError.invalidResponse)
+        await vm.loadNextPageIfNeeded(currentItem: page1.last!)
+        #expect(movies(vm) == page1)
+        #expect(vm.paginationError != nil)
+    }
+
+    @Test func refreshResetsPages() async {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let page1 = movies(vm)
+        await vm.loadNextPageIfNeeded(currentItem: page1.last!)
+        #expect(movies(vm).count > page1.count)
+
+        await vm.refresh()
+        #expect(movies(vm) == page1)
+        #expect(await service.calls.last == .popular(page: 1))
+
+        // Pagination works again after the reset.
+        await vm.loadNextPageIfNeeded(currentItem: page1.last!)
+        #expect(await service.calls.last == .popular(page: 2))
+        #expect(movies(vm).count > page1.count)
+    }
+}
