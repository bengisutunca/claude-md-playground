+import Foundation
+import Observation
+
+@MainActor
+@Observable
+final class MovieListViewModel {
+    private(set) var state: ViewState<[Movie]> = .idle
+    /// Set when loading a page after the first one fails; the existing list stays visible.
+    private(set) var paginationError: String?
+
+    private let service: any MovieService
+    private var movies: [Movie] = []
+    private var currentPage = 0
+    private var totalPages = 1
+    private var isFetching = false
+    /// Bumped by `refresh()` so results from superseded requests are discarded.
+    private var generation = 0
+
+    init(service: any MovieService) {
+        self.service = service
+    }
+
+    var hasMorePages: Bool { currentPage < totalPages }
+
+    /// Loads the first page unless a load already happened or is in flight.
+    func load() async {
+        guard !isFetching, case .idle = state else { return }
+        await fetch(page: 1, reset: true)
+    }
+
+    /// Discards loaded pages and reloads from page 1.
+    func refresh() async {
+        generation += 1
+        await fetch(page: 1, reset: true)
+    }
+
+    func loadNextPageIfNeeded(currentItem: Movie) async {
+        guard !isFetching, hasMorePages, currentItem.id == movies.last?.id else { return }
+        await fetch(page: currentPage + 1, reset: false)
+    }
+
+    private func fetch(page: Int, reset: Bool) async {
+        isFetching = true
+        let token = generation
+        paginationError = nil
+        if reset && movies.isEmpty { state = .loading }
+        do {
+            let response = try await service.popular(page: page)
+            guard token == generation else { return }
+            if reset { movies = [] }
+            let known = Set(movies.map(\.id))
+            movies += response.results.filter { !known.contains($0.id) }
+            currentPage = response.page
+            totalPages = response.totalPages
+            state = movies.isEmpty ? .empty : .loaded(movies)
+        } catch {
+            guard token == generation else { return }
+            let message = Self.message(for: error)
+            if reset {
+                movies = []
+                currentPage = 0
+                totalPages = 1
+                state = .failed(message)
+            } else {
+                paginationError = message
+            }
+        }
+        isFetching = false
+    }
+
+    static func message(for error: Error) -> String {
+        let offline = "Couldn't reach the server. Check your connection and try again."
+        switch error {
+        case let api as APIError:
+            switch api {
+            case .missingAPIKey:
+                return "No TMDB API key is configured."
+            case .httpStatus(let code, let message):
+                if code == 401 { return "Authentication failed. Check your TMDB API key." }
+                return message ?? "The server returned an error (\(code))."
+            case .decoding:
+                return "Received an unexpected response from the server."
+            case .transport, .invalidResponse:
+                return offline
+            }
+        case is URLError:
+            return offline
+        default:
+            return "Something went wrong. Please try again."
+        }
+    }
+}
