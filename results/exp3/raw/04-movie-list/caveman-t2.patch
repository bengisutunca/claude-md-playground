+import Foundation
+import Observation
+
+@MainActor
+@Observable
+final class MovieListViewModel {
+    private(set) var state: ViewState<[Movie]> = .idle
+
+    private let service: any MovieService
+    private var movies: [Movie] = []
+    private var currentPage = 0
+    private var totalPages = 1
+    private var isFetching = false
+    /// Bumped by `refresh()` so a page fetch that was in flight is discarded.
+    private var generation = 0
+
+    init(service: any MovieService) {
+        self.service = service
+    }
+
+    func load() async {
+        guard case .idle = state else { return }
+        await fetch(page: 1, showLoading: true)
+    }
+
+    func refresh() async {
+        generation += 1
+        isFetching = false
+        // The existing list stays visible while refreshing; it is replaced on success.
+        await fetch(page: 1, showLoading: movies.isEmpty)
+    }
+
+    func loadNextPageIfNeeded(currentItem: Movie) async {
+        guard case .loaded = state, currentItem.id == movies.last?.id,
+              currentPage < totalPages else { return }
+        await fetch(page: currentPage + 1, showLoading: false)
+    }
+
+    private func fetch(page: Int, showLoading: Bool) async {
+        guard !isFetching else { return }
+        let token = generation
+        isFetching = true
+        if showLoading { state = .loading }
+        defer { if token == generation { isFetching = false } }
+
+        do {
+            let response = try await service.popular(page: page)
+            guard token == generation else { return }
+            movies = page == 1 ? response.results : movies + response.results
+            currentPage = response.page
+            totalPages = response.totalPages
+            state = movies.isEmpty ? .empty : .loaded(movies)
+        } catch {
+            guard token == generation else { return }
+            // A failed later page keeps the list on screen and is retried on the next trigger.
+            if page == 1 {
+                movies = []
+                state = .failed(Self.message(for: error))
+            }
+        }
+    }
+
+    static func message(for error: Error) -> String {
+        switch error as? APIError {
+        case .missingAPIKey?: "The TMDB API key is missing."
+        case .httpStatus(_, let message?)?: message
+        case .httpStatus(let code, nil)?: "The server returned an error (\(code))."
+        case .decoding?, .invalidResponse?: "Received an unexpected response from the server."
+        case .transport?: "Could not reach the server. Check your connection and try again."
+        case nil: "Something went wrong. Please try again."
+        }
+    }
+}
