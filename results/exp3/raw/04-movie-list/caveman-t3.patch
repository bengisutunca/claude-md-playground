+import Foundation
+import Observation
+
+@MainActor
+@Observable
+final class MovieListViewModel {
+    private(set) var state: ViewState<[Movie]> = .idle
+    /// Message for the last failed request, including failures of later pages (where `state` keeps the loaded list).
+    private(set) var errorMessage: String?
+
+    private let service: any MovieService
+    private var movies: [Movie] = []
+    private var page = 0
+    private var totalPages = 1
+    private var isFetching = false
+
+    init(service: any MovieService) {
+        self.service = service
+    }
+
+    func load() async {
+        guard page == 0 else { return }
+        await fetch(page: 1, reset: false)
+    }
+
+    func refresh() async {
+        await fetch(page: 1, reset: true)
+    }
+
+    func loadNextPageIfNeeded(currentItem: Movie) async {
+        guard page > 0, page < totalPages, currentItem.id == movies.last?.id else { return }
+        await fetch(page: page + 1, reset: false)
+    }
+
+    private func fetch(page requested: Int, reset: Bool) async {
+        guard !isFetching else { return }
+        isFetching = true
+        defer { isFetching = false }
+        if movies.isEmpty { state = .loading }
+
+        do {
+            let response = try await service.popular(page: requested)
+            movies = reset ? response.results : movies + response.results
+            page = response.page
+            totalPages = response.totalPages
+            errorMessage = nil
+            state = movies.isEmpty ? .empty : .loaded(movies)
+        } catch {
+            let message = Self.message(for: error)
+            errorMessage = message
+            if movies.isEmpty { state = .failed(message) }
+        }
+    }
+
+    private static func message(for error: Error) -> String {
+        switch error as? APIError {
+        case .missingAPIKey:
+            "The TMDB API key is missing."
+        case .httpStatus(let code, let message):
+            message ?? "The server returned an error (\(code))."
+        case .transport:
+            "Couldn't reach the server. Check your connection and try again."
+        case .decoding, .invalidResponse:
+            "Received an unexpected response from the server."
+        case nil:
+            "Something went wrong. Please try again."
+        }
+    }
+}
