+import Foundation
+import Observation
+
+@MainActor
+@Observable
+final class MovieListViewModel {
+    private(set) var state: ViewState<[Movie]> = .idle
+
+    private let service: any MovieService
+    private var movies: [Movie] = []
+    private var nextPage = 1
+    private var totalPages = 1
+    private var isLoadingPage = false
+    /// Bumped by `refresh()` so results of superseded requests are dropped.
+    private var generation = 0
+
+    init(service: any MovieService) {
+        self.service = service
+    }
+
+    func load() async {
+        guard !isLoadingPage else { return }
+        if case .loaded = state { return }
+        await loadFirstPage()
+    }
+
+    func refresh() async {
+        generation += 1
+        await loadFirstPage()
+    }
+
+    func loadNextPageIfNeeded(currentItem: Movie) async {
+        guard !isLoadingPage, nextPage <= totalPages,
+              case .loaded(let items) = state, items.last?.id == currentItem.id else { return }
+        isLoadingPage = true
+        let token = generation
+        defer { if token == generation { isLoadingPage = false } }
+        do {
+            let response = try await service.popular(page: nextPage)
+            guard token == generation else { return }
+            append(response)
+            state = .loaded(movies)
+        } catch {
+            // Keep the loaded list; scrolling to the end again retries.
+        }
+    }
+
+    private func loadFirstPage() async {
+        isLoadingPage = true
+        let token = generation
+        defer { if token == generation { isLoadingPage = false } }
+        if case .loaded = state {} else { state = .loading }
+        do {
+            let response = try await service.popular(page: 1)
+            guard token == generation else { return }
+            movies = []
+            append(response)
+            state = movies.isEmpty ? .empty : .loaded(movies)
+        } catch {
+            guard token == generation else { return }
+            state = .failed(Self.message(for: error))
+        }
+    }
+
+    private func append(_ response: PagedResponse<Movie>) {
+        let known = Set(movies.map(\.id))
+        movies += response.results.filter { !known.contains($0.id) }
+        nextPage = response.page + 1
+        totalPages = response.totalPages
+    }
+
+    private static func message(for error: Error) -> String {
+        switch error as? APIError {
+        case .missingAPIKey: "The TMDB API key is missing."
+        case .httpStatus(_, let message?): message
+        case .httpStatus: "The server returned an error. Please try again."
+        case .transport: "Couldn't reach the server. Check your connection and try again."
+        case .invalidResponse, .decoding: "Received an unexpected response. Please try again."
+        case nil: "Something went wrong. Please try again."
+        }
+    }
+}
