+import Foundation
+import Observation
+
+/// Popular movies, loaded page by page.
+@MainActor @Observable
+final class MovieListViewModel {
+    private(set) var state: ViewState<[Movie]> = .idle
+    /// Set when a refresh or next-page load fails while movies are already shown.
+    private(set) var errorMessage: String?
+    private(set) var isLoadingPage = false
+
+    private let service: any MovieService
+    private var movies: [Movie] = []
+    private var currentPage = 0
+    private var totalPages = 1
+    /// Bumped by `refresh()` so responses from superseded requests are dropped.
+    private var generation = 0
+
+    var hasMorePages: Bool { currentPage < totalPages }
+
+    init(service: any MovieService) {
+        self.service = service
+    }
+
+    /// Loads the first page unless movies are already loaded or a load is in flight.
+    func load() async {
+        guard movies.isEmpty, !isLoadingPage else { return }
+        await fetch(page: 1)
+    }
+
+    /// Reloads from the first page. Current movies stay visible until the new page arrives.
+    func refresh() async {
+        generation += 1
+        await fetch(page: 1)
+    }
+
+    /// Loads the next page when `currentItem` is the last loaded movie.
+    func loadNextPageIfNeeded(currentItem: Movie) async {
+        guard currentItem.id == movies.last?.id, !isLoadingPage, hasMorePages else { return }
+        await fetch(page: currentPage + 1)
+    }
+
+    private func fetch(page: Int) async {
+        let requestGeneration = generation
+        isLoadingPage = true
+        errorMessage = nil
+        if movies.isEmpty { state = .loading }
+
+        do {
+            let response = try await service.popular(page: page)
+            guard requestGeneration == generation else { return }
+            if page == 1 {
+                movies = response.results
+            } else {
+                // TMDB can repeat a movie across pages; keep ids unique for the list.
+                let known = Set(movies.map(\.id))
+                movies += response.results.filter { !known.contains($0.id) }
+            }
+            currentPage = response.page
+            totalPages = response.totalPages
+            isLoadingPage = false
+            state = movies.isEmpty ? .empty : .loaded(movies)
+        } catch {
+            guard requestGeneration == generation else { return }
+            isLoadingPage = false
+            if Task.isCancelled {
+                if movies.isEmpty { state = .idle }
+                return
+            }
+            let message = APIError.userMessage(for: error)
+            if movies.isEmpty {
+                state = .failed(message)
+            } else {
+                errorMessage = message
+            }
+        }
+    }
+}
