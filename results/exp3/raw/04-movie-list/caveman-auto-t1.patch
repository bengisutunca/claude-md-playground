diff --git a/Sources/TMDBApp/Networking/APIError.swift b/Sources/TMDBApp/Networking/APIError.swift
index d7dd306..9c8d583 100644
--- a/Sources/TMDBApp/Networking/APIError.swift
+++ b/Sources/TMDBApp/Networking/APIError.swift
@@ -12,3 +12,29 @@ enum APIError: Error {
 struct TMDBErrorBody: Decodable {
     let statusMessage: String
 }
+
+extension APIError: LocalizedError {
+    static let genericMessage = "Something went wrong. Please try again."
+
+    /// User-facing message for any error a service throws.
+    static func userMessage(for error: Error) -> String {
+        (error as? APIError)?.errorDescription ?? genericMessage
+    }
+
+    var errorDescription: String? {
+        switch self {
+        case .missingAPIKey:
+            return "The TMDB API key is missing."
+        case .httpStatus(401, _):
+            return "Your TMDB API key is invalid."
+        case .httpStatus(404, _):
+            return "The requested content could not be found."
+        case .httpStatus(let code, _) where code >= 500:
+            return "TMDB is having trouble right now. Please try again later."
+        case .transport:
+            return "Couldn't connect. Check your internet connection and try again."
+        case .httpStatus, .invalidResponse, .decoding:
+            return Self.genericMessage
+        }
+    }
+}
