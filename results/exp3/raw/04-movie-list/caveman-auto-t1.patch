+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("MovieListViewModel")
+struct MovieListViewModelTests {
+    private func fixture(_ name: String) throws -> [Movie] {
+        try JSONDecoder.tmdb.decode(PagedResponse<Movie>.self, from: Fixture.data(name)).results
+    }
+
+    private func movies(in vm: MovieListViewModel) -> [Movie] {
+        if case .loaded(let movies) = vm.state { return movies }
+        return []
+    }
+
+    @Test func startsIdle() {
+        #expect(MovieListViewModel(service: MockMovieService()).state == .idle)
+    }
+
+    @Test func firstLoadShowsPageOne() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+
+        await vm.load()
+
+        #expect(vm.state == .loaded(try fixture("popular_page1")))
+        #expect(vm.hasMorePages)
+        #expect(!vm.isLoadingPage)
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func loadIsNoOpWhenAlreadyLoaded() async {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+
+        await vm.load()
+        await vm.load()
+
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func paginatesAcrossPages() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+
+        await vm.load()
+        await vm.loadNextPageIfNeeded(currentItem: movies(in: vm).last!)
+
+        #expect(vm.state == .loaded(try fixture("popular_page1") + fixture("popular_page2")))
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func nonLastItemDoesNotLoadNextPage() async {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+
+        await vm.load()
+        await vm.loadNextPageIfNeeded(currentItem: movies(in: vm).first!)
+
+        #expect(await service.calls == [.popular(page: 1)])
+    }
+
+    @Test func stopsAtTotalPages() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+
+        await vm.load()
+        await vm.loadNextPageIfNeeded(currentItem: movies(in: vm).last!)
+        #expect(!vm.hasMorePages)
+        await vm.loadNextPageIfNeeded(currentItem: movies(in: vm).last!)
+
+        #expect(movies(in: vm).count == (try fixture("popular_page1") + fixture("popular_page2")).count)
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func ignoresDuplicateCallsWhileLoading() async {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        let last = movies(in: vm).last!
+
+        async let first: Void = vm.loadNextPageIfNeeded(currentItem: last)
+        async let second: Void = vm.loadNextPageIfNeeded(currentItem: last)
+        _ = await (first, second)
+
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2)])
+    }
+
+    @Test func firstLoadErrorShowsFailedState() async {
+        let service = MockMovieService(error: APIError.httpStatus(code: 401, message: "Invalid API key"))
+        let vm = MovieListViewModel(service: service)
+
+        await vm.load()
+
+        #expect(vm.state == .failed("Your TMDB API key is invalid."))
+        #expect(!vm.isLoadingPage)
+    }
+
+    @Test func nextPageErrorKeepsMoviesAndExposesMessage() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+
+        await service.setError(APIError.transport(URLError(.notConnectedToInternet)))
+        await vm.loadNextPageIfNeeded(currentItem: movies(in: vm).last!)
+
+        #expect(vm.state == .loaded(try fixture("popular_page1")))
+        #expect(vm.errorMessage == APIError.transport(URLError(.notConnectedToInternet)).errorDescription)
+        #expect(vm.hasMorePages)
+    }
+
+    @Test func retryAfterErrorLoads() async throws {
+        let service = MockMovieService(error: APIError.invalidResponse)
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        #expect(vm.state == .failed(APIError.genericMessage))
+
+        await service.setError(nil)
+        await vm.load()
+
+        #expect(vm.state == .loaded(try fixture("popular_page1")))
+    }
+
+    @Test func refreshResetsToFirstPage() async throws {
+        let service = MockMovieService()
+        let vm = MovieListViewModel(service: service)
+        await vm.load()
+        await vm.loadNextPageIfNeeded(currentItem: movies(in: vm).last!)
+        #expect(!vm.hasMorePages)
+
+        await vm.refresh()
+
+        #expect(vm.state == .loaded(try fixture("popular_page1")))
+        #expect(vm.hasMorePages)
+
+        await vm.loadNextPageIfNeeded(currentItem: movies(in: vm).last!)
+        #expect(await service.calls == [.popular(page: 1), .popular(page: 2), .popular(page: 1), .popular(page: 2)])
+    }
+}
