@@ -0,0 +1,52 @@
+import SwiftUI
+
+/// One movie in a list: poster thumbnail, title, year and rating.
+struct MovieRowView: View {
+    let movie: Movie
+    var imageURLBuilder = ImageURLBuilder()
+
+    var body: some View {
+        HStack(spacing: 12) {
+            poster
+            VStack(alignment: .leading, spacing: 4) {
+                Text(movie.title)
+                    .font(.headline)
+                    .lineLimit(2)
+                if let year = movie.year {
+                    Text(year)
+                        .font(.subheadline)
+                        .foregroundStyle(.secondary)
+                }
+                Label(movie.ratingText, systemImage: "star.fill")
+                    .font(.subheadline)
+                    .foregroundStyle(.secondary)
+                    .labelStyle(.titleAndIcon)
+            }
+        }
+        .padding(.vertical, 4)
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel(accessibilityText)
+    }
+
+    private var poster: some View {
+        AsyncImage(url: imageURLBuilder.url(path: movie.posterPath, size: .w185)) { phase in
+            if let image = phase.image {
+                image.resizable().scaledToFill()
+            } else {
+                ZStack {
+                    Rectangle().fill(.quaternary)
+                    Image(systemName: "film")
+                        .foregroundStyle(.secondary)
+                }
+            }
+        }
+        .frame(width: 60, height: 90)
+        .clipShape(RoundedRectangle(cornerRadius: 6))
+    }
+
+    private var accessibilityText: String {
+        [movie.title, movie.year, "Rating \(movie.ratingText)"]
+            .compactMap { $0 }
+            .joined(separator: ", ")
+    }
+}
