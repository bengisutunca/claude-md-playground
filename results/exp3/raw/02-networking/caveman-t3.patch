@@ -0,0 +1,14 @@
+import Foundation
+
+enum APIError: Error {
+    case invalidResponse
+    case httpStatus(code: Int, message: String?)
+    case decoding(Error)
+    case transport(Error)
+    case missingAPIKey
+
+    /// TMDB error body: `{"status_code": 7, "status_message": "...", "success": false}`.
+    struct Body: Decodable {
+        let statusMessage: String?
+    }
+}
