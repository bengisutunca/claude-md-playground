@@ -0,0 +1,26 @@
+import Foundation
+
+struct APIConfiguration: Sendable {
+    static let keyName = "TMDB_API_KEY"
+
+    let apiKey: String
+    let baseURL: URL
+
+    init(apiKey: String, baseURL: URL = TMDBApp.apiBaseURL) {
+        self.apiKey = apiKey
+        self.baseURL = baseURL
+    }
+
+    /// Reads the key from the environment, falling back to the bundle's Info.plist.
+    static func load(
+        environment: [String: String] = ProcessInfo.processInfo.environment,
+        bundle: Bundle = .main
+    ) throws -> APIConfiguration {
+        let candidates = [environment[keyName], bundle.object(forInfoDictionaryKey: keyName) as? String]
+        for case let key? in candidates {
+            let trimmed = key.trimmingCharacters(in: .whitespacesAndNewlines)
+            if !trimmed.isEmpty { return APIConfiguration(apiKey: trimmed) }
+        }
+        throw APIError.missingAPIKey
+    }
+}
