@@ -0,0 +1,92 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("Networking", .serialized)
+struct NetworkingTests {
+    private let config = APIConfiguration(apiKey: "test-key")
+
+    private func client() -> TMDBClient {
+        TMDBClient(session: MockURLProtocol.makeSession(), configuration: config)
+    }
+
+    private func serve(_ status: Int, _ data: Data) {
+        MockURLProtocol.handler = { request in
+            let response = HTTPURLResponse(url: request.url!, statusCode: status, httpVersion: nil, headerFields: nil)!
+            return (response, data)
+        }
+    }
+
+    private func query(_ endpoint: Endpoint) throws -> (path: String, items: [String: String]) {
+        let url = try #require(try endpoint.urlRequest(configuration: config).url)
+        let comps = try #require(URLComponents(url: url, resolvingAgainstBaseURL: false))
+        let items = Dictionary(uniqueKeysWithValues: (comps.queryItems ?? []).map { ($0.name, $0.value ?? "") })
+        return (comps.path, items)
+    }
+
+    @Test func successDecodesPopular() async throws {
+        serve(200, try Fixture.data("popular_page1"))
+        let page = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+        #expect(page.results.count == 5)
+    }
+
+    @Test func unauthorizedMapsToHttpStatus() async throws {
+        serve(401, try Fixture.data("error_401"))
+        do {
+            _ = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch let APIError.httpStatus(code, message) {
+            #expect(code == 401)
+            #expect(message == "Invalid API key: You must be granted a valid key.")
+        }
+    }
+
+    @Test func malformedBodyMapsToDecoding() async throws {
+        serve(200, try Fixture.data("error_401"))
+        do {
+            _ = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch APIError.decoding {
+        }
+    }
+
+    @Test func transportFailureIsWrapped() async throws {
+        MockURLProtocol.handler = { _ in throw URLError(.notConnectedToInternet) }
+        do {
+            _ = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch APIError.transport {
+        }
+    }
+
+    @Test func popularQuery() throws {
+        let q = try query(.popular(page: 2))
+        #expect(q.path == "/3/movie/popular")
+        #expect(q.items == ["api_key": "test-key", "language": "en-US", "page": "2"])
+    }
+
+    @Test func searchQuery() throws {
+        let q = try query(.search(query: "the matrix & co", page: 3))
+        #expect(q.path == "/3/search/movie")
+        #expect(q.items == ["api_key": "test-key", "language": "en-US", "query": "the matrix & co", "page": "3"])
+    }
+
+    @Test func detailQuery() throws {
+        let q = try query(.movieDetail(id: 27205))
+        #expect(q.path == "/3/movie/27205")
+        #expect(q.items == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func creditsQuery() throws {
+        let q = try query(.credits(movieID: 27205))
+        #expect(q.path == "/3/movie/27205/credits")
+        #expect(q.items == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func configurationLoad() throws {
+        #expect(try APIConfiguration.load(environment: ["TMDB_API_KEY": "abc"]).apiKey == "abc")
+        #expect(throws: APIError.self) {
+            try APIConfiguration.load(environment: ["TMDB_API_KEY": "  "], bundle: Bundle(for: MockURLProtocol.self))
+        }
+    }
+}
