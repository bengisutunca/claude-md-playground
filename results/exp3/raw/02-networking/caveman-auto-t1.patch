+++ b/Tests/TMDBAppTests/NetworkingTests.swift
@@ -0,0 +1,157 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+private let config = APIConfiguration(apiKey: "test-key")
+
+private func queryDict(_ request: URLRequest) throws -> [String: String] {
+    let url = try #require(request.url)
+    let items = try #require(URLComponents(url: url, resolvingAgainstBaseURL: false)?.queryItems)
+    return Dictionary(uniqueKeysWithValues: items.map { ($0.name, $0.value ?? "") })
+}
+
+@Suite("Endpoint")
+struct EndpointTests {
+    @Test func popular() throws {
+        let request = try Endpoint.popular(page: 2).urlRequest(configuration: config)
+        #expect(request.url?.path == "/3/movie/popular")
+        #expect(request.url?.host == "api.themoviedb.org")
+        #expect(try queryDict(request) == ["api_key": "test-key", "language": "en-US", "page": "2"])
+    }
+
+    @Test func search() throws {
+        let request = try Endpoint.search(query: "the matrix & co", page: 1).urlRequest(configuration: config)
+        #expect(request.url?.path == "/3/search/movie")
+        #expect(try queryDict(request) == ["api_key": "test-key", "language": "en-US",
+                                           "query": "the matrix & co", "page": "1"])
+    }
+
+    @Test func movieDetail() throws {
+        let request = try Endpoint.movieDetail(id: 27205).urlRequest(configuration: config)
+        #expect(request.url?.path == "/3/movie/27205")
+        #expect(try queryDict(request) == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func credits() throws {
+        let request = try Endpoint.credits(movieID: 27205).urlRequest(configuration: config)
+        #expect(request.url?.path == "/3/movie/27205/credits")
+        #expect(try queryDict(request) == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func customBaseURL() throws {
+        let custom = APIConfiguration(apiKey: "k", baseURL: URL(string: "https://example.com/api")!)
+        let request = try Endpoint.popular(page: 1).urlRequest(configuration: custom)
+        #expect(request.url?.host == "example.com")
+        #expect(request.url?.path == "/api/movie/popular")
+    }
+
+    @Test func emptyKeyThrows() {
+        #expect {
+            try Endpoint.popular(page: 1).urlRequest(configuration: APIConfiguration(apiKey: ""))
+        } throws: { error in
+            guard case APIError.missingAPIKey = error else { return false }
+            return true
+        }
+    }
+}
+
+@Suite("APIConfiguration")
+struct APIConfigurationTests {
+    /// Writes a flat bundle whose Info.plist contains `info`.
+    private func makeBundle(_ info: [String: String]) throws -> Bundle {
+        let dir = FileManager.default.temporaryDirectory
+            .appendingPathComponent("TMDBTest-\(UUID().uuidString).bundle")
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        let plist = try PropertyListSerialization.data(fromPropertyList: info, format: .xml, options: 0)
+        try plist.write(to: dir.appendingPathComponent("Info.plist"))
+        return try #require(Bundle(url: dir))
+    }
+
+    @Test func readsEnvironment() throws {
+        let bundle = try makeBundle(["TMDB_API_KEY": "plist-key"])
+        let loaded = try APIConfiguration.load(environment: ["TMDB_API_KEY": "env-key"], bundle: bundle)
+        #expect(loaded.apiKey == "env-key")
+        #expect(loaded.baseURL == TMDBApp.apiBaseURL)
+    }
+
+    @Test func fallsBackToInfoPlist() throws {
+        let bundle = try makeBundle(["TMDB_API_KEY": "plist-key"])
+        #expect(try APIConfiguration.load(environment: ["TMDB_API_KEY": ""], bundle: bundle).apiKey == "plist-key")
+    }
+
+    @Test func missingKeyThrows() throws {
+        let bundle = try makeBundle(["TMDB_API_KEY": "  "])
+        #expect {
+            try APIConfiguration.load(environment: [:], bundle: bundle)
+        } throws: { error in
+            guard case APIError.missingAPIKey = error else { return false }
+            return true
+        }
+    }
+}
+
+@Suite("TMDBClient", .serialized)
+struct TMDBClientTests {
+    private let client = TMDBClient(session: MockURLProtocol.session(), configuration: config)
+
+    @Test func decodesSuccess() async throws {
+        MockURLProtocol.serve(fixture: "popular_page1")
+        let page = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+        #expect(page.page == 1)
+        #expect(page.results.first?.id == 27205)
+    }
+
+    @Test func sendsEndpointRequest() async throws {
+        let seen = Locked<URLRequest?>(nil)
+        MockURLProtocol.handler = { request in
+            seen.value = request
+            let response = HTTPURLResponse(url: request.url!, statusCode: 200, httpVersion: nil, headerFields: nil)!
+            return (response, try Fixture.data("movie_detail_27205"))
+        }
+        let detail = try await client.send(.movieDetail(id: 27205), as: MovieDetail.self)
+        #expect(detail.id == 27205)
+        let request = try #require(seen.value)
+        #expect(request.url?.path == "/3/movie/27205")
+        #expect(try queryDict(request)["api_key"] == "test-key")
+    }
+
+    @Test func http401ParsesStatusMessage() async {
+        MockURLProtocol.serve(fixture: "error_401", status: 401)
+        await #expect {
+            _ = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+        } throws: { error in
+            guard case let APIError.httpStatus(code, message) = error else { return false }
+            return code == 401 && message == "Invalid API key: You must be granted a valid key."
+        }
+    }
+
+    @Test func decodingFailure() async {
+        MockURLProtocol.serve(fixture: "error_401")
+        await #expect {
+            _ = try await client.send(.movieDetail(id: 27205), as: MovieDetail.self)
+        } throws: { error in
+            guard case APIError.decoding = error else { return false }
+            return true
+        }
+    }
+
+    @Test func transportFailure() async {
+        MockURLProtocol.handler = { _ in throw URLError(.notConnectedToInternet) }
+        await #expect {
+            _ = try await client.send(.credits(movieID: 27205), as: Credits.self)
+        } throws: { error in
+            guard case APIError.transport = error else { return false }
+            return true
+        }
+    }
+}
+
+private final class Locked<Value>: @unchecked Sendable {
+    private let lock = NSLock()
+    private var _value: Value
+    init(_ value: Value) { _value = value }
+    var value: Value {
+        get { lock.withLock { _value } }
+        set { lock.withLock { _value = newValue } }
+    }
+}
