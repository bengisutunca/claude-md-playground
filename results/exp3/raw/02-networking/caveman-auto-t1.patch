@@ -0,0 +1,32 @@
+import Foundation
+
+/// TMDB credentials and base URL. The key comes from the environment or Info.plist, never from source.
+struct APIConfiguration: Equatable, Sendable {
+    static let apiKeyName = "TMDB_API_KEY"
+
+    let apiKey: String
+    let baseURL: URL
+
+    init(apiKey: String, baseURL: URL = TMDBApp.apiBaseURL) {
+        self.apiKey = apiKey
+        self.baseURL = baseURL
+    }
+
+    /// Reads `TMDB_API_KEY` from `environment`, falling back to the bundle's Info.plist.
+    /// Throws `APIError.missingAPIKey` when neither has a non-empty value.
+    static func load(
+        environment: [String: String] = ProcessInfo.processInfo.environment,
+        bundle: Bundle = .main
+    ) throws -> APIConfiguration {
+        let candidates = [
+            environment[apiKeyName],
+            bundle.object(forInfoDictionaryKey: apiKeyName) as? String,
+        ]
+        for candidate in candidates {
+            if let key = candidate?.trimmingCharacters(in: .whitespacesAndNewlines), !key.isEmpty {
+                return APIConfiguration(apiKey: key)
+            }
+        }
+        throw APIError.missingAPIKey
+    }
+}
diff --git a/Sources/TMDBApp/Networking/APIError.swift b/Sources/TMDBApp/Networking/APIError.swift
new file mode 100644
index 0000000..40db384
--- /dev/null
+++ b/Sources/TMDBApp/Networking/APIError.swift
@@ -0,0 +1,15 @@
+import Foundation
+
+enum APIError: Error {
+    case invalidResponse
+    case httpStatus(code: Int, message: String?)
+    case decoding(Error)
+    case transport(Error)
+    case missingAPIKey
+}
+
+/// TMDB error payload, e.g. `{"status_code": 7, "status_message": "Invalid API key…", "success": false}`.
+struct TMDBErrorBody: Decodable, Sendable {
+    let statusCode: Int?
+    let statusMessage: String?
+}
