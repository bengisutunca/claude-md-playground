@@ -0,0 +1,87 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite(.serialized)
+struct NetworkingTests {
+    let config = APIConfiguration(apiKey: "test-key")
+
+    private func items(_ endpoint: Endpoint) throws -> (String, [String: String]) {
+        let url = try endpoint.urlRequest(configuration: config).url!
+        let comps = URLComponents(url: url, resolvingAgainstBaseURL: false)!
+        let dict = Dictionary(uniqueKeysWithValues: (comps.queryItems ?? []).map { ($0.name, $0.value ?? "") })
+        return (comps.path, dict)
+    }
+
+    @Test func popularRequest() throws {
+        let (path, q) = try items(.popular(page: 2))
+        #expect(path == "/3/movie/popular")
+        #expect(q == ["api_key": "test-key", "language": "en-US", "page": "2"])
+    }
+
+    @Test func searchRequest() throws {
+        let (path, q) = try items(.search(query: "the matrix & co", page: 1))
+        #expect(path == "/3/search/movie")
+        #expect(q == ["api_key": "test-key", "language": "en-US", "query": "the matrix & co", "page": "1"])
+    }
+
+    @Test func detailRequest() throws {
+        let (path, q) = try items(.movieDetail(id: 27205))
+        #expect(path == "/3/movie/27205")
+        #expect(q == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func creditsRequest() throws {
+        let (path, q) = try items(.credits(movieID: 27205))
+        #expect(path == "/3/movie/27205/credits")
+        #expect(q == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func successDecoding() async throws {
+        MockURLProtocol.handler = MockURLProtocol.respond(status: 200, data: try Fixture.data("popular_page1"))
+        let client = TMDBClient(session: MockURLProtocol.session(), configuration: config)
+        let page = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+        #expect(page.page == 1)
+        #expect(!page.results.isEmpty)
+    }
+
+    @Test func unauthorizedError() async throws {
+        MockURLProtocol.handler = MockURLProtocol.respond(status: 401, data: try Fixture.data("error_401"))
+        let client = TMDBClient(session: MockURLProtocol.session(), configuration: config)
+        do {
+            _ = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("Expected error")
+        } catch let APIError.httpStatus(code, message) {
+            #expect(code == 401)
+            #expect(message == "Invalid API key: You must be granted a valid key.")
+        }
+    }
+
+    @Test func decodingFailure() async throws {
+        MockURLProtocol.handler = MockURLProtocol.respond(status: 200, data: try Fixture.data("movie_credits_27205"))
+        let client = TMDBClient(session: MockURLProtocol.session(), configuration: config)
+        do {
+            _ = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("Expected error")
+        } catch APIError.decoding {
+        }
+    }
+
+    @Test func transportError() async throws {
+        MockURLProtocol.handler = { _ in throw URLError(.notConnectedToInternet) }
+        let client = TMDBClient(session: MockURLProtocol.session(), configuration: config)
+        do {
+            _ = try await client.send(.movieDetail(id: 1), as: MovieDetail.self)
+            Issue.record("Expected error")
+        } catch APIError.transport {
+        }
+    }
+
+    @Test func configurationLoading() throws {
+        let c = try APIConfiguration.load(environment: ["TMDB_API_KEY": "abc"], bundle: Bundle())
+        #expect(c.apiKey == "abc")
+        #expect(throws: APIError.self) {
+            try APIConfiguration.load(environment: ["TMDB_API_KEY": ""], bundle: Bundle())
+        }
+    }
+}
