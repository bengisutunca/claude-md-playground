@@ -0,0 +1,46 @@
+import Foundation
+
+public enum Endpoint: Equatable, Sendable {
+    case popular(page: Int)
+    case search(query: String, page: Int)
+    case movieDetail(id: Int)
+    case credits(movieID: Int)
+
+    var path: String {
+        switch self {
+        case .popular: return "/movie/popular"
+        case .search: return "/search/movie"
+        case let .movieDetail(id): return "/movie/\(id)"
+        case let .credits(movieID): return "/movie/\(movieID)/credits"
+        }
+    }
+
+    var queryItems: [URLQueryItem] {
+        switch self {
+        case let .popular(page):
+            return [URLQueryItem(name: "page", value: String(page))]
+        case let .search(query, page):
+            return [URLQueryItem(name: "query", value: query), URLQueryItem(name: "page", value: String(page))]
+        case .movieDetail, .credits:
+            return []
+        }
+    }
+
+    public func urlRequest(configuration: APIConfiguration) throws -> URLRequest {
+        guard var components = URLComponents(url: configuration.baseURL, resolvingAgainstBaseURL: false) else {
+            throw APIError.invalidResponse
+        }
+        var basePath = components.path
+        while basePath.hasSuffix("/") { basePath.removeLast() }
+        components.path = basePath + path
+        components.queryItems = [
+            URLQueryItem(name: "api_key", value: configuration.apiKey),
+            URLQueryItem(name: "language", value: "en-US"),
+        ] + queryItems
+        guard let url = components.url else { throw APIError.invalidResponse }
+        var request = URLRequest(url: url)
+        request.httpMethod = "GET"
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        return request
+    }
+}
