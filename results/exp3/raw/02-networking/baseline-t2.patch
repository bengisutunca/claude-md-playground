@@ -0,0 +1,31 @@
+import Foundation
+
+public struct APIConfiguration: Sendable {
+    public static let keyName = "TMDB_API_KEY"
+
+    public var apiKey: String
+    public var baseURL: URL
+
+    public init(apiKey: String, baseURL: URL = TMDBApp.apiBaseURL) {
+        self.apiKey = apiKey
+        self.baseURL = baseURL
+    }
+
+    /// Reads the key from the environment, falling back to the bundle's Info.plist.
+    public static func load(
+        environment: [String: String] = ProcessInfo.processInfo.environment,
+        bundle: Bundle = .main
+    ) throws -> APIConfiguration {
+        func clean(_ value: String?) -> String? {
+            guard let trimmed = value?.trimmingCharacters(in: .whitespacesAndNewlines), !trimmed.isEmpty else { return nil }
+            return trimmed
+        }
+        if let key = clean(environment[keyName]) {
+            return APIConfiguration(apiKey: key)
+        }
+        if let key = clean(bundle.object(forInfoDictionaryKey: keyName) as? String) {
+            return APIConfiguration(apiKey: key)
+        }
+        throw APIError.missingAPIKey
+    }
+}
diff --git a/Sources/TMDBApp/Networking/APIError.swift b/Sources/TMDBApp/Networking/APIError.swift
new file mode 100644
index 0000000..897bed0
--- /dev/null
+++ b/Sources/TMDBApp/Networking/APIError.swift
@@ -0,0 +1,25 @@
+import Foundation
+
+public enum APIError: Error {
+    case invalidResponse
+    case httpStatus(code: Int, message: String?)
+    case decoding(Error)
+    case transport(Error)
+    case missingAPIKey
+}
+
+extension APIError: LocalizedError {
+    public var errorDescription: String? {
+        switch self {
+        case .invalidResponse: return "The server returned an invalid response."
+        case let .httpStatus(code, message): return message ?? "Request failed with status \(code)."
+        case let .decoding(error): return "Failed to decode response: \(error.localizedDescription)"
+        case let .transport(error): return error.localizedDescription
+        case .missingAPIKey: return "TMDB API key is missing."
+        }
+    }
+}
+
+struct TMDBErrorBody: Decodable {
+    let statusMessage: String?
+}
