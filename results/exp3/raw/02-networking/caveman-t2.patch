@@ -0,0 +1,91 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("Networking", .serialized)
+struct NetworkingTests {
+    let config = APIConfiguration(apiKey: "test-key")
+
+    private func client() -> TMDBClient {
+        TMDBClient(session: MockURLProtocol.session(), configuration: config)
+    }
+
+    private func serve(_ status: Int, _ data: Data) {
+        MockURLProtocol.handler = { request in
+            (HTTPURLResponse(url: request.url!, statusCode: status, httpVersion: nil, headerFields: nil)!, data)
+        }
+    }
+
+    private func items(_ endpoint: Endpoint) throws -> (path: String, items: [String: String]) {
+        let url = try #require(try endpoint.urlRequest(configuration: config).url)
+        let components = try #require(URLComponents(url: url, resolvingAgainstBaseURL: false))
+        let dict = Dictionary(uniqueKeysWithValues: (components.queryItems ?? []).map { ($0.name, $0.value ?? "") })
+        return (components.path, dict)
+    }
+
+    @Test func successDecodes() async throws {
+        serve(200, try Fixture.data("popular_page1"))
+        let page = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+        #expect(page.page == 1)
+        #expect(page.results.first?.id == 27205)
+    }
+
+    @Test func unauthorizedParsesStatusMessage() async throws {
+        serve(401, try Fixture.data("error_401"))
+        do {
+            _ = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch let APIError.httpStatus(code, message) {
+            #expect(code == 401)
+            #expect(message == "Invalid API key: You must be granted a valid key.")
+        }
+    }
+
+    @Test func decodingFailure() async throws {
+        serve(200, try Fixture.data("movie_credits_27205"))
+        do {
+            _ = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch APIError.decoding {
+        }
+    }
+
+    @Test func transportFailure() async throws {
+        MockURLProtocol.handler = { _ in throw URLError(.notConnectedToInternet) }
+        do {
+            _ = try await client().send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch APIError.transport {
+        }
+    }
+
+    @Test func popularQuery() throws {
+        let r = try items(.popular(page: 2))
+        #expect(r.path.hasSuffix("/movie/popular"))
+        #expect(r.items == ["api_key": "test-key", "language": "en-US", "page": "2"])
+    }
+
+    @Test func searchQuery() throws {
+        let r = try items(.search(query: "dark knight & co", page: 3))
+        #expect(r.path.hasSuffix("/search/movie"))
+        #expect(r.items == ["api_key": "test-key", "language": "en-US", "page": "3", "query": "dark knight & co"])
+    }
+
+    @Test func detailQuery() throws {
+        let r = try items(.movieDetail(id: 27205))
+        #expect(r.path.hasSuffix("/movie/27205"))
+        #expect(r.items == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func creditsQuery() throws {
+        let r = try items(.credits(movieID: 27205))
+        #expect(r.path.hasSuffix("/movie/27205/credits"))
+        #expect(r.items == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func configurationLoading() throws {
+        #expect(try APIConfiguration.load(environment: ["TMDB_API_KEY": "abc"], bundle: .main).apiKey == "abc")
+        #expect(throws: APIError.self) { try APIConfiguration.load(environment: ["TMDB_API_KEY": ""], bundle: .main) }
+        #expect(throws: APIError.self) { try APIConfiguration.load(environment: [:], bundle: .main) }
+    }
+}
