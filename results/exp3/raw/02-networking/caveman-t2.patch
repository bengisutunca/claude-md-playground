+++ b/Sources/TMDBApp/Networking/APIError.swift
@@ -0,0 +1,26 @@
+import Foundation
+
+public enum APIError: Error {
+    case invalidResponse
+    case httpStatus(code: Int, message: String?)
+    case decoding(Error)
+    case transport(Error)
+    case missingAPIKey
+}
+
+extension APIError: LocalizedError {
+    public var errorDescription: String? {
+        switch self {
+        case .invalidResponse: "The server response was invalid."
+        case .httpStatus(let code, let message): message ?? "Request failed with status \(code)."
+        case .decoding: "The server response could not be read."
+        case .transport(let error): error.localizedDescription
+        case .missingAPIKey: "TMDB_API_KEY is not configured."
+        }
+    }
+}
+
+/// TMDB error body; only `status_message` is used.
+struct TMDBErrorBody: Decodable {
+    let statusMessage: String?
+}
