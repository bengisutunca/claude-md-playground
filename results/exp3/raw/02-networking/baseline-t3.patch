+import Foundation
+import Testing
+@testable import TMDBApp
+
+final class MockURLProtocol: URLProtocol, @unchecked Sendable {
+    nonisolated(unsafe) static var handler: (@Sendable (URLRequest) throws -> (HTTPURLResponse, Data))?
+    nonisolated(unsafe) static var lastRequest: URLRequest?
+
+    override class func canInit(with request: URLRequest) -> Bool { true }
+    override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+
+    override func startLoading() {
+        Self.lastRequest = request
+        guard let handler = Self.handler else {
+            client?.urlProtocol(self, didFailWithError: URLError(.badServerResponse))
+            return
+        }
+        do {
+            let (response, data) = try handler(request)
+            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: data)
+            client?.urlProtocolDidFinishLoading(self)
+        } catch {
+            client?.urlProtocol(self, didFailWithError: error)
+        }
+    }
+
+    override func stopLoading() {}
+}
+
+@Suite("Networking", .serialized)
+struct NetworkingTests {
+    let config = APIConfiguration(apiKey: "test-key")
+
+    func makeClient(status: Int = 200, fixture: String) throws -> TMDBClient {
+        let data = try Fixture.data(fixture)
+        MockURLProtocol.handler = { request in
+            (HTTPURLResponse(url: request.url!, statusCode: status, httpVersion: nil, headerFields: nil)!, data)
+        }
+        return TMDBClient(session: mockSession(), configuration: config)
+    }
+
+    func mockSession() -> URLSession {
+        let cfg = URLSessionConfiguration.ephemeral
+        cfg.protocolClasses = [MockURLProtocol.self]
+        return URLSession(configuration: cfg)
+    }
+
+    func items(_ endpoint: Endpoint) throws -> [String: String] {
+        let request = try endpoint.urlRequest(configuration: config)
+        let comps = URLComponents(url: request.url!, resolvingAgainstBaseURL: false)!
+        return Dictionary(uniqueKeysWithValues: (comps.queryItems ?? []).map { ($0.name, $0.value ?? "") })
+    }
+
+    @Test func successDecodesPopular() async throws {
+        let client = try makeClient(fixture: "popular_page1")
+        let response = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+        #expect(response.page == 1)
+        #expect(!response.results.isEmpty)
+        #expect(MockURLProtocol.lastRequest?.url?.path.hasSuffix("/movie/popular") == true)
+    }
+
+    @Test func unauthorizedMapsToHTTPStatus() async throws {
+        let client = try makeClient(status: 401, fixture: "error_401")
+        do {
+            _ = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("Expected error")
+        } catch let APIError.httpStatus(code, message) {
+            #expect(code == 401)
+            #expect(message == "Invalid API key: You must be granted a valid key.")
+        }
+    }
+
+    @Test func decodingFailure() async throws {
+        let client = try makeClient(fixture: "error_401")
+        do {
+            _ = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("Expected error")
+        } catch APIError.decoding {
+        }
+    }
+
+    @Test func transportFailure() async throws {
+        MockURLProtocol.handler = { _ in throw URLError(.notConnectedToInternet) }
+        let client = TMDBClient(session: mockSession(), configuration: config)
+        do {
+            _ = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("Expected error")
+        } catch APIError.transport {
+        }
+    }
+
+    @Test func queryItemsPerEndpoint() throws {
+        #expect(try items(.popular(page: 2)) == ["api_key": "test-key", "language": "en-US", "page": "2"])
+        #expect(try items(.search(query: "dark knight", page: 3))
+                == ["api_key": "test-key", "language": "en-US", "query": "dark knight", "page": "3"])
+        #expect(try items(.movieDetail(id: 27205)) == ["api_key": "test-key", "language": "en-US"])
+        #expect(try items(.credits(movieID: 27205)) == ["api_key": "test-key", "language": "en-US"])
+    }
+
+    @Test func paths() throws {
+        func path(_ e: Endpoint) throws -> String { try e.urlRequest(configuration: config).url!.path }
+        #expect(try path(.popular(page: 1)) == "/3/movie/popular")
+        #expect(try path(.search(query: "x", page: 1)) == "/3/search/movie")
+        #expect(try path(.movieDetail(id: 5)) == "/3/movie/5")
+        #expect(try path(.credits(movieID: 5)) == "/3/movie/5/credits")
+    }
+
+    @Test func configurationLoading() throws {
+        #expect(try APIConfiguration.load(environment: ["TMDB_API_KEY": "abc"]).apiKey == "abc")
+        #expect(throws: APIError.self) {
+            try APIConfiguration.load(environment: ["TMDB_API_KEY": ""], bundle: Bundle(for: MockURLProtocol.self))
+        }
+    }
+}
