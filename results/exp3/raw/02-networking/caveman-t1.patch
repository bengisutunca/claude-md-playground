@@ -0,0 +1,28 @@
+import Foundation
+
+/// Credentials and base URL for the TMDB API. The key is never hard-coded.
+struct APIConfiguration: Sendable {
+    static let apiKeyName = "TMDB_API_KEY"
+
+    let apiKey: String
+    let baseURL: URL
+
+    init(apiKey: String, baseURL: URL = TMDBApp.apiBaseURL) {
+        self.apiKey = apiKey
+        self.baseURL = baseURL
+    }
+
+    /// Reads `TMDB_API_KEY` from the environment, falling back to the bundle's Info.plist.
+    static func load(
+        environment: [String: String] = ProcessInfo.processInfo.environment,
+        bundle: Bundle = .main
+    ) throws -> APIConfiguration {
+        let candidates = [environment[apiKeyName], bundle.object(forInfoDictionaryKey: apiKeyName) as? String]
+        for candidate in candidates {
+            if let key = candidate?.trimmingCharacters(in: .whitespacesAndNewlines), !key.isEmpty {
+                return APIConfiguration(apiKey: key)
+            }
+        }
+        throw APIError.missingAPIKey
+    }
+}
diff --git a/Sources/TMDBApp/Networking/APIError.swift b/Sources/TMDBApp/Networking/APIError.swift
