@@ -0,0 +1,44 @@
+import Foundation
+
+enum Endpoint: Equatable, Sendable {
+    case popular(page: Int)
+    case search(query: String, page: Int)
+    case movieDetail(id: Int)
+    case credits(movieID: Int)
+
+    var path: String {
+        switch self {
+        case .popular: "/movie/popular"
+        case .search: "/search/movie"
+        case .movieDetail(let id): "/movie/\(id)"
+        case .credits(let id): "/movie/\(id)/credits"
+        }
+    }
+
+    private var queryItems: [URLQueryItem] {
+        switch self {
+        case .popular(let page):
+            [URLQueryItem(name: "page", value: String(page))]
+        case .search(let query, let page):
+            [URLQueryItem(name: "query", value: query), URLQueryItem(name: "page", value: String(page))]
+        case .movieDetail, .credits:
+            []
+        }
+    }
+
+    func urlRequest(configuration: APIConfiguration) throws -> URLRequest {
+        guard var components = URLComponents(url: configuration.baseURL, resolvingAgainstBaseURL: false) else {
+            throw APIError.invalidResponse
+        }
+        components.path += path
+        components.queryItems = [
+            URLQueryItem(name: "api_key", value: configuration.apiKey),
+            URLQueryItem(name: "language", value: "en-US"),
+        ] + queryItems
+        guard let url = components.url else { throw APIError.invalidResponse }
+        var request = URLRequest(url: url)
+        request.httpMethod = "GET"
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        return request
+    }
+}
diff --git a/Sources/TMDBApp/Networking/HTTPClient.swift b/Sources/TMDBApp/Networking/HTTPClient.swift
new file mode 100644
index 0000000..60e6d7a
--- /dev/null
+++ b/Sources/TMDBApp/Networking/HTTPClient.swift
@@ -0,0 +1,41 @@
+import Foundation
+
+protocol HTTPClient: Sendable {
+    func send<T: Decodable>(_ endpoint: Endpoint, as type: T.Type) async throws -> T
+}
+
+struct TMDBClient: HTTPClient {
+    private let session: URLSession
+    private let configuration: APIConfiguration?
+
+    /// With a nil `configuration`, `APIConfiguration.load()` runs on each request.
+    init(session: URLSession = .shared, configuration: APIConfiguration? = nil) {
+        self.session = session
+        self.configuration = configuration
+    }
+
+    func send<T: Decodable>(_ endpoint: Endpoint, as type: T.Type) async throws -> T {
+        let config = try configuration ?? APIConfiguration.load()
+        let request = try endpoint.urlRequest(configuration: config)
+
+        let data: Data
+        let response: URLResponse
+        do {
+            (data, response) = try await session.data(for: request)
+        } catch {
+            throw APIError.transport(error)
+        }
+
+        guard let http = response as? HTTPURLResponse else { throw APIError.invalidResponse }
+        guard (200..<300).contains(http.statusCode) else {
+            let message = try? JSONDecoder.tmdb.decode(TMDBErrorBody.self, from: data).statusMessage
+            throw APIError.httpStatus(code: http.statusCode, message: message)
+        }
+
+        do {
+            return try JSONDecoder.tmdb.decode(type, from: data)
+        } catch {
+            throw APIError.decoding(error)
+        }
+    }
+}
