@@ -0,0 +1,105 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+/// Serves canned responses; never touches the network.
+final class MockURLProtocol: URLProtocol, @unchecked Sendable {
+    nonisolated(unsafe) static var handler: ((URLRequest) throws -> (Int, Data))?
+
+    override class func canInit(with request: URLRequest) -> Bool { true }
+    override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+
+    override func startLoading() {
+        guard let handler = Self.handler else {
+            client?.urlProtocol(self, didFailWithError: URLError(.unsupportedURL))
+            return
+        }
+        do {
+            let (status, data) = try handler(request)
+            let response = HTTPURLResponse(url: request.url!, statusCode: status, httpVersion: nil, headerFields: nil)!
+            client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+            client?.urlProtocol(self, didLoad: data)
+            client?.urlProtocolDidFinishLoading(self)
+        } catch {
+            client?.urlProtocol(self, didFailWithError: error)
+        }
+    }
+
+    override func stopLoading() {}
+}
+
+@Suite("Networking", .serialized)
+struct NetworkingTests {
+    let config = APIConfiguration(apiKey: "test-key")
+
+    private func makeClient(handler: @escaping (URLRequest) throws -> (Int, Data)) -> TMDBClient {
+        MockURLProtocol.handler = handler
+        let sessionConfig = URLSessionConfiguration.ephemeral
+        sessionConfig.protocolClasses = [MockURLProtocol.self]
+        return TMDBClient(session: URLSession(configuration: sessionConfig), configuration: config)
+    }
+
+    private func makeClient(status: Int = 200, fixture: String) throws -> TMDBClient {
+        let data = try Fixture.data(fixture)
+        return makeClient { _ in (status, data) }
+    }
+
+    @Test func successDecodes() async throws {
+        let page = try await makeClient(fixture: "popular_page1")
+            .send(.popular(page: 1), as: PagedResponse<Movie>.self)
+        #expect(page.results.count == 5)
+    }
+
+    @Test func unauthorizedMapsToHTTPStatus() async throws {
+        let client = try makeClient(status: 401, fixture: "error_401")
+        do {
+            _ = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch let APIError.httpStatus(code, message) {
+            #expect(code == 401)
+            #expect(message == "Invalid API key: You must be granted a valid key.")
+        }
+    }
+
+    @Test func wrongShapeThrowsDecoding() async throws {
+        let client = try makeClient(fixture: "error_401")
+        do {
+            _ = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch APIError.decoding {
+        }
+    }
+
+    @Test func transportErrorIsWrapped() async throws {
+        let client = makeClient { _ in throw URLError(.notConnectedToInternet) }
+        do {
+            _ = try await client.send(.popular(page: 1), as: PagedResponse<Movie>.self)
+            Issue.record("expected error")
+        } catch APIError.transport {
+        }
+    }
+
+    @Test(arguments: [
+        (Endpoint.popular(page: 2), "/3/movie/popular", ["page": "2"]),
+        (Endpoint.search(query: "the matrix & co", page: 3), "/3/search/movie", ["query": "the matrix & co", "page": "3"]),
+        (Endpoint.movieDetail(id: 27205), "/3/movie/27205", [:]),
+        (Endpoint.credits(movieID: 27205), "/3/movie/27205/credits", [:]),
+    ])
+    func queryItems(endpoint: Endpoint, path: String, extra: [String: String]) throws {
+        let request = try endpoint.urlRequest(configuration: config)
+        let url = try #require(request.url)
+        #expect(url.path == path)
+        let items = URLComponents(url: url, resolvingAgainstBaseURL: false)?.queryItems ?? []
+        var expected = ["api_key": "test-key", "language": "en-US"]
+        expected.merge(extra) { _, new in new }
+        #expect(Dictionary(uniqueKeysWithValues: items.map { ($0.name, $0.value ?? "") }) == expected)
+    }
+
+    @Test func configurationLoading() throws {
+        let emptyBundle = Bundle(for: MockURLProtocol.self)
+        #expect(try APIConfiguration.load(environment: ["TMDB_API_KEY": "abc"], bundle: emptyBundle).apiKey == "abc")
+        #expect(throws: APIError.self) {
+            try APIConfiguration.load(environment: ["TMDB_API_KEY": ""], bundle: emptyBundle)
+        }
+    }
+}
