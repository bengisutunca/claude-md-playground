+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("SearchViewModel")
+struct SearchViewModelTests {
+    private func makeVM(_ service: MockMovieService) -> SearchViewModel {
+        SearchViewModel(service: service, sleep: { _ in })
+    }
+
+    @Test func shortQueryDoesNotCallService() async {
+        let service = MockMovieService()
+        let vm = makeVM(service)
+        vm.query = "i"
+        await vm.waitForSearch()
+        vm.query = "  a "
+        await vm.waitForSearch()
+        #expect(vm.state == .idle)
+        #expect(await service.calls.isEmpty)
+    }
+
+    @Test func rapidTypingTriggersOneSearch() async {
+        let service = MockMovieService()
+        let vm = makeVM(service)
+        for q in ["in", "inc", "ince", "incep", "inception"] { vm.query = q }
+        await vm.waitForSearch()
+        #expect(await service.calls == [.search(query: "inception", page: 1)])
+    }
+
+    @Test func clearingQueryCancelsPendingSearch() async {
+        let service = MockMovieService()
+        let vm = makeVM(service)
+        vm.query = "inception"
+        vm.query = ""
+        await vm.waitForSearch()
+        #expect(vm.state == .idle)
+        #expect(await service.calls.isEmpty)
+    }
+
+    @Test func debounceDelayIsPassedToSleep() async {
+        let service = MockMovieService()
+        let recorded = DurationRecorder()
+        let vm = SearchViewModel(service: service, debounce: .milliseconds(123),
+                                 sleep: { recorded.record($0) })
+        vm.query = "inception"
+        await vm.waitForSearch()
+        #expect(recorded.values == [.milliseconds(123)])
+    }
+
+    @Test func searchInception() async {
+        let service = MockMovieService()
+        let vm = makeVM(service)
+        vm.query = "inception"
+        await vm.waitForSearch()
+        guard case .loaded(let movies) = vm.state else { Issue.record("expected loaded"); return }
+        #expect(movies.contains { $0.id == 27205 })
+    }
+
+    @Test func emptyResultIsEmptyState() async {
+        let service = MockMovieService()
+        let vm = makeVM(service)
+        vm.query = "empty"
+        await vm.waitForSearch()
+        #expect(vm.state == .empty)
+    }
+
+    @Test func errorState() async {
+        let service = MockMovieService(error: APIError.transport(URLError(.notConnectedToInternet)))
+        let vm = makeVM(service)
+        vm.query = "inception"
+        await vm.waitForSearch()
+        #expect(vm.state == .failed("Couldn't reach the server. Check your connection."))
+    }
+}
+
+private final class DurationRecorder: @unchecked Sendable {
+    private let lock = NSLock()
+    private var storage: [Duration] = []
+    var values: [Duration] {
+        lock.lock()
+        defer { lock.unlock() }
+        return storage
+    }
+    func record(_ d: Duration) {
+        lock.lock()
+        storage.append(d)
+        lock.unlock()
+    }
+}
