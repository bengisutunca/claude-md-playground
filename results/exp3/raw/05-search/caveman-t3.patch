@@ -0,0 +1,85 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+@MainActor
+@Suite("SearchViewModel")
+struct SearchViewModelTests {
+    private struct Offline: Error {}
+
+    private func makeVM(_ service: MockMovieService) -> SearchViewModel {
+        SearchViewModel(service: service, sleep: { _ in })
+    }
+
+    @Test func shortQueryDoesNotCallService() async {
+        let service = MockMovieService()
+        let vm = makeVM(service)
+        vm.query = "a"
+        await vm.waitForSearch()
+        vm.query = "  b "
+        await vm.waitForSearch()
+        #expect(vm.state == .idle)
+        #expect(await service.calls.isEmpty)
+    }
+
+    @Test func rapidTypingTriggersOneSearch() async {
+        let service = MockMovieService()
+        // Sleepers block until the gate opens, so earlier searches are superseded mid-debounce.
+        let gate = Gate()
+        let vm = SearchViewModel(service: service, sleep: { _ in try await gate.wait() })
+        for q in ["in", "inc", "ince", "inception"] {
+            vm.query = q
+            await Task.yield()
+        }
+        await gate.open()
+        await vm.waitForSearch()
+        #expect(await service.calls == [.search(query: "inception", page: 1)])
+    }
+
+    @Test func searchInceptionLoadsResults() async {
+        let service = MockMovieService()
+        let vm = makeVM(service)
+        vm.query = "inception"
+        await vm.waitForSearch()
+        guard case .loaded(let movies) = vm.state else {
+            Issue.record("expected loaded, got \(vm.state)")
+            return
+        }
+        #expect(movies.first?.id == 27205)
+    }
+
+    @Test func emptyResultIsEmptyState() async {
+        let service = MockMovieService()
+        let vm = makeVM(service)
+        vm.query = "empty"
+        await vm.waitForSearch()
+        #expect(vm.state == .empty)
+    }
+
+    @Test func serviceErrorIsFailedState() async {
+        let service = MockMovieService(error: APIError.transport(Offline()))
+        let vm = makeVM(service)
+        vm.query = "inception"
+        await vm.waitForSearch()
+        #expect(vm.state == .failed("Couldn't reach the server. Check your connection."))
+    }
+}
+
+/// Holds sleepers until opened; a cancelled sleeper throws once released.
+private actor Gate {
+    private var isOpen = false
+    private var waiters: [CheckedContinuation<Void, Never>] = []
+
+    func wait() async throws {
+        if !isOpen {
+            await withCheckedContinuation { waiters.append($0) }
+        }
+        try Task.checkCancellation()
+    }
+
+    func open() {
+        isOpen = true
+        waiters.forEach { $0.resume() }
+        waiters = []
+    }
+}
