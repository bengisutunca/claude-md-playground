+import Foundation
+@testable import TMDBApp
+
+/// Reusable `MovieService` for view-model tests: returns fixture data, or `error` if set. Records calls.
+final class MockMovieService: MovieService, @unchecked Sendable {
+    enum Call: Equatable {
+        case popular(page: Int)
+        case search(query: String, page: Int)
+        case detail(id: Int)
+        case credits(id: Int)
+    }
+
+    private let lock = NSLock()
+    private var _calls: [Call] = []
+    private var _error: Error?
+
+    var calls: [Call] { lock.withLock { _calls } }
+    var error: Error? {
+        get { lock.withLock { _error } }
+        set { lock.withLock { _error = newValue } }
+    }
+
+    init(error: Error? = nil) { _error = error }
+
+    private func record<T: Decodable>(_ call: Call, fixture: String, as type: T.Type) throws -> T {
+        lock.withLock { _calls.append(call) }
+        if let error { throw error }
+        return try JSONDecoder.tmdb.decode(T.self, from: Fixture.data(fixture))
+    }
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        try record(.popular(page: page), fixture: page == 2 ? "popular_page2" : "popular_page1", as: PagedResponse<Movie>.self)
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        try record(.search(query: query, page: page), fixture: "search_inception", as: PagedResponse<Movie>.self)
+    }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        try record(.detail(id: id), fixture: "movie_detail_27205", as: MovieDetail.self)
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        try record(.credits(id: id), fixture: "movie_credits_27205", as: Credits.self)
+    }
+}
