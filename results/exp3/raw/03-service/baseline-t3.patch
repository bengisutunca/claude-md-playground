@@ -0,0 +1,50 @@
+import Foundation
+@testable import TMDBApp
+
+/// Reusable `MovieService` for view-model tests. Returns fixture data (or a configured error) and records calls.
+final class MockMovieService: MovieService, @unchecked Sendable {
+    enum Call: Equatable {
+        case popular(page: Int)
+        case search(query: String, page: Int)
+        case detail(id: Int)
+        case credits(id: Int)
+    }
+
+    private let lock = NSLock()
+    private var _calls: [Call] = []
+    private var _error: Error?
+
+    var calls: [Call] { lock.withLock { _calls } }
+
+    /// When set, every method throws this error.
+    var error: Error? {
+        get { lock.withLock { _error } }
+        set { lock.withLock { _error = newValue } }
+    }
+
+    var popularFixture = "popular_page1"
+    var searchFixture = "search_inception"
+    var detailFixture = "movie_detail_27205"
+    var creditsFixture = "movie_credits_27205"
+
+    init(error: Error? = nil) { _error = error }
+
+    private func record<T: Decodable>(_ call: Call, fixture: String, as type: T.Type) throws -> T {
+        let err: Error? = lock.withLock { _calls.append(call); return _error }
+        if let err { throw err }
+        return try JSONDecoder.tmdb.decode(T.self, from: Fixture.data(fixture))
+    }
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        try record(.popular(page: page), fixture: popularFixture, as: PagedResponse<Movie>.self)
+    }
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        try record(.search(query: query, page: page), fixture: searchFixture, as: PagedResponse<Movie>.self)
+    }
+    func detail(id: Int) async throws -> MovieDetail {
+        try record(.detail(id: id), fixture: detailFixture, as: MovieDetail.self)
+    }
+    func credits(id: Int) async throws -> Credits {
+        try record(.credits(id: id), fixture: creditsFixture, as: Credits.self)
+    }
+}
