@@ -0,0 +1,81 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+/// `HTTPClient` that serves fixtures by endpoint and records requested endpoints. Never touches the network.
+private final class MockHTTPClient: HTTPClient, @unchecked Sendable {
+    private let lock = NSLock()
+    private var _endpoints: [Endpoint] = []
+    var error: Error?
+
+    var endpoints: [Endpoint] { lock.withLock { _endpoints } }
+
+    func send<T: Decodable>(_ endpoint: Endpoint, as type: T.Type) async throws -> T {
+        lock.withLock { _endpoints.append(endpoint) }
+        if let error { throw error }
+        let name: String
+        switch endpoint {
+        case .popular(let page): name = page == 2 ? "popular_page2" : "popular_page1"
+        case .search: name = "search_inception"
+        case .movieDetail: name = "movie_detail_27205"
+        case .credits: name = "movie_credits_27205"
+        }
+        return try JSONDecoder.tmdb.decode(T.self, from: Fixture.data(name))
+    }
+}
+
+@Suite("TMDBMovieService")
+struct MovieServiceTests {
+    @Test func popularUsesEndpointAndDecodes() async throws {
+        let client = MockHTTPClient()
+        let page = try await TMDBMovieService(client: client).popular(page: 2)
+        #expect(client.endpoints == [.popular(page: 2)])
+        #expect(page.page == 2)
+        #expect(!page.results.isEmpty)
+    }
+
+    @Test func searchUsesEndpointAndDecodes() async throws {
+        let client = MockHTTPClient()
+        let page = try await TMDBMovieService(client: client).search(query: "inception", page: 1)
+        #expect(client.endpoints == [.search(query: "inception", page: 1)])
+        #expect(!page.results.isEmpty)
+    }
+
+    @Test func detailUsesEndpointAndDecodes() async throws {
+        let client = MockHTTPClient()
+        let detail = try await TMDBMovieService(client: client).detail(id: 27205)
+        #expect(client.endpoints == [.movieDetail(id: 27205)])
+        #expect(detail.id == 27205)
+    }
+
+    @Test func creditsUsesEndpointAndDecodes() async throws {
+        let client = MockHTTPClient()
+        let credits = try await TMDBMovieService(client: client).credits(id: 27205)
+        #expect(client.endpoints == [.credits(movieID: 27205)])
+        #expect(credits.id == 27205)
+        #expect(!credits.cast.isEmpty)
+    }
+
+    @Test func propagatesClientErrors() async {
+        let client = MockHTTPClient()
+        client.error = APIError.httpStatus(code: 401, message: "nope")
+        do {
+            _ = try await TMDBMovieService(client: client).popular(page: 1)
+            Issue.record("expected error")
+        } catch APIError.httpStatus(let code, _) {
+            #expect(code == 401)
+        } catch {
+            Issue.record("unexpected error \(error)")
+        }
+    }
+
+    @Test func mockServiceRecordsCallsAndErrors() async throws {
+        let mock = MockMovieService()
+        _ = try await mock.popular(page: 3)
+        _ = try await mock.search(query: "x", page: 1)
+        #expect(mock.calls == [.popular(page: 3), .search(query: "x", page: 1)])
+        mock.error = APIError.invalidResponse
+        await #expect(throws: APIError.self) { _ = try await mock.detail(id: 1) }
+        #expect(mock.calls.last == .detail(id: 1))
+    }
+}
