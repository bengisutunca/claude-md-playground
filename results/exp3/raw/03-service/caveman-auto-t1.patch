@@ -0,0 +1,30 @@
+import Foundation
+@testable import TMDBApp
+
+/// `HTTPClient` that decodes a fixture (or throws a configured error) and records endpoints.
+final class MockHTTPClient: HTTPClient, @unchecked Sendable {
+    enum Response {
+        case fixture(String)
+        case failure(Error)
+    }
+
+    private let lock = NSLock()
+    private let response: Response
+    private var _endpoints: [Endpoint] = []
+
+    init(_ response: Response) {
+        self.response = response
+    }
+
+    var endpoints: [Endpoint] { lock.withLock { _endpoints } }
+
+    func send<T: Decodable>(_ endpoint: Endpoint, as type: T.Type) async throws -> T {
+        lock.withLock { _endpoints.append(endpoint) }
+        switch response {
+        case .fixture(let name):
+            return try JSONDecoder.tmdb.decode(T.self, from: Fixture.data(name))
+        case .failure(let error):
+            throw error
+        }
+    }
+}
