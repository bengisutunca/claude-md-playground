+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("TMDBMovieService")
+struct TMDBMovieServiceTests {
+    @Test func popularUsesPopularEndpoint() async throws {
+        let client = MockHTTPClient(.fixture("popular_page2"))
+        let page = try await TMDBMovieService(client: client).popular(page: 2)
+        #expect(client.endpoints == [.popular(page: 2)])
+        #expect(page.page == 2)
+        #expect(page.results.count == 2)
+    }
+
+    @Test func searchUsesSearchEndpoint() async throws {
+        let client = MockHTTPClient(.fixture("search_inception"))
+        let page = try await TMDBMovieService(client: client).search(query: "Inception", page: 1)
+        #expect(client.endpoints == [.search(query: "Inception", page: 1)])
+        #expect(page.results.first?.id == 27205)
+    }
+
+    @Test func detailUsesDetailEndpoint() async throws {
+        let client = MockHTTPClient(.fixture("movie_detail_27205"))
+        let detail = try await TMDBMovieService(client: client).detail(id: 27205)
+        #expect(client.endpoints == [.movieDetail(id: 27205)])
+        #expect(detail.id == 27205)
+        #expect(detail.title == "Inception")
+    }
+
+    @Test func creditsUsesCreditsEndpoint() async throws {
+        let client = MockHTTPClient(.fixture("movie_credits_27205"))
+        let credits = try await TMDBMovieService(client: client).credits(id: 27205)
+        #expect(client.endpoints == [.credits(movieID: 27205)])
+        #expect(credits.id == 27205)
+        #expect(!credits.cast.isEmpty)
+    }
+
+    @Test func propagatesClientErrors() async throws {
+        let client = MockHTTPClient(.failure(APIError.httpStatus(code: 401, message: "nope")))
+        let service = TMDBMovieService(client: client)
+        do {
+            _ = try await service.popular(page: 1)
+            Issue.record("expected error")
+        } catch APIError.httpStatus(let code, let message) {
+            #expect(code == 401)
+            #expect(message == "nope")
+        }
+    }
+}
+
+@Suite("ImageURLBuilder")
+struct ImageURLBuilderTests {
+    let builder = ImageURLBuilder()
+
+    @Test func buildsURLUnderImageBase() {
+        #expect(builder.url(path: "/inception.jpg", size: .w342)?.absoluteString
+                == "https://image.tmdb.org/t/p/w342/inception.jpg")
+    }
+
+    @Test(arguments: [
+        (ImageURLBuilder.Size.w185, "w185"),
+        (.w342, "w342"),
+        (.w780, "w780"),
+        (.original, "original")
+    ])
+    func eachSize(size: ImageURLBuilder.Size, segment: String) {
+        #expect(builder.url(path: "/a.jpg", size: size)?.absoluteString
+                == "https://image.tmdb.org/t/p/\(segment)/a.jpg")
+    }
+
+    @Test func pathWithoutLeadingSlash() {
+        #expect(builder.url(path: "a.jpg", size: .w185)?.absoluteString
+                == "https://image.tmdb.org/t/p/w185/a.jpg")
+    }
+
+    @Test func nilOrEmptyPathGivesNil() {
+        #expect(builder.url(path: nil, size: .w342) == nil)
+        #expect(builder.url(path: "", size: .original) == nil)
+    }
+
+    @Test func customBaseURL() {
+        let custom = ImageURLBuilder(baseURL: URL(string: "https://cdn.example.test/img")!)
+        #expect(custom.url(path: "/x.png", size: .w780)?.absoluteString
+                == "https://cdn.example.test/img/w780/x.png")
+    }
+}
+
+@Suite("MockMovieService")
+struct MockMovieServiceTests {
+    @Test func servesFixturesAndRecordsCalls() async throws {
+        let mock = MockMovieService()
+        #expect(try await mock.popular(page: 2).page == 2)
+        #expect(try await mock.search(query: "inception", page: 1).results.first?.id == 27205)
+        #expect(try await mock.search(query: "zzz", page: 1).results.isEmpty)
+        #expect(try await mock.detail(id: 27205).id == 27205)
+        #expect(try await mock.credits(id: 27205).id == 27205)
+        #expect(mock.calls == [
+            .popular(page: 2),
+            .search(query: "inception", page: 1),
+            .search(query: "zzz", page: 1),
+            .detail(id: 27205),
+            .credits(id: 27205)
+        ])
+    }
+
+    @Test func throwsConfiguredError() async throws {
+        let mock = MockMovieService(error: URLError(.notConnectedToInternet))
+        await #expect(throws: URLError.self) { try await mock.detail(id: 1) }
+        #expect(mock.calls == [.detail(id: 1)])
+    }
+}
