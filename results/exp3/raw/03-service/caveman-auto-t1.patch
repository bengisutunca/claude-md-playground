+import Foundation
+@testable import TMDBApp
+
+/// `MovieService` that serves bundled fixtures (or a configured error) and records every call.
+///
+/// Fixtures: `popular(page:)` → `popular_page<N>`; `search` → `search_inception` when the
+/// query contains "inception", otherwise `search_empty`; `detail` → `movie_detail_27205`;
+/// `credits` → `movie_credits_27205`.
+final class MockMovieService: MovieService, @unchecked Sendable {
+    enum Call: Equatable, Sendable {
+        case popular(page: Int)
+        case search(query: String, page: Int)
+        case detail(id: Int)
+        case credits(id: Int)
+    }
+
+    private let lock = NSLock()
+    private var _calls: [Call] = []
+    private var _error: Error?
+
+    init(error: Error? = nil) {
+        _error = error
+    }
+
+    /// Calls received so far, in order.
+    var calls: [Call] { lock.withLock { _calls } }
+
+    /// When set, every method records its call and then throws this error.
+    var error: Error? {
+        get { lock.withLock { _error } }
+        set { lock.withLock { _error = newValue } }
+    }
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        try respond(.popular(page: page), fixture: "popular_page\(page)")
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        let fixture = query.localizedCaseInsensitiveContains("inception") ? "search_inception" : "search_empty"
+        return try respond(.search(query: query, page: page), fixture: fixture)
+    }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        try respond(.detail(id: id), fixture: "movie_detail_27205")
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        try respond(.credits(id: id), fixture: "movie_credits_27205")
+    }
+
+    private func respond<T: Decodable>(_ call: Call, fixture: String) throws -> T {
+        let error = lock.withLock { () -> Error? in
+            _calls.append(call)
+            return _error
+        }
+        if let error { throw error }
+        return try JSONDecoder.tmdb.decode(T.self, from: Fixture.data(fixture))
+    }
+}
