+import Foundation
+import Testing
+@testable import TMDBApp
+
+@Suite("ImageURLBuilder")
+struct ImageURLBuilderTests {
+    let builder = ImageURLBuilder()
+
+    @Test(arguments: ImageURLBuilder.Size.allCases)
+    func buildsURLForEverySize(size: ImageURLBuilder.Size) {
+        #expect(builder.url(path: "/inception.jpg", size: size)?.absoluteString
+            == "https://image.tmdb.org/t/p/\(size.rawValue)/inception.jpg")
+    }
+
+    @Test func exampleFromSpec() {
+        #expect(builder.url(path: "/inception.jpg", size: .w342)?.absoluteString
+            == "https://image.tmdb.org/t/p/w342/inception.jpg")
+    }
+
+    @Test func nilOrEmptyPathGivesNil() {
+        #expect(builder.url(path: nil, size: .w342) == nil)
+        #expect(builder.url(path: "", size: .w342) == nil)
+    }
+
+    @Test func pathWithoutLeadingSlash() {
+        #expect(builder.url(path: "inception.jpg", size: .w342)?.absoluteString
+            == "https://image.tmdb.org/t/p/w342/inception.jpg")
+    }
+
+    @Test func customBaseURL() {
+        let custom = ImageURLBuilder(baseURL: URL(string: "https://cdn.test/img")!)
+        #expect(custom.url(path: "/a.jpg", size: .original)?.absoluteString == "https://cdn.test/img/original/a.jpg")
+    }
+}
