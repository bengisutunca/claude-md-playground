+import Foundation
+@testable import TMDBApp
+
+/// Reusable `MovieService` test double: returns fixture data (or a configured error) and records calls.
+final class MockMovieService: MovieService, @unchecked Sendable {
+    enum Call: Equatable {
+        case popular(page: Int)
+        case search(query: String, page: Int)
+        case detail(id: Int)
+        case credits(id: Int)
+    }
+
+    private let lock = NSLock()
+    private var _calls: [Call] = []
+
+    var error: Error?
+    var popularFixture = "popular_page1"
+    var searchFixture = "search_inception"
+    var detailFixture = "movie_detail_27205"
+    var creditsFixture = "movie_credits_27205"
+
+    var calls: [Call] { lock.withLock { _calls } }
+
+    init(error: Error? = nil) { self.error = error }
+
+    private func record(_ call: Call) { lock.withLock { _calls.append(call) } }
+
+    private func load<T: Decodable>(_ name: String, _ type: T.Type) throws -> T {
+        if let error { throw error }
+        return try JSONDecoder.tmdb.decode(T.self, from: Fixture.data(name))
+    }
+
+    func popular(page: Int) async throws -> PagedResponse<Movie> {
+        record(.popular(page: page))
+        return try load(popularFixture, PagedResponse<Movie>.self)
+    }
+
+    func search(query: String, page: Int) async throws -> PagedResponse<Movie> {
+        record(.search(query: query, page: page))
+        return try load(searchFixture, PagedResponse<Movie>.self)
+    }
+
+    func detail(id: Int) async throws -> MovieDetail {
+        record(.detail(id: id))
+        return try load(detailFixture, MovieDetail.self)
+    }
+
+    func credits(id: Int) async throws -> Credits {
+        record(.credits(id: id))
+        return try load(creditsFixture, Credits.self)
+    }
+}
