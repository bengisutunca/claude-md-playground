+import Foundation
+
+struct ImageURLBuilder: Sendable {
+    enum Size: String, CaseIterable, Sendable {
+        case w185, w342, w780, original
+    }
+
+    let baseURL: URL
+
+    init(baseURL: URL = TMDBApp.imageBaseURL) {
+        self.baseURL = baseURL
+    }
+
+    /// Returns `<baseURL>/<size>/<path>`, or nil when `path` is nil or empty.
+    func url(path: String?, size: Size) -> URL? {
+        guard let path else { return nil }
+        let trimmed = path.drop { $0 == "/" }
+        guard !trimmed.isEmpty else { return nil }
+        return baseURL.appendingPathComponent(size.rawValue).appendingPathComponent(String(trimmed))
+    }
+}
