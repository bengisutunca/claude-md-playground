+import Foundation
+
+struct ImageURLBuilder: Sendable {
+    enum Size: String, Sendable {
+        case w185, w342, w780, original
+    }
+
+    let baseURL: URL
+
+    init(baseURL: URL = TMDBApp.imageBaseURL) {
+        self.baseURL = baseURL
+    }
+
+    /// `path` is a TMDB path such as `/inception.jpg`. Returns nil for a nil or empty path.
+    func url(path: String?, size: Size) -> URL? {
+        guard let path, !path.isEmpty else { return nil }
+        let relative = path.hasPrefix("/") ? String(path.dropFirst()) : path
+        return baseURL.appendingPathComponent(size.rawValue).appendingPathComponent(relative)
+    }
+}
