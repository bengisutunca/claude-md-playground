@@ -0,0 +1,72 @@
+import Foundation
+import Testing
+@testable import TMDBApp
+
+/// `HTTPClient` stub: records endpoints, serves a fixture or throws. Never touches the network.
+private final class StubClient: HTTPClient, @unchecked Sendable {
+    private let lock = NSLock()
+    private var _endpoints: [Endpoint] = []
+    var endpoints: [Endpoint] { lock.withLock { _endpoints } }
+    let fixture: String?
+    let error: Error?
+
+    init(fixture: String? = nil, error: Error? = nil) {
+        self.fixture = fixture
+        self.error = error
+    }
+
+    func send<T: Decodable>(_ endpoint: Endpoint, as type: T.Type) async throws -> T {
+        lock.withLock { _endpoints.append(endpoint) }
+        if let error { throw error }
+        return try JSONDecoder.tmdb.decode(T.self, from: Fixture.data(fixture!))
+    }
+}
+
+@Suite("TMDBMovieService")
+struct MovieServiceTests {
+    @Test func popularUsesEndpointAndReturnsPage() async throws {
+        let client = StubClient(fixture: "popular_page2")
+        let page = try await TMDBMovieService(client: client).popular(page: 2)
+        #expect(client.endpoints == [.popular(page: 2)])
+        #expect(page.page == 2)
+    }
+
+    @Test func searchUsesEndpointAndReturnsResults() async throws {
+        let client = StubClient(fixture: "search_inception")
+        let page = try await TMDBMovieService(client: client).search(query: "inception", page: 1)
+        #expect(client.endpoints == [.search(query: "inception", page: 1)])
+        #expect(page.results.first?.id == 27205)
+    }
+
+    @Test func detailUsesEndpoint() async throws {
+        let client = StubClient(fixture: "movie_detail_27205")
+        let detail = try await TMDBMovieService(client: client).detail(id: 27205)
+        #expect(client.endpoints == [.movieDetail(id: 27205)])
+        #expect(detail.id == 27205)
+    }
+
+    @Test func creditsUsesEndpoint() async throws {
+        let client = StubClient(fixture: "movie_credits_27205")
+        _ = try await TMDBMovieService(client: client).credits(id: 27205)
+        #expect(client.endpoints == [.credits(movieID: 27205)])
+    }
+
+    @Test func errorsPropagate() async throws {
+        let client = StubClient(error: APIError.httpStatus(code: 401, message: "nope"))
+        do {
+            _ = try await TMDBMovieService(client: client).popular(page: 1)
+            Issue.record("expected error")
+        } catch APIError.httpStatus(let code, _) {
+            #expect(code == 401)
+        }
+    }
+
+    @Test func mockServiceRecordsCallsAndThrows() async throws {
+        let mock = MockMovieService()
+        _ = try await mock.popular(page: 1)
+        _ = try await mock.detail(id: 27205)
+        #expect(mock.calls == [.popular(page: 1), .detail(id: 27205)])
+        mock.error = APIError.invalidResponse
+        await #expect(throws: APIError.self) { try await mock.credits(id: 1) }
+    }
+}
